<script>
  function initYoutubeCpmCalculator() {
    // Mode tabs
    const tabModeCpm = document.getElementById('tab-mode-cpm');
    const tabModeViews = document.getElementById('tab-mode-views');
    const formModeCpm = document.getElementById('form-mode-cpm');
    const formModeViews = document.getElementById('form-mode-views');

    // Currency selector
    const selectCurrency = document.getElementById('calc-currency');
    const currencyPrefixRevenue = document.getElementById('currency-prefix-revenue');
    const btnReset = document.getElementById('btn-reset');

    // Mode 1 Inputs
    const inputAdImpressions = document.getElementById('input-ad-impressions');
    const inputAdRevenue = document.getElementById('input-ad-revenue');

    // Mode 2 Inputs
    const inputVideoViews = document.getElementById('input-video-views');
    const inputMonetizedRate = document.getElementById('input-monetized-rate');
    const selectNichePreset = document.getElementById('select-niche-preset');

    // Stat Displays
    const valCalculatedCpm = document.getElementById('val-calculated-cpm');
    const badgeCpmLabel = document.getElementById('badge-cpm-label');
    const subCpmDetail = document.getElementById('sub-cpm-detail');

    const valCreatorPayout = document.getElementById('val-creator-payout');
    const subPayoutDetail = document.getElementById('sub-payout-detail');

    const valYoutubeShare = document.getElementById('val-youtube-share');
    const subYtDetail = document.getElementById('sub-yt-detail');

    const valStat4Primary = document.getElementById('val-stat4-primary');
    const labelStat4Title = document.getElementById('label-stat4-title');
    const badgeStat4Tag = document.getElementById('badge-stat4-tag');
    const subStat4Detail = document.getElementById('sub-stat4-detail');

    // Breakdown
    const resExplanationText = document.getElementById('res-explanation-text');
    const resMathBox = document.getElementById('res-math-box');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const copySummaryLabel = document.getElementById('copy-summary-label');

    if (!inputAdImpressions || !inputAdRevenue) return;

    let currentMode = 'cpm'; // 'cpm' or 'views'
    const currencySymbols = {
      USD: '$',
      EUR: '€',
      GBP: '£',
      CAD: 'CA$',
      AUD: 'A$',
      INR: '₹'
    };

    function getCurrencySymbol() {
      const code = selectCurrency ? selectCurrency.value : 'USD';
      return currencySymbols[code] || '$';
    }

    function formatCurrency(val) {
      const sym = getCurrencySymbol();
      const num = isNaN(val) ? 0 : Math.max(0, val);
      return `${sym}${num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function calculate() {
      const sym = getCurrencySymbol();

      if (currentMode === 'cpm') {
        // Direct CPM calculation: (Ad Revenue / Monetized Impressions) * 1,000
        const impressions = parseFloat(inputAdImpressions.value) || 0;
        const revenue = parseFloat(inputAdRevenue.value) || 0;

        let cpm = 0;
        if (impressions > 0 && revenue > 0) {
          cpm = (revenue / impressions) * 1000;
        }

        const netPayout = revenue * 0.55;
        const ytShare = revenue * 0.45;
        const effectiveRpm = impressions > 0 ? (netPayout / impressions) * 1000 : 0;

        // Update Stat Cards
        if (valCalculatedCpm) valCalculatedCpm.textContent = formatCurrency(cpm);
        if (badgeCpmLabel) badgeCpmLabel.textContent = 'Calculated CPM';
        if (subCpmDetail) subCpmDetail.textContent = 'Per 1,000 ad impressions';

        if (valCreatorPayout) valCreatorPayout.textContent = formatCurrency(netPayout);
        if (subPayoutDetail) subPayoutDetail.textContent = `Creator 55% share (~${formatCurrency(effectiveRpm)}/1k)`;

        if (valYoutubeShare) valYoutubeShare.textContent = formatCurrency(ytShare);
        if (subYtDetail) subYtDetail.textContent = 'YouTube 45% platform cut';

        if (valStat4Primary) valStat4Primary.textContent = impressions.toLocaleString('en-US');
        if (labelStat4Title) labelStat4Title.textContent = 'Ad Impressions';
        if (badgeStat4Tag) badgeStat4Tag.textContent = 'Monetized';
        if (subStat4Detail) subStat4Detail.textContent = `From ${formatCurrency(revenue)} revenue entered`;

        // Update Breakdown Box
        if (resExplanationText) {
          if (impressions > 0 && revenue > 0) {
            resExplanationText.innerHTML = `At <strong>${impressions.toLocaleString('en-US')} monetized ad impressions</strong> and <strong>${formatCurrency(revenue)} ad revenue</strong>, advertisers paid an average <strong>${formatCurrency(cpm)} CPM</strong> (${formatCurrency(cpm)} per 1,000 ad impressions).`;
          } else {
            resExplanationText.innerHTML = 'Enter monetized ad impressions and associated ad revenue above to calculate your YouTube CPM rate.';
          }
        }

        if (resMathBox) {
          resMathBox.innerHTML = `
            <span class="math-step">&bull; <strong>Formula:</strong> (Ad Revenue &divide; Monetized Impressions) &times; 1,000 = (${formatCurrency(revenue)} &divide; ${impressions.toLocaleString('en-US')}) &times; 1,000 = <strong>${formatCurrency(cpm)} CPM</strong></span>
            <span class="math-step">&bull; <strong>Estimated Creator Payout (55%):</strong> ${formatCurrency(revenue)} &times; 0.55 = <strong>${formatCurrency(netPayout)}</strong></span>
            <span class="math-step">&bull; <strong>YouTube Platform Cut (45%):</strong> ${formatCurrency(revenue)} &times; 0.45 = <strong>${formatCurrency(ytShare)}</strong></span>
          `;
        }

      } else {
        // Mode 2: Estimate from Views & Niche Benchmark
        const views = parseFloat(inputVideoViews ? inputVideoViews.value : '0') || 0;
        const monetizedPct = Math.min(100, Math.max(0, parseFloat(inputMonetizedRate ? inputMonetizedRate.value : '60') || 60));
        const nicheRate = parseFloat(selectNichePreset ? selectNichePreset.value : '12') || 12;

        const monetizedImpressions = views * (monetizedPct / 100);
        const grossAdSpend = (monetizedImpressions / 1000) * nicheRate;
        const netPayout = grossAdSpend * 0.55;
        const ytShare = grossAdSpend * 0.45;
        const creatorRpm = views > 0 ? (netPayout / views) * 1000 : 0;

        // Update Stat Cards
        if (valCalculatedCpm) valCalculatedCpm.textContent = formatCurrency(nicheRate);
        if (badgeCpmLabel) badgeCpmLabel.textContent = 'Benchmark CPM';
        if (subCpmDetail) subCpmDetail.textContent = 'Advertiser gross rate';

        if (valCreatorPayout) valCreatorPayout.textContent = formatCurrency(netPayout);
        if (subPayoutDetail) subPayoutDetail.textContent = `Effective Creator RPM: ${formatCurrency(creatorRpm)}`;

        if (valYoutubeShare) valYoutubeShare.textContent = formatCurrency(ytShare);
        if (subYtDetail) subYtDetail.textContent = 'YouTube 45% platform fee';

        if (valStat4Primary) valStat4Primary.textContent = Math.round(monetizedImpressions).toLocaleString('en-US');
        if (labelStat4Title) labelStat4Title.textContent = 'Monetized Impressions';
        if (badgeStat4Tag) badgeStat4Tag.textContent = `${monetizedPct}% Monetized`;
        if (subStat4Detail) subStat4Detail.textContent = `Out of ${views.toLocaleString('en-US')} total views`;

        // Update Breakdown Box
        if (resExplanationText) {
          resExplanationText.innerHTML = `For <strong>${views.toLocaleString('en-US')} total views</strong> with <strong>${monetizedPct}% monetized</strong> (~${Math.round(monetizedImpressions).toLocaleString('en-US')} ad impressions) at <strong>${formatCurrency(nicheRate)} CPM</strong>, total advertiser gross spend is <strong>${formatCurrency(grossAdSpend)}</strong>.`;
        }

        if (resMathBox) {
          resMathBox.innerHTML = `
            <span class="math-step">&bull; <strong>Monetized Impressions:</strong> ${views.toLocaleString('en-US')} views &times; ${monetizedPct}% = <strong>${Math.round(monetizedImpressions).toLocaleString('en-US')} impressions</strong></span>
            <span class="math-step">&bull; <strong>Gross Advertiser Spend:</strong> (${Math.round(monetizedImpressions).toLocaleString('en-US')} &divide; 1,000) &times; ${formatCurrency(nicheRate)} = <strong>${formatCurrency(grossAdSpend)}</strong></span>
            <span class="math-step">&bull; <strong>Creator Net Payout (55%):</strong> ${formatCurrency(grossAdSpend)} &times; 0.55 = <strong>${formatCurrency(netPayout)}</strong> (${formatCurrency(creatorRpm)} RPM)</span>
            <span class="math-step">&bull; <strong>YouTube Platform Cut (45%):</strong> ${formatCurrency(grossAdSpend)} &times; 0.45 = <strong>${formatCurrency(ytShare)}</strong></span>
          `;
        }
      }
    }

    function switchMode(mode) {
      currentMode = mode;
      if (tabModeCpm && tabModeViews) {
        tabModeCpm.classList.toggle('active', mode === 'cpm');
        tabModeCpm.setAttribute('aria-selected', mode === 'cpm' ? 'true' : 'false');
        tabModeViews.classList.toggle('active', mode === 'views');
        tabModeViews.setAttribute('aria-selected', mode === 'views' ? 'true' : 'false');
      }

      if (formModeCpm && formModeViews) {
        formModeCpm.classList.toggle('hidden', mode !== 'cpm');
        formModeViews.classList.toggle('hidden', mode !== 'views');
      }

      calculate();
    }

    if (tabModeCpm) tabModeCpm.addEventListener('click', () => switchMode('cpm'));
    if (tabModeViews) tabModeViews.addEventListener('click', () => switchMode('views'));

    // Input change listeners
    [inputAdImpressions, inputAdRevenue, inputVideoViews, inputMonetizedRate].forEach(input => {
      if (input) input.addEventListener('input', calculate);
    });

    if (selectNichePreset) {
      selectNichePreset.addEventListener('change', calculate);
    }

    if (selectCurrency) {
      selectCurrency.addEventListener('change', () => {
        if (currencyPrefixRevenue) {
          currencyPrefixRevenue.textContent = getCurrencySymbol();
        }
        calculate();
      });
    }

    // Reset button
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (inputAdImpressions) inputAdImpressions.value = '50000';
        if (inputAdRevenue) inputAdRevenue.value = '450.00';
        if (inputVideoViews) inputVideoViews.value = '100000';
        if (inputMonetizedRate) inputMonetizedRate.value = '60';
        if (selectNichePreset) selectNichePreset.value = '12';
        if (selectCurrency) selectCurrency.value = 'USD';
        if (currencyPrefixRevenue) currencyPrefixRevenue.textContent = '$';
        switchMode('cpm');
      });
    }

    // One-click copy summary
    if (btnCopySummary && copySummaryLabel) {
      btnCopySummary.addEventListener('click', async () => {
        const cpm = valCalculatedCpm ? valCalculatedCpm.textContent : '$0.00';
        const payout = valCreatorPayout ? valCreatorPayout.textContent : '$0.00';
        const ytCut = valYoutubeShare ? valYoutubeShare.textContent : '$0.00';
        const stat4 = valStat4Primary ? valStat4Primary.textContent : '0';

        const summaryText = `YouTube CPM Calculation Summary:\n` +
          `• Advertiser CPM: ${cpm} per 1k impressions\n` +
          `• Creator Net Payout (55%): ${payout}\n` +
          `• YouTube Platform Share (45%): ${ytCut}\n` +
          `• Monetized Ad Volume: ${stat4}\n` +
          `Calculated with CreatorsFeel YouTube CPM Calculator: https://creatorsfeel.com/tools/youtube-cpm-calculator`;

        try {
          await navigator.clipboard.writeText(summaryText);
          const original = copySummaryLabel.textContent;
          copySummaryLabel.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copySummaryLabel.textContent = original;
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    // Initial calculation
    calculate();
  }

  // Handle both DOMContentLoaded and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYoutubeCpmCalculator);
  } else {
    initYoutubeCpmCalculator();
  }

  document.addEventListener('astro:after-swap', initYoutubeCpmCalculator);
</script>
---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is Cost Per Engagement (CPE) and how is it calculated?",
    answer: "Cost Per Engagement (CPE) is a marketing efficiency metric that measures the exact cost incurred for every active interaction generated on an ad or social media post. It is calculated using the formula: CPE = Total Campaign Spend / Total Engagements. Engagements include likes, comments, shares, saves, retweets, video plays, and link clicks."
  },
  {
    question: "What is the difference between CPE, CPC, and CPM?",
    answer: "CPM (Cost Per Mille) charges for every 1,000 passive impressions (views) regardless of interaction. CPC (Cost Per Click) only charges when a user clicks a destination URL link. CPE (Cost Per Engagement) charges whenever a user actively interacts with the content (such as liking, commenting, sharing, saving, or swiping a carousel)."
  },
  {
    question: "What is considered a good or healthy Cost Per Engagement benchmark?",
    answer: "Across mainstream social platforms, a CPE between $0.05 and $0.20 is considered highly efficient, while $0.20 to $0.50 is standard for Facebook and Instagram promotions. For professional B2B platforms like LinkedIn, standard CPEs range higher ($1.20 to $3.00) due to high-value executive targeting and high customer lifetime values (LTV)."
  },
  {
    question: "What specific actions count as an engagement?",
    answer: "Engagements encompass all active user touchpoints: social signals (likes, reactions, comments, replies), content distribution (shares, reposts, retweets), content curation (saves, bookmarks, favorites), media interactions (video views, carousel swipes, audio unmutes), and direct actions (profile visits, link clicks, sticker taps)."
  },
  {
    question: "Why is Cost Per Engagement often a safer metric than CPM?",
    answer: "In CPM campaigns, advertisers pay for ad impressions even if the user rapidly scrolls past without noticing the content. In CPE models or analysis, advertisers only measure or pay for users who demonstrate verified interest by actively interacting with the creative."
  },
  {
    question: "How can brands use CPE to evaluate influencer collaborations?",
    answer: "Brands can divide an influencer's sponsorship fee by their verified average engagements (likes, comments, shares, saves) across past sponsored posts. A lower historical CPE indicates an engaged, responsive community, providing proof of campaign cost-effectiveness."
  },
  {
    question: "How do carousel posts help lower Cost Per Engagement?",
    answer: "Multi-slide carousels encourage users to swipe through multiple frames. Because each swipe, save, or comment is recorded as an active user interaction, carousels generate multiple engagement opportunities per impression, drastically lowering the effective CPE."
  },
  {
    question: "Can a campaign have a low CPE but still fail to generate sales?",
    answer: "Yes. If an ad creative is highly entertaining or click-baity, it may generate thousands of low-cost likes and comments (low CPE) from users who have zero purchasing intent. CPE must always be analyzed alongside downstream conversion metrics like Cost Per Acquisition (CAC) and Return on Ad Spend (ROAS)."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'CPE Calculator', item: '/tools/cost-per-engagement-calculator' }
];
---

<ToolLayout
  title="Cost Per Engagement (CPE) Calculator - Social Ad & Influencer ROI Tool"
  description="Free online Cost Per Engagement (CPE) calculator. Calculate marketing budget, total engagements, or campaign CPE rate instantly. Audit FB promos, Instagram ads, and social media ROI."
  toolName="Cost Per Engagement Calculator"
  toolDescription="Analyze ad performance metrics. Toggle between calculating CPE, campaign budget, or total engagements instantly with optional engagement breakdowns."
  category="Calculators"
  faqs={faqs}
>


  <!-- Interactive Calculator Interface -->
  <div slot="calculator" class="calc-card glass">
    <!-- Mode selector tabs -->
    <div class="calculator-mode-selector" role="tablist" aria-label="Calculator Mode">
      <button type="button" class="mode-tab active" data-mode="cpe" role="tab" aria-selected="true" aria-controls="calc-form-container">
        <span class="tab-long">Calculate CPE</span>
        <span class="tab-short">CPE</span>
      </button>
      <button type="button" class="mode-tab" data-mode="cost" role="tab" aria-selected="false" aria-controls="calc-form-container">
        <span class="tab-long">Calculate Budget</span>
        <span class="tab-short">Budget</span>
      </button>
      <button type="button" class="mode-tab" data-mode="engagements" role="tab" aria-selected="false" aria-controls="calc-form-container">
        <span class="tab-long">Calculate Engagements</span>
        <span class="tab-short">Engagements</span>
      </button>
    </div>

    <div class="calc-grid" id="calc-form-container">
      <!-- Inputs Form -->
      <form class="calc-form" id="cpe-form" onsubmit="return false;">
        <input type="hidden" id="active-mode" value="cpe" />

        <div class="form-group" id="cost-group">
          <div class="label-header">
            <label for="campaign-cost" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              Total Campaign Spend ($)
            </label>
          </div>
          <input type="number" id="campaign-cost" class="form-input" placeholder="0" min="0.01" step="0.01" required />
          <span class="input-helper">The total budget allocated or spent on the ad campaign or promotion.</span>
        </div>

        <div class="form-group" id="cpe-group" class="hidden" style="display: none;">
          <div class="label-header">
            <label for="cpe-rate" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
              </svg>
              Target CPE ($)
            </label>
          </div>
          <input type="number" id="cpe-rate" class="form-input" placeholder="0" min="0.001" step="0.001" />
          <span class="input-helper">The cost per engagement (CPE) rate you want to pay or analyze.</span>
        </div>

        <div class="form-group" id="engagements-wrapper-group">
          <!-- Input Type Toggle (Simple vs Breakdown) -->
          <div class="label-header">
            <label for="input-method" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
              </svg>
              Engagement Input Mode
            </label>
          </div>
          <select id="input-method" class="form-input">
            <option value="simple">Simple Total Input</option>
            <option value="breakdown">Detailed Breakdown</option>
          </select>
        </div>

        <!-- Simple input element -->
        <div class="form-group" id="simple-engagements-group">
          <div class="label-header">
            <label for="total-engagements" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94-3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
              </svg>
              Total Engagements
            </label>
          </div>
          <input type="number" id="total-engagements" class="form-input" placeholder="0" min="1" step="1" required />
          <span class="input-helper">The aggregate interactions recorded across posts or ads.</span>
        </div>

        <!-- Breakdown input panel -->
        <div id="breakdown-inputs-group" class="hidden" style="display: none; flex-direction: column; gap: 1.25rem;">
          <div class="form-group">
            <label for="breakdown-likes" class="icon-label">Likes / Reactions</label>
            <input type="number" id="breakdown-likes" class="form-input" placeholder="0" min="0" value="0" />
          </div>
          <div class="form-group">
            <label for="breakdown-comments" class="icon-label">Comments</label>
            <input type="number" id="breakdown-comments" class="form-input" placeholder="0" min="0" value="0" />
          </div>
          <div class="form-group">
            <label for="breakdown-shares" class="icon-label">Shares / Retweets</label>
            <input type="number" id="breakdown-shares" class="form-input" placeholder="0" min="0" value="0" />
          </div>
          <div class="form-group">
            <label for="breakdown-clicks" class="icon-label">Link Clicks</label>
            <input type="number" id="breakdown-clicks" class="form-input" placeholder="0" min="0" value="0" />
          </div>
          <div class="form-group">
            <label for="breakdown-saves" class="icon-label">Saves / Bookmarks</label>
            <input type="number" id="breakdown-saves" class="form-input" placeholder="0" min="0" value="0" />
          </div>
        </div>

        <div class="form-actions">
          <button type="button" id="calc-submit-btn" class="calc-btn" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l8.932-8.931m-8.932 8.931a3 3 0 1 1-4.243-4.243l8.932-8.93m9.9 9.913a3 3 0 1 1-4.243-4.243l8.932-8.931m-8.932 8.931a3 3 0 1 1-4.243-4.243l8.932-8.93" />
            </svg>
            Calculate Metrics
          </button>
          <button type="button" id="calc-reset-btn" class="calc-btn-secondary" style="width: 100%;">Reset Form</button>
        </div>
      </form>

      <!-- Results Display -->
      <div class="calc-results" id="results-wrapper">
        <!-- Waiting state -->
        <div class="empty-state text-center" id="res-empty-box">
          <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0h.5m-.5 0h-9.5m0 0h-.5" />
          </svg>
          <h3>Awaiting Calculation</h3>
          <p class="text-muted">Select your calculation target, enter the required metrics, and click Calculate.</p>
        </div>

        <!-- Output display -->
        <div class="results-active hidden" id="res-active-box">
          <div class="rate-range-box">
            <h4 class="rate-label" id="res-primary-label">Calculated CPE</h4>
            <div class="rate-range" id="res-primary-val">$0.00</div>
            <div class="grade-badge" id="res-benchmark-badge">-</div>
          </div>

          <!-- Campaign breakdowns -->
          <div class="breakdown-box">
            <h4 class="breakdown-title">Campaign Efficiency Breakdowns</h4>
            <div class="breakdown-list">
              <div class="breakdown-item">
                <span class="breakdown-label" id="res-metric1-label">Total Spend:</span>
                <span class="breakdown-val" id="res-metric1-val">-</span>
              </div>
              <div class="breakdown-item">
                <span class="breakdown-label" id="res-metric2-label">Total Engagements:</span>
                <span class="breakdown-val" id="res-metric2-val">-</span>
              </div>
              <div class="breakdown-item" id="breakdown-likes-row" style="display: none;">
                <span class="breakdown-label">Likes / Comments / Shares:</span>
                <span class="breakdown-val" id="breakdown-likes-val">-</span>
              </div>
              <div class="breakdown-item">
                <span class="breakdown-label">Cost per 1,000 Engagements:</span>
                <span class="breakdown-val" id="breakdown-k-val">-</span>
              </div>
            </div>
          </div>

          <!-- Rating description -->
          <div class="rating-explanation glass" id="benchmark-rating-box">
            <h5 class="rating-title" id="rating-title-text">Campaign Assessment</h5>
            <p class="rating-desc" id="rating-desc-text">Calculated rates will yield insights here.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Editorial slot -->
  <div slot="about" class="editorial-content">
    <h2>The Complete Guide to Cost Per Engagement (CPE) & Campaign Efficiency</h2>
    <p>
      In modern social media marketing and influencer advertising, tracking simple impressions is no longer sufficient to evaluate campaign success. Billions of automated programmatic impressions are served daily across feeds, but impressions only measure how many screens an asset rendered on—not whether anyone stopped to look, read, or care.
    </p>
    <p>
      To measure genuine audience attention and affinity, digital marketers and content creators rely on <strong>Cost Per Engagement (CPE)</strong>. By quantifying the financial investment required to generate active user participation—such as likes, comments, shares, video plays, saves, and link clicks—CPE provides an undeniable gauge of creative resonance and budget efficiency.
    </p>
    <p>
      Our interactive <strong>Cost Per Engagement Calculator</strong> empowers you to analyze past marketing spend, forecast required campaign budgets, or estimate interaction volumes with precision.
    </p>

    <div class="callout-box">
      <div class="callout-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon" style="display:inline-block; vertical-align:middle; color:var(--color-brand); margin-right:6px;"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg> Campaign Strategy & Optimization
      </div>
      <p style="margin: 0; font-size: 0.95rem;">
        Looking to lower ad acquisition costs and scale creative performance? Read our in-depth strategy guide: <a href="/blog/cost-per-engagement-calculator-guide">Cost Per Engagement Metrics & Campaign ROI Optimizations</a>.
      </p>
    </div>

    <h2>What is Cost Per Engagement (CPE) and Why Does It Matter?</h2>
    <p>
      <strong>Cost Per Engagement (CPE)</strong> is a digital marketing performance and bidding metric that calculates the average dollar amount spent to generate a single verified user interaction with an advertisement or social media post.
    </p>
    <p>
      Unlike passive view-based advertising, CPE shifts the focus toward active consumer participation. CPE is critical for two key industry stakeholders:
    </p>
    <ul>
      <li><strong>For Brands & Advertisers:</strong> CPE ensures marketing capital is not wasted on unengaged impressions. It identifies top-performing creative assets and allows media buyers to shift ad spend toward high-intent audiences, directly lowering Customer Acquisition Costs (CAC).</li>
      <li><strong>For Creators & Influencers:</strong> Knowing your historical CPE allows you to prove your audience's loyalty and responsiveness. Presenting low CPE averages (e.g., $0.10 to $0.20 per interaction) in your media kit gives you massive leverage to justify premium sponsorship rates.</li>
    </ul>

    <h2>How Cost Per Engagement is Calculated</h2>
    <p>
      The core mathematical formula for calculating Cost Per Engagement is straightforward:
    </p>

    <div class="formula-box">
      Cost Per Engagement (CPE) = Total Campaign Spend / Total Engagements
      <br />
      Cost Per 1,000 Engagements (CPKE) = CPE × 1,000
    </div>

    <h3>What Actions Count as an Engagement?</h3>
    <p>
      An engagement represents any conscious, active interaction a user takes with your content rather than passively scrolling past it. Across major social platforms, engagements include:
    </p>

    <div class="step-guide">
      <div class="step-item">
        <h3>1. Social Signals & Feedback (Likes, Reactions & Comments)</h3>
        <p>
          Direct approval and conversation. Double-tapping an Instagram post, reacting on Facebook or LinkedIn, or typing a thoughtful comment reflects high audience resonance.
        </p>
      </div>

      <div class="step-item">
        <h3>2. Content Amplification (Shares, Reposts & Retweets)</h3>
        <p>
          The highest form of social advocacy. When users share your post to their personal Stories, repost to their feed, or send it via Direct Message (DM), they organically amplify your reach at zero additional media cost.
        </p>
      </div>

      <div class="step-item">
        <h3>3. High-Intent Curation (Saves, Bookmarks & Favorites)</h3>
        <p>
          Saving a post on Instagram, TikTok, or Pinterest indicates strong long-term value. Users bookmark tutorials, product recommendations, and recipes to revisit later, making saves a strong indicator of future purchasing intent.
        </p>
      </div>

      <div class="step-item">
        <h3>4. Media Consumption (Video Views, Swipes & Expands)</h3>
        <p>
          Active consumption behaviors, including watching 3+ seconds of video, unmuting audio, swiping through multi-frame carousel slides, and tapping image expands.
        </p>
      </div>

      <div class="step-item">
        <h3>5. Direct-Response Actions (Link Clicks & Sticker Taps)</h3>
        <p>
          Clicking destination URLs, tapping Instagram Story link stickers, visiting creator bios, or expanding lead generation forms.
        </p>
      </div>
    </div>

    <h2>CPE vs CPC vs CPM: Strategic Differences & When to Use Each</h2>
    <p>
      To build an efficient marketing strategy, you must know when to buy or evaluate media based on CPE, CPC, or CPM:
    </p>

    <div class="table-responsive-wrapper">
      <table class="content-table">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Full Name</th>
            <th>Pricing Model</th>
            <th>Primary Objective</th>
            <th>Best Use Case</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>CPM</strong></td>
            <td>Cost Per Mille</td>
            <td>Cost per 1,000 impressions (views)</td>
            <td>Top-of-Funnel Brand Reach</td>
            <td>Mass awareness campaigns, brand launches, and PR announcements where maximum visibility is the sole objective.</td>
          </tr>
          <tr>
            <td><strong>CPC</strong></td>
            <td>Cost Per Click</td>
            <td>Cost per outbound website click</td>
            <td>Direct Website Traffic</td>
            <td>E-commerce product pages, lead capture funnels, and app downloads requiring external site visits.</td>
          </tr>
          <tr>
            <td><strong>CPE</strong></td>
            <td>Cost Per Engagement</td>
            <td>Cost per active social interaction</td>
            <td>Audience Affinity & Proof</td>
            <td>Social proof building, viral video distribution, community growth, and algorithmic feed acceleration.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3>Why CPE is Often More Reliable Than CPM</h3>
    <p>
      In a standard CPM campaign, an advertiser pays for ad space even if the ad renders below the fold on a desktop screen or is scrolled past in under half a second on mobile. Under a CPE framework, budget is tied directly to users who demonstrate active attention, shifting the risk away from the buyer and ensuring media spend maps directly to human engagement.
    </p>

    <h2>Key Factors That Dictate Cost Per Engagement</h2>
    <p>
      Your campaign CPE is influenced by five core variables:
    </p>

    <h3>1. Platform Algorithm & Feed Formats</h3>
    <p>
      Different social networks generate vastly different interaction costs. TikTok and Instagram Reels benefit from algorithmic video feeds that generate low-cost interactions ($0.04 – $0.15 CPE), while professional B2B platforms like LinkedIn command higher costs ($1.20 – $2.80 CPE) due to executive audience targeting.
    </p>

    <h3>2. Creative Format: Carousels & Short-Form Video</h3>
    <p>
      Multi-slide carousel posts consistently yield the lowest CPEs across social media. Because every individual swipe through a 5-to-10-slide deck registers as an engagement, a single user often generates 4 to 8 interactions on one impression.
    </p>

    <h3>3. The First 3 Seconds (Hook Strength)</h3>
    <p>
      For video ads and organic clips, the vast majority of drop-offs happen in the first three seconds. A compelling visual or auditory hook stops the scroll and dramatically increases watch time, shares, and comments, driving CPE downward.
    </p>

    <h3>4. Audience Niche & Buyer Intent</h3>
    <p>
      General lifestyle, meme, and entertainment niches have large audiences and low interaction costs. Conversely, specialized high-ticket verticals (B2B SaaS, Real Estate, Wealth Management) have smaller, high-LTV audiences that naturally operate at higher baseline CPEs.
    </p>

    <h3>5. Clear Call-to-Action (CTA) Prompts</h3>
    <p>
      Explicitly guiding viewers on how to engage (e.g., <em>'Drop your thoughts below'</em> or <em>'Save this checklist for your next shoot'</em>) can increase total engagement volume by 30% to 50% without increasing ad spend.
    </p>

    <h2>How This Cost Per Engagement Calculator Works</h2>
    <p>
      Our calculator offers three distinct mathematical modes to suit your planning or auditing needs:
    </p>

    <div class="step-guide">
      <div class="step-item">
        <h3>Mode 1: Calculate CPE (Performance Audit)</h3>
        <p>
          Input your total spend and total engagements to determine your exact Cost Per Engagement, Cost Per 1,000 Engagements (CPKE), and automated performance benchmark rating.
        </p>
      </div>

      <div class="step-item">
        <h3>Mode 2: Calculate Budget (Campaign Forecasting)</h3>
        <p>
          Input your target CPE rate and desired engagement goal to forecast the total marketing spend required to hit your objective.
        </p>
      </div>

      <div class="step-item">
        <h3>Mode 3: Calculate Engagements (Volume Expectation)</h3>
        <p>
          Input your allocated budget and target CPE to project the total volume of social interactions your campaign should generate.
        </p>
      </div>
    </div>

    <h2>Step-by-Step Guide: How to Use the Calculator Effectively</h2>
    <p>
      Follow these simple steps to analyze your campaigns in seconds:
    </p>

    <div class="step-guide">
      <div class="step-item">
        <h3>Step 1: Choose Your Calculation Target</h3>
        <p>
          Select the tab at the top: <strong>Calculate CPE</strong> to audit a finished campaign, <strong>Calculate Budget</strong> to forecast necessary ad spend, or <strong>Calculate Engagements</strong> to project interaction volume.
        </p>
      </div>

      <div class="step-item">
        <h3>Step 2: Choose Your Engagement Input Mode</h3>
        <p>
          Select <strong>Simple Total Input</strong> to enter an aggregate number of interactions, or switch to <strong>Detailed Breakdown</strong> to itemize Likes, Comments, Shares, Link Clicks, and Saves separately.
        </p>
      </div>

      <div class="step-item">
        <h3>Step 3: Enter Campaign Financials & Metrics</h3>
        <p>
          Input your total campaign spend (or target CPE) and your verified engagement numbers from your social media analytics dashboard.
        </p>
      </div>

      <div class="step-item">

---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is the Amazon Associates program?",
    answer: "Amazon Associates is Amazon's official affiliate marketing program. It allows website owners, bloggers, content creators, and influencers to monetize their audience traffic by embedding customized affiliate referral links. When a visitor clicks a tracking link and purchases qualifying products within 24 hours, the affiliate earns a percentage-based commission on the sale."
  },
  {
    question: "How do product categories affect my commission rates?",
    answer: "Amazon assigns fixed standard commission rates based on product category. Rates range from 1% up to 10%. For example, Luxury Beauty and Amazon Games offer a 10% commission; Physical Books, Kitchen, and Automotive yield 4.5%; Apparel and Shoes pay 4.0%; Home, Pet Products, and Toys yield 3.0%; PC and PC Components earn 2.5%; Televisions pay 2.0%; and Kindle or Fire Tablets pay 1.0%."
  },
  {
    question: "What is a typical Amazon affiliate conversion rate?",
    answer: "Because Amazon is a globally trusted e-commerce platform with fast Prime shipping and one-click purchasing, conversion rates are significantly higher than standard retail sites. Typical Amazon affiliate conversion rates average between 3% and 8%. High-intent commercial content such as product roundups, comparison tables, and buyer's guides often converts at 8% to 12% or higher."
  },
  {
    question: "What is the Amazon 24-hour cookie window and how does the cart hold work?",
    answer: "When a user clicks your affiliate link, a 24-hour tracking cookie is placed on their browser. You earn commissions on any eligible products they add to their cart during that 24-hour session. If an item is added to their cart within the 24-hour window, you still receive credit as long as they complete the checkout within 89 days, provided the customer does not clear their cart or click another affiliate's link."
  },
  {
    question: "What is the Amazon 'Halo Effect' (cross-category sales)?",
    answer: "The 'Halo Effect' occurs when a reader clicks your affiliate link for one product (such as a $15 book) but purchases other unrelated items during that shopping session (such as a $600 coffee machine or $150 in household groceries). Amazon credits you with qualifying commissions on every eligible item purchased in that entire cart."
  },
  {
    question: "Can I mention specific product prices in my articles?",
    answer: "No. Amazon's Operating Agreement strictly prohibits hardcoding fixed product prices in static content because Amazon prices fluctuate dynamically. You may only display real-time prices using the Amazon Product Advertising API (PA-API) with a required timestamp, or use generic call-to-action buttons such as 'Check Current Price on Amazon'."
  },
  {
    question: "What is the difference between direct and indirect qualifying purchases?",
    answer: "A direct qualifying purchase occurs when a customer buys the exact product you linked to in your content. An indirect qualifying purchase occurs when a customer clicks your link for Product A but ends up purchasing Product B in a different category. Under current Amazon operating rules, both earn you category-specific commissions during the active 24-hour session."
  },
  {
    question: "How do Amazon Bounty events work?",
    answer: "Bounties are fixed dollar payouts Amazon awards when you refer visitors who sign up for specific Amazon services and free trials. For example, referring sign-ups for Amazon Prime Free Trials, Audible memberships, Amazon Business accounts, Prime Video Channels, and Baby or Wedding Registries pay flat bounties ranging from $3.00 to $15.00+ per registration, regardless of whether the user makes a physical product purchase."
  }
];

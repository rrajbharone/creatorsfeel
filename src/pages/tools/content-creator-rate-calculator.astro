<script>
  function initContentCreatorRateCalculator() {
    const btnInstagram = document.getElementById('btn-platform-instagram');
    const btnTiktok = document.getElementById('btn-platform-tiktok');
    const btnYoutube = document.getElementById('btn-platform-youtube');

    const inputFollowers = document.getElementById('calc-followers');
    const labelFollowersText = document.getElementById('label-followers-text');
    const descFollowers = document.getElementById('desc-followers');
    const selectContentType = document.getElementById('calc-content-type');
    const inputAvgViews = document.getElementById('calc-avg-views');
    const btnReset = document.getElementById('btn-reset-form');

    const boxEmptyResults = document.getElementById('box-empty-results');
    const boxActiveResults = document.getElementById('box-active-results');

    const badgePlatformName = document.getElementById('badge-platform-name');
    const badgeFormatName = document.getElementById('badge-format-name');
    const badgeCreatorTier = document.getElementById('badge-creator-tier');

    const valMinRate = document.getElementById('val-min-rate');
    const valRecRate = document.getElementById('val-rec-rate');
    const valMaxRate = document.getElementById('val-max-rate');
    const resExplanationText = document.getElementById('res-explanation-text');

    const btnCopyRates = document.getElementById('btn-copy-rates');
    const copyRatesLabel = document.getElementById('copy-rates-label');

    if (!inputFollowers || !selectContentType) return;

    let currentPlatform = 'instagram';

    const formatOptions = {
      instagram: [
        { value: 'reel', label: 'Instagram Reel (Vertical Video)', multiplier: 1.25 },
        { value: 'feed_post', label: 'Static Feed Post (Single Photo)', multiplier: 1.0 },
        { value: 'carousel', label: 'Multi-Slide Carousel Post', multiplier: 1.15 },
        { value: 'story_set', label: 'Instagram Story Set (3 Frames with Link)', multiplier: 0.50 }
      ],
      tiktok: [
        { value: 'video', label: 'Sponsored TikTok Video (15-60s)', multiplier: 1.0 },
        { value: 'series', label: 'Multi-Part Series Video (2-Part)', multiplier: 1.45 },
        { value: 'ambassador', label: 'Brand Ambassador Video Deliverable', multiplier: 1.25 }
      ],
      youtube: [
        { value: 'integration_60s', label: '60-Second Video Integration (Mid-roll)', multiplier: 1.0 },
        { value: 'dedicated', label: 'Dedicated Sponsored Video (Full 8-15 Mins)', multiplier: 2.2 },
        { value: 'youtube_short', label: 'YouTube Short (Vertical Video)', multiplier: 0.60 }
      ]
    };

    function updateFormatDropdown() {
      if (!selectContentType) return;
      const opts = formatOptions[currentPlatform] || formatOptions.instagram;
      selectContentType.innerHTML = '';
      opts.forEach(opt => {
        const el = document.createElement('option');
        el.value = opt.value;
        el.textContent = opt.label;
        selectContentType.appendChild(el);
      });
    }

    function setPlatform(platform) {
      currentPlatform = platform;

      [btnInstagram, btnTiktok, btnYoutube].forEach(btn => {
        if (!btn) return;
        const matches = btn.getAttribute('data-platform') === platform;
        btn.classList.toggle('active', matches);
        btn.setAttribute('aria-pressed', matches ? 'true' : 'false');
      });

      if (labelFollowersText && descFollowers) {
        if (platform === 'youtube') {
          labelFollowersText.textContent = 'Subscriber Count';
          descFollowers.textContent = 'Total subscribers subscribed to your YouTube channel.';
        } else {
          labelFollowersText.textContent = 'Follower Count';
          descFollowers.textContent = `Total followers on your ${platform === 'instagram' ? 'Instagram' : 'TikTok'} profile.`;
        }
      }

      updateFormatDropdown();
      calculateRates();
    }

    if (btnInstagram) btnInstagram.addEventListener('click', () => setPlatform('instagram'));
    if (btnTiktok) btnTiktok.addEventListener('click', () => setPlatform('tiktok'));
    if (btnYoutube) btnYoutube.addEventListener('click', () => setPlatform('youtube'));

    function getCreatorTier(count) {
      if (count < 10000) return 'Nano-Creator';
      if (count < 50000) return 'Micro-Creator';
      if (count < 500000) return 'Mid-Tier Creator';
      if (count < 1000000) return 'Macro-Creator';
      return 'Elite Creator';
    }

    function calculateRates() {
      const audienceCount = parseFloat(inputFollowers ? inputFollowers.value : '0');
      const avgViews = parseFloat(inputAvgViews ? inputAvgViews.value : '0');

      if (isNaN(audienceCount) || audienceCount <= 0) {
        if (boxActiveResults) boxActiveResults.classList.add('hidden');
        if (boxEmptyResults) boxEmptyResults.classList.remove('hidden');
        return;
      }

      if (boxEmptyResults) boxEmptyResults.classList.add('hidden');
      if (boxActiveResults) boxActiveResults.classList.remove('hidden');

      const opts = formatOptions[currentPlatform] || formatOptions.instagram;
      const selectedValue = selectContentType ? selectContentType.value : '';
      const matchedFormat = opts.find(o => o.value === selectedValue) || opts[0];
      const formatMultiplier = matchedFormat.multiplier;

      let baseQuote = 0;

      if (currentPlatform === 'instagram') {
        const followerRate = (audienceCount / 1000) * 11.5;
        if (avgViews > 0) {
          const viewRate = (avgViews / 1000) * 35.0;
          baseQuote = (followerRate * 0.45) + (viewRate * 0.55);
        } else {
          baseQuote = followerRate;
        }
        baseQuote *= formatMultiplier;
      } else if (currentPlatform === 'tiktok') {
        const followerRate = (audienceCount / 1000) * 8.5;
        if (avgViews > 0) {
          const viewRate = (avgViews / 1000) * 28.0;
          baseQuote = (followerRate * 0.40) + (viewRate * 0.60);
        } else {
          baseQuote = followerRate;
        }
        baseQuote *= formatMultiplier;
      } else if (currentPlatform === 'youtube') {
        const subRate = (audienceCount / 1000) * 22.0;
        if (avgViews > 0) {
          const viewRate = (avgViews / 1000) * 45.0;
          baseQuote = (subRate * 0.35) + (viewRate * 0.65);
        } else {
          baseQuote = subRate;
        }
        baseQuote *= formatMultiplier;
      }

      const rec = Math.max(35, Math.round(baseQuote / 5) * 5);
      const min = Math.max(25, Math.round((rec * 0.75) / 5) * 5);
      const max = Math.max(45, Math.round((rec * 1.30) / 5) * 5);

      if (valRecRate) valRecRate.textContent = `$${rec.toLocaleString('en-US')}`;
      if (valMinRate) valMinRate.textContent = `$${min.toLocaleString('en-US')}`;
      if (valMaxRate) valMaxRate.textContent = `$${max.toLocaleString('en-US')}`;

      const platformLabel = currentPlatform === 'instagram' ? 'Instagram' : currentPlatform === 'tiktok' ? 'TikTok' : 'YouTube';
      const countLabel = currentPlatform === 'youtube' ? 'subscribers' : 'followers';
      const tier = getCreatorTier(audienceCount);

      if (badgePlatformName) badgePlatformName.textContent = platformLabel;
      if (badgeFormatName) badgeFormatName.textContent = matchedFormat.label.split('(')[0].trim();
      if (badgeCreatorTier) badgeCreatorTier.textContent = tier;

      if (resExplanationText) {
        if (avgViews > 0) {
          resExplanationText.innerHTML = `Estimated sponsorship rate for a <strong>${platformLabel} ${matchedFormat.label.split('(')[0].trim()}</strong> with <strong>${audienceCount.toLocaleString('en-US')} ${countLabel}</strong> and <strong>${avgViews.toLocaleString('en-US')} average views</strong>.`;
        } else {
          resExplanationText.innerHTML = `Estimated sponsorship rate for a <strong>${platformLabel} ${matchedFormat.label.split('(')[0].trim()}</strong> based on <strong>${audienceCount.toLocaleString('en-US')} ${countLabel}</strong>.`;
        }
      }
    }

    inputFollowers.addEventListener('input', calculateRates);
    selectContentType.addEventListener('change', calculateRates);
    if (inputAvgViews) inputAvgViews.addEventListener('input', calculateRates);

    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (inputFollowers) inputFollowers.value = '25000';
        if (inputAvgViews) inputAvgViews.value = '4500';
        setPlatform('instagram');
      });
    }

    if (btnCopyRates && copyRatesLabel) {
      btnCopyRates.addEventListener('click', async () => {
        const platformLabel = currentPlatform === 'instagram' ? 'Instagram' : currentPlatform === 'tiktok' ? 'TikTok' : 'YouTube';
        const formatText = selectContentType ? selectContentType.options[selectContentType.selectedIndex].text : '';
        const rec = valRecRate ? valRecRate.textContent : '$0';
        const min = valMinRate ? valMinRate.textContent : '$0';
        const max = valMaxRate ? valMaxRate.textContent : '$0';

        const summaryText = `Content Creator Rate Estimate (${platformLabel}):\n` +
          `• Deliverable: ${formatText}\n` +
          `• Recommended Rate: ${rec}\n` +
          `• Minimum Floor: ${min}\n` +
          `• Premium Rate: ${max}\n` +
          `Estimated with CreatorsFeel Content Creator Rate Calculator: https://creatorsfeel.com/tools/content-creator-rate-calculator`;

        try {
          await navigator.clipboard.writeText(summaryText);
          const original = copyRatesLabel.textContent;
          copyRatesLabel.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copyRatesLabel.textContent = original;
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    // Initialize with default platform
    setPlatform('instagram');
  }

  // Handle both DOMContentLoaded and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContentCreatorRateCalculator);
  } else {
    initContentCreatorRateCalculator();
  }

  document.addEventListener('astro:after-swap', initContentCreatorRateCalculator);
</script>

<script>
  const setupYoutubeDescriptionFormatter = () => {
    const descInput = document.getElementById('description-input') as HTMLTextAreaElement;

    const timestampsCheck = document.getElementById('timestamps-check') as HTMLInputElement;
    const bulletsCheck = document.getElementById('bullets-check') as HTMLInputElement;
    const linksCheck = document.getElementById('links-check') as HTMLInputElement;
    const spacingCheck = document.getElementById('spacing-check') as HTMLInputElement;

    // Actions
    const formatBtn = document.getElementById('format-btn');
    const resetBtn = document.getElementById('reset-btn');
    const copyBtn = document.getElementById('copy-description-btn');

    // Layout slots
    const resultsWrapper = document.getElementById('results-wrapper');

    // Metrics targets
    const statCharCount = document.getElementById('stat-char-count');
    const statCharBadge = document.getElementById('stat-char-badge');
    const statLineCount = document.getElementById('stat-line-count');
    const statLinkCount = document.getElementById('stat-link-count');
    const statTagCount = document.getElementById('stat-tag-count');

    // Mockup targets
    const mockupFormattedText = document.getElementById('mockup-formatted-text');
    const charCounterTag = document.getElementById('char-counter-tag');

    const formatDescription = () => {
      let text = descInput?.value || '';

      const formatTimestamps = timestampsCheck?.checked;
      const formatBullets = bulletsCheck?.checked;
      const formatLinks = linksCheck?.checked;
      const cleanSpacing = spacingCheck?.checked;

      let lines = text.split('\n');

      // 1. Process timestamps
      if (formatTimestamps) {
        let hasStart = false;
        lines = lines.map(line => {
          // Detect MM:SS or HH:MM:SS
          const timeMatch = line.match(/(?:\d{1,2}:)?\d{1,2}:\d{2}/);
          if (timeMatch) {
            const timeCode = timeMatch[0];
            if (timeCode === '00:00' || timeCode === '0:00' || timeCode === '00:00:00') {
              hasStart = true;
            }
            // Structure: "MM:SS - Chapter Title"
            const title = line.replace(timeCode, '').replace(/^[\s\-_:=]+/, '').trim();
            return `${timeCode} - ${title}`;
          }
          return line;
        });

        // Prepend 00:00 Intro if missing and timestamps exist
        const hasTimestamps = lines.some(l => /(?:\d{1,2}:)?\d{1,2}:\d{2}/.test(l));
        if (hasTimestamps && !hasStart) {
          const firstTimeIdx = lines.findIndex(l => /(?:\d{1,2}:)?\d{1,2}:\d{2}/.test(l));
          if (firstTimeIdx !== -1) {
            lines.splice(firstTimeIdx, 0, '00:00 - Intro');
          }
        }
      }

      // 2. Process list bullet points
      if (formatBullets) {
        let bulletIdx = 0;
        const bulletEmojis = ['📌', '✅', '👉', '✨', '⚡'];
        lines = lines.map(line => {
          if (line.trim().startsWith('-') || line.trim().startsWith('*')) {
            const cleanText = line.replace(/^[\s\-*]+/, '').trim();
            const emoji = bulletEmojis[bulletIdx % bulletEmojis.length];
            bulletIdx++;
            return `${emoji} ${cleanText}`;
          }
          return line;
        });
      }

      // 3. Process links
      if (formatLinks) {
        lines = lines.map(line => {
          // Find standard domain pattern e.g. creatorsfeel.com or youtube.com/abc
          const domainMatch = line.match(/(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(?:\/[^\s]*)?/);
          if (domainMatch && !line.includes('http://') && !line.includes('https://')) {
            const domain = domainMatch[0];
            return line.replace(domain, `https://${domain}`);
          }
          return line;
        });
      }

      // 4. Normalize spacing
      let formattedText = lines.join('\n');
      if (cleanSpacing) {
        formattedText = formattedText
          .replace(/\r\n/g, '\n')
          .replace(/\n{3,}/g, '\n\n') // Max double line breaks
          .trim();
      }

      // Update counters
      const charCount = formattedText.length;
      const totalLines = formattedText.split('\n').filter(Boolean).length;
      
      const linkMatches = formattedText.match(/https?:\/\/[^\s]+/g);
      const totalLinks = linkMatches ? linkMatches.length : 0;

      const tagMatches = formattedText.match(/#[a-zA-Z0-9_]+/g);
      const totalTags = tagMatches ? tagMatches.length : 0;

      // Update metrics slots
      if (statCharCount) statCharCount.textContent = charCount.toString();
      if (statLineCount) statLineCount.textContent = totalLines.toString();
      if (statLinkCount) statLinkCount.textContent = totalLinks.toString();
      if (statTagCount) statTagCount.textContent = totalTags.toString();

      if (statCharBadge) {
        if (charCount > 5000) {
          statCharBadge.textContent = 'Too Long (> 5k)';
          statCharBadge.style.background = '#ffeeef';
          statCharBadge.style.color = '#ef4444';
        } else {
          statCharBadge.textContent = 'Optimal (< 5000)';
          statCharBadge.style.background = '#dcfce7';
          statCharBadge.style.color = '#16a34a';
        }
      }

      if (charCounterTag) {
        charCounterTag.textContent = `${charCount.toLocaleString()} / 5,000 characters`;
        charCounterTag.style.color = charCount > 5000 ? '#ef4444' : '#aaaaaa';
      }

      // Update mockup content
      if (mockupFormattedText) {
        mockupFormattedText.textContent = formattedText;
      }

      resultsWrapper?.classList.remove('hidden');
    };

    formatBtn?.addEventListener('click', () => {
      formatDescription();

      const resultsSection = document.getElementById('results-wrapper');
      if (resultsSection) {
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Handle copying individual description preview
    copyBtn?.addEventListener('click', () => {
      const formattedText = mockupFormattedText?.textContent || '';
      if (!formattedText) return;

      navigator.clipboard.writeText(formattedText).then(() => {
        if (copyBtn) {
          copyBtn.textContent = 'Copied! ✓';
          setTimeout(() => {
            copyBtn.textContent = 'Copy Formatted Text';
          }, 1500);
        }
      });
    });

    // Reset inputs
    resetBtn?.addEventListener('click', () => {
      if (descInput) descInput.value = '';
      resultsWrapper?.classList.add('hidden');
    });

    // Auto-run initial format
    formatDescription();
  };

  setupYoutubeDescriptionFormatter();
  document.addEventListener('astro:after-swap', setupYoutubeDescriptionFormatter);
</script>

---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is a YouTube description formatter?",
    answer: "A YouTube description formatter is an SEO optimization tool that structures video descriptions with clean line breaks, highlighted timestamps, standardized bullet emojis, and social template links, ensuring they comply with YouTube's 5,000-character limit."
  },
  {
    question: "How do I format timestamps so they become clickable on YouTube?",
    answer: "To create clickable chapter timestamps on YouTube, list them in your description using the MM:SS or HH:MM:SS format, starting with exactly 00:00 (or 0:00). Each timestamp must be on a new line followed by a space and a chapter name."
  },
  {
    question: "Can formatting my YouTube description improve video search rankings?",
    answer: "Yes, well-formatted descriptions improve search indexing by placing primary target keywords in the first 2 lines, structuring LSI synonyms in the body, and organizing links/timestamps. This improves user experience, boosts click-through rates (CTR), and increases average watch time."
  },
  {
    question: "Does this tool automatically clean up broken links?",
    answer: "Yes, the formatter scans your description for plain text URLs and converts them to standard hyperlinked formats, ensuring your affiliate resources and social links remain active and clickable for viewers."
  },
  {
    question: "Is this YouTube Description Formatter free to use?",
    answer: "Yes, our YouTube Description Formatter is 100% free with unlimited description edits, character counts, copy-paste outputs, and live collapsible preview panels."
  }
];
---

<ToolLayout
  title="YouTube Description Formatter - Free Video SEO Optimizer"
  description="Format your YouTube video descriptions with clickable timestamps, emojis, clean paragraph spacing, and social templates. Audit character limits in real-time."
  toolName="YouTube Description Formatter"
  toolDescription="Format and optimize your YouTube video descriptions in real-time. Structure timestamps, convert lists to bullets, normalize spacing, and preview layouts."
  category="Writing Tools"
  faqs={faqs}
>
  <div slot="calculator" class="calc-card glass">
    <!-- Main Advanced Grid Layout -->
    <div class="calc-grid">
      <!-- Left Column: Formatter Inputs -->
      <div class="calc-form-column">
        <div class="calc-form">
          <!-- Description Text Area -->
          <div class="form-group">
            <label for="description-input" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />

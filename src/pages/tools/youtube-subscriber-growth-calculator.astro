</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const currentInput = document.getElementById('current-subs') as HTMLInputElement | null;
    const monthlyInput = document.getElementById('monthly-growth') as HTMLInputElement | null;
    const targetInput = document.getElementById('target-subs') as HTMLInputElement | null;
    const presetBtns = document.querySelectorAll('.preset-btn');
    const btnCalculate = document.getElementById('btn-calculate');
    const btnReset = document.getElementById('btn-reset');

    // Alert & Results container
    const statusAlert = document.getElementById('status-alert');
    const alertMessage = document.getElementById('alert-message');
    const resEmptyBox = document.getElementById('res-empty-box');
    const resultsSection = document.getElementById('results-section');
    const achievedBanner = document.getElementById('achieved-banner');
    const heroResultCard = document.getElementById('hero-result-card');
    const longTimelineBox = document.getElementById('long-timeline-box');

    // Hero Result elements
    const resNeededTitle = document.getElementById('res-needed-title');
    const resTimeHero = document.getElementById('res-time-hero');
    const resRateNote = document.getElementById('res-rate-note');
    const resDateBadge = document.getElementById('res-date-badge');

    // Metric elements
    const resCurrentSubs = document.getElementById('res-current-subs');
    const resTargetSubs = document.getElementById('res-target-subs');
    const resSubsNeeded = document.getElementById('res-subs-needed');
    const resMonthlyRate = document.getElementById('res-monthly-rate');
    const resTargetDate = document.getElementById('res-target-date');
    const resProgressPct = document.getElementById('res-progress-pct');

    // Progress bar elements
    const progressBarTitle = document.getElementById('progress-bar-title');
    const progressPctVal = document.getElementById('progress-pct-val');
    const progressFill = document.getElementById('progress-fill');

    if (!currentInput || !monthlyInput || !targetInput) return;

    // Number Formatting Helper with Commas
    function formatNumber(num: number): string {
      if (isNaN(num) || !isFinite(num)) return '0';
      return Math.round(num).toLocaleString('en-US');
    }

    // Main Calculator Execution Function (Runs ONLY on Calculate Growth click)
    function executeCalculation() {
      // Hide alert by default
      if (statusAlert) statusAlert.classList.add('hidden');

      let current = parseFloat(currentInput?.value || '0');
      let monthly = parseFloat(monthlyInput?.value || '0');
      let target = parseFloat(targetInput?.value || '0');

      // Validation 1: NaN or Negative values
      if (isNaN(current) || current < 0) current = 0;
      if (isNaN(target) || target < 0) target = 0;

      // Validation 2: Monthly growth must be > 0
      if (isNaN(monthly) || monthly <= 0) {
        if (statusAlert && alertMessage) {
          statusAlert.classList.remove('hidden');
          alertMessage.textContent = 'Average monthly subscriber growth must be greater than 0.';
        }
        if (resultsSection) resultsSection.classList.add('hidden');
        if (resEmptyBox) resEmptyBox.classList.remove('hidden');
        return;
      }

      // Hide empty state placeholder, show active results
      if (resEmptyBox) resEmptyBox.classList.add('hidden');

      // Handle Current >= Target Edge Case
      if (target > 0 && current >= target) {
        if (resultsSection) resultsSection.classList.remove('hidden');
        if (achievedBanner) achievedBanner.classList.remove('hidden');
        if (heroResultCard) heroResultCard.classList.add('hidden');
        if (longTimelineBox) longTimelineBox.classList.add('hidden');

        if (resCurrentSubs) resCurrentSubs.textContent = formatNumber(current);
        if (resTargetSubs) resTargetSubs.textContent = formatNumber(target);
        if (resSubsNeeded) resSubsNeeded.textContent = '0';
        if (resMonthlyRate) resMonthlyRate.textContent = `${formatNumber(monthly)} / mo`;
        if (resTargetDate) resTargetDate.textContent = 'Achieved!';
        if (resProgressPct) resProgressPct.textContent = '100%';

        if (progressBarTitle) progressBarTitle.textContent = `Progress to ${formatNumber(target)} Subscribers`;
        if (progressPctVal) progressPctVal.textContent = `${formatNumber(current)} / ${formatNumber(target)} (100%)`;
        if (progressFill) progressFill.style.width = '100%';

        // Scroll to results section on mobile/viewport
        smoothScrollToResults();
        return;
      }

      // Standard Calculation: Target > Current
      if (achievedBanner) achievedBanner.classList.add('hidden');
      if (heroResultCard) heroResultCard.classList.remove('hidden');

      const subsNeeded = Math.max(0, target - current);
      const exactMonths = subsNeeded / monthly;
      const roundedMonths = Math.ceil(exactMonths);
      const progressPct = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;

      // Format Human-Friendly Duration
      const years = Math.floor(roundedMonths / 12);
      const remainingMonths = roundedMonths % 12;
      let humanDuration = '';
      if (years > 0) {
        humanDuration = remainingMonths > 0 
          ? `${years} ${years === 1 ? 'Year' : 'Years'} ${remainingMonths} ${remainingMonths === 1 ? 'Month' : 'Months'}`
          : `${years} ${years === 1 ? 'Year' : 'Years'}`;
      } else {
        humanDuration = `${roundedMonths} ${roundedMonths === 1 ? 'Month' : 'Months'}`;
      }

      // Calculate Target Achievement Date
      const now = new Date();
      const targetDate = new Date(now.getFullYear(), now.getMonth() + roundedMonths, 1);
      const monthNamesShort = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      const monthNamesFull = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      const formattedDateFull = `${monthNamesFull[targetDate.getMonth()]} ${targetDate.getFullYear()}`;
      const formattedDateShort = `${monthNamesShort[targetDate.getMonth()]} ${targetDate.getFullYear()}`;

      // Update Hero Result Card
      if (resNeededTitle) resNeededTitle.textContent = `You Need ${formatNumber(subsNeeded)} More Subscribers`;
      if (resTimeHero) resTimeHero.textContent = humanDuration;
      if (resRateNote) resRateNote.textContent = `Based on an average growth of ${formatNumber(monthly)} subscribers per month.`;
      if (resDateBadge) resDateBadge.textContent = `Estimated Target Date: ${formattedDateFull}`;

      // Update Long Timeline Warning Box (> 5 years / > 60 months)
      if (longTimelineBox) {
        if (roundedMonths > 60) {
          longTimelineBox.classList.remove('hidden');
        } else {
          longTimelineBox.classList.add('hidden');
        }
      }

      // Update 6 Metric Cards
      if (resCurrentSubs) resCurrentSubs.textContent = formatNumber(current);
      if (resTargetSubs) resTargetSubs.textContent = formatNumber(target);
      if (resSubsNeeded) resSubsNeeded.textContent = formatNumber(subsNeeded);
      if (resMonthlyRate) resMonthlyRate.textContent = `${formatNumber(monthly)} / mo`;
      if (resTargetDate) resTargetDate.textContent = formattedDateShort;
      if (resProgressPct) resProgressPct.textContent = `${progressPct}%`;

      // Update Progress Bar
      if (progressBarTitle) progressBarTitle.textContent = `Progress to ${formatNumber(target)} Subscribers`;
      if (progressPctVal) progressPctVal.textContent = `${formatNumber(current)} / ${formatNumber(target)} (${progressPct}%)`;
      if (progressFill) progressFill.style.width = `${progressPct}%`;

      // Render results section
      if (resultsSection) resultsSection.classList.remove('hidden');

      // Scroll smoothly to results section on mobile/viewport
      smoothScrollToResults();
    }

    // Smooth Scroll Helper
    function smoothScrollToResults() {
      if (!resultsSection) return;
      // Scroll smoothly on mobile or narrow screens so results are in view
      if (window.innerWidth < 992) {
        setTimeout(() => {
          const yOffset = -20;
          const y = resultsSection.getBoundingClientRect().top + window.pageYOffset + yOffset;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }, 50);
      }
    }

    // Reset Functionality
    function resetForm() {
      if (currentInput) currentInput.value = '';
      if (monthlyInput) monthlyInput.value = '';
      if (targetInput) targetInput.value = '';
      
      presetBtns.forEach(btn => btn.classList.remove('active'));
      if (statusAlert) statusAlert.classList.add('hidden');
      if (resultsSection) resultsSection.classList.add('hidden');
      if (resEmptyBox) resEmptyBox.classList.remove('hidden');

      if (currentInput) currentInput.focus();
    }

    // Calculate Button Click Event
    if (btnCalculate) {
      btnCalculate.addEventListener('click', executeCalculation);
    }

    // Reset Button Click Event
    if (btnReset) {
      btnReset.addEventListener('click', resetForm);
    }

    // Preset Goal Buttons Event Listener
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetVal = btn.getAttribute('data-target');
        if (targetVal && targetInput) {
          targetInput.value = targetVal;
          presetBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        }
      });
    });
  });
</script>

<script>
  function initSubscriberGrowthCalculator() {
    const inputCurrentSubs = document.getElementById('input-current-subs') as HTMLInputElement | null;
    const inputDailySubs = document.getElementById('input-daily-subs') as HTMLInputElement | null;
    const periodTabs = document.querySelectorAll('.period-tab');

    const badgePeriodLabel = document.getElementById('badge-period-label');
    const valNewSubs = document.getElementById('val-new-subs');
    const subNewDetail = document.getElementById('sub-new-detail');
    const valTotalSubs = document.getElementById('val-total-subs');
    const subTotalDetail = document.getElementById('sub-total-detail');
    const valGrowthPct = document.getElementById('val-growth-pct');
    const subGrowthDetail = document.getElementById('sub-growth-detail');

    const chartDynamicGroup = document.getElementById('chart-dynamic-group');

    const msValToday = document.getElementById('ms-val-today');
    const msVal30d = document.getElementById('ms-val-30d');
    const msVal90d = document.getElementById('ms-val-90d');
    const msVal6m = document.getElementById('ms-val-6m');
    const msVal1y = document.getElementById('ms-val-1y');

    const resExplanationText = document.getElementById('res-explanation-text');
    const btnReset = document.getElementById('btn-reset');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const copySummaryLabel = document.getElementById('copy-summary-label');

    if (!inputCurrentSubs || !inputDailySubs) return;

    // State Variables
    let currentPeriodDays = 30;
    let periodName = '30 Days';

    function formatNumber(num: number): string {
      if (isNaN(num) || !isFinite(num)) return '0';
      return Math.round(num).toLocaleString('en-US');
    }

    function calculateGrowth() {
      let current = parseFloat(inputCurrentSubs?.value || '0');
      let daily = parseFloat(inputDailySubs?.value || '0');

      if (isNaN(current) || current < 0) current = 0;
      if (isNaN(daily) || daily < 0) daily = 0;

      const estimatedNew = Math.round(daily * currentPeriodDays);
      const projectedTotal = current + estimatedNew;

      let growthPctText = '0.0%';
      let growthSubText = 'No change in audience size';

      if (current > 0) {
        const pct = ((estimatedNew / current) * 100).toFixed(1);
        growthPctText = `+${pct}%`;
        growthSubText = `Expansion over ${formatNumber(current)} starting subs`;
      } else if (current === 0 && estimatedNew > 0) {
        growthPctText = `+${formatNumber(estimatedNew)}`;
        growthSubText = `First audience members from 0`;
      }

      // Update Dashboard Metric Cards
      if (badgePeriodLabel) {
        badgePeriodLabel.textContent = `${periodName} Growth Forecast`;
      }

      if (valNewSubs) {
        valNewSubs.textContent = `+${formatNumber(estimatedNew)}`;
      }

      if (subNewDetail) {
        subNewDetail.textContent = `Based on ${formatNumber(daily)} new subs/day`;
      }

      if (valTotalSubs) {
        valTotalSubs.textContent = formatNumber(projectedTotal);
      }

      if (subTotalDetail) {
        subTotalDetail.textContent = `At end of ${periodName}`;
      }

      if (valGrowthPct) {
        valGrowthPct.textContent = growthPctText;
      }

      if (subGrowthDetail) {
        subGrowthDetail.textContent = growthSubText;
      }

      // Update Quick Milestone Indicators Strip
      const subs30d = current + Math.round(daily * 30);
      const subs90d = current + Math.round(daily * 90);
      const subs6m = current + Math.round(daily * 180);
      const subs1y = current + Math.round(daily * 365);

      if (msValToday) msValToday.textContent = formatNumber(current);
      if (msVal30d) msVal30d.textContent = formatNumber(subs30d);
      if (msVal90d) msVal90d.textContent = formatNumber(subs90d);
      if (msVal6m) msVal6m.textContent = formatNumber(subs6m);
      if (msVal1y) msVal1y.textContent = formatNumber(subs1y);

      // Update Calculation Guidance Sentence
      if (resExplanationText) {
        resExplanationText.innerHTML = `Projections assume a steady pace of <strong>${formatNumber(daily)} new subscribers per day</strong> added to your starting base of <strong>${formatNumber(current)} subscribers</strong> over <strong>${periodName}</strong>.`;
      }

      // Render Responsive SVG Growth Curve
      renderChart(current, daily, currentPeriodDays);
    }

    function renderChart(current: number, daily: number, periodDays: number) {
      if (!chartDynamicGroup) return;

      const chartXStart = 65;
      const chartXEnd = 540;
      const chartYBottom = 170;
      const chartYTop = 45;
      const usableHeight = chartYBottom - chartYTop;

      // 5 Checkpoints: 0%, 25%, 50%, 75%, 100%
      const checkpoints = [
        { pct: 0, label: 'Today', days: 0 },
        { pct: 0.25, label: getStepLabel(periodDays, 0.25), days: Math.round(periodDays * 0.25) },
        { pct: 0.50, label: getStepLabel(periodDays, 0.50), days: Math.round(periodDays * 0.50) },
        { pct: 0.75, label: getStepLabel(periodDays, 0.75), days: Math.round(periodDays * 0.75) },
        { pct: 1.00, label: getStepLabel(periodDays, 1.00), days: periodDays }
      ];

      const minVal = current;
      const maxVal = Math.max(current + 1, current + Math.round(daily * periodDays));
      const rangeVal = maxVal - minVal || 1;

      const points = checkpoints.map(cp => {
        const val = current + Math.round(daily * cp.days);
        const normVal = (val - minVal) / rangeVal;
        const x = chartXStart + cp.pct * (chartXEnd - chartXStart);
        // Invert Y coordinate so higher numbers are higher visually
        const y = chartYBottom - normVal * usableHeight;
        return { x, y, val, label: cp.label };
      });

      // Construct Area Path (for gradient fill)
      const areaPathD = `M ${points[0].x} ${chartYBottom} ` +
        points.map(p => `L ${p.x} ${p.y}`).join(' ') +
        ` L ${points[points.length - 1].x} ${chartYBottom} Z`;

      // Construct Line Path
      const linePathD = `M ${points[0].x} ${points[0].y} ` +
        points.slice(1).map(p => `L ${p.x} ${p.y}`).join(' ');

      // Build SVG Elements
      let svgHtml = `
        <path d="${areaPathD}" fill="url(#growthAreaGradient)" />
        <path d="${linePathD}" fill="none" stroke="#4f46e5" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
      `;

      // Add Data Point Circles and Labels
      points.forEach(p => {
        svgHtml += `
          <!-- Point Circle -->
          <circle cx="${p.x}" cy="${p.y}" r="5" fill="#ffffff" stroke="#4f46e5" stroke-width="2.5" />
          
          <!-- Point Value Label -->
          <text x="${p.x}" y="${Math.max(25, p.y - 12)}" text-anchor="middle" class="chart-point-val">${formatNumber(p.val)}</text>
          
          <!-- X-Axis Label -->
          <text x="${p.x}" y="200" text-anchor="middle" class="chart-axis-label">${p.label}</text>
        `;
      });

      chartDynamicGroup.innerHTML = svgHtml;
    }

    function getStepLabel(periodDays: number, fraction: number): string {
      const days = Math.round(periodDays * fraction);
      if (periodDays === 30) {
        if (fraction === 0.25) return 'Day 8';
        if (fraction === 0.50) return 'Day 15';
        if (fraction === 0.75) return 'Day 22';
        return 'Day 30';
      }
      if (periodDays === 90) {
        if (fraction === 0.25) return 'Day 23';
        if (fraction === 0.50) return 'Day 45';
        if (fraction === 0.75) return 'Day 68';
        return '90 Days';
      }
      if (periodDays === 180) {
        if (fraction === 0.25) return '1.5 Mos';
        if (fraction === 0.50) return '3 Mos';
        if (fraction === 0.75) return '4.5 Mos';
        return '6 Months';
      }
      if (periodDays === 365) {
        if (fraction === 0.25) return '3 Mos (Q1)';
        if (fraction === 0.50) return '6 Mos (Q2)';
        if (fraction === 0.75) return '9 Mos (Q3)';
        return '1 Year';
      }
      return `${days}d`;
    }

    // Input Listeners for Live Calculation
    inputCurrentSubs.addEventListener('input', calculateGrowth);
    inputDailySubs.addEventListener('input', calculateGrowth);

    // Period Tabs Event Listeners
    periodTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const days = parseInt(tab.getAttribute('data-days') || '30', 10);
        currentPeriodDays = days;
        periodName = days === 365 ? '1 Year' : days === 180 ? '6 Months' : days === 90 ? '90 Days' : '30 Days';

        periodTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-pressed', 'false');
        });

        tab.classList.add('active');
        tab.setAttribute('aria-pressed', 'true');

        calculateGrowth();
      });
    });

    // Reset Action
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (inputCurrentSubs) inputCurrentSubs.value = '1250';
        if (inputDailySubs) inputDailySubs.value = '15';

        currentPeriodDays = 30;
        periodName = '30 Days';

        periodTabs.forEach(t => {
          const days = parseInt(t.getAttribute('data-days') || '30', 10);
          if (days === 30) {
            t.classList.add('active');
            t.setAttribute('aria-pressed', 'true');
          } else {
            t.classList.remove('active');
            t.setAttribute('aria-pressed', 'false');
          }
        });

        calculateGrowth();
      });
    }

    // Copy Summary Action
    if (btnCopySummary && copySummaryLabel) {
      btnCopySummary.addEventListener('click', async () => {
        const current = inputCurrentSubs.value || '0';
        const daily = inputDailySubs.value || '0';
        const newSubs = valNewSubs?.textContent || '0';
        const total = valTotalSubs?.textContent || '0';
        const pct = valGrowthPct?.textContent || '0%';

        const summaryText = `YouTube Subscriber Growth Forecast (${periodName}):\n` +
          `• Current Subscribers: ${formatNumber(parseFloat(current))}\n` +
          `• Daily Gain: ${formatNumber(parseFloat(daily))} subs/day\n` +
          `• Estimated New Subs: ${newSubs}\n` +
          `• Projected Total: ${total}\n` +
          `• Estimated Growth: ${pct}\n` +
          `Projected with CreatorsFeel YouTube Subscriber Growth Calculator: https://creatorsfeel.com/tools/youtube-subscriber-growth-calculator`;

        try {
          await navigator.clipboard.writeText(summaryText);
          const original = copySummaryLabel.textContent;
          copySummaryLabel.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copySummaryLabel.textContent = original;
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    // Initial Execution
    calculateGrowth();
  }

  // Handle both DOMContentLoaded and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSubscriberGrowthCalculator);
  } else {
    initSubscriberGrowthCalculator();
  }

  document.addEventListener('astro:after-swap', initSubscriberGrowthCalculator);
</script>

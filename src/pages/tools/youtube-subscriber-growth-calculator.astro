---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "How does the YouTube Subscriber Growth Calculator estimate my goal date?",
    answer: "The calculator determines the remaining subscribers needed to reach your goal (Target Subscribers minus Current Subscribers) and divides that number by your Average Monthly Subscriber Growth. It then projects the estimated target achievement month and year starting from today's date."
  },
  {
    question: "How long does it take to get 1,000 subscribers on YouTube?",
    answer: "On average, new YouTube channels take between 6 and 18 months to reach 1,000 subscribers. Channels that post consistently (1-2 videos per week) in a specific niche with optimized titles and thumbnails tend to reach 1,000 subscribers much faster."
  },
  {
    question: "How long does it take to reach 10,000 subscribers on YouTube?",
    answer: "Reaching 10,000 subscribers typically takes 1.5 to 3 years. Because channel growth is non-linear and speeds up as YouTube's recommendation engine indexes your content library, scaling from 1,000 to 10,000 subscribers is usually faster than getting your first 1,000 subscribers."
  },
  {
    question: "Why is YouTube subscriber growth not completely linear?",
    answer: "Linear projections assume constant monthly growth, but YouTube channel growth is compounding. As your video library expands, your baseline monthly views increase, causing your monthly subscriber acquisition rate to accelerate over time."
  },
  {
    question: "What is a good subscriber conversion rate for YouTube videos?",
    answer: "A healthy subscriber conversion rate is around 1% to 3% of total video views. For example, if a video receives 10,000 views, gaining 100 to 300 new subscribers is considered strong performance."
  },
  {
    question: "Can I use this calculator to track progress toward YouTube Partner Program (YPP) monetization?",
    answer: "Yes! You can set your target to 1,000 subscribers (the subscriber milestone required for the YouTube Partner Program) to calculate how many months remain until you fulfill the subscriber monetization requirement."
  }
];
---

<ToolLayout
  title="YouTube Subscriber Growth Calculator - Goal & Timeline Forecast"
  description="Free YouTube Subscriber Growth Calculator. Calculate how long to reach 1,000, 10,000, or 100,000 subscribers based on your monthly growth rate and target goals."
  toolName="YouTube Subscriber Growth Calculator"
  toolDescription="Forecast your channel timeline, estimate months to reach target subscriber goals, calculate annual subscriber growth, and track milestone progress."
  category="Calculators"
  faqs={faqs}
>
  <!-- Main Calculator Interface -->
  <div slot="calculator" class="calc-card glass">
    <div class="calc-main-grid">
      
      <!-- Inputs Column -->
      <div class="calc-input-panel">
        <h3 class="panel-heading">Channel Growth Inputs</h3>
        
        <div class="form-group">
          <label for="current-subs" class="input-label">Current Subscribers</label>
          <div class="input-wrapper">
            <input 
              type="number" 
              id="current-subs" 
              class="calc-input" 
              value="250" 
              min="0" 
              step="1"
              placeholder="e.g. 250" 
            />
            <span class="input-unit">subs</span>
          </div>
        </div>

        <div class="form-group">
          <label for="monthly-growth" class="input-label">Average New Subscribers / Month</label>
          <div class="input-wrapper">
            <input 
              type="number" 
              id="monthly-growth" 
              class="calc-input" 
              value="50" 
              min="1" 
              step="1"
              placeholder="e.g. 50" 
            />
            <span class="input-unit">subs/mo</span>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="target-subs" class="input-label">Target Subscriber Goal</label>
            <span class="preset-label">Quick Goals:</span>
          </div>
          <div class="input-wrapper">
            <input 
              type="number" 
              id="target-subs" 
              class="calc-input" 
              value="1000" 
              min="1" 
              step="1"
              placeholder="e.g. 1000" 
            />
            <span class="input-unit">subs</span>
          </div>

          <!-- Quick Target Presets Bar -->
          <div class="presets-bar">
            <button type="button" class="preset-btn" data-target="1000">1K (YPP)</button>
            <button type="button" class="preset-btn" data-target="5000">5K</button>
            <button type="button" class="preset-btn" data-target="10000">10K</button>
            <button type="button" class="preset-btn" data-target="50000">50K</button>
            <button type="button" class="preset-btn" data-target="100000">100K</button>
          </div>
        </div>

        <!-- Form Action Buttons -->
        <div class="form-actions-row">
          <button type="button" id="btn-calculate" class="calc-btn-primary">
            Calculate Growth
          </button>
          <button type="button" id="btn-reset" class="calc-btn-secondary">
            Reset
          </button>
        </div>

        <!-- Inline Validation Alert Box -->
        <div class="status-alert-box hidden" id="status-alert">
          <span class="alert-icon">⚠️</span>
          <span class="alert-message" id="alert-message">Please enter valid inputs.</span>
        </div>

        <!-- Pre-calculation Help Note -->
        <div class="help-note-box">
          <div class="note-icon">💡</div>
          <div class="note-text">
            Enter your current subscribers, average monthly growth rate, and target goal above, then click <strong>Calculate Growth</strong> to generate your timeline forecast.
          </div>
        </div>
      </div>

      <!-- Right Column: Results & Progress Forecast -->
      <div class="calc-results-panel" id="results-panel">
        
        <!-- Placeholder Waiting State (Visible before calculation) -->
        <div class="empty-state" id="res-empty-box">
          <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 0 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
          </svg>
          <h3 class="empty-title">Waiting for Calculation</h3>
          <p class="empty-desc">Enter your details and click Calculate Growth to see your subscriber growth projection here.</p>
        </div>

        <!-- Active Calculation Results (Rendered upon clicking Calculate Growth) -->
        <div class="results-active hidden" id="results-section">
          <h3 class="panel-heading">Subscriber Growth Forecast</h3>

          <!-- Goal Achieved Banner (Visible if Current >= Target) -->
          <div class="achieved-banner hidden" id="achieved-banner">
            <span class="achieved-icon">🎉</span>
            <h4 class="achieved-title">Congratulations! You've already reached your target.</h4>
            <p class="achieved-text">Your current subscriber count has met or surpassed your target goal. Set a higher target above to project future growth!</p>
          </div>

          <!-- Main Projection Card -->
          <div class="hero-result-card" id="hero-result-card">
            <span class="hero-needed-badge" id="res-needed-title">You Need 750 More Subscribers</span>
            <span class="hero-sub-title">Estimated Time at Your Current Growth Rate</span>
            <div class="hero-main-value" id="res-time-hero">1 Year 3 Months</div>
            <p class="hero-rate-note" id="res-rate-note">Based on an average growth of 50 subscribers per month.</p>
            <div class="hero-date-badge" id="res-date-badge">Estimated Date: November 2027</div>
          </div>

          <!-- Long Timeline Warning Box (Visible if estimated time > 5 years) -->
          <div class="long-timeline-box hidden" id="long-timeline-box">
            <div class="long-timeline-header">
              <span class="long-timeline-icon">⌛</span>
              <strong class="long-timeline-title">Your current growth pace suggests a long timeline</strong>
            </div>
            <p class="long-timeline-text">
              Based on your current average monthly subscriber growth, the calculator produces a long-term projection. This does not mean it will actually take this long. YouTube growth can accelerate significantly when a video performs well, a channel reaches a new audience, or content strategy improves.
            </p>
          </div>

          <!-- 6 Key Metric Cards Grid -->
          <div class="metrics-grid">
            
            <div class="metric-card">
              <span class="metric-value" id="res-current-subs">250</span>
              <span class="metric-label">Current Subs</span>
              <span class="metric-sub text-muted">Baseline count</span>
            </div>

            <div class="metric-card">
              <span class="metric-value" id="res-target-subs">1,000</span>
              <span class="metric-label">Target Subs</span>
              <span class="metric-sub text-muted">Milestone goal</span>
            </div>

            <div class="metric-card highlight-card">
              <span class="metric-value" id="res-subs-needed">750</span>
              <span class="metric-label">Subscribers Needed</span>
              <span class="metric-sub text-muted">Remaining gap</span>
            </div>

            <div class="metric-card">
              <span class="metric-value" id="res-monthly-rate">50 / mo</span>
              <span class="metric-label">Monthly Growth</span>
              <span class="metric-sub text-muted">Average rate</span>
            </div>

            <div class="metric-card">
              <span class="metric-value" id="res-target-date">Nov 2027</span>
              <span class="metric-label">Estimated Date</span>
              <span class="metric-sub text-muted">Projected month</span>
            </div>

            <div class="metric-card">
              <span class="metric-value" id="res-progress-pct">25%</span>
              <span class="metric-label">Current Progress</span>
              <span class="metric-sub text-muted">Goal completion</span>
            </div>

          </div>

          <!-- Visual Progress Bar -->
          <div class="progress-section">
            <div class="progress-label-row">
              <span class="progress-title" id="progress-bar-title">Progress to 1,000 Subscribers</span>
              <span class="progress-pct-val" id="progress-pct-val">250 / 1,000 (25%)</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill" id="progress-fill" style="width: 25%;"></div>
            </div>
          </div>

          <!-- Growth Reality & Projection Explanation Box -->
          <div class="growth-reality-box">
            <div class="reality-header">
              <span class="reality-icon">📊</span>
              <h4 class="reality-title">Important: YouTube Growth Is Not Linear</h4>
            </div>
            <p class="reality-intro">
              This calculation answers: <strong>"How long would it take if I continued growing at my current average rate?"</strong> It is an estimate based on your current baseline pace, not a rigid prediction of what will happen to your channel.
            </p>
            <ul class="reality-list">
              <li><strong>Initial Slow Phase:</strong> Subscriber growth is often slow initially while building your video foundation.</li>
              <li><strong>Viral & Recommendation Spikes:</strong> A single successful video can bring a sudden, dramatic surge in subscribers.</li>
              <li><strong>Compounding Search Traffic:</strong> An expanding video library builds recurring organic views that gather subscribers 24/7.</li>
              <li><strong>Audience Authority:</strong> Consistent publishing improves CTR and converts casual viewers into loyal subscribers faster over time.</li>
            </ul>
          </div>

        </div>

      </div>

    </div>
  </div>

  <!-- Editorial & SEO Content Slot -->
  <div slot="about" class="editorial-content">
    <section class="editorial-section">
      <h2>Complete Guide to YouTube Subscriber Growth Calculation and Milestone Forecasting</h2>
      <p>
        Setting clear, data-driven subscriber milestones is one of the most effective strategies for growing a successful YouTube channel. Whether your immediate goal is reaching 1,000 subscribers to unlock monetization through the YouTube Partner Program (YPP) or scaling past 10,000 subscribers to establish full-time brand authority, knowing your growth velocity keeps your publishing strategy focused.
      </p>
      <p>
        Our <strong>YouTube Subscriber Growth Calculator</strong> calculates your growth trajectory in real-time. By inputting your current subscriber count, average monthly new subscribers, and target goal, you get an immediate breakdown of the subscribers needed, estimated months required, expected completion date, annual growth rate, and percentage completion.
      </p>

      <h2>What is a YouTube Subscriber Growth Calculator?</h2>
      <p>
        A YouTube Subscriber Growth Calculator is a specialized digital forecasting tool designed to measure the mathematical timeline required for a channel to travel from its current subscriber benchmark to a target goal.
      </p>
      <p>
        Instead of guessing when your channel will reach key milestones, the calculator applies linear growth principles to your monthly acquisition metrics, providing a realistic baseline for channel planning, content calendars, and sponsorship pitching.
      </p>

      <h2>How the Subscriber Growth Calculation Works</h2>
      <p>
        The core math behind our subscriber calculator is straightforward, transparent, and accurate:
      </p>
      <div class="formula-box glass">
        <div class="formula-row">
          <strong>1. Subscribers Needed</strong> = Target Subscribers − Current Subscribers
        </div>
        <div class="formula-row">
          <strong>2. Estimated Months</strong> = Subscribers Needed ÷ Average Monthly New Subscribers
        </div>
        <div class="formula-row">
          <strong>3. Annual Growth Rate</strong> = Average Monthly New Subscribers × 12
        </div>
        <div class="formula-row">
          <strong>4. Current Progress (%)</strong> = (Current Subscribers ÷ Target Subscribers) × 100
        </div>
      </div>
      <p>
        For example, if you currently have <strong>250 subscribers</strong>, gain an average of <strong>50 new subscribers per month</strong>, and set a target of <strong>1,000 subscribers</strong>:
      </p>
      <ul>
        <li><strong>Subscribers Needed:</strong> 1,000 − 250 = 750 subscribers.</li>
        <li><strong>Estimated Months:</strong> 750 ÷ 50 = 15 months (1 Year 3 Months).</li>
        <li><strong>Annual Subscriber Growth:</strong> 50 × 12 = 600 subscribers per year.</li>
        <li><strong>Current Progress:</strong> (250 ÷ 1,000) × 100 = 25%.</li>
      </ul>

      <h2>Estimating Time to Reach 1,000 YouTube Subscribers</h2>
      <p>
        Reaching <strong>1,000 subscribers</strong> is the first major milestone for every creator because it represents the subscriber threshold needed to qualify for YouTube Partner Program monetization (alongside 4,000 public watch hours or 10M Shorts views).
      </p>
      <p>
        Here is how average timelines vary based on monthly subscriber acquisition rates:
      </p>
      <div class="table-responsive">
        <table class="editorial-table">
          <thead>
            <tr>
              <th>Monthly Growth Rate</th>
              <th>Starting Subscribers</th>
              <th>Subscribers Needed</th>
              <th>Estimated Time to 1,000 Subs</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>10 subs / month</strong></td>
              <td>0</td>
              <td>1,000</td>
              <td>100 Months (~8.3 Years)</td>
            </tr>
            <tr>
              <td><strong>25 subs / month</strong></td>
              <td>100</td>
              <td>900</td>
              <td>36 Months (3 Years)</td>
            </tr>
            <tr>
              <td><strong>50 subs / month</strong></td>
              <td>250</td>
              <td>750</td>
              <td>15 Months (1.25 Years)</td>
            </tr>
            <tr>
              <td><strong>100 subs / month</strong></td>
              <td>500</td>
              <td>500</td>
              <td>5 Months (~0.4 Years)</td>
            </tr>
            <tr>
              <td><strong>200 subs / month</strong></td>
              <td>200</td>
              <td>800</td>
              <td>4 Months (~0.33 Years)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Estimating Time to Reach 10,000 YouTube Subscribers</h2>
      <p>
        Scaling from 1,000 to 10,000 subscribers transitions a channel from hobby status to an established media platform. At 10,000 subscribers, creators unlock additional community features, brand deal opportunities, and higher baseline algorithmic reach.
      </p>
      <p>
        While linear calculations project timelines based on fixed monthly numbers, most channels experience an acceleration in growth after passing 1,000 subscribers. This occurs because an expanded library of top-performing videos continues to gather search traffic and recommendation impressions round-the-clock.
      </p>

      <h2>Linear Projections vs. Exponential Algorithmic Growth</h2>
      <p>
        It is important to recognize that YouTube subscriber growth rarely follows a flat, straight line forever:
      </p>
      <div class="comparison-box glass">
        <div class="comp-column">
          <h3 class="comp-heading">Linear Projection (Calculator Baseline)</h3>
          <p>
            Assumes a static monthly growth rate (e.g. exactly 50 subscribers every 30 days). Useful for setting realistic minimum targets and evaluating current performance.
          </p>
        </div>
        <div class="comp-column">
          <h3 class="comp-heading text-brand">Exponential Channel Compound Growth</h3>
          <p>
            As your publishing consistency improves, your video catalog grows, and click-through rates rise, YouTube's algorithm pushes your videos to broader seed audiences, accelerating monthly subscriber gains.
          </p>
        </div>
      </div>

      <h2>5 Proven Strategies to Accelerate YouTube Subscriber Growth</h2>
      <p>
        If your estimated timeline to reach your goal is longer than desired, implementing these optimization strategies can increase your monthly subscriber acquisition rate:
      </p>
      <ol>
        <li>
          <strong>Optimize Your First 50 Characters of Titles:</strong> Make sure your video titles communicate clear value immediately so viewers in search grids click through. Use our <a href="/tools/youtube-title-character-counter">YouTube Title Character Counter</a> to prevent mobile title truncation.
        </li>
        <li>
          <strong>Structure Descriptions for Search Indexing:</strong> Use detailed, keyword-rich descriptions with formatted chapter timestamps to rank in YouTube search. Use our <a href="/tools/youtube-description-formatter">YouTube Description Formatter</a> for clean layouts.
        </li>
        <li>
          <strong>Target High-Demand, Low-Competition Keywords:</strong> Focus on specific search queries that viewers are actively searching for. Generate content topics with our <a href="/tools/youtube-keyword-generator">YouTube Keyword Generator</a> and <a href="/tools/youtube-tag-generator">YouTube Tag Generator</a>.
        </li>
        <li>
          <strong>Track Watch Hours Alongside Subscribers:</strong> Remember that monetization requires both 1,000 subscribers and 4,000 watch hours. Forecast your watch time progress using our <a href="/tools/youtube-watch-time-calculator">YouTube Watch Time Calculator</a>.
        </li>
        <li>
          <strong>Include Verbal & Visual Call-to-Actions (CTAs):</strong> Don't assume satisfied viewers will subscribe automatically. Remind them mid-video by explaining <em>why</em> subscribing benefits them (e.g. "Subscribe for new weekly guides").
        </li>
      </ol>

      <h2>Common Mistakes When Setting YouTube Subscriber Goals</h2>
      <ul>
        <li><strong>Comparing Early Growth to Large Competitors:</strong> Comparing a 200-subscriber channel's monthly growth to a 500,000-subscriber channel creates unrealistic expectations. Focus on incremental percentage growth.</li>
        <li><strong>Focusing on Subscriber Count Over View Velocity:</strong> Subscribers are a lagging indicator; video views and watch time are leading indicators. Increasing video views naturally drives subscriber conversion.</li>
        <li><strong>Inconsistent Upload Schedules:</strong> Sporadic posting disrupts your audience's habit loop and limits YouTube's ability to test your content against consistent viewer segments.</li>
        <li><strong>Changing Niches Too Frequently:</strong> Broad pivoting confuses YouTube's recommendation engine and leads to low subscriber notification click-through rates.</li>
      </ul>

      <h2>Step-by-Step Guide: How to Use the Calculator</h2>
      <ul class="steps-list">
        <li><strong>Step 1: Enter Current Subscribers:</strong> Type your exact subscriber count as displayed in YouTube Studio.</li>
        <li><strong>Step 2: Input Average Monthly Growth:</strong> Enter how many new subscribers your channel gains on average each month (e.g., last 28 days sub count in Analytics).</li>
        <li><strong>Step 3: Select or Enter Target Goal:</strong> Use the quick preset buttons (1K, 5K, 10K, 50K, 100K) or enter a custom target goal.</li>
        <li><strong>Step 4: Click Calculate Growth:</strong> Click the primary action button to run the calculation and view your projected milestone breakdown.</li>
        <li><strong>Step 5: Review Strategic Insights:</strong> Read the non-linear growth notes and evaluate how increasing monthly output can shorten your timeline.</li>
      </ul>

      <h2>Explore More Free YouTube Creator Tools on CreatorsFeel</h2>
      <div class="internal-links-grid">
        <a href="/tools/youtube-watch-time-calculator" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Watch Time Calculator</div>
          <div class="tool-link-desc">Track public watch hours and forecast your channel timeline toward the 4,000-hour YPP monetization threshold.</div>
        </a>
        <a href="/tools/youtube-title-character-counter" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Title Character Counter</div>
          <div class="tool-link-desc">Count characters, words, spaces, and emojis in your video titles while auditing mobile snippet truncation.</div>
        </a>
        <a href="/tools/youtube-description-formatter" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Description Formatter</div>
          <div class="tool-link-desc">Format clean descriptions, build clickable timestamps, normalize link formatting, and avoid truncation.</div>
        </a>
        <a href="/tools/youtube-keyword-generator" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Keyword Generator</div>
          <div class="tool-link-desc">Discover high-volume, low-competition keywords for video titles, descriptions, and channel tags.</div>
        </a>
        <a href="/tools/youtube-tag-generator" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Tag Generator</div>
          <div class="tool-link-desc">Generate character-optimized SEO metadata tags for YouTube videos and Shorts to improve search indexing.</div>
        </a>
      </div>
    </section>
  </div>
</ToolLayout>

<style>
  /* Base Card Container */
  .calc-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Main Two-Column Grid */
  .calc-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3.5vw, 2.25rem);
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 992px) {
    .calc-main-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
    }
  }

  /* Left Panel: Inputs */
  .calc-input-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 100%;
  }

  .panel-heading {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .input-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .preset-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .input-wrapper {
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .input-wrapper:focus-within {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .calc-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    background: transparent;
    border: none;
    outline: none;
    box-sizing: border-box;
  }

  .input-unit {
    padding-right: 1rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Target Presets Bar */
  .presets-bar {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .preset-btn {
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-fast);
    min-height: 32px;
  }

  .preset-btn:hover, .preset-btn.active {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: #ffffff;
  }

  /* Form Action Buttons */
  .form-actions-row {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .calc-btn-primary {
    flex: 1;
    min-width: 160px;
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--gradient-brand);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: transform var(--transition-fast), opacity var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    text-align: center;
  }

  .calc-btn-primary:hover {
    opacity: 0.95;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
  }

  .calc-btn-secondary {
    padding: 0.85rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-alt);

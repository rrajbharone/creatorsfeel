---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What does CPM stand for in advertising?",
    answer: "CPM stands for 'Cost Per Mille'. 'Mille' is the Latin word for thousand, meaning CPM represents the price an advertiser pays for every 1,000 impressions (displays or views) of an advertisement."
  },
  {
    question: "How do you calculate CPM?",
    answer: "To calculate CPM, divide the total campaign budget by the total number of impressions, then multiply by 1,000. The mathematical formula is: CPM = (Total Campaign Cost / Total Impressions) × 1,000."
  },
  {
    question: "What is the difference between CPM, CPC, and CPA?",
    answer: "CPM (Cost Per Mille) charges per 1,000 ad views regardless of clicks. CPC (Cost Per Click) charges only when a user clicks on the ad. CPA (Cost Per Acquisition) charges only when a user completes a desired action, such as buying a product or signing up for a service."
  },
  {
    question: "What is the difference between advertiser CPM and publisher RPM?",
    answer: "CPM is an advertiser-side metric measuring the cost to purchase 1,000 impressions. RPM (Revenue Per Mille) is a publisher-side metric measuring the creator's earnings per 1,000 page views or video plays after ad platform revenue splits and fill rates are applied."
  },
  {
    question: "What is considered a good or average CPM rate?",
    answer: "A standard global CPM for general consumer social media ads in Tier 1 countries ranges between $5.00 and $18.00. In high-value niches like finance, insurance, and B2B SaaS, CPMs frequently exceed $30.00 to $60.00+, while broad entertainment niches in Tier 3 countries can see CPMs below $2.00."
  },
  {
    question: "Does CPM measure unique viewers or total ad views?",
    answer: "CPM measures total impressions, not unique reach. If one person views your advertisement 5 times, that counts as 5 impressions. Unique viewer volume is measured separately via Reach and Frequency metrics."
  },
  {
    question: "Why do CPM rates surge during the fourth quarter (Q4)?",
    answer: "CPM rates increase by 50% to 100%+ during Q4 (October through December) because major retailers and e-commerce brands flood ad auctions with massive holiday budgets for Black Friday and Christmas, driving up real-time bidding (RTB) competition."
  },
  {
    question: "How can advertisers lower their CPM without losing ad quality?",
    answer: "Advertisers can lower CPM by establishing frequency caps (e.g., maximum 3 views per user), slightly broadening narrow audience parameters, improving ad creative relevance to boost Click-Through Rates (CTR), and testing less congested placements like Reels or display inventory."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'CPM Calculator', item: '/tools/cpm-calculator' }
];

const canonicalUrl = "https://creatorsfeel.com/tools/cpm-calculator";
---


---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    question: "Why does Instagram compress my Reels and make them look blurry?",
    answer: "Instagram automatically recompresses all uploaded videos using aggressive server-side encoding to save bandwidth and ensure rapid mobile streaming. If your original video has an excessively high bitrate (such as 50+ Mbps from a 4K camera) or non-standard dimensions, Instagram's automated transcoders compress it harshly, resulting in pixelation, color banding, and stuttering. Compressing your Reel to an optimal 1080×1920 resolution at 1.8 to 3.0 Mbps beforehand prevents Instagram's transcoders from degrading your visual quality."
  },
  {
    question: "What are the recommended video specifications for Instagram Reels in 2026?",
    answer: "According to Meta's official guidelines, the recommended specifications for Instagram Reels are: 1080 × 1920 pixels resolution (9:16 vertical aspect ratio), 30 or 60 frames per second (fps), MP4 or WebM container with H.264/VP9 video codec, AAC audio codec at 128 kbps (48 kHz stereo), a target video bitrate between 1.5 Mbps and 3.5 Mbps, and a maximum file size under 250 MB (maximum duration up to 90 seconds in the native feed or 15 minutes for uploaded videos)."
  },
  {
    question: "What is the difference between High Quality, Balanced, and Smaller File compression presets?",
    answer: "The 'High Quality' preset targets approximately 3.0 Mbps bitrate, preserving maximum sharpness and fine textures for high-detail footage with a modest 25%–35% file size reduction. The 'Balanced' preset targets approximately 1.8 Mbps, achieving the sweet spot for Instagram Reels with roughly 45%–60% file size reduction and near-lossless clarity on mobile screens. The 'Smaller File' preset targets approximately 900 Kbps, reducing file size by 65%–80% for fast uploads over slow cellular networks or strict storage limits."
  },
  {
    question: "Are my uploaded videos private, and does this tool upload files to any cloud server?",
    answer: "Your videos are 100% private and confidential. All video processing, frame rendering, and media compression execute entirely client-side inside your own web browser using HTML5 Canvas, Web Audio, and MediaRecorder APIs. Your video files, audio tracks, and personal metadata never leave your computer or smartphone, and zero bytes are transmitted to any external server."
  },
  {
    question: "Why would a compressed video occasionally turn out larger than the original file?",
    answer: "If your source video is already heavily compressed with an ultra-low bitrate (such as 500 Kbps from a WhatsApp forward or screen recording) and you select the 'High Quality' preset (targeting 3.0 Mbps), re-encoding the video at a higher target bitrate will allocate more bits per second, yielding a larger output file without improving quality. If your video is already small, choose 'Smaller File' or keep the original file as-is."
  },
  {
    question: "Can I compress landscape (16:9) or square (1:1) videos for Instagram Reels?",
    answer: "Yes. You can upload any standard aspect ratio (16:9 landscape, 1:1 square, 4:5 portrait, or 9:16 vertical). The tool allows you to preserve the original aspect ratio with reduced bitrate, or fit it cleanly into a standard 9:16 vertical frame for Reels, TikTok, and YouTube Shorts."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'Video Compressor for Reels', item: '/tools/video-compressor-for-reels' }
];

const origin = Astro.site ? Astro.site.origin : "https://creatorsfeel.com";
const canonicalUrl = new URL(Astro.url.pathname, origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${canonicalUrl}#application`,
  "name": "Video Compressor for Reels",
  "url": canonicalUrl,
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "description": "Free online Video Compressor for Reels. Compress MP4, MOV, and WebM videos for Instagram Reels, TikTok, and YouTube Shorts without quality loss. 100% private client-side compression.",
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout
  title="Video Compressor for Reels - Compress Instagram Reels Free Online"
  description="Free online Video Compressor for Reels. Reduce video file size for Instagram Reels, TikTok, and Shorts without losing 1080p quality. 100% client-side privacy."
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script type="application/ld+json" slot="meta" set:html={JSON.stringify(softwareSchema)} />

  <div class="tool-page-wrapper">

    <!-- 1. HERO SECTION (Centered Max-Width 820px) -->
    <header class="tool-hero-section">
      <div class="container hero-inner">

        <!-- Breadcrumbs at top -->
        <div class="hero-breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>

        <!-- Pill Badge with SVG Icon (Zero Emojis) -->
        <div class="hero-badge">
          <span class="badge-icon-tool">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tool-svg" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </span>
          <span class="badge-title">Instagram Reels &amp; Short Video Optimizer</span>
          <span class="badge-pill-free">100% Private</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-headline">
          Video Compressor for <span class="gradient-text">Reels</span>
        </h1>

        <!-- Short Description -->
        <p class="hero-desc">
          Compress and optimize your Instagram Reels, TikTok, and YouTube Shorts videos directly in your browser. Reduce file size without losing crisp 1080p visual clarity. No server uploads.
        </p>

        <!-- Feature Chips Row (Zero Emojis - Clean SVG Icons) -->
        <div class="hero-features-row">
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
            </svg>
            9:16 Vertical Reel Presets
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Smart Bitrate Control
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75A2.25 2.25 0 001.5 12v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
            Zero Server Uploads
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            Instant Free Download
          </span>
        </div>
      </div>
    </header>

    <!-- 2. MAIN TOOL SECTION (Container Max-Width 940px) -->
    <section class="tool-main-section" aria-label="Video Compressor for Reels Tool Interface">
      <div class="container tool-card-container">

        <!-- The Prominent SaaS Tool Card -->
        <div class="saas-tool-card">

          <!-- Card Header Bar -->
          <div class="card-header-bar">
            <div class="header-title-cluster">
              <div class="card-icon-wrap" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="title-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
              </div>
              <div>
                <h2 class="card-title-text">Reels Video Compression Studio</h2>
                <span class="card-sub-text">Workflow: Upload Video → Choose Settings → Compress → Download</span>
              </div>
            </div>

            <div class="header-controls-cluster">
              <div class="live-status-pill">
                <span class="live-pulse-dot" aria-hidden="true"></span>
                <span>Client-Side Active</span>
              </div>
              <button type="button" class="btn-reset-tool" id="btn-reset-all" title="Reset compressor inputs and video">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="reset-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                <span>Reset</span>
              </button>
            </div>
          </div>

          <!-- STEP 1: VIDEO UPLOAD AREA -->
          <div class="upload-section-wrap">
            <div class="dropzone-box" id="dropzone" tabindex="0" role="button" aria-label="Upload video file for Reels compression">
              <input type="file" id="video-file-input" class="hidden-file-input" accept="video/mp4,video/webm,video/quicktime,video/x-m4v,video/mkv,video/*,.mp4,.mov,.webm,.m4v,.mkv" />
              
              <!-- Dropzone Initial Prompt -->
              <div class="dropzone-prompt" id="dropzone-prompt">
                <div class="upload-icon-circle" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="upload-arrow-svg">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                  </svg>
                </div>
                <h3 class="dropzone-prompt-title">Drag &amp; Drop Your Video for Reels Here</h3>
                <p class="dropzone-prompt-sub">or <span class="browse-action-link">browse video file</span> from your device</p>
                <div class="format-tags-row">
                  <span class="format-tag">MP4</span>
                  <span class="format-tag">MOV</span>
                  <span class="format-tag">WebM</span>
                  <span class="format-tag">9:16 Vertical &amp; Landscape</span>
                  <span class="format-tag privacy-tag">100% Client-Side Private</span>
                </div>
              </div>

              <!-- Uploaded Video Bar & Metadata (Shown after file selection) -->
              <div class="loaded-video-card" id="loaded-video-card" style="display: none;">
                <div class="video-preview-thumb-wrap">
                  <video id="loaded-source-video" class="loaded-thumb-video" muted playsinline></video>
                </div>
                <div class="video-meta-content">
                  <div class="video-meta-title-row">
                    <span class="video-filename" id="meta-filename">my_reel.mp4</span>
                    <button type="button" class="btn-change-video" id="btn-change-video" title="Select a different video file">
                      Change Video
                    </button>
                  </div>
                  <div class="meta-pills-cluster">
                    <span class="meta-pill" id="pill-filesize">0 MB</span>
                    <span class="meta-pill" id="pill-duration">00:00 Duration</span>
                    <span class="meta-pill" id="pill-resolution">1080 × 1920</span>
                    <span class="meta-pill highlight-pill" id="pill-aspect-ratio">9:16 Vertical Reel</span>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="upload-alert-box" id="upload-error-box" style="display: none;" role="alert">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="alert-svg" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              <span id="upload-error-msg">Please upload a valid video file under 500 MB.</span>
            </div>
          </div>

          <!-- STEP 2: COMPRESSION SETTINGS (Visible when video is loaded or configured) -->
          <div class="settings-container-wrap" id="settings-container">
            <div class="settings-header-row">
              <h3 class="settings-title">Compression &amp; Reels Encoding Settings</h3>
              <span class="settings-sub">Tailored to bypass Instagram Reels automated transcode degradation</span>
            </div>

            <div class="settings-grid">
              
              <!-- Setting 1: Quality Preset -->
              <div class="setting-field-group">
                <label for="select-preset" class="setting-label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="field-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" />
                  </svg>
                  <span>Compression Quality Preset</span>
                </label>
                <div class="styled-select-wrap">
                  <select id="select-preset" class="styled-select">
                    <option value="balanced" selected>Balanced (Target ~1.8 Mbps - Recommended for Reels)</option>
                    <option value="high">High Quality (Target ~3.0 Mbps - Maximum Sharpness)</option>
                    <option value="smaller">Smaller File (Target ~900 Kbps - Maximum Space Savings)</option>
                  </select>
                  <div class="select-chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </div>
                </div>
                <p class="setting-helper-text" id="helper-preset-text">
                  Optimal 1.8 Mbps bitrate prevents Instagram's server from recompressing and introducing blur.
                </p>
              </div>

              <!-- Setting 2: Output Resolution -->
              <div class="setting-field-group">
                <label for="select-resolution" class="setting-label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="field-svg" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                  <span>Target Output Resolution</span>
                </label>
                <div class="styled-select-wrap">
                  <select id="select-resolution" class="styled-select">
                    <option value="original" selected>Original Resolution (Preserve Dimensions)</option>
                    <option value="1080">1080p (Full HD - Meta Recommended for Reels)</option>
                    <option value="720">720p (HD - Fast Mobile Loading)</option>
                    <option value="480">480p (SD - Ultra Lightweight)</option>
                  </select>
                  <div class="select-chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </div>
                </div>
                <p class="setting-helper-text" id="helper-resolution-text">
                  Videos are never upscaled beyond original source dimensions to prevent artificial pixelation.
                </p>
              </div>

              <!-- Setting 3: Audio Track Setting -->
              <div class="setting-field-group">
                <label for="select-audio" class="setting-label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="field-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.757 3.63 8.25 4.51 8.25H6.75z" />
                  </svg>
                  <span>Audio Track</span>
                </label>
                <div class="styled-select-wrap">
                  <select id="select-audio" class="styled-select">
                    <option value="keep" selected>Keep Audio Track (Standard Stereo)</option>
                    <option value="mute">Remove Audio Track (Save extra 10%–20% file size)</option>
                  </select>
                  <div class="select-chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </div>
                </div>
                <p class="setting-helper-text">
                  Choose 'Remove Audio' if you plan to add trending background music directly inside the Instagram app.
                </p>
              </div>

              <!-- Setting 4: Aspect Ratio Framing -->
              <div class="setting-field-group">
                <label for="select-framing" class="setting-label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="field-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                  </svg>
                  <span>Framing for Reels</span>
                </label>
                <div class="styled-select-wrap">
                  <select id="select-framing" class="styled-select">
                    <option value="fit" selected>Keep Original Aspect Ratio (Fit without cropping)</option>
                    <option value="crop916">Center Crop to 9:16 Vertical Reel</option>
                  </select>
                  <div class="select-chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </div>
                </div>
                <p class="setting-helper-text">
                  Convert horizontal clips into full-screen 9:16 Reels or maintain letterboxed proportions.
                </p>
              </div>

            </div>

            <!-- Estimated Size Pill Box -->
            <div class="estimate-strip-box">
              <div class="estimate-info-group">
                <span class="estimate-label">Estimated Output Size:</span>
                <span class="estimate-value" id="label-estimated-size">Select or upload a video</span>
              </div>
              <span class="estimate-disclaimer">
                *Estimated size is calculated from target bitrate and duration. Actual output size is confirmed upon encoding completion.
              </span>
            </div>

            <!-- Primary Action Row -->
            <div class="compress-actions-row">
              <button type="button" class="btn-compress-primary" id="btn-start-compression">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-btn-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25" />
                </svg>
                <span>Compress Video for Reels</span>
              </button>
            </div>

            <!-- Live Progress Feedback Card (Displayed during active compression) -->
            <div class="compression-progress-card" id="compression-progress-card" style="display: none;" aria-live="polite">
              <div class="progress-meta-row">
                <div class="progress-title-cluster">
                  <span class="spinner-dot-pulse" aria-hidden="true"></span>
                  <span class="progress-phase-title" id="progress-phase-title">Compressing video frames...</span>
                </div>
                <span class="progress-numeric-pct" id="progress-numeric-pct">0%</span>
              </div>
              
              <div class="progress-track-bg">
                <div class="progress-fill-bar" id="progress-fill-bar" style="width: 0%;"></div>
              </div>
              
              <div class="progress-sub-info-row">
                <span id="progress-sub-detail">Processing locally in browser canvas...</span>
                <span id="progress-timer-detail">Elapsed: 00:00</span>
              </div>
            </div>

          </div>

          <!-- STEP 3: RESULTS & DOWNLOAD SECTION -->
          <div class="compression-results-area" id="compression-results-area" style="display: none;">
            
            <div class="card-divider"></div>

            <!-- Success Verdict Banner -->
            <div class="verdict-banner-success">
              <div class="verdict-icon-circle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="check-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <div class="verdict-text-block">
                <h3 class="verdict-heading">Reel Compressed Successfully!</h3>
                <p class="verdict-sub">Optimized for high-retention Instagram Reels, TikTok, and YouTube Shorts playback.</p>
              </div>
            </div>

            <!-- 4 Essential Result Metric Cards -->
            <div class="results-grid-four">
              
              <!-- Card 1: Compressed Size (Highlighted) -->
              <div class="result-metric-card highlight-card">
                <div class="metric-top-row">
                  <span class="metric-label-title">Compressed Size</span>
                  <div class="metric-icon-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                  </div>
                </div>
                <div class="metric-large-value" id="res-compressed-size">0.00 MB</div>
                <p class="metric-sub-detail" id="res-compressed-sub">Output file ready for download</p>
              </div>

              <!-- Card 2: Original Size -->
              <div class="result-metric-card">
                <div class="metric-top-row">
                  <span class="metric-label-title">Original Size</span>
                  <div class="metric-icon-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                      <line x1="8" y1="21" x2="16" y2="21"/>
                    </svg>
                  </div>
                </div>
                <div class="metric-large-value" id="res-original-size">0.00 MB</div>
                <p class="metric-sub-detail">Source input video file</p>
              </div>

              <!-- Card 3: Size Reduction -->
              <div class="result-metric-card">
                <div class="metric-top-row">
                  <span class="metric-label-title">Size Reduction</span>

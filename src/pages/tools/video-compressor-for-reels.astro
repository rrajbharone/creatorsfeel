    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    line-height: 1.6;
    color: var(--color-text-muted, #64748b);
    margin: 0 0 1.75rem 0;
    max-width: 680px;
  }

  .hero-features-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
  }

  .feature-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-text, #334155);
  }

  .chip-svg {
    width: 14px;
    height: 14px;
    color: var(--color-brand, #6366f1);
    flex-shrink: 0;
  }

  /* ==========================================================================
     2. MAIN TOOL SECTION & SAAS TOOL CARD
     ========================================================================== */
  .tool-main-section {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .tool-card-container {
    max-width: 940px;
  }

  .saas-tool-card {
    background: var(--color-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 20px;
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05), 0 20px 40px -15px rgba(99, 102, 241, 0.04);
  }

  /* Header Bar */
  .card-header-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 680px) {
    .card-header-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .header-title-cluster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .card-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand, #6366f1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .title-svg {
    width: 20px;
    height: 20px;
  }

  .card-title-text {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 0;
  }

  .card-sub-text {
    font-size: 0.75rem;
    color: var(--color-text-muted, #64748b);
  }

  .header-controls-cluster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: #059669;
    background: #ecfdf5;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid #a7f3d0;
  }

  .live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
  }

  .btn-reset-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    border-radius: 10px;
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted, #64748b);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-reset-tool:hover {
    color: var(--color-text, #0f172a);
    background: var(--color-card, #ffffff);
    border-color: #cbd5e1;
  }

  .reset-svg {
    width: 14px;
    height: 14px;
  }

  /* Dropzone Styling */
  .upload-section-wrap {
    margin-bottom: 1.5rem;
  }

  .dropzone-box {
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    background: var(--color-bg-alt, #f8fafc);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
    position: relative;
  }

  .dropzone-box:hover,
  .dropzone-box:focus-visible,
  .dropzone-box.dragover {
    border-color: var(--color-brand, #6366f1);
    background: rgba(99, 102, 241, 0.04);
  }

  .hidden-file-input {
    display: none;
  }

  .dropzone-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .upload-icon-circle {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand, #6366f1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
    transition: transform 0.2s ease;
  }

  .dropzone-box:hover .upload-icon-circle {
    transform: translateY(-2px);
  }

  .upload-arrow-svg {
    width: 26px;
    height: 26px;
  }

  .dropzone-prompt-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 0;
  }

  .dropzone-prompt-sub {
    font-size: 0.875rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  .browse-action-link {
    color: var(--color-brand, #6366f1);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .format-tags-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.5rem;
  }

  .format-tag {
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--color-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    font-size: 0.725rem;
    font-weight: 600;
    color: var(--color-text-muted, #64748b);
  }

  .privacy-tag {
    color: #059669;
    border-color: #a7f3d0;
    background: #ecfdf5;
  }

  /* Loaded Video Metadata Card */
  .loaded-video-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: left;
    background: var(--color-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 1.15rem;
  }

  @media (min-width: 580px) {
    .loaded-video-card {
      flex-direction: row;
      align-items: center;
    }
  }

  .video-preview-thumb-wrap {
    width: 90px;
    height: 120px;
    border-radius: 10px;
    overflow: hidden;
    background: #0f172a;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loaded-thumb-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-meta-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
  }

  .video-meta-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .video-filename {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }

  .btn-change-video {
    padding: 0.3rem 0.65rem;
    border-radius: 8px;
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand, #6366f1);
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .btn-change-video:hover {
    background: #eef2ff;
    border-color: #c7d2fe;
  }

  .meta-pills-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .meta-pill {
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text, #334155);
  }

  .highlight-pill {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand, #6366f1);
    border-color: rgba(99, 102, 241, 0.25);
  }

  .upload-alert-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-top: 0.75rem;
  }

  .alert-svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* Settings Grid */
  .settings-container-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .settings-header-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .settings-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 0;
  }

  .settings-sub {
    font-size: 0.8rem;
    color: var(--color-text-muted, #64748b);
  }

  .settings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
  }

  @media (min-width: 640px) {
    .settings-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .setting-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .setting-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .field-svg {
    width: 16px;
    height: 16px;
    color: var(--color-brand, #6366f1);
    flex-shrink: 0;
  }

  .styled-select-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .styled-select {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 2.25rem 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--color-border, #e2e8f0);
    background: var(--color-bg, #ffffff);
    color: var(--color-text, #0f172a);
    font-size: 0.875rem;
    font-weight: 600;
    font-family: inherit;
    outline: none;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: all 0.15s ease;
  }

  .styled-select:focus {
    border-color: var(--color-brand, #6366f1);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .select-chevron {
    position: absolute;
    right: 0.95rem;
    pointer-events: none;
    display: flex;
    align-items: center;
    color: var(--color-text-muted, #64748b);
  }

  .select-chevron svg {
    width: 16px;
    height: 16px;
  }

  .setting-helper-text {
    font-size: 0.775rem;
    line-height: 1.4;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  /* Estimate Strip */
  .estimate-strip-box {
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 12px;
    padding: 0.85rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .estimate-info-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .estimate-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .estimate-value {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-brand, #6366f1);
    font-family: var(--font-heading, 'Outfit', sans-serif);
  }

  .estimate-disclaimer {
    font-size: 0.725rem;
    color: var(--color-text-muted, #64748b);
    font-style: italic;
  }

  /* Compress Button */
  .compress-actions-row {
    display: flex;
    margin-top: 0.5rem;
  }

  .btn-compress-primary {
    width: 100%;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: 12px;
    background: var(--color-brand, #6366f1);
    color: #ffffff;
    border: none;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
  }

  .btn-compress-primary:hover {
    background: #4f46e5;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.4);
  }

  .btn-compress-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .action-btn-svg {
    width: 18px;
    height: 18px;
  }

  /* Compression Progress Card */
  .compression-progress-card {
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 1.15rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .progress-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .progress-title-cluster {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .spinner-dot-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand, #6366f1);
    animation: pulse 1.2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(0.8); opacity: 0.5; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  .progress-phase-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .progress-numeric-pct {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-brand, #6366f1);
  }

  .progress-track-bg {
    width: 100%;
    height: 8px;
    border-radius: 9999px;
    background: var(--color-border, #e2e8f0);
    overflow: hidden;
  }

  .progress-fill-bar {
    height: 100%;
    border-radius: 9999px;
    background: linear-gradient(90deg, #6366f1, #a855f7);
    transition: width 0.15s linear;
  }

  .progress-sub-info-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted, #64748b);
  }

  /* Divider */
  .card-divider {
    height: 1px;
    background: var(--color-border, #e2e8f0);
    margin: 1.75rem 0;
  }

  /* STEP 3: RESULTS DISPLAY */
  .compression-results-area {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .verdict-banner-success {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 14px;
    padding: 1rem 1.25rem;
  }

  .verdict-icon-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #10b981;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .check-svg {
    width: 20px;
    height: 20px;
  }

  .verdict-heading {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.05rem;
    font-weight: 800;
    color: #065f46;
    margin: 0 0 0.15rem 0;
  }

  .verdict-sub {
    font-size: 0.8rem;
    color: #047857;
    margin: 0;
  }

  /* Results 4 Grid */
  .results-grid-four {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 580px) {
    .results-grid-four {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 860px) {
    .results-grid-four {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .result-metric-card {
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
    padding: 1.15rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.45rem;
  }

  .result-metric-card.highlight-card {
    background: linear-gradient(145deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.04) 100%);
    border: 1.5px solid rgba(99, 102, 241, 0.35);
  }

  .metric-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .metric-label-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .metric-icon-badge {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand, #6366f1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .metric-icon-badge svg {
    width: 15px;
    height: 15px;
  }

  .metric-large-value {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text, #0f172a);
    line-height: 1.15;
  }

  .highlight-card .metric-large-value {
    color: var(--color-brand, #4f46e5);
  }

  .savings-value {
    color: #059669;
  }

  .metric-sub-detail {
    font-size: 0.725rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  /* Player Stage */
  .compressed-player-stage {
    background: var(--color-bg-alt, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
    overflow: hidden;
  }

  .player-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.15rem;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    background: var(--color-card, #ffffff);
  }

  .player-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .player-tag-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-brand, #6366f1);
    background: rgba(99, 102, 241, 0.08);
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
  }

  .player-aspect-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    background: #0f172a;
    max-height: 480px;
  }

  .output-preview-video {
    max-width: 100%;
    max-height: 440px;
    border-radius: 8px;
    outline: none;
  }

  /* Final Actions */
  .final-actions-cluster {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 580px) {
    .final-actions-cluster {
      flex-direction: row;
    }
  }

  .btn-download-compressed {
    flex: 1;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    background: #059669;
    color: #ffffff;
    border: none;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
  }

  .btn-download-compressed:hover {
    background: #047857;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35);
  }

  .btn-compress-another {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    background: var(--color-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text, #0f172a);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-compress-another:hover {

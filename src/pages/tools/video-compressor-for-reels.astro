<script>
  function initVideoCompressorForReels() {
    // Elements
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('video-file-input');
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedVideoCard = document.getElementById('loaded-video-card');
    const loadedSourceVideo = document.getElementById('loaded-source-video');
    const metaFilename = document.getElementById('meta-filename');
    const pillFilesize = document.getElementById('pill-filesize');
    const pillDuration = document.getElementById('pill-duration');
    const pillResolution = document.getElementById('pill-resolution');
    const pillAspectRatio = document.getElementById('pill-aspect-ratio');
    const btnChangeVideo = document.getElementById('btn-change-video');
    const uploadErrorBox = document.getElementById('upload-error-box');
    const uploadErrorMsg = document.getElementById('upload-error-msg');

    // Controls
    const selectPreset = document.getElementById('select-preset');
    const selectResolution = document.getElementById('select-resolution');
    const selectAudio = document.getElementById('select-audio');
    const selectFraming = document.getElementById('select-framing');
    const labelEstimatedSize = document.getElementById('label-estimated-size');
    const helperPresetText = document.getElementById('helper-preset-text');
    const btnStartCompression = document.getElementById('btn-start-compression');
    const btnResetAll = document.getElementById('btn-reset-all');

    // Progress Elements
    const progressCard = document.getElementById('compression-progress-card');
    const progressPhaseTitle = document.getElementById('progress-phase-title');
    const progressNumericPct = document.getElementById('progress-numeric-pct');
    const progressFillBar = document.getElementById('progress-fill-bar');
    const progressSubDetail = document.getElementById('progress-sub-detail');
    const progressTimerDetail = document.getElementById('progress-timer-detail');

    // Results Elements
    const resultsArea = document.getElementById('compression-results-area');
    const resCompressedSize = document.getElementById('res-compressed-size');
    const resOriginalSize = document.getElementById('res-original-size');
    const resSavingsPct = document.getElementById('res-savings-pct');
    const resSavingsMb = document.getElementById('res-savings-mb');
    const resOutputResolution = document.getElementById('res-output-resolution');
    const resOutputFormat = document.getElementById('res-output-format');
    const outputPlayer = document.getElementById('compressed-output-player');
    const btnDownloadCompressed = document.getElementById('btn-download-compressed');
    const btnCompressAnother = document.getElementById('btn-compress-another');

    // State Variables
    let currentFile = null;
    let sourceBlobUrl = null;
    let outputBlobUrl = null;
    let outputDownloadName = 'reel_compressed.mp4';
    let isProcessing = false;
    let progressInterval = null;
    let startTime = 0;

    // Bitrate Presets in bps
    const BITRATE_PRESETS = {
      high: 3000000,    // 3.0 Mbps
      balanced: 1800000,// 1.8 Mbps (Recommended for Reels)
      smaller: 900000   // 900 Kbps
    };

    function formatBytes(bytes) {
      if (bytes === 0 || isNaN(bytes)) return '0.00 MB';
      const mb = bytes / (1024 * 1024);
      return `${mb.toFixed(2)} MB`;
    }

    function formatSeconds(secs) {
      if (isNaN(secs) || secs < 0) return '00:00';
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    function showError(msg) {
      if (uploadErrorBox && uploadErrorMsg) {
        uploadErrorMsg.textContent = msg;
        uploadErrorBox.style.display = 'flex';
      }
    }

    function clearError() {
      if (uploadErrorBox) {
        uploadErrorBox.style.display = 'none';
      }
    }

    function updateEstimatedSize() {
      if (!currentFile || !loadedSourceVideo || isNaN(loadedSourceVideo.duration) || loadedSourceVideo.duration <= 0) {
        if (labelEstimatedSize) labelEstimatedSize.textContent = 'Upload a video to calculate estimate';
        return;
      }

      const presetKey = selectPreset ? selectPreset.value : 'balanced';
      const targetVideoBitrate = BITRATE_PRESETS[presetKey] || 1800000;
      const keepAudio = selectAudio ? selectAudio.value === 'keep' : true;
      const audioBitrate = keepAudio ? 96000 : 0; // 96 kbps
      const totalBitrateBps = targetVideoBitrate + audioBitrate;

      const durationSecs = loadedSourceVideo.duration;
      // Formula: (bits / 8) = bytes
      const estimatedBytes = (totalBitrateBps * durationSecs) / 8;
      const estimatedMB = estimatedBytes / (1024 * 1024);
      const originalMB = currentFile.size / (1024 * 1024);
      const estSavingsPct = Math.round(((originalMB - estimatedMB) / originalMB) * 100);

      let savingsText = '';
      if (estSavingsPct > 0) {
        savingsText = ` (~${estSavingsPct}% smaller)`;
      } else if (estSavingsPct < 0) {
        savingsText = ' (Re-encoding source)';
      }

      if (labelEstimatedSize) {
        labelEstimatedSize.textContent = `~${estimatedMB.toFixed(2)} MB${savingsText}`;
      }
    }

    function handleFile(file) {
      clearError();

      if (!file) return;

      // Validate video MIME type or common extensions
      const validTypes = ['video/mp4', 'video/webm', 'video/quicktime', 'video/x-m4v', 'video/mkv'];
      const isVideo = file.type.startsWith('video/') || validTypes.includes(file.type) || /\.(mp4|mov|webm|m4v|mkv)$/i.test(file.name);

      if (!isVideo) {
        showError('Please upload a valid video file (MP4, MOV, WebM, or MKV).');
        return;
      }

      // Memory limit sanity check (500 MB)
      if (file.size > 500 * 1024 * 1024) {
        showError('Video file exceeds 500 MB. To prevent browser memory exhaustion on mobile devices, please select a clip under 500 MB.');
        return;
      }

      currentFile = file;

      // Release previous source URL if any
      if (sourceBlobUrl) {
        URL.revokeObjectURL(sourceBlobUrl);
      }
      sourceBlobUrl = URL.createObjectURL(file);

      // Hide results if re-uploading
      if (resultsArea) resultsArea.style.display = 'none';

      // Load metadata in hidden video element
      if (loadedSourceVideo) {
        loadedSourceVideo.src = sourceBlobUrl;
        loadedSourceVideo.onloadedmetadata = () => {
          const w = loadedSourceVideo.videoWidth || 1080;
          const h = loadedSourceVideo.videoHeight || 1920;
          const dur = loadedSourceVideo.duration || 0;

          // Compute aspect ratio label
          let aspectLabel = 'Standard Video';
          const ratio = w / h;
          if (ratio > 0.54 && ratio < 0.58) {
            aspectLabel = '9:16 Vertical Reel (Optimal)';
          } else if (ratio > 0.78 && ratio < 0.82) {
            aspectLabel = '4:5 Portrait Video';
          } else if (ratio > 0.98 && ratio < 1.02) {
            aspectLabel = '1:1 Square Video';
          } else if (ratio > 1.7 && ratio < 1.8) {
            aspectLabel = '16:9 Landscape Video';
          }

          if (metaFilename) metaFilename.textContent = file.name;
          if (pillFilesize) pillFilesize.textContent = formatBytes(file.size);
          if (pillDuration) pillDuration.textContent = formatSeconds(dur);
          if (pillResolution) pillResolution.textContent = `${w} × ${h}`;
          if (pillAspectRatio) pillAspectRatio.textContent = aspectLabel;

          // Adjust resolution dropdown options based on source resolution
          if (selectResolution) {
            const opt1080 = selectResolution.querySelector('option[value="1080"]');
            if (opt1080) {
              const maxDim = Math.max(w, h);
              if (maxDim < 1080) {
                opt1080.textContent = '1080p (Source is lower - upscaling disabled)';
                opt1080.disabled = true;
                if (selectResolution.value === '1080') {
                  selectResolution.value = 'original';
                }
              } else {
                opt1080.textContent = '1080p (Full HD - Meta Recommended for Reels)';
                opt1080.disabled = false;
              }
            }
          }

          // Switch UI view
          if (dropzonePrompt) dropzonePrompt.style.display = 'none';
          if (loadedVideoCard) loadedVideoCard.style.display = 'flex';

          updateEstimatedSize();
        };

        loadedSourceVideo.onerror = () => {
          showError('Unable to read this video format in your current browser. Try converting to MP4 (H.264).');
        };
      }
    }

    function resetAll() {
      currentFile = null;
      isProcessing = false;

      if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
      }

      if (fileInput) fileInput.value = '';

      if (sourceBlobUrl) {
        URL.revokeObjectURL(sourceBlobUrl);
        sourceBlobUrl = null;
      }
      if (outputBlobUrl) {
        URL.revokeObjectURL(outputBlobUrl);
        outputBlobUrl = null;
      }

      if (loadedSourceVideo) loadedSourceVideo.src = '';
      if (outputPlayer) outputPlayer.src = '';

      if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
      if (loadedVideoCard) loadedVideoCard.style.display = 'none';
      if (progressCard) progressCard.style.display = 'none';
      if (resultsArea) resultsArea.style.display = 'none';

      if (btnStartCompression) {
        btnStartCompression.disabled = false;
        btnStartCompression.style.display = 'inline-flex';
      }

      clearError();
      if (labelEstimatedSize) labelEstimatedSize.textContent = 'Select or upload a video';
    }

    // Drag and Drop Listeners
    if (dropzone) {
      dropzone.addEventListener('click', (e) => {
        // Prevent clicking 'Change Video' from opening file picker twice
        if (e.target && (e.target.id === 'btn-change-video' || e.target.closest('#btn-change-video'))) {
          return;
        }
        if (fileInput) fileInput.click();
      });

      ['dragenter', 'dragover'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          handleFile(dt.files[0]);
        }
      });
    }

    if (fileInput) {
      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          handleFile(fileInput.files[0]);
        }
      });
    }

    if (btnChangeVideo) {
      btnChangeVideo.addEventListener('click', (e) => {
        e.stopPropagation();
        if (fileInput) fileInput.click();
      });
    }

    if (btnResetAll) {
      btnResetAll.addEventListener('click', resetAll);
    }

    if (btnCompressAnother) {
      btnCompressAnother.addEventListener('click', () => {
        resetAll();
        if (dropzone) dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }

    // Settings changes update estimate
    if (selectPreset) selectPreset.addEventListener('change', updateEstimatedSize);
    if (selectResolution) selectResolution.addEventListener('change', updateEstimatedSize);
    if (selectAudio) selectAudio.addEventListener('change', updateEstimatedSize);
    if (selectFraming) selectFraming.addEventListener('change', updateEstimatedSize);

    // =========================================================================
    // HIGH-PERFORMANCE CLIENT-SIDE VIDEO COMPRESSION ENGINE
    // =========================================================================
    async function startCompression() {
      if (!currentFile || !sourceBlobUrl || !loadedSourceVideo) {
        showError('Please select or drag a video file first before compressing.');
        return;
      }

      if (isProcessing) return;
      isProcessing = true;
      clearError();

      // Lock UI controls
      if (btnStartCompression) {
        btnStartCompression.disabled = true;
        btnStartCompression.style.display = 'none';
      }
      if (resultsArea) resultsArea.style.display = 'none';
      if (progressCard) progressCard.style.display = 'flex';

      // Start elapsed timer
      startTime = Date.now();
      if (progressInterval) clearInterval(progressInterval);
      progressInterval = setInterval(() => {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        if (progressTimerDetail) {
          progressTimerDetail.textContent = `Elapsed: ${formatSeconds(elapsed)}`;
        }
      }, 1000);

      const updateProgress = (pct, phaseText, subText) => {
        const clamped = Math.max(0, Math.min(100, Math.round(pct)));
        if (progressNumericPct) progressNumericPct.textContent = `${clamped}%`;
        if (progressFillBar) progressFillBar.style.width = `${clamped}%`;
        if (phaseText && progressPhaseTitle) progressPhaseTitle.textContent = phaseText;
        if (subText && progressSubDetail) progressSubDetail.textContent = subText;
      };

      updateProgress(2, 'Initializing browser encoder...', 'Setting up frame buffer...');

      try {
        const video = document.createElement('video');
        video.src = sourceBlobUrl;
        video.crossOrigin = 'anonymous';
        video.playsInline = true;
        video.muted = false;

        await new Promise((resolve, reject) => {
          video.onloadedmetadata = () => resolve(true);
          video.onerror = () => reject(new Error('Browser could not decode the source video stream.'));
        });

        const origW = video.videoWidth || 1080;
        const origH = video.videoHeight || 1920;
        const duration = video.duration || 1;

        // Calculate Target Dimensions
        const resChoice = selectResolution ? selectResolution.value : 'original';
        const framingChoice = selectFraming ? selectFraming.value : 'fit';
        let targetW = origW;
        let targetH = origH;

        if (framingChoice === 'crop916') {
          // Force 9:16 aspect ratio
          if (resChoice === '720') {
            targetW = 720;
            targetH = 1280;
          } else if (resChoice === '480') {
            targetW = 480;
            targetH = 854;
          } else {
            targetW = 1080;
            targetH = 1920;
          }
        } else {
          // Standard proportional scale
          if (resChoice !== 'original') {
            const maxDim = parseInt(resChoice, 10);
            if (origH >= origW) {
              // Vertical or square
              if (origH > maxDim) {
                const ratio = origW / origH;
                targetH = maxDim;
                targetW = Math.round(maxDim * ratio);
              }
            } else {
              // Landscape
              if (origW > maxDim) {
                const ratio = origH / origW;
                targetW = maxDim;
                targetH = Math.round(maxDim * ratio);
              }
            }
          }
        }

        // Encoders require even dimensions
        targetW = targetW - (targetW % 2);
        targetH = targetH - (targetH % 2);
        if (targetW < 120) targetW = 120;
        if (targetH < 120) targetH = 120;

        // Determine Bitrate
        const presetKey = selectPreset ? selectPreset.value : 'balanced';
        const targetVideoBitrate = BITRATE_PRESETS[presetKey] || 1800000;
        const keepAudio = selectAudio ? selectAudio.value === 'keep' : true;

        updateProgress(8, 'Configuring canvas and audio pipeline...', `Resolution: ${targetW}×${targetH}`);

        // Setup Offscreen Canvas
        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d', { alpha: false });
        if (!ctx) throw new Error('HTML5 Canvas 2D context creation failed.');

        // 30 FPS Stream
        const stream = canvas.captureStream(30);

        // Audio Stream Integration
        let audioContext = null;
        let audioConnected = false;

        if (keepAudio) {
          try {
            const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
            if (AudioCtxClass) {
              audioContext = new AudioCtxClass();
              if (audioContext.state === 'suspended') {
                await audioContext.resume();
              }
              const sourceNode = audioContext.createMediaElementSource(video);
              const destinationNode = audioContext.createMediaStreamDestination();
              sourceNode.connect(destinationNode);
              const tracks = destinationNode.stream.getAudioTracks();
              if (tracks && tracks.length > 0) {
                stream.addTrack(tracks[0]);
                audioConnected = true;
              }
            }
          } catch (audioErr) {
            console.warn('Audio capture warning (falling back to video track only):', audioErr);
          }
        }

        // Determine Best Supported MIME Type
        let chosenMime = 'video/webm';
        let extension = 'webm';

        // Check for MP4 support (Safari, modern Chromium)
        if (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported) {
          if (MediaRecorder.isTypeSupported('video/mp4;codecs=avc1,mp4a.40.2')) {
            chosenMime = 'video/mp4;codecs=avc1,mp4a.40.2';
            extension = 'mp4';
          } else if (MediaRecorder.isTypeSupported('video/mp4')) {
            chosenMime = 'video/mp4';
            extension = 'mp4';
          } else if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus')) {
            chosenMime = 'video/webm;codecs=vp9,opus';
            extension = 'webm';
          } else if (MediaRecorder.isTypeSupported('video/webm;codecs=vp8,opus')) {
            chosenMime = 'video/webm;codecs=vp8,opus';
            extension = 'webm';
          }
        }

        const recorderOptions = {
          mimeType: chosenMime,
          videoBitsPerSecond: targetVideoBitrate
        };
        if (audioConnected) {
          recorderOptions.audioBitsPerSecond = 96000;
        }

        const recorder = new MediaRecorder(stream, recorderOptions);
        const recordedChunks = [];

        recorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) {
            recordedChunks.push(e.data);
          }
        };

        // Render Loop
        let isEnded = false;
        video.currentTime = 0;

        recorder.start(100);
        await video.play();

        const renderFrame = () => {
          if (isEnded) return;

          // Handle Center Crop 9:16 or Proportional Fit
          if (framingChoice === 'crop916' && origW / origH !== targetW / targetH) {
            const sourceRatio = origW / origH;
            const targetRatio = targetW / targetH;
            let sx = 0, sy = 0, sw = origW, sh = origH;

            if (sourceRatio > targetRatio) {
              // Source is wider: crop horizontal sides
              sw = origH * targetRatio;
              sx = (origW - sw) / 2;
            } else {
              // Source is taller: crop vertical top/bottom
              sh = origW / targetRatio;
              sy = (origH - sh) / 2;
            }
            ctx.drawImage(video, sx, sy, sw, sh, 0, 0, targetW, targetH);
          } else {
            // Standard fill
            ctx.drawImage(video, 0, 0, targetW, targetH);
          }

          const pct = Math.min(98, Math.round((video.currentTime / duration) * 100));
          updateProgress(pct, `Compressing video frames... (${pct}%)`, `Encoding at ${Math.round(targetVideoBitrate / 1000)} Kbps`);

          if (!video.paused && !video.ended) {
            requestAnimationFrame(renderFrame);
          }
        };

        requestAnimationFrame(renderFrame);

        // Wait for video completion
        await new Promise((resolve) => {
          video.onended = () => {
            isEnded = true;
            recorder.stop();
            resolve(true);
          };
          // Fallback timer if onended is delayed
          setTimeout(() => {
            if (!isEnded) {
              isEnded = true;
              if (recorder.state === 'recording') recorder.stop();
              resolve(true);
            }
          }, (duration + 2) * 1000);
        });

        // Wait for MediaRecorder to stop
        await new Promise((resolve) => {
          recorder.onstop = () => resolve(true);
        });

        if (audioContext) {
          try {
            await audioContext.close();
          } catch (e) {
            // Ignore close errors
          }
        }

        updateProgress(100, 'Finalizing output file...', 'Assembling video chunks...');

        // Finalize Output Blob
        const outputBlob = new Blob(recordedChunks, { type: chosenMime });

        if (outputBlob.size === 0) {
          throw new Error('Video compression failed to produce data. Please retry with Balanced settings.');
        }

        if (outputBlobUrl) {
          URL.revokeObjectURL(outputBlobUrl);
        }
        outputBlobUrl = URL.createObjectURL(outputBlob);

        // Set download name
        const cleanName = currentFile.name.replace(/\.[^/.]+$/, '');
        outputDownloadName = `reel_compressed_${cleanName}.${extension}`;

        // Calculate Stats
        const originalBytes = currentFile.size;
        const compressedBytes = outputBlob.size;
        const diffBytes = originalBytes - compressedBytes;
        const savingsPct = Math.round((diffBytes / originalBytes) * 100);

        // Populate Result Cards
        if (resCompressedSize) resCompressedSize.textContent = formatBytes(compressedBytes);
        if (resOriginalSize) resOriginalSize.textContent = formatBytes(originalBytes);
        if (resOutputResolution) resOutputResolution.textContent = `${targetW} × ${targetH}`;
        if (resOutputFormat) resOutputFormat.textContent = `${extension.toUpperCase()} • ${framingChoice === 'crop916' ? '9:16 Vertical Reel' : 'Proportional Fit'}`;

        if (resSavingsPct && resSavingsMb) {
          if (savingsPct > 0) {
            resSavingsPct.textContent = `-${savingsPct}%`;
            resSavingsPct.style.color = '#059669';
            resSavingsMb.textContent = `${formatBytes(diffBytes)} saved`;
          } else {
            resSavingsPct.textContent = `+${Math.abs(savingsPct)}%`;
            resSavingsPct.style.color = 'var(--color-text-muted)';
            resSavingsMb.textContent = 'High-bitrate re-encode';
          }
        }

        // Preview Player
        if (outputPlayer) {
          outputPlayer.src = outputBlobUrl;
        }

        // Stop progress timer
        if (progressInterval) {
          clearInterval(progressInterval);
          progressInterval = null;
        }

        // Switch UI to Results
        if (progressCard) progressCard.style.display = 'none';
        if (resultsArea) {
          resultsArea.style.display = 'flex';
          resultsArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        isProcessing = false;
        if (btnStartCompression) {
          btnStartCompression.disabled = false;
          btnStartCompression.style.display = 'inline-flex';
        }

      } catch (err) {
        console.error('Compression failure:', err);
        isProcessing = false;
        if (progressInterval) {
          clearInterval(progressInterval);
          progressInterval = null;
        }
        if (progressCard) progressCard.style.display = 'none';
        if (btnStartCompression) {
          btnStartCompression.disabled = false;
          btnStartCompression.style.display = 'inline-flex';
        }
        showError(`Compression Error: ${err.message || 'Unable to compress video. Try choosing Balanced preset or converting input to MP4.'}`);
      }
    }

    if (btnStartCompression) {
      btnStartCompression.addEventListener('click', startCompression);
    }

    // Download Handler
    if (btnDownloadCompressed) {
      btnDownloadCompressed.addEventListener('click', () => {
        if (!outputBlobUrl) return;
        const a = document.createElement('a');
        a.href = outputBlobUrl;
        a.download = outputDownloadName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
    }
  }

  // Handle both DOM load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoCompressorForReels);
  } else {
    initVideoCompressorForReels();
  }

  document.addEventListener('astro:after-swap', initVideoCompressorForReels);
</script>

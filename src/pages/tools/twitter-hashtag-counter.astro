  .density-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .density-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    background: rgba(100, 116, 139, 0.1);
    color: #475569;
  }

  .density-desc {
    margin: 0;
    font-size: 0.825rem;
    color: var(--color-text-muted, #64748b);
    line-height: 1.5;
  }

  .density-status-banner.status-optimal {
    border-color: rgba(16, 185, 129, 0.35);
    background: rgba(16, 185, 129, 0.08);
  }
  .density-status-banner.status-optimal .density-badge {
    background: rgba(16, 185, 129, 0.2);
    color: #059669;
  }

  .density-status-banner.status-warning {
    border-color: rgba(245, 158, 11, 0.35);
    background: rgba(245, 158, 11, 0.08);
  }
  .density-status-banner.status-warning .density-badge {
    background: rgba(245, 158, 11, 0.2);
    color: #d97706;
  }

  .density-status-banner.status-danger {
    border-color: rgba(239, 68, 68, 0.35);
    background: rgba(239, 68, 68, 0.08);
  }
  .density-status-banner.status-danger .density-badge {
    background: rgba(239, 68, 68, 0.2);
    color: #dc2626;
  }

  /* =========================================================
     4 VIVID, DISTINCT COLORFUL RESULT CARDS
     ========================================================= */
  .vivid-result-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 480px) {
    .vivid-result-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 820px) {
    .vivid-result-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    border-radius: 18px;
    padding: 1.15rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    min-width: 0;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.08);
  }

  .stat-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .stat-icon-circle {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .circle-svg {
    width: 17px;
    height: 17px;
  }

  .stat-badge-tag {
    font-size: 0.675rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .stat-number-display {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .stat-label-text {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .stat-sub-info {
    font-size: 0.725rem;
    color: var(--color-text-muted, #64748b);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* COLOR 1: Purple / Indigo */
  .stat-purple {
    background: linear-gradient(145deg, #ffffff 0%, rgba(99, 102, 241, 0.06) 100%);
    border: 1.5px solid rgba(99, 102, 241, 0.22);
  }
  .purple-circle {
    background: rgba(99, 102, 241, 0.12);
    color: #4f46e5;
  }
  .badge-purple-tag {
    background: rgba(99, 102, 241, 0.1);
    color: #4f46e5;
  }
  .purple-number {
    color: #4f46e5;
  }

  /* COLOR 2: Rose / Pink */
  .stat-pink {
    background: linear-gradient(145deg, #ffffff 0%, rgba(244, 63, 94, 0.06) 100%);
    border: 1.5px solid rgba(244, 63, 94, 0.22);
  }
  .pink-circle {
    background: rgba(244, 63, 94, 0.12);
    color: #e11d48;
  }
  .badge-pink-tag {
    background: rgba(244, 63, 94, 0.1);
    color: #e11d48;
  }
  .pink-number {
    color: #e11d48;
  }

  /* COLOR 3: Sky / Blue */
  .stat-blue {
    background: linear-gradient(145deg, #ffffff 0%, rgba(14, 165, 233, 0.06) 100%);
    border: 1.5px solid rgba(14, 165, 233, 0.22);
  }
  .blue-circle {
    background: rgba(14, 165, 233, 0.12);
    color: #0284c7;
  }
  .badge-blue-tag {
    background: rgba(14, 165, 233, 0.1);
    color: #0284c7;
  }
  .blue-number {
    color: #0284c7;
  }

  /* COLOR 4: Emerald / Green */
  .stat-emerald {
    background: linear-gradient(145deg, #ffffff 0%, rgba(16, 185, 129, 0.06) 100%);
    border: 1.5px solid rgba(16, 185, 129, 0.22);
  }
  .emerald-circle {
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
  }
  .badge-emerald-tag {
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
  }
  .emerald-number {
    color: #059669;
  }

  /* Emerald State Overrides (Warning / Over Limit) */
  .stat-emerald.state-warn {
    border-color: rgba(245, 158, 11, 0.35);
    background: linear-gradient(145deg, #ffffff 0%, rgba(245, 158, 11, 0.06) 100%);
  }
  .stat-emerald.state-warn .emerald-number {
    color: #d97706;
  }
  .stat-emerald.state-warn .badge-emerald-tag {
    background: rgba(245, 158, 11, 0.15);
    color: #d97706;
  }

  .stat-emerald.state-danger {
    border-color: rgba(239, 68, 68, 0.35);
    background: linear-gradient(145deg, #ffffff 0%, rgba(239, 68, 68, 0.06) 100%);
  }
  .stat-emerald.state-danger .emerald-number {
    color: #dc2626;
  }
  .stat-emerald.state-danger .badge-emerald-tag {
    background: rgba(239, 68, 68, 0.15);
    color: #dc2626;
  }

  /* Secondary Analytics Strip */
  .secondary-analytics-strip {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-radius: 14px;
    background: var(--color-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .analytics-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.825rem;
  }

  .analytics-label {
    color: var(--color-text-muted, #64748b);
  }

  .analytics-val {
    color: var(--color-text, #0f172a);
    font-weight: 700;
  }

  .analytics-sep {
    width: 1px;
    height: 16px;
    background: var(--color-border, #cbd5e1);
  }

  @media (max-width: 580px) {
    .analytics-sep {
      display: none;
    }
    .secondary-analytics-strip {
      justify-content: flex-start;
      gap: 0.5rem 1.25rem;
    }
  }

  /* Detected Hashtags Section */
  .detected-hashtags-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  .detected-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .section-title-text {
    margin: 0;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .title-svg {
    width: 17px;
    height: 17px;
    color: var(--color-brand, #4f46e5);
    flex-shrink: 0;
  }

  .pill-counter {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand, #4f46e5);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
  }

  .btn-copy-unique-only {
    font-size: 0.775rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    border: 1px solid rgba(99, 102, 241, 0.25);
    background: rgba(99, 102, 241, 0.08);
    color: var(--color-brand, #4f46e5);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-copy-unique-only:hover {
    background: rgba(99, 102, 241, 0.16);
    border-color: var(--color-brand, #4f46e5);
  }

  /* Empty Hashtags Box */
  .empty-hashtags-box {
    padding: 2.25rem 1.5rem;
    text-align: center;
    border-radius: 16px;
    border: 1.5px dashed var(--color-border, #cbd5e1);
    background: var(--color-bg, #f8fafc);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .empty-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand, #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.35rem;
  }

  .empty-svg {
    width: 20px;
    height: 20px;
  }

  .empty-box-title {
    margin: 0;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .empty-box-sub {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted, #64748b);
    max-width: 460px;
    line-height: 1.5;
  }

  /* Hashtag Chips Grid */
  .hashtag-chips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 0.65rem;
  }

  :global(.modern-chip-card) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.95rem;
    border-radius: 12px;
    background: var(--color-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
    min-width: 0;
  }

  :global(.modern-chip-card:hover) {
    border-color: var(--color-brand, #4f46e5);
    background: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.08);
  }

  :global(.chip-left) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  :global(.chip-text) {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-brand, #4f46e5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.chip-right) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  :global(.chip-count-badge) {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text-muted, #64748b);
  }

  :global(.chip-count-badge.is-repeated) {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
    color: #d97706;
  }

  :global(.chip-len-badge) {
    font-size: 0.675rem;
    color: var(--color-text-muted, #64748b);
  }

  :global(.chip-copy-svg) {
    width: 14px;
    height: 14px;
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }

  :global(.modern-chip-card:hover .chip-copy-svg) {
    opacity: 1;
  }

  /* =========================================================
     3. CONTENT & SEO GUIDE SECTION
     ========================================================= */
  .tool-content-section {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: var(--color-bg, #f8fafc);
  }

  .content-inner-container {
    max-width: 940px;
    margin: 0 auto;
    padding-left: clamp(0.75rem, 3vw, 1.5rem);
    padding-right: clamp(0.75rem, 3vw, 1.5rem);
    box-sizing: border-box;
  }

  .content-card {
    background: var(--color-bg-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 24px;
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .content-pill {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand, #4f46e5);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .editorial-block h2 {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 1.5rem 0 0.85rem 0;
  }

  .editorial-block h2:first-of-type {
    margin-top: 0;
  }

  .editorial-block p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text, #334155);
    margin: 0 0 1.25rem 0;
  }

  .styled-list, .styled-numbered-list {
    margin: 0 0 1.5rem 0;
    padding-left: 1.35rem;
    color: var(--color-text, #334155);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .styled-list li, .styled-numbered-list li {
    margin-bottom: 0.5rem;
  }

  .editorial-block code {
    background: rgba(99, 102, 241, 0.08);
    color: var(--color-brand, #4f46e5);
    padding: 0.15rem 0.4rem;
    border-radius: 5px;
    font-size: 0.875rem;
  }

  .editorial-block a {
    color: var(--color-brand, #4f46e5);
    text-decoration: underline;
    font-weight: 600;
  }

  /* Benchmark Table */
  .table-card-wrapper {
    overflow-x: auto;
    margin: 1.5rem 0;
    border-radius: 16px;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .benchmark-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
    min-width: 500px;
  }

  .benchmark-table th, .benchmark-table td {
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .benchmark-table th {
    background: var(--color-bg, #f8fafc);
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .benchmark-table tr:last-child td {
    border-bottom: none;
  }

  .metric-positive {
    font-weight: 700;
    color: #059669;
  }

  .metric-neutral {
    font-weight: 700;
    color: #d97706;
  }

  .metric-negative {
    font-weight: 700;
    color: #dc2626;
  }

  .badge-table {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    margin-right: 0.35rem;
  }

  .table-success {
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
  }

  .table-warning {
    background: rgba(245, 158, 11, 0.12);
    color: #d97706;
  }

  .table-danger {
    background: rgba(239, 68, 68, 0.12);
    color: #dc2626;
  }

  /* Tip Card Box (Matching Influencer Rate Calculator) */
  .tip-card-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .tip-item {
    background: var(--color-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 1.15rem 1.25rem;
  }

  .tip-item strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-text, #0f172a);
    margin-bottom: 0.35rem;
  }

  .tip-item p {
    font-size: 0.875rem;
    color: var(--color-text-muted, #64748b);
    line-height: 1.55;
    margin: 0;
  }

  /* FAQ Accordion */
  .faq-accordion-section {
    border-top: 1px solid var(--color-border, #e2e8f0);
    padding-top: 2.5rem;
  }

  .faq-section-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 0 0 1.25rem 0;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-accordion-item {
    background: var(--color-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .faq-accordion-item:hover {
    border-color: var(--color-brand, #4f46e5);
  }

  .faq-summary {
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text, #0f172a);
    user-select: none;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    width: 18px;
    height: 18px;
    color: var(--color-brand, #4f46e5);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-body {
    padding: 0 1.25rem 1.15rem;
    color: var(--color-text-muted, #64748b);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .faq-body p {
    margin: 0;
  }

  /* Related Tools Block */
  .related-tools-block {
    border-top: 1px solid var(--color-border, #e2e8f0);
    padding-top: 2.5rem;
  }

  .related-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .related-title {
    margin: 0;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .view-all-tools-btn {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-brand, #4f46e5);
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .view-all-tools-btn:hover {
    transform: translateX(2px);
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .related-tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-recommend-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.15rem;
    border-radius: 16px;
    border: 1px solid var(--color-border, #e2e8f0);
    background: var(--color-bg, #f8fafc);
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }

  .tool-recommend-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand, #4f46e5);
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.08);
  }

  .recommend-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand, #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .recommend-svg {
    width: 18px;
    height: 18px;
  }

  .recommend-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .recommend-name {
    margin: 0;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-brand, #4f46e5);
  }

  .recommend-desc {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted, #64748b);
    line-height: 1.45;
  }

  /* =========================================================
     4. REFINED GRAY DARK THEME (#202124 / #181A1B / #2B2D30 / #303238)
     ========================================================= */
  :global([data-theme="dark"]) .tool-hero-section {
    background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(99, 102, 241, 0.15), transparent 70%), linear-gradient(180deg, #181A1B 0%, #202124 100%);

<script>
  function setupTwitterHashtagCounter() {
    const tweetInput = document.getElementById('tweet-input') as HTMLTextAreaElement | null;
    if (!tweetInput) return;

    if (tweetInput.getAttribute('data-counter-ready')) return;
    tweetInput.setAttribute('data-counter-ready', 'true');

    // Controls
    const tabStandard = document.getElementById('tab-standard');
    const tabPremium = document.getElementById('tab-premium');
    const platformLimitText = document.getElementById('platform-limit-text');
    const badgeLimitDisplay = document.getElementById('badge-limit-display');

    // Quick helpers
    const btnCleanSpacing = document.getElementById('btn-clean-spacing');
    const btnPaste = document.getElementById('btn-paste');

    // Action buttons
    const btnCopyTweet = document.getElementById('btn-copy-tweet');
    const copyTweetLabel = document.getElementById('copy-tweet-label');
    const btnCopyHashtags = document.getElementById('btn-copy-hashtags');
    const copyHashtagsLabel = document.getElementById('copy-hashtags-label');
    const btnClear = document.getElementById('btn-clear');
    const btnCopyUnique = document.getElementById('btn-copy-unique');

    // Progress bar
    const progressMeterFill = document.getElementById('progress-meter-fill');

    // Density banner
    const densityStatusBanner = document.getElementById('density-status-banner');
    const densityIcon = document.getElementById('density-icon');
    const densityTitle = document.getElementById('density-title');
    const densityBadge = document.getElementById('density-badge');
    const densityDesc = document.getElementById('density-desc');

    // 4 Vivid Result Displays
    const valTotalHashtags = document.getElementById('val-total-hashtags');
    const subHashtagsDetail = document.getElementById('sub-hashtags-detail');

    const valUniqueHashtags = document.getElementById('val-unique-hashtags');
    const subUniqueDetail = document.getElementById('sub-unique-detail');

    const valCharacters = document.getElementById('val-characters');
    const subCharDetail = document.getElementById('sub-char-detail');

    const cardRemaining = document.getElementById('card-remaining');
    const circleRemaining = document.getElementById('circle-remaining');
    const badgeRemainingStatus = document.getElementById('badge-remaining-status');
    const valRemaining = document.getElementById('val-remaining');
    const subRemainingDetail = document.getElementById('sub-remaining-detail');

    // Secondary Analytics
    const valWords = document.getElementById('val-words');
    const valHashtagChars = document.getElementById('val-hashtag-chars');
    const valHashtagShare = document.getElementById('val-hashtag-share');
    const valAvgTagLen = document.getElementById('val-avg-tag-len');

    // Hashtags list
    const detectedPillCounter = document.getElementById('detected-pill-counter');
    const emptyHashtagsBox = document.getElementById('empty-hashtags-box');
    const hashtagChipsGrid = document.getElementById('hashtag-chips-grid');

    // SVG icon templates for dynamic state rendering (Zero Emojis)
    const svgSearch = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="status-svg"><circle cx="11" cy="11" r="7" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35" /></svg>`;
    const svgCheck = `<svg viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" class="status-svg"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
    const svgWarn = `<svg viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" class="status-svg"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
    const svgDanger = `<svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" class="status-svg"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 9l-6 6m0-6l6 6" /></svg>`;
    const svgClock = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="circle-svg"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3" /></svg>`;
    const svgCopy = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-copy-svg"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`;
    const svgCopiedCheck = `<svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" class="chip-copy-svg"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;

    // Default limit: 280 characters
    let currentLimit = 280;

    // Strict Twitter Hashtag Regex
    const hashtagRegex = /(?:^|[^\p{L}\p{N}_])#([\p{L}\p{N}_]*[\p{L}_][\p{L}\p{N}_]*)/gu;
    const urlRegex = /https?:\/\/[^\s]+/gi;
    const emojiRegex = /[\p{Extended_Pictographic}\u{1F3FB}-\u{1F3FF}\u{1F9B0}-\u{1F9B3}]/gu;

    function extractHashtags(text: string): string[] {
      if (!text) return [];
      const matches: string[] = [];
      let m: RegExpExecArray | null;
      hashtagRegex.lastIndex = 0;
      while ((m = hashtagRegex.exec(text)) !== null) {
        matches.push('#' + m[1]);
      }
      return matches;
    }

    function calculateXWeightedLength(text: string): number {
      if (!text) return 0;
      const textWithUrlsReplaced = text.replace(urlRegex, 'x'.repeat(23));
      let length = 0;
      for (const char of textWithUrlsReplaced) {
        if (char.match(emojiRegex)) {
          length += 2;
        } else {
          length += 1;
        }
      }
      return length;
    }

    interface UniqueHashtag {
      display: string;
      count: number;
      length: number;
    }

    function getUniqueHashtags(tags: string[]): UniqueHashtag[] {
      const map = new Map<string, UniqueHashtag>();
      tags.forEach(tag => {
        const lower = tag.toLowerCase();
        if (!map.has(lower)) {
          map.set(lower, { display: tag, count: 0, length: Array.from(tag).length });
        }
        map.get(lower)!.count++;
      });
      return Array.from(map.values());
    }

    function updateAllCounts() {
      const rawText = tweetInput ? tweetInput.value : '';

      // 1. Hashtags
      const hashtagMatches = extractHashtags(rawText);
      const totalHashtags = hashtagMatches.length;
      const uniqueHashtags = getUniqueHashtags(hashtagMatches);
      const uniqueCount = uniqueHashtags.length;
      const duplicateCount = totalHashtags - uniqueCount;

      const hashtagCharsSum = hashtagMatches.reduce((acc, tag) => acc + Array.from(tag).length, 0);
      const rawChars = Array.from(rawText).length;
      const avgTagLen = totalHashtags > 0 ? (hashtagCharsSum / totalHashtags).toFixed(1) : '0';
      const hashtagSharePct = rawChars > 0 ? Math.min(100, Math.round((hashtagCharsSum / rawChars) * 100)) : 0;

      // 2. Character weights & Remaining
      const xWeightedChars = calculateXWeightedLength(rawText);
      const remainingAllowance = currentLimit - xWeightedChars;
      const progressPct = Math.min(100, Math.round((xWeightedChars / currentLimit) * 100));

      // 3. Words
      const trimmed = rawText.trim();
      const wordsCount = trimmed ? trimmed.split(/\s+/).filter(Boolean).length : 0;

      // Update Card 1: Total Hashtags
      if (valTotalHashtags) valTotalHashtags.textContent = totalHashtags.toLocaleString();
      if (subHashtagsDetail) {
        subHashtagsDetail.textContent = totalHashtags === 0 
          ? '0 occurrences detected' 
          : `${totalHashtags} total hashtag occurrence(s)`;
      }

      // Update Card 2: Unique Hashtags
      if (valUniqueHashtags) valUniqueHashtags.textContent = uniqueCount.toLocaleString();
      if (subUniqueDetail) {
        subUniqueDetail.textContent = duplicateCount > 0 
          ? `${duplicateCount} repeated tag(s)` 
          : 'All tags are unique';
      }

      // Update Card 3: Characters
      if (valCharacters) valCharacters.textContent = rawChars.toLocaleString();
      if (subCharDetail) {
        subCharDetail.textContent = `X-weighted: ${xWeightedChars.toLocaleString()} / ${currentLimit.toLocaleString()}`;
      }

      // Update Card 4: Remaining
      if (valRemaining && cardRemaining && badgeRemainingStatus && subRemainingDetail && circleRemaining) {
        cardRemaining.classList.remove('state-warn', 'state-danger');

        if (remainingAllowance >= 0) {
          valRemaining.textContent = remainingAllowance.toLocaleString();
          subRemainingDetail.textContent = `${remainingAllowance.toLocaleString()} characters left`;

          if (remainingAllowance <= (currentLimit === 280 ? 20 : 100)) {
            cardRemaining.classList.add('state-warn');
            badgeRemainingStatus.textContent = 'Tight';
            circleRemaining.innerHTML = svgWarn;
          } else {
            badgeRemainingStatus.textContent = 'Safe';
            circleRemaining.innerHTML = svgClock;
          }
        } else {
          valRemaining.textContent = `-${Math.abs(remainingAllowance).toLocaleString()}`;
          subRemainingDetail.textContent = `${Math.abs(remainingAllowance).toLocaleString()} chars over limit!`;
          cardRemaining.classList.add('state-danger');
          badgeRemainingStatus.textContent = 'Over Limit';
          circleRemaining.innerHTML = svgDanger;
        }
      }

      // Secondary analytics
      if (valWords) valWords.textContent = wordsCount.toLocaleString();
      if (valHashtagChars) valHashtagChars.textContent = `${hashtagCharsSum.toLocaleString()} chars`;
      if (valHashtagShare) valHashtagShare.textContent = `${hashtagSharePct}%`;
      if (valAvgTagLen) valAvgTagLen.textContent = `${avgTagLen} chars`;

      // Progress bar fill
      if (progressMeterFill) {
        progressMeterFill.style.width = `${progressPct}%`;
        progressMeterFill.className = 'progress-meter-fill';
        if (remainingAllowance < 0) {
          progressMeterFill.classList.add('meter-danger');
        } else if (progressPct >= 85) {
          progressMeterFill.classList.add('meter-warn');
        }
      }

      // Density banner
      updateDensityBanner(totalHashtags, remainingAllowance);

      // Hashtag chips
      renderHashtagChips(uniqueHashtags, totalHashtags);
    }

    function updateDensityBanner(tagCount: number, remainingChars: number) {
      if (!densityStatusBanner || !densityIcon || !densityTitle || !densityBadge || !densityDesc) return;

      densityStatusBanner.className = 'density-status-banner';

      if (remainingChars < 0) {
        densityStatusBanner.classList.add('status-danger');
        densityIcon.innerHTML = svgDanger;
        densityTitle.textContent = `Character Limit Exceeded (-${Math.abs(remainingChars)} chars)`;
        densityBadge.textContent = 'Over Limit';
        densityDesc.textContent = `Your tweet exceeds the ${currentLimit.toLocaleString()}-character allowance for this mode. Trim your copy before publishing on X.`;
        return;
      }

      if (tagCount === 0) {
        densityStatusBanner.classList.add('status-neutral');
        densityIcon.innerHTML = svgSearch;
        densityTitle.textContent = 'No Hashtags Detected';
        densityBadge.textContent = 'Awaiting Input';
        densityDesc.textContent = 'Twitter officially recommends using 1 to 2 relevant hashtags per tweet. Posts with 1–2 hashtags achieve up to 21% higher engagement without looking spammy.';
      } else if (tagCount >= 1 && tagCount <= 2) {
        densityStatusBanner.classList.add('status-optimal');
        densityIcon.innerHTML = svgCheck;
        densityTitle.textContent = `Optimal Range: ${tagCount} ${tagCount === 1 ? 'Hashtag' : 'Hashtags'}`;
        densityBadge.textContent = 'Peak Reach';
        densityDesc.textContent = 'Great balance! Research shows 1-2 focused hashtags maximize retweets and organic impressions without cluttering the feed.';
      } else if (tagCount >= 3 && tagCount <= 4) {
        densityStatusBanner.classList.add('status-warning');
        densityIcon.innerHTML = svgWarn;
        densityTitle.textContent = `Moderate Hashtag Usage (${tagCount} Hashtags)`;
        densityBadge.textContent = 'Moderate';
        densityDesc.textContent = '3 to 4 hashtags can dilute tweet focus and may decrease retweets by ~17%. Consider keeping only your 1-2 highest-impact hashtags.';
      } else {
        densityStatusBanner.classList.add('status-danger');
        densityIcon.innerHTML = svgDanger;
        densityTitle.textContent = `Over-Hashtagged (${tagCount} Hashtags)`;
        densityBadge.textContent = 'Suppression Risk';
        densityDesc.textContent = 'Using 5 or more hashtags triggers algorithmic suppression and looks spammy on mobile feeds. Prune down to 1-2 targeted niche hashtags.';
      }
    }

    function renderHashtagChips(uniqueList: UniqueHashtag[], totalCount: number) {
      if (!detectedPillCounter || !emptyHashtagsBox || !hashtagChipsGrid || !btnCopyUnique) return;

      detectedPillCounter.textContent = `${totalCount} total • ${uniqueList.length} unique`;

      if (uniqueList.length === 0) {
        emptyHashtagsBox.style.display = 'flex';
        hashtagChipsGrid.style.display = 'none';
        btnCopyUnique.style.display = 'none';
        hashtagChipsGrid.innerHTML = '';
        return;
      }

      emptyHashtagsBox.style.display = 'none';
      hashtagChipsGrid.style.display = 'grid';
      btnCopyUnique.style.display = 'inline-block';
      hashtagChipsGrid.innerHTML = '';

      uniqueList.forEach(item => {
        const chip = document.createElement('div');
        chip.className = 'modern-chip-card';
        chip.title = `Click to copy ${item.display}`;

        const isRepeated = item.count > 1;
        const countBadgeClass = isRepeated ? 'chip-count-badge is-repeated' : 'chip-count-badge';
        const countBadgeText = isRepeated ? `${item.count}× REPEATED` : `${item.count}×`;

        chip.innerHTML = `
          <div class="chip-left">
            <span class="chip-text">${escapeHtml(item.display)}</span>
          </div>
          <div class="chip-right">
            <span class="${countBadgeClass}">${countBadgeText}</span>
            <span class="chip-len-badge">${item.length}c</span>
            <span class="chip-copy-icon-wrap" aria-hidden="true">${svgCopy}</span>
          </div>
        `;

        chip.addEventListener('click', () => {
          navigator.clipboard.writeText(item.display).then(() => {
            const originalHtml = chip.innerHTML;
            chip.innerHTML = `
              <div class="chip-left">
                <span class="chip-text" style="color: #10b981;">Copied!</span>
              </div>
              <div class="chip-right">
                <span class="chip-count-badge" style="color: #10b981; border-color: rgba(16, 185, 129, 0.4);">${svgCopiedCheck}</span>
              </div>
            `;
            setTimeout(() => {
              chip.innerHTML = originalHtml;
            }, 1400);
          });
        });

        hashtagChipsGrid.appendChild(chip);
      });
    }

    function escapeHtml(str: string): string {
      return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
      );
    }

    // Input listeners
    ['input', 'change', 'keyup'].forEach(evt => {
      tweetInput.addEventListener(evt, updateAllCounts);
    });

    // Mode Switcher: Standard (280) vs X Premium (25K)
    if (tabStandard && tabPremium) {
      tabStandard.addEventListener('click', () => {
        currentLimit = 280;
        tabStandard.classList.add('active');
        tabStandard.setAttribute('aria-pressed', 'true');
        tabPremium.classList.remove('active');
        tabPremium.setAttribute('aria-pressed', 'false');
        if (platformLimitText) {
          platformLimitText.innerHTML = 'Standard Account: <strong>280 chars</strong>';
        }
        if (badgeLimitDisplay) badgeLimitDisplay.textContent = 'Limit: 280';
        updateAllCounts();
      });

      tabPremium.addEventListener('click', () => {
        currentLimit = 25000;
        tabPremium.classList.add('active');
        tabPremium.setAttribute('aria-pressed', 'true');
        tabStandard.classList.remove('active');
        tabStandard.setAttribute('aria-pressed', 'false');
        if (platformLimitText) {
          platformLimitText.innerHTML = 'X Premium Account: <strong>25,000 chars</strong>';
        }
        if (badgeLimitDisplay) badgeLimitDisplay.textContent = 'Limit: 25K';
        updateAllCounts();
      });
    }

    // Action 1: Copy Full Tweet
    if (btnCopyTweet && copyTweetLabel) {
      btnCopyTweet.addEventListener('click', () => {
        const text = tweetInput.value;
        if (!text.trim()) {
          const original = copyTweetLabel.textContent;
          copyTweetLabel.textContent = 'Tweet is empty!';
          setTimeout(() => {
            copyTweetLabel.textContent = original;
          }, 1600);
          return;
        }

        navigator.clipboard.writeText(text).then(() => {
          const original = copyTweetLabel.textContent;
          copyTweetLabel.textContent = 'Copied Tweet!';
          setTimeout(() => {
            copyTweetLabel.textContent = original;
          }, 1600);
        });
      });
    }

    // Action 2: Copy Hashtags Only
    if (btnCopyHashtags && copyHashtagsLabel) {
      btnCopyHashtags.addEventListener('click', () => {
        const text = tweetInput.value;
        const matches = extractHashtags(text);
        if (matches.length === 0) {
          const original = copyHashtagsLabel.textContent;
          copyHashtagsLabel.textContent = 'No tags to copy!';
          setTimeout(() => {
            copyHashtagsLabel.textContent = original;
          }, 1600);
          return;
        }

        const tagsString = matches.join(' ');
        navigator.clipboard.writeText(tagsString).then(() => {
          const original = copyHashtagsLabel.textContent;
          copyHashtagsLabel.textContent = `Copied ${matches.length} Tags!`;
          setTimeout(() => {
            copyHashtagsLabel.textContent = original;
          }, 1600);
        });
      });
    }

    // Action 3: Copy Unique Hashtags
    if (btnCopyUnique) {
      btnCopyUnique.addEventListener('click', () => {
        const text = tweetInput.value;
        const matches = extractHashtags(text);
        const unique = getUniqueHashtags(matches);
        if (unique.length === 0) return;

        const uniqueString = unique.map(u => u.display).join(' ');
        navigator.clipboard.writeText(uniqueString).then(() => {
          const original = btnCopyUnique.textContent;
          btnCopyUnique.textContent = 'Copied Unique!';
          setTimeout(() => {
            btnCopyUnique.textContent = original;
          }, 1600);
        });
      });
    }

    // Action 4: Clear All
    if (btnClear) {
      btnClear.addEventListener('click', () => {
        tweetInput.value = '';
        updateAllCounts();
        tweetInput.focus();
      });
    }

    // Action 5: Clean Spacing
    if (btnCleanSpacing) {
      btnCleanSpacing.addEventListener('click', () => {
        tweetInput.value = tweetInput.value
          .split('\n')
          .map(line => line.replace(/[ \t]+/g, ' ').trim())
          .join('\n')
          .trim();
        updateAllCounts();
      });
    }

    // Action 6: Paste Text
    if (btnPaste) {
      btnPaste.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) {
            tweetInput.value = text;
            updateAllCounts();
          }
        } catch (e) {
          tweetInput.focus();
        }
      });
    }

    // Initial calculation
    updateAllCounts();
  }

  // Setup on page load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTwitterHashtagCounter);
  } else {
    setupTwitterHashtagCounter();
  }

  document.addEventListener('astro:after-swap', setupTwitterHashtagCounter);
</script>

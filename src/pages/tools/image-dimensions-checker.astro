  }

  .empty-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 320px;
    margin: 0;
    line-height: 1.45;
  }

  /* Results Display Box */
  .results-display-box {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: 100%;
  }

  /* Verdict Status Banner */
  .verdict-banner {
    padding: 0.9rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);

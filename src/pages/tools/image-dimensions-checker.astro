    const specRatio = document.getElementById('spec-ratio');
    const specRatioDec = document.getElementById('spec-ratio-dec');
    const specMp = document.getElementById('spec-mp');
    const specTotalPx = document.getElementById('spec-total-px');
    const specFilesize = document.getElementById('spec-filesize');
    const specBytes = document.getElementById('spec-bytes');
    const specFormat = document.getElementById('spec-format');
    const specMime = document.getElementById('spec-mime');

    // Compatibility
    const compatGrid = document.getElementById('compat-grid');

    // Reset
    const btnResetTool = document.getElementById('btn-reset-tool');

    // Current State Storage
    let activeObjectUrl: string | null = null;
    let currentWidth = 0;
    let currentHeight = 0;
    let currentRatioString = '';

    if (!fileInput || !dropzone) return;

    // Helper: Revoke memory blob URL to prevent leaks
    function cleanupObjectUrl() {
      if (activeObjectUrl) {
        URL.revokeObjectURL(activeObjectUrl);
        activeObjectUrl = null;
      }
    }

    // Helper: Show friendly in-UI error
    function showError(msg: string) {
      if (errorMessage) errorMessage.textContent = msg;
      if (errorBanner) errorBanner.style.display = 'flex';
    }

    // Helper: Hide error
    function hideError() {
      if (errorBanner) errorBanner.style.display = 'none';
    }

    if (btnCloseError) {
      btnCloseError.addEventListener('click', hideError);
    }

    // File Trigger Handlers
    if (btnBrowseTrigger) {
      btnBrowseTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        fileInput.click();
      });
    }

    dropzone.addEventListener('click', () => {
      fileInput.click();
    });

    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    if (btnReplaceImage) {
      btnReplaceImage.addEventListener('click', () => {
        fileInput.click();
      });
    }

    // Drag and Drop Handling
    ['dragenter', 'dragover'].forEach((evt) => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach((evt) => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dragover');
      });
    });

    dropzone.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        processSelectedFile(dt.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        processSelectedFile(fileInput.files[0]);
      }
    });

    // Reset Tool Handler
    if (btnResetTool) {
      btnResetTool.addEventListener('click', resetAll);
    }

    function resetAll() {
      cleanupObjectUrl();
      currentWidth = 0;
      currentHeight = 0;
      currentRatioString = '';
      if (fileInput) fileInput.value = '';
      if (imagePreview) imagePreview.src = '';
      hideError();

      if (resultsWorkspace) resultsWorkspace.style.display = 'none';
      if (uploadZoneWrapper) uploadZoneWrapper.style.display = 'block';
    }

    // Mathematical Greatest Common Divisor
    function getGcd(a: number, b: number): number {
      return b === 0 ? a : getGcd(b, a % b);
    }

    // Calculate Aspect Ratio with Standard Approximations
    function getAspectRatioData(w: number, h: number): { ratio: string; name: string; decimal: string } {
      if (w <= 0 || h <= 0) return { ratio: '1:1', name: 'Square', decimal: '1.00:1' };

      const gcd = getGcd(w, h);
      const rW = w / gcd;
      const rH = h / gcd;
      const dec = w / h;
      const decStr = dec.toFixed(2);

      // Exact integer reductions
      if (rW === 16 && rH === 9) return { ratio: '16:9', name: 'Widescreen (16:9)', decimal: `${decStr}:1` };
      if (rW === 9 && rH === 16) return { ratio: '9:16', name: 'Vertical / Story / Reel', decimal: `${decStr}:1` };
      if (rW === 1 && rH === 1) return { ratio: '1:1', name: 'Square (1:1)', decimal: `${decStr}:1` };
      if (rW === 4 && rH === 3) return { ratio: '4:3', name: 'Standard Photo (4:3)', decimal: `${decStr}:1` };
      if (rW === 3 && rH === 4) return { ratio: '3:4', name: 'Portrait Photo (3:4)', decimal: `${decStr}:1` };
      if (rW === 4 && rH === 5) return { ratio: '4:5', name: 'Instagram Portrait (4:5)', decimal: `${decStr}:1` };
      if (rW === 5 && rH === 4) return { ratio: '5:4', name: 'Standard Display (5:4)', decimal: `${decStr}:1` };
      if (rW === 3 && rH === 2) return { ratio: '3:2', name: 'Classic 35mm (3:2)', decimal: `${decStr}:1` };
      if (rW === 2 && rH === 3) return { ratio: '2:3', name: 'Vertical 35mm (2:3)', decimal: `${decStr}:1` };
      if (rW === 2 && rH === 1) return { ratio: '2:1', name: 'Univisium (2:1)', decimal: `${decStr}:1` };
      if (rW === 1 && rH === 2) return { ratio: '1:2', name: 'Tall Banner (1:2)', decimal: `${decStr}:1` };

      // Decimal tolerances for slight non-exact crops
      if (Math.abs(dec - 16 / 9) < 0.02) return { ratio: '16:9', name: 'Near 16:9 Widescreen', decimal: `${decStr}:1` };
      if (Math.abs(dec - 9 / 16) < 0.02) return { ratio: '9:16', name: 'Near 9:16 Vertical', decimal: `${decStr}:1` };
      if (Math.abs(dec - 1.0) < 0.02) return { ratio: '1:1', name: 'Near 1:1 Square', decimal: `${decStr}:1` };
      if (Math.abs(dec - 4 / 5) < 0.02) return { ratio: '4:5', name: 'Near 4:5 Instagram Portrait', decimal: `${decStr}:1` };
      if (Math.abs(dec - 4 / 3) < 0.02) return { ratio: '4:3', name: 'Near 4:3 Photo', decimal: `${decStr}:1` };
      if (Math.abs(dec - 1.905) < 0.03) return { ratio: '1.91:1', name: 'Open Graph Banner', decimal: `${decStr}:1` };
      if (Math.abs(dec - 21 / 9) < 0.04) return { ratio: '21:9', name: 'Ultrawide Cinema', decimal: `${decStr}:1` };

      // Simplified Small Integer check
      if (rW <= 30 && rH <= 30) {
        return { ratio: `${rW}:${rH}`, name: `Aspect Ratio ${rW}:${rH}`, decimal: `${decStr}:1` };
      }

      // Default Decimal Ratio
      return { ratio: `${decStr}:1`, name: `Custom Ratio (${decStr}:1)`, decimal: `${decStr}:1` };
    }

    // Format Bytes to human readable string
    function formatBytes(bytes: number): { formatted: string; exact: string } {
      const exact = `${bytes.toLocaleString()} bytes`;
      if (bytes < 1024) return { formatted: `${bytes} B`, exact };
      if (bytes < 1024 * 1024) return { formatted: `${(bytes / 1024).toFixed(1)} KB`, exact };
      return { formatted: `${(bytes / (1024 * 1024)).toFixed(2)} MB`, exact };
    }

    // Main File Processing Engine
    function processSelectedFile(file: File) {
      hideError();

      if (!file) {
        showError('No file selected.');
        return;
      }

      // Size Limit: 50 MB
      const maxSizeBytes = 50 * 1024 * 1024;
      if (file.size > maxSizeBytes) {
        showError('File exceeds the 50 MB limit. Please select an image under 50 MB.');
        return;
      }

      // Format Verification
      const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/avif', 'image/svg+xml'];
      const fileExt = file.name.split('.').pop()?.toLowerCase() || '';
      const allowedExts = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'avif', 'svg'];

      const isMimeValid = file.type && validTypes.includes(file.type);
      const isExtValid = allowedExts.includes(fileExt);

      if (!isMimeValid && !isExtValid) {
        showError(`Unsupported file format (.${fileExt || 'unknown'}). Please choose a PNG, JPG, WebP, AVIF, GIF, or SVG.`);
        return;
      }

      cleanupObjectUrl();
      const objectUrl = URL.createObjectURL(file);
      activeObjectUrl = objectUrl;

      // Handle SVG separately for robust viewBox / width attribute extraction
      if (file.type === 'image/svg+xml' || fileExt === 'svg') {
        processSvgFile(file, objectUrl);
      } else {
        processRasterFile(file, objectUrl);
      }
    }

    // Process Standard Raster Images (PNG, JPG, WebP, AVIF, GIF)
    function processRasterFile(file: File, objectUrl: string) {
      const img = new Image();
      img.onload = () => {
        const w = img.naturalWidth || img.width;
        const h = img.naturalHeight || img.height;

        if (!w || !h) {
          showError('Unable to extract dimensions from this image. The file may be empty or corrupted.');
          return;
        }

        displayImageResults(w, h, file, objectUrl);
      };

      img.onerror = () => {
        showError('Could not decode image data. The file appears to be corrupted or invalid.');
      };

      img.src = objectUrl;
    }

    // Process SVG Images with ViewBox / Attribute Fallback
    function processSvgFile(file: File, objectUrl: string) {
      const img = new Image();
      img.onload = () => {
        let w = img.naturalWidth || img.width;
        let h = img.naturalHeight || img.height;

        if (w > 0 && h > 0) {
          displayImageResults(w, h, file, objectUrl);
        } else {
          // Fallback: Read SVG XML text and parse viewBox or width/height attributes
          file.text().then(svgText => {
            try {
              const parser = new DOMParser();
              const xmlDoc = parser.parseFromString(svgText, 'image/svg+xml');
              const svgElement = xmlDoc.querySelector('svg');
              if (svgElement) {
                const viewBox = svgElement.getAttribute('viewBox');
                if (viewBox) {
                  const parts = viewBox.trim().split(/[\s,]+/).map(Number);
                  if (parts.length === 4 && parts[2] > 0 && parts[3] > 0) {
                    w = Math.round(parts[2]);
                    h = Math.round(parts[3]);
                  }
                }
                if ((!w || !h) && svgElement.hasAttribute('width') && svgElement.hasAttribute('height')) {
                  w = Math.round(parseFloat(svgElement.getAttribute('width') || '0'));
                  h = Math.round(parseFloat(svgElement.getAttribute('height') || '0'));
                }
              }
            } catch {
              // Ignore parse errors, fallback below
            }

            displayImageResults(w || 800, h || 600, file, objectUrl);
          }).catch(() => {
            displayImageResults(800, 600, file, objectUrl);
          });
        }
      };

      img.onerror = () => {
        showError('Could not decode SVG file. The SVG code may be malformed or invalid.');
      };

      img.src = objectUrl;
    }

    // Populate Results into DOM
    function displayImageResults(width: number, height: number, file: File, objectUrl: string) {
      currentWidth = width;
      currentHeight = height;

      const totalPixels = width * height;
      const megapixels = (totalPixels / 1000000).toFixed(2);
      const ratioData = getAspectRatioData(width, height);
      currentRatioString = ratioData.ratio;

      const orientation = width > height ? 'Landscape' : width < height ? 'Portrait' : 'Square';
      const fileExt = file.name.split('.').pop()?.toUpperCase() || 'IMAGE';
      const sizeData = formatBytes(file.size);

      // 1. Hero Banner
      if (heroDimsValue) heroDimsValue.textContent = `${width.toLocaleString()} × ${height.toLocaleString()}`;
      if (heroRatioTag) heroRatioTag.textContent = ratioData.ratio;
      if (heroOrientationTag) heroOrientationTag.textContent = orientation;
      if (heroMpTag) heroMpTag.textContent = `${megapixels} MP`;

      // 2. Image Preview
      if (imagePreview) {
        imagePreview.src = objectUrl;
        imagePreview.alt = `${file.name} preview (${width} × ${height} px)`;
      }
      if (previewDimBadge) previewDimBadge.textContent = `${width} × ${height} px`;
      if (fileNameCaption) {
        fileNameCaption.textContent = file.name;
        fileNameCaption.title = file.name;
      }

      // 3. Technical Specifications Grid
      if (specWidth) specWidth.textContent = `${width.toLocaleString()} px`;
      if (specHeight) specHeight.textContent = `${height.toLocaleString()} px`;
      if (specRatio) specRatio.textContent = ratioData.ratio;
      if (specRatioDec) {
        specRatioDec.textContent = ratioData.decimal;
        specRatioDec.title = `${ratioData.decimal} • ${ratioData.name}`;
      }
      if (specMp) specMp.textContent = `${megapixels} MP`;
      if (specTotalPx) specTotalPx.textContent = `${totalPixels.toLocaleString()} px`;
      if (specFilesize) specFilesize.textContent = sizeData.formatted;
      if (specBytes) specBytes.textContent = sizeData.exact;
      if (specFormat) specFormat.textContent = fileExt;
      if (specMime) specMime.textContent = file.type || `image/${fileExt.toLowerCase()}`;

      // 4. Social Media Compatibility Audit
      if (compatGrid) {
        compatGrid.innerHTML = '';
        const decRatio = width / height;

        standardPlatforms.forEach((platform) => {
          const isExact = width === platform.width && height === platform.height;
          const targetRatioDec = platform.width / platform.height;
          const isRatioMatch = Math.abs(decRatio - targetRatioDec) < 0.03;

          const item = document.createElement('div');
          item.className = 'compat-item';

          const col = document.createElement('div');
          col.className = 'compat-platform-col';

          const nameSpan = document.createElement('span');
          nameSpan.className = 'compat-name';
          nameSpan.textContent = platform.name;

          const targetSpan = document.createElement('span');
          targetSpan.className = 'compat-target';
          targetSpan.textContent = `${platform.width} × ${platform.height} px (${platform.ratio})`;

          col.appendChild(nameSpan);
          col.appendChild(targetSpan);

          const badge = document.createElement('span');
          if (isExact) {
            badge.className = 'compat-badge exact';
            badge.textContent = 'Exact Fit';
          } else if (isRatioMatch) {
            badge.className = 'compat-badge ratio';
            badge.textContent = 'Ratio Match';
          } else {
            badge.className = 'compat-badge diff';
            badge.textContent = 'Different Size';
          }

          item.appendChild(col);
          item.appendChild(badge);
          compatGrid.appendChild(item);
        });
      }

      // Switch Visibility
      if (uploadZoneWrapper) uploadZoneWrapper.style.display = 'none';
      if (resultsWorkspace) resultsWorkspace.style.display = 'flex';
    }

    // Copy to Clipboard Utility
    function copyText(text: string, buttonEl: HTMLElement | null, textEl: HTMLElement | null, defaultLabel: string) {
      if (!text || !buttonEl || !textEl) return;

      const performFeedback = () => {
        buttonEl.classList.add('copied');
        textEl.textContent = 'Copied!';
        setTimeout(() => {
          buttonEl.classList.remove('copied');
          textEl.textContent = defaultLabel;
        }, 2000);
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(performFeedback).catch(() => {
          fallbackCopy(text);
          performFeedback();
        });
      } else {
        fallbackCopy(text);
        performFeedback();
      }
    }

    function fallbackCopy(text: string) {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.top = '0';
      textArea.style.left = '0';
      textArea.style.opacity = '0';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
      } catch {
        // Fallback catch
      }
      document.body.removeChild(textArea);
    }

    // Attach Copy Listeners
    if (btnCopyDims) {
      btnCopyDims.addEventListener('click', () => {
        if (currentWidth && currentHeight) {
          copyText(`${currentWidth} x ${currentHeight} px`, btnCopyDims, copyDimsText, 'Copy Dimensions');
        }
      });
    }

    if (btnCopyRatio) {
      btnCopyRatio.addEventListener('click', () => {
        if (currentRatioString) {
          copyText(currentRatioString, btnCopyRatio, copyRatioText, 'Copy Ratio');
        }
      });
    }
  });
</script>

  }

  .verdict-title {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .verdict-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* 6 Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 576px) {
    .metrics-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .metric-card {
    padding: 0.8rem 0.6rem;
    text-align: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: border-color var(--transition-fast);
  }

  .metric-card:hover {
    border-color: var(--color-border-hover);
  }

  .metric-value {
    font-size: 1.05rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-brand);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.2rem;
  }

  .metric-sub {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Preview Stage Card */
  .preview-stage-card {
    padding: 1rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stage-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stage-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stage-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .preview-canvas-wrapper {
    width: 100%;
    max-height: 260px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preview-img-display {
    max-width: 100%;
    max-height: 260px;
    object-fit: contain;
  }

  /* Platform Fit Card */
  .platform-fit-card {
    padding: 1rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .fit-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .fit-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .fit-sub {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .fit-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
  }

  @media (min-width: 640px) {
    .fit-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  :global(.fit-item) {
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.775rem;
  }

  :global(.fit-name) {
    font-weight: 600;
    color: var(--color-text);
  }

  :global(.fit-tag) {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  :global(.fit-tag.matched) {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
  }

  :global(.fit-tag.unmatched) {
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
  }

  /* Editorial Content Styles */
  .editorial-section {
    padding-top: 1.5rem;
  }

  .editorial-section h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .editorial-section p {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .editorial-section ul, .editorial-section ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .editorial-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .editorial-section code {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .editorial-table th, .editorial-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .editorial-table th {
    background: var(--color-bg-alt);
    font-weight: 700;
  }

  .editorial-table tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .internal-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-link-card {
    display: block;
    padding: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  interface PlatformPreset {
    name: string;
    width: number;
    height: number;
    ratio: string;
  }

  const platformPresets: PlatformPreset[] = [
    { name: 'YouTube Thumbnail (1280×720)', width: 1280, height: 720, ratio: '16:9' },
    { name: 'Full HD Widescreen (1920×1080)', width: 1920, height: 1080, ratio: '16:9' },
    { name: 'Instagram Square Post (1080×1080)', width: 1080, height: 1080, ratio: '1:1' },
    { name: 'Instagram Portrait (1080×1350)', width: 1080, height: 1350, ratio: '4:5' },
    { name: 'TikTok / Story / Reel (1080×1920)', width: 1080, height: 1920, ratio: '9:16' },
    { name: 'Open Graph / Facebook (1200×630)', width: 1200, height: 630, ratio: '40:21' },
    { name: 'Twitter / X Post (1200×675)', width: 1200, height: 675, ratio: '16:9' },
    { name: 'Twitter Header Banner (1500×500)', width: 1500, height: 500, ratio: '3:1' }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedFileBar = document.getElementById('loaded-file-bar');
    const loadedThumbImg = document.getElementById('loaded-thumb-img') as HTMLImageElement | null;
    const loadedFilename = document.getElementById('loaded-filename');
    const loadedFilesize = document.getElementById('loaded-filesize');
    const btnClearFile = document.getElementById('btn-clear-file');
    const presetBtns = document.querySelectorAll('.preset-pill-btn');

    const btnAnalyze = document.getElementById('btn-analyze');
    const btnClearAll = document.getElementById('btn-clear-all');

    // Audit Displays
    const emptyStateCard = document.getElementById('empty-state-card');
    const resultsDisplayBox = document.getElementById('results-display-box');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictDesc = document.getElementById('verdict-desc');

    const resDims = document.getElementById('res-dims');
    const resAspectRatio = document.getElementById('res-aspect-ratio');
    const resAspectName = document.getElementById('res-aspect-name');
    const resMegapixels = document.getElementById('res-megapixels');
    const resTotalPixels = document.getElementById('res-total-pixels');
    const resFileSize = document.getElementById('res-file-size');
    const resBytes = document.getElementById('res-bytes');
    const resOrientation = document.getElementById('res-orientation');
    const resFormat = document.getElementById('res-format');
    const resMime = document.getElementById('res-mime');

    const previewBadgeDims = document.getElementById('preview-badge-dims');
    const previewImgDisplay = document.getElementById('preview-img-display') as HTMLImageElement | null;
    const fitList = document.getElementById('fit-list');

    if (!dropzone || !fileInput) return;

    let currentFileObj: File | null = null;
    let loadedImageElement: HTMLImageElement | null = null;

    // Drag & Drop Handling
    ['dragenter', 'dragover'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dragover');
      });
    });

    dropzone.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFileSelection(dt.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFileSelection(fileInput.files[0]);
      }
    });

    if (btnClearFile) btnClearFile.addEventListener('click', resetState);
    if (btnClearAll) btnClearAll.addEventListener('click', resetState);

    // Preset Sample Testing Buttons
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const w = parseInt(btn.getAttribute('data-w') || '1920', 10);
        const h = parseInt(btn.getAttribute('data-h') || '1080', 10);
        const label = btn.getAttribute('data-label') || 'Sample Test';
        createSampleImageAndAnalyze(w, h, label);
      });
    });

    function resetState() {
      currentFileObj = null;
      loadedImageElement = null;
      if (fileInput) fileInput.value = '';
      if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
      if (loadedFileBar) loadedFileBar.style.display = 'none';
      if (resultsDisplayBox) resultsDisplayBox.style.display = 'none';
      if (emptyStateCard) emptyStateCard.style.display = 'flex';
    }

    function handleFileSelection(file: File) {
      if (!file || !file.type.startsWith('image/')) {
        alert('Please select a valid image file (PNG, JPG, WEBP, GIF, SVG, AVIF).');
        return;
      }

      currentFileObj = file;
      const mbSize = (file.size / (1024 * 1024)).toFixed(2);
      const kbSize = (file.size / 1024).toFixed(1);
      const displaySize = file.size > 1024 * 1024 ? `${mbSize} MB` : `${kbSize} KB`;

      if (loadedFilename) loadedFilename.textContent = file.name;
      if (loadedFilesize) loadedFilesize.textContent = displaySize;

      const reader = new FileReader();
      reader.onload = (evt) => {
        const dataUrl = evt.target?.result as string;
        if (loadedThumbImg) loadedThumbImg.src = dataUrl;

        const img = new Image();
        img.onload = () => {
          loadedImageElement = img;
          if (dropzonePrompt) dropzonePrompt.style.display = 'none';
          if (loadedFileBar) loadedFileBar.style.display = 'flex';
          analyzeImage(img.naturalWidth || img.width, img.naturalHeight || img.height, file.name, file.size, file.type, dataUrl);
        };
        img.src = dataUrl;
      };
      reader.readAsDataURL(file);
    }

    function createSampleImageAndAnalyze(w: number, h: number, label: string) {
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      if (ctx) {
        // Draw sample gradient canvas
        const grad = ctx.createLinearGradient(0, 0, w, h);
        grad.addColorStop(0, '#6366f1');
        grad.addColorStop(1, '#a855f7');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);

        ctx.fillStyle = '#ffffff';
        ctx.font = `bold ${Math.max(24, Math.floor(h / 14))}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(`${w} × ${h} px`, w / 2, h / 2);
      }

      canvas.toBlob((blob) => {
        if (!blob) return;
        const dataUrl = canvas.toDataURL('image/png');
        if (loadedThumbImg) loadedThumbImg.src = dataUrl;
        if (loadedFilename) loadedFilename.textContent = `${w}x${h}_sample.png`;
        if (loadedFilesize) loadedFilesize.textContent = `${(blob.size / 1024).toFixed(1)} KB`;
        if (dropzonePrompt) dropzonePrompt.style.display = 'none';
        if (loadedFileBar) loadedFileBar.style.display = 'flex';
        analyzeImage(w, h, `${w}x${h}_sample.png`, blob.size, 'image/png', dataUrl);
      }, 'image/png');
    }

    function getGcd(a: number, b: number): number {
      return b === 0 ? a : getGcd(b, a % b);
    }

    function calculateAspectRatio(w: number, h: number): { ratio: string; name: string } {
      const gcd = getGcd(w, h);
      const rW = w / gcd;
      const rH = h / gcd;
      const decimal = (w / h).toFixed(2);
      const decNum = parseFloat(decimal);

      if ((rW === 16 && rH === 9) || (decNum >= 1.77 && decNum <= 1.79)) return { ratio: '16:9', name: 'Widescreen (16:9)' };
      if ((rW === 9 && rH === 16) || (decNum >= 0.55 && decNum <= 0.57)) return { ratio: '9:16', name: 'Vertical / Story / Reel' };
      if (rW === 1 && rH === 1) return { ratio: '1:1', name: 'Square (1:1)' };
      if (rW === 4 && rH === 3 || (decNum >= 1.32 && decNum <= 1.34)) return { ratio: '4:3', name: 'Standard Photo (4:3)' };
      if (rW === 3 && rH === 2 || (decNum >= 1.49 && decNum <= 1.51)) return { ratio: '3:2', name: 'Classic 35mm (3:2)' };
      if (rW === 4 && rH === 5 || (decNum >= 0.79 && decNum <= 0.81)) return { ratio: '4:5', name: 'Instagram Portrait (4:5)' };
      if (decNum >= 1.89 && decNum <= 1.93) return { ratio: '1.91:1', name: 'Open Graph Banner' };
      if (rW <= 30 && rH <= 30) return { ratio: `${rW}:${rH}`, name: `Custom Ratio (${decimal}:1)` };
      return { ratio: `${decimal}:1`, name: `Aspect Ratio (${decimal}:1)` };
    }

    function analyzeImage(width: number, height: number, filename: string, sizeBytes: number, mimeType: string, dataUrl: string) {
      const totalPixels = width * height;
      const megapixels = (totalPixels / 1000000).toFixed(2);
      const aspect = calculateAspectRatio(width, height);
      const orientation = width > height ? 'Landscape' : width < height ? 'Portrait' : 'Square';

      const ext = filename.split('.').pop()?.toUpperCase() || 'IMAGE';
      const mbSize = (sizeBytes / (1024 * 1024)).toFixed(2);
      const kbSize = (sizeBytes / 1024).toFixed(1);
      const formattedSize = sizeBytes > 1024 * 1024 ? `${mbSize} MB` : `${kbSize} KB`;

      // Update Audit Metric Cards
      if (resDims) resDims.textContent = `${width} × ${height} px`;
      if (resAspectRatio) resAspectRatio.textContent = aspect.ratio;
      if (resAspectName) resAspectName.textContent = aspect.name;
      if (resMegapixels) resMegapixels.textContent = `${megapixels} MP`;
      if (resTotalPixels) resTotalPixels.textContent = `${totalPixels.toLocaleString()} Total Pixels`;
      if (resFileSize) resFileSize.textContent = formattedSize;
      if (resBytes) resBytes.textContent = `${sizeBytes.toLocaleString()} Bytes`;
      if (resOrientation) resOrientation.textContent = orientation;
      if (resFormat) resFormat.textContent = ext;
      if (resMime) resMime.textContent = mimeType || 'image/*';

      // Update Preview Card
      if (previewBadgeDims) previewBadgeDims.textContent = `${width} × ${height} px • ${aspect.ratio}`;
      if (previewImgDisplay) previewImgDisplay.src = dataUrl;

      // Update Social Media Platform Fit Checklist
      if (fitList) {
        fitList.innerHTML = '';
        const decRatio = parseFloat((width / height).toFixed(2));

        platformPresets.forEach(preset => {
          const isExact = width === preset.width && height === preset.height;
          const targetDec = parseFloat((preset.width / preset.height).toFixed(2));
          const isRatioMatch = Math.abs(decRatio - targetDec) < 0.03;

          const item = document.createElement('div');
          item.className = 'fit-item';

          const nameSpan = document.createElement('span');
          nameSpan.className = 'fit-name';
          nameSpan.textContent = preset.name;

          const tagSpan = document.createElement('span');
          if (isExact) {
            tagSpan.className = 'fit-tag matched';
            tagSpan.textContent = 'Exact Fit';
          } else if (isRatioMatch) {
            tagSpan.className = 'fit-tag matched';
            tagSpan.textContent = 'Ratio Match';
          } else {
            tagSpan.className = 'fit-tag unmatched';
            tagSpan.textContent = 'Different Ratio';
          }

          item.appendChild(nameSpan);
          item.appendChild(tagSpan);
          fitList.appendChild(item);
        });
      }

      if (verdictTitle) verdictTitle.textContent = `${width} × ${height} px (${aspect.ratio})`;
      if (verdictDesc) verdictDesc.textContent = `${filename} • ${formattedSize} • ${megapixels} MP • ${orientation}`;

      if (emptyStateCard) emptyStateCard.style.display = 'none';
      if (resultsDisplayBox) {
        resultsDisplayBox.style.display = 'flex';
        if (window.innerWidth < 992) {
          resultsDisplayBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    if (btnAnalyze) {
      btnAnalyze.addEventListener('click', () => {
        if (loadedImageElement) {
          const w = loadedImageElement.naturalWidth || loadedImageElement.width;
          const h = loadedImageElement.naturalHeight || loadedImageElement.height;
          analyzeImage(w, h, currentFileObj?.name || 'image.png', currentFileObj?.size || 0, currentFileObj?.type || 'image/png', loadedImageElement.src);
        } else {
          alert('Please upload an image first or click one of the sample test buttons.');
        }
      });
    }
  });
</script>

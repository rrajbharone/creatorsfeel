const filterTabs = [
  { key: 'all', label: 'All Tools' },
  { key: 'youtube', label: 'YouTube' },
  { key: 'instagram', label: 'Instagram' },
  { key: 'tiktok', label: 'TikTok' },
  { key: 'image', label: 'Image & Video' },
  { key: 'seo', label: 'SEO' },
  { key: 'general', label: 'General' }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' }
];
---

<BaseLayout 
  title="All Creator Tools & Calculators - CreatorsFeel"
  description="Explore 80+ free creator tools, calculators, and generators for YouTube, Instagram, TikTok, SEO, and video workflows. Fast, privacy-focused, and 100% free."
  breadcrumbs={breadcrumbs}
  hideGlow={true}
>
  <div class="all-tools-page">
    <div class="container page-container">
      
      <!-- 1. Page Header -->
      <header class="page-header text-center">
        <div class="header-pill">
          <span>80+ Free Creator Tools</span>
        </div>
        <h1 class="page-title">
          Explore All <span class="text-purple-highlight">Creator Tools</span>
        </h1>
        <p class="page-subtitle">
          Free, fast, and privacy-focused tools, calculators, and utilities built specifically to help content creators save time, optimize content, and grow on every platform.
        </p>
      </header>

      <!-- 2. Explore by Category: 6 Pastel Cards matching Reference Image -->
      <section class="section-categories" aria-label="Explore by Category">
        <div class="categories-grid-6">
          {categories.map(cat => (
            <button 
              type="button"
              class="category-pastel-card" 
              data-cat-trigger={cat.key}
              style={`background-color: ${cat.bg}; border-color: ${cat.border}; text-align: left;`}
              aria-label={`Filter by ${cat.title}`}
            >
              <div class="category-icon-square" style={`background-color: ${cat.iconColor};`}>
                <div class="category-svg-icon" set:html={cat.icon} />
              </div>
              <h2 class="category-card-title">{cat.title}</h2>
              <p class="category-card-desc">{cat.description}</p>
            </button>
          ))}
        </div>
      </section>

      <!-- 3. Search Bar & Filter Tabs -->
      <section class="section-filters" id="tools-section">
        <div class="filters-panel">
          
          <!-- Top Row: Search Input & Results Count -->
          <div class="search-row">
            <div class="search-input-box">
              <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.637 10.637Z" />
              </svg>
              <input 
                type="search" 
                id="tools-search" 
                class="tools-search-input"
                placeholder="Search creator tools and calculators..." 
                aria-label="Search tools by title or keyword"
                autocomplete="off"
              />
              <button type="button" id="search-clear-btn" class="search-clear-btn hidden" aria-label="Clear search query">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            
            <div class="results-count-wrap">
              <span id="results-count" class="results-count-text">Showing <strong>81</strong> tools</span>
            </div>
          </div>

          <!-- Bottom Row: Category Filter Tabs -->
          <div class="filter-tabs-row" role="tablist" aria-label="Filter tools by category">
            {filterTabs.map(tab => (
              <button 
                type="button"
                role="tab"
                class:list={["filter-tab-pill", { active: tab.key === 'all' }]}
                data-tab-key={tab.key}
                aria-selected={tab.key === 'all' ? "true" : "false"}
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. Tools Grid (81 Tools) -->
      <section class="section-tools-grid" aria-label="Tools Directory">
        <div class="tools-directory-grid" id="tools-directory-grid">
          {tools.map(tool => (
            <a 
              href={tool.href} 
              class="tool-item-card" 
              data-title={tool.title.toLowerCase()}
              data-desc={tool.description.toLowerCase()}
              data-category={tool.categoryKey}
            >
              <div class="card-top-row">
                <div class="tool-icon-square" style={`background-color: ${tool.iconBg};`}>
                  <div class="tool-svg-box" set:html={tool.icon} />
                </div>
                <span class={`tool-badge-pill badge-${tool.categoryKey}`}>
                  {tool.badge}
                </span>
              </div>

              <h3 class="tool-card-title">{tool.title}</h3>
              <p class="tool-card-desc">{tool.description}</p>

              <div class="tool-card-footer">
                <span class="tool-action-text">Try Tool</span>
                <div class="tool-arrow-circle" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14m-7-7 7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Empty State -->
        <div id="tools-empty-state" class="tools-empty-state hidden">
          <div class="empty-icon-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.637 10.637Z" />
            </svg>
          </div>
          <h3 class="empty-title">No tools found</h3>
          <p class="empty-desc">We couldn't find any tools matching your search criteria. Try using different keywords or resetting your category filter.</p>
          <button type="button" id="reset-filters-btn" class="btn-reset-filters">
            Reset Filters
          </button>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .all-tools-page {
    background: var(--color-bg, #ffffff);
    min-height: 80vh;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    transition: background 0.2s ease;
  }

  .page-container {
    max-width: 1240px;
    margin: 0 auto;
    padding-left: clamp(1rem, 3vw, 2rem);
    padding-right: clamp(1rem, 3vw, 2rem);
  }

  /* 1. Header */
  .page-header {
    max-width: 760px;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header-pill {
    display: inline-block;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    background: var(--color-bg-subtle, #eef2ff);
    color: var(--color-brand, #4f46e5);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid var(--color-border, #e0e7ff);
    box-shadow: 0 1px 3px rgba(79, 70, 229, 0.08);
  }

  :global([data-theme="dark"]) .header-pill {
    background: rgba(99, 102, 241, 0.2);
    color: #a5b4fc;
    border-color: rgba(99, 102, 241, 0.3);
    box-shadow: none;
  }

  .page-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    color: var(--color-text, #0f172a);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem 0;
  }

  .text-purple-highlight {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global([data-theme="dark"]) .text-purple-highlight {
    background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    font-size: clamp(0.95rem, 1.5vw, 1.075rem);
    line-height: 1.6;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  /* 2. Category Cards (6 Cards matching reference) */
  .section-categories {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .categories-grid-6 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 480px) {
    .categories-grid-6 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .categories-grid-6 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .categories-grid-6 {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .category-pastel-card {
    padding: 1.5rem 1.15rem;
    border-radius: 14px;
    border: 1px solid transparent;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .category-pastel-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px var(--color-shadow-hover, rgba(15, 23, 42, 0.06));
  }

  .category-pastel-card.active {
    box-shadow: 0 0 0 2px var(--color-brand, #4f46e5), 0 8px 20px rgba(79, 70, 229, 0.15);
    transform: translateY(-2px);
  }

  :global([data-theme="dark"]) .category-pastel-card {
    background-color: var(--color-bg-card, #2B2D30) !important;
    border-color: var(--color-border, #41444A) !important;
  }

  :global([data-theme="dark"]) .category-pastel-card:hover {
    background-color: var(--color-bg-card-hover, #33363B) !important;
    border-color: var(--color-border-hover, #5A5E66) !important;
  }

  :global([data-theme="dark"]) .category-pastel-card.active {
    border-color: var(--color-brand-light, #818cf8) !important;
    box-shadow: 0 0 0 2px #818cf8, 0 8px 20px rgba(99, 102, 241, 0.25);
  }

  .category-icon-square {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    margin-bottom: 1.15rem;
    flex-shrink: 0;
  }

  .category-svg-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-card-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 0 0 0.35rem 0;
  }

  .category-card-desc {
    font-size: 0.775rem;
    line-height: 1.4;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  /* 3. Filters Panel */
  .section-filters {
    margin-bottom: 2rem;
  }

  .filters-panel {
    background: var(--color-bg-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 2px 8px var(--color-shadow, rgba(15, 23, 42, 0.03));
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .search-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .search-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .search-input-box {
    position: relative;
    flex: 1 1 auto;
    max-width: 580px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-subtle, #94a3b8);
    pointer-events: none;
  }

  .tools-search-input {
    width: 100%;
    height: 46px;
    padding: 0 2.5rem 0 2.75rem;
    background: var(--color-bg-input, #f8fafc);
    border: 1px solid var(--color-border, #cbd5e1);
    border-radius: 10px;
    font-size: 16px; /* Prevents iOS auto-zoom */
    color: var(--color-text, #0f172a);
    transition: all 0.2s ease;
    outline: none;
    box-sizing: border-box;
  }

  .tools-search-input:focus {
    background: var(--color-bg-card, #ffffff);
    border-color: var(--color-brand, #4f46e5);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }

  .tools-search-input::placeholder {
    color: var(--color-text-subtle, #94a3b8);
    font-size: 0.9rem;
  }

  .search-clear-btn {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-bg-subtle, #e2e8f0);
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-muted, #64748b);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .search-clear-btn:hover {
    background: var(--color-border-hover, #cbd5e1);
    color: var(--color-text, #0f172a);
  }

  .results-count-wrap {
    flex-shrink: 0;
  }

  .results-count-text {
    font-size: 0.875rem;
    color: var(--color-text-muted, #64748b);
  }

  .results-count-text strong {
    color: var(--color-text, #0f172a);
  }

  .filter-tabs-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .filter-tabs-row::-webkit-scrollbar {
    display: none;
  }

  .filter-tab-pill {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background: var(--color-bg-subtle, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text-muted, #64748b);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .filter-tab-pill:hover {
    border-color: var(--color-border-hover, #cbd5e1);
    color: var(--color-text, #0f172a);
  }

  .filter-tab-pill.active {
    background: var(--color-brand, #4f46e5);
    border-color: var(--color-brand, #4f46e5);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(79, 70, 229, 0.25);
  }

  /* 4. Tools Directory Grid */
  .tools-directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 520px) {
    .tools-directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 820px) {
    .tools-directory-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .tools-directory-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tool-item-card {
    background: var(--color-bg-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 1.35rem 1.25rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
    position: relative;
    box-sizing: border-box;
  }

  .tool-item-card:hover {
    border-color: var(--color-border-hover, #cbd5e1);
    background: var(--color-bg-card-hover, #f8fafc);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px var(--color-shadow-hover, rgba(15, 23, 42, 0.06));
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .tool-icon-square {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
  }

  .tool-svg-box {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tool-svg-box :global(svg) {
    width: 20px;
    height: 20px;
  }

  .tool-badge-pill {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    letter-spacing: 0.02em;
  }

  .badge-youtube { background: #fee2e2; color: #dc2626; }
  .badge-instagram { background: #fce7f3; color: #db2777; }
  .badge-tiktok { background: #f1f5f9; color: #0f172a; }
  .badge-image { background: #dcfce7; color: #059669; }
  .badge-seo { background: #dbeafe; color: #1d4ed8; }
  .badge-general { background: #fef3c7; color: #b45309; }

  :global([data-theme="dark"]) .badge-youtube { background: rgba(239, 68, 68, 0.2); color: #f87171; }
  :global([data-theme="dark"]) .badge-instagram { background: rgba(236, 72, 153, 0.2); color: #f472b6; }
  :global([data-theme="dark"]) .badge-tiktok { background: #33363B; color: #F1F3F4; }
  :global([data-theme="dark"]) .badge-image { background: rgba(16, 185, 129, 0.2); color: #34d399; }
  :global([data-theme="dark"]) .badge-seo { background: rgba(37, 99, 235, 0.2); color: #60a5fa; }
  :global([data-theme="dark"]) .badge-general { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }

  .tool-card-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    line-height: 1.35;
    margin: 0 0 0.4rem 0;
  }

  .tool-card-desc {
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--color-text-muted, #64748b);
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .tool-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle, #f1f5f9);
  }

  .tool-action-text {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-brand, #4f46e5);
    transition: color 0.15s ease;
  }

  :global([data-theme="dark"]) .tool-action-text {
    color: var(--color-brand-light, #818cf8);
  }

  .tool-arrow-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-bg-subtle, #f1f5f9);
    color: var(--color-text-muted, #64748b);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease, color 0.15s ease;
  }

  .tool-item-card:hover .tool-arrow-circle {
    background: rgba(99, 102, 241, 0.2);
    color: var(--color-brand-light, #818cf8);
    transform: translateX(3px);
  }

  /* Empty State */
  .tools-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
    background: var(--color-bg-card, #f8fafc);
    border: 1px dashed var(--color-border, #cbd5e1);
    border-radius: 16px;
    margin: 1rem 0;
  }

  .empty-icon-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-brand, #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  :global([data-theme="dark"]) .empty-icon-circle {
    background: rgba(99, 102, 241, 0.25);
    color: var(--color-brand-light, #818cf8);
  }

  .empty-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 0 0 0.5rem 0;
  }

  .empty-desc {
    max-width: 440px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted, #64748b);
    margin: 0 0 1.5rem 0;
  }

  .btn-reset-filters {
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    background: var(--color-brand, #4f46e5);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
    font-family: inherit;
  }

  .btn-reset-filters:hover {
    background: var(--color-brand-hover, #4338ca);
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  function setupToolsDirectory() {
    const searchInput = document.getElementById('tools-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-clear-btn');
    const tabs = document.querySelectorAll('.filter-tab-pill');
    const catCards = document.querySelectorAll('.category-pastel-card');
    const cards = document.querySelectorAll('.tool-item-card');
    const emptyState = document.getElementById('tools-empty-state');
    const resultsCountEl = document.getElementById('results-count');
    const resetBtn = document.getElementById('reset-filters-btn');

    if (!searchInput) return;

    let activeCategory = 'all';
    let searchQuery = '';

    function filterTools() {
      let visibleCount = 0;

      cards.forEach(cardEl => {
        const card = cardEl as HTMLElement;
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const cat = card.getAttribute('data-category') || '';

        const matchesQuery = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);
        const matchesCategory = activeCategory === 'all' || cat === activeCategory;

        if (matchesQuery && matchesCategory) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update count text
      if (resultsCountEl) {
        if (visibleCount === cards.length) {
          resultsCountEl.innerHTML = `Showing <strong>${visibleCount}</strong> tools`;
        } else {
          resultsCountEl.innerHTML = `Found <strong>${visibleCount}</strong> of ${cards.length} tools`;
        }
      }

      // Empty state
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }

      // Clear button visibility
      if (clearBtn) {
        if (searchQuery.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    function setCategory(catKey: string, updateUrl: boolean = true) {
      activeCategory = catKey;

      // Update tabs
      tabs.forEach(t => {
        const key = t.getAttribute('data-tab-key');
        if (key === catKey) {
          t.classList.add('active');
          t.setAttribute('aria-selected', 'true');
        } else {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        }
      });

      // Update category cards highlight
      catCards.forEach(c => {
        const key = c.getAttribute('data-cat-trigger');
        if (key === catKey) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });

      // Update URL query parameter without full reload
      if (updateUrl && typeof window !== 'undefined') {
        const url = new URL(window.location.href);
        if (catKey !== 'all') {
          url.searchParams.set('category', catKey);
        } else {
          url.searchParams.delete('category');
        }
        window.history.replaceState({}, '', url.toString());
      }

      filterTools();
    }

    function resetFilters() {
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      setCategory('all');
      if (typeof window !== 'undefined') {
        const url = new URL(window.location.href);
        url.search = '';
        window.history.replaceState({}, '', url.toString());
      }
    }

    // Category Card clicks
    catCards.forEach(c => {
      c.addEventListener('click', () => {
        const key = c.getAttribute('data-cat-trigger') || 'all';
        if (activeCategory === key) {
          setCategory('all');
        } else {
          setCategory(key);
          // Scroll smoothly to filter section
          const toolsSec = document.getElementById('tools-section');
          if (toolsSec) {
            toolsSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    // Filter tab clicks
    tabs.forEach(t => {
      t.addEventListener('click', () => {
        const key = t.getAttribute('data-tab-key') || 'all';
        setCategory(key);
      });
    });

    // Search input typing
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      filterTools();
    });

    // Clear search
    clearBtn?.addEventListener('click', () => {
      searchQuery = '';
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      filterTools();
    });

    // Reset button in empty state
    resetBtn?.addEventListener('click', resetFilters);

    // Keyboard support: Escape clears search
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchQuery = '';
        searchInput.value = '';
        filterTools();
      }
    });

    // Handle initial URL parameters (?category=..., ?cat=..., ?q=...)
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category') || urlParams.get('cat');
    const queryParam = urlParams.get('q');

    if (queryParam) {
      searchInput.value = queryParam;
      searchQuery = queryParam.toLowerCase().trim();
    }

    if (categoryParam) {
      const normalizedCat = categoryParam.toLowerCase();
      const validKeys = ['youtube', 'instagram', 'tiktok', 'image', 'seo', 'general'];
      if (validKeys.includes(normalizedCat)) {
        setCategory(normalizedCat, false);
      } else {
        filterTools();
      }
    } else {
      filterTools();
    }
  }

  setupToolsDirectory();
  document.addEventListener('astro:after-swap', setupToolsDirectory);
</script>

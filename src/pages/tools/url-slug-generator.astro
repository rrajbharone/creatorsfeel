</style>

<script>
  const setupUrlSlugGenerator = () => {
    const valueInput = document.getElementById('value-input') as HTMLInputElement;
    const separatorSelect = document.getElementById('separator-input') as HTMLSelectElement;
    const stopWordsCheck = document.getElementById('stop-words-check') as HTMLInputElement;
    const numbersCheck = document.getElementById('numbers-check') as HTMLInputElement;

    // Actions
    const generateBtn = document.getElementById('generate-btn');
    const resetBtn = document.getElementById('calc-reset-btn');

    // Result Elements
    const slugOutput = document.getElementById('slug-output') as HTMLTextAreaElement;
    const slugCounter = document.getElementById('slug-counter');
    const slugStatusText = document.getElementById('slug-status-text');
    const slugWordCount = document.getElementById('slug-word-count');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const copySlugBtn = document.getElementById('copy-slug-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const clearSlugBtn = document.getElementById('clear-slug-btn');

    // Common Stop Words
    const STOP_WORDS = new Set([
      'a', 'about', 'above', 'after', 'again', 'against', 'all', 'am', 'an', 'and', 'any', 'are', 'arent',
      'as', 'at', 'be', 'because', 'been', 'before', 'being', 'below', 'between', 'both', 'but', 'by',
      'cant', 'cannot', 'could', 'couldnt', 'did', 'didnt', 'do', 'does', 'doesnt', 'doing', 'dont',
      'down', 'during', 'each', 'few', 'for', 'from', 'further', 'had', 'hadnt', 'has', 'hasnt', 'have',
      'havent', 'having', 'he', 'hed', 'hell', 'hes', 'her', 'here', 'heres', 'hers', 'herself', 'him',
      'himself', 'his', 'how', 'hows', 'i', 'id', 'ill', 'im', 'ive', 'if', 'in', 'into', 'is', 'isnt',
      'it', 'its', 'itself', 'lets', 'me', 'more', 'most', 'mustnt', 'my', 'myself', 'no', 'nor', 'not',
      'of', 'off', 'on', 'once', 'only', 'or', 'other', 'ought', 'our', 'ours', 'ourselves', 'out', 'over',
      'own', 'same', 'shant', 'she', 'shed', 'shell', 'shes', 'should', 'shouldnt', 'so', 'some', 'such',
      'than', 'that', 'thats', 'the', 'their', 'theirs', 'them', 'themselves', 'then', 'there', 'theres',
      'these', 'they', 'theyd', 'theyll', 'theyre', 'theyve', 'this', 'those', 'through', 'to', 'too',
      'under', 'until', 'up', 'very', 'was', 'wasnt', 'we', 'wed', 'well', 'were', 'weve', 'werent',
      'what', 'whats', 'when', 'whens', 'where', 'wheres', 'which', 'while', 'who', 'whos', 'whom',
      'why', 'whys', 'with', 'wont', 'would', 'wouldnt', 'you', 'youd', 'youll', 'youre', 'youve',
      'your', 'yours', 'yourself', 'yourselves'
    ]);

    // Sanitization logic
    const slugify = (text: string, sep: string, removeStop: boolean, removeNum: boolean): string => {
      // 1. Lowercase & Normalize diacritics / accented characters
      let str = text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

      // 2. Remove special characters (keep words, spaces, hyphens)
      str = str.replace(/[^a-z0-9\s-]/g, '');

      // 3. Split into words
      let words = str.split(/\s+/).filter(w => w.length > 0);

      // 4. Filter stop words
      if (removeStop) {
        words = words.filter(w => !STOP_WORDS.has(w));
      }

      // 5. Filter numbers
      if (removeNum) {
        words = words.filter(w => !/^\d+$/.test(w));
      }

      // 6. Join using chosen separator
      return words.join(sep);
    };

    // Update health & indicators
    const updateSlugHealth = () => {
      const text = slugOutput?.value || '';
      const len = text.length;
      const sep = separatorSelect?.value || '-';
      const words = text ? text.split(new RegExp(`[\\s\\${sep}]+`)).filter(Boolean) : [];
      const wordCount = words.length;

      // Update counters
      if (slugCounter) {
        slugCounter.textContent = `${len} / 60 chars`;
        if (len > 80) {
          slugCounter.style.color = '#ef4444';
        } else if (len > 60) {
          slugCounter.style.color = '#f59e0b';
        } else {
          slugCounter.style.color = 'var(--color-text-muted)';
        }
      }

      if (slugWordCount) {
        slugWordCount.textContent = `${wordCount} ${wordCount === 1 ? 'word' : 'words'}`;
      }

      // Update progress bar & status text
      if (progressBarFill) {
        const percent = Math.min((len / 60) * 100, 100);
        progressBarFill.style.width = `${percent}%`;

        if (len === 0) {
          progressBarFill.style.backgroundColor = 'var(--color-brand)';
          if (slugStatusText) slugStatusText.textContent = 'Enter text to generate an SEO slug';
        } else if (len > 80) {
          progressBarFill.style.backgroundColor = '#ef4444';
          if (slugStatusText) slugStatusText.textContent = 'Slug is quite long (over 80 chars) — consider shortening';
        } else if (len > 60) {
          progressBarFill.style.backgroundColor = '#f59e0b';
          if (slugStatusText) slugStatusText.textContent = 'Slug is slightly long (over 60 chars)';
        } else {
          progressBarFill.style.backgroundColor = '#10b981';
          if (slugStatusText) slugStatusText.textContent = 'Optimal SEO length (under 60 characters)';
        }
      }
    };

    // Generate slug from input fields
    const generateSlug = () => {
      const val = (valueInput?.value || '').trim();
      const sep = separatorSelect?.value || '-';
      const removeStop = stopWordsCheck?.checked || false;
      const removeNum = numbersCheck?.checked || false;

      if (!val) {
        if (slugOutput) slugOutput.value = '';
        updateSlugHealth();
        return;
      }

      const result = slugify(val, sep, removeStop, removeNum);
      if (slugOutput) {
        slugOutput.value = result;
      }
      updateSlugHealth();
    };

    // Event listeners for real-time reactivity
    valueInput?.addEventListener('input', generateSlug);
    separatorSelect?.addEventListener('change', generateSlug);
    stopWordsCheck?.addEventListener('change', generateSlug);
    numbersCheck?.addEventListener('change', generateSlug);

    // Direct edit in the output area
    slugOutput?.addEventListener('input', updateSlugHealth);

    // Explicit button trigger
    generateBtn?.addEventListener('click', generateSlug);

    // Copy to clipboard
    copySlugBtn?.addEventListener('click', () => {
      const text = slugOutput?.value || '';
      if (!text) {
        return;
      }

      navigator.clipboard.writeText(text).then(() => {
        if (copyBtnText) {
          const originalText = copyBtnText.textContent;
          copyBtnText.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copyBtnText.textContent = originalText;
          }, 2000);
        }
      });
    });

    // Clear slug
    clearSlugBtn?.addEventListener('click', () => {
      if (slugOutput) {
        slugOutput.value = '';
        updateSlugHealth();
      }
    });

    // Reset all fields
    resetBtn?.addEventListener('click', () => {
      if (valueInput) valueInput.value = '';
      if (separatorSelect) separatorSelect.value = '-';
      if (stopWordsCheck) stopWordsCheck.checked = false;
      if (numbersCheck) numbersCheck.checked = false;
      if (slugOutput) slugOutput.value = '';
      updateSlugHealth();
    });

    // Initialize on page load
    generateSlug();
  };

  setupUrlSlugGenerator();
  document.addEventListener('astro:after-swap', setupUrlSlugGenerator);
</script>

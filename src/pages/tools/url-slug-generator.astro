<script>
  const setupSlugGenerator = () => {
    const slugInput = document.getElementById('slug-input') as HTMLInputElement | null;
    const slugOutput = document.getElementById('slug-output') as HTMLInputElement | null;
    const charCountEl = document.getElementById('char-count');
    const wordCountEl = document.getElementById('word-count');
    const lengthPill = document.getElementById('length-pill');
    const statusMsg = document.getElementById('status-message');
    const btnCopy = document.getElementById('btn-copy-slug');
    const copyBtnText = document.getElementById('copy-btn-text');
    const btnClear = document.getElementById('btn-clear');
    const btnPaste = document.getElementById('btn-paste');

    if (!slugInput || !slugOutput) return;

    // Pure, client-side, Unicode-aware slugification function
    const slugify = (text: string): string => {
      if (!text) return '';
      let str = text.trim();
      // 1. Unicode NFD normalization to safely strip diacritical marks (e.g. accents)
      str = str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      // 2. Convert to lowercase
      str = str.toLowerCase();
      // 3. Strip apostrophes/quotes so don't -> dont
      str = str.replace(/['’`"]/g, '');
      // 4. Replace any non-letter, non-number character with space
      str = str.replace(/[^\p{L}\p{N}\s\-_]+/gu, ' ');
      // 5. Replace any whitespace/hyphens/underscores sequence with single hyphen
      str = str.replace(/[\s\-_]+/g, '-');
      // 6. Trim leading and trailing hyphens
      str = str.replace(/^-+|-+$/g, '');
      return str;
    };

    const updateGenerator = () => {
      const rawText = slugInput.value;
      const slug = slugify(rawText);
      slugOutput.value = slug;

      const charLen = slug.length;
      const words = slug ? slug.split('-').filter(Boolean) : [];
      const wordLen = words.length;

      if (charCountEl) charCountEl.textContent = String(charLen);
      if (wordCountEl) wordCountEl.textContent = String(wordLen);

      // Update length pill and status message
      if (lengthPill && statusMsg) {
        if (charLen === 0) {
          lengthPill.className = 'length-pill pill-optimal';
          lengthPill.textContent = 'Ready';
          statusMsg.textContent = 'Enter text above to generate an SEO slug';
        } else if (charLen <= 60) {
          lengthPill.className = 'length-pill pill-optimal';
          lengthPill.textContent = 'Optimal Length';
          statusMsg.textContent = 'Optimal SEO length (recommended under 60 characters)';
        } else if (charLen <= 80) {
          lengthPill.className = 'length-pill pill-moderate';
          lengthPill.textContent = 'Moderate Length';
          statusMsg.textContent = 'Slightly long (between 60 and 80 characters)';
        } else {
          lengthPill.className = 'length-pill pill-long';
          lengthPill.textContent = 'Long Slug';
          statusMsg.textContent = 'Slug is quite long (over 80 characters) — consider shortening';
        }
      }
    };

    // Live reactivity on input, keyup, change
    slugInput.addEventListener('input', updateGenerator);
    slugInput.addEventListener('keyup', updateGenerator);
    slugInput.addEventListener('change', updateGenerator);

    // Paste quick button
    btnPaste?.addEventListener('click', async () => {
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const text = await navigator.clipboard.readText();
          if (text) {
            slugInput.value = text;
            updateGenerator();
            slugInput.focus();
          }
        } else {
          slugInput.focus();
        }
      } catch {
        slugInput.focus();
      }
    });

    // Copy to clipboard button
    btnCopy?.addEventListener('click', async () => {
      const slugToCopy = slugOutput.value.trim();
      if (!slugToCopy) {
        btnCopy.classList.add('empty-alert');
        if (copyBtnText) copyBtnText.textContent = 'Nothing to Copy';
        setTimeout(() => {
          btnCopy.classList.remove('empty-alert');
          if (copyBtnText) copyBtnText.textContent = 'Copy Slug';
        }, 1500);
        return;
      }

      try {
        await navigator.clipboard.writeText(slugToCopy);
        btnCopy.classList.add('copied');
        if (copyBtnText) copyBtnText.textContent = 'Copied to Clipboard!';
        setTimeout(() => {
          btnCopy.classList.remove('copied');
          if (copyBtnText) copyBtnText.textContent = 'Copy Slug';
        }, 2000);
      } catch {
        // Fallback selection
        slugOutput.select();
        document.execCommand('copy');
        btnCopy.classList.add('copied');
        if (copyBtnText) copyBtnText.textContent = 'Copied!';
        setTimeout(() => {
          btnCopy.classList.remove('copied');
          if (copyBtnText) copyBtnText.textContent = 'Copy Slug';
        }, 2000);
      }
    });

    // Clear button
    btnClear?.addEventListener('click', () => {
      slugInput.value = '';
      updateGenerator();
      slugInput.focus();
    });

    // Run initial generation on page mount
    updateGenerator();
  };

  setupSlugGenerator();
  document.addEventListener('astro:after-swap', setupSlugGenerator);
</script>

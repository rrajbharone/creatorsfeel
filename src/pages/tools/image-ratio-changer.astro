  }

  .faq-body {
    padding: 0 1.25rem 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .faq-body p {
    margin: 0;
  }

  /* =========================================================
     RESPONSIVE BREAKPOINTS (320px to 860px)
     ========================================================= */
  @media (max-width: 600px) {
    .card-header-bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .meta-strip {
      flex-direction: column;
      align-items: flex-start;
    }

    .meta-strip-actions {
      width: 100%;
      justify-content: flex-end;
    }

    .mode-tabs {
      grid-template-columns: 1fr;
    }

    .stage-controls-bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .zoom-control-group, .align-control-group {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 430px) {
    .saas-tool-card {
      padding: 0.85rem 0.75rem;
    }

    .dropzone {
      padding: 1.5rem 0.75rem;
      min-height: 220px;
    }

    .btn-select-file {
      width: 100%;
      justify-content: center;
    }

    .ratios-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  interface RatioPreset {
    id: string;
    label: string;
    ratio: number; // width / height
    use: string;
  }

  const ratioPresets: Record<string, RatioPreset> = {
    '1:1': { id: '1:1', label: '1:1', ratio: 1.0, use: 'Square' },
    '4:5': { id: '4:5', label: '4:5', ratio: 4 / 5, use: 'IG Post' },
    '9:16': { id: '9:16', label: '9:16', ratio: 9 / 16, use: 'Reels / Shorts' },
    '16:9': { id: '16:9', label: '16:9', ratio: 16 / 9, use: 'YouTube' },
    '3:2': { id: '3:2', label: '3:2', ratio: 3 / 2, use: 'Classic' },
    '2:3': { id: '2:3', label: '2:3', ratio: 2 / 3, use: 'Portrait' },
    '4:3': { id: '4:3', label: '4:3', ratio: 4 / 3, use: 'Standard' },
    '5:4': { id: '5:4', label: '5:4', ratio: 5 / 4, use: 'Print' },
    '21:9': { id: '21:9', label: '21:9', ratio: 21 / 9, use: 'Cinema' }
  };

  document.addEventListener('DOMContentLoaded', () => {
    // DOM Elements - Upload & Containers
    const fileInput = document.getElementById('image-file-input') as HTMLInputElement | null;
    const dropzone = document.getElementById('dropzone');
    const btnBrowseTrigger = document.getElementById('btn-browse-trigger');
    const uploadZoneWrapper = document.getElementById('upload-zone-wrapper');
    const studioWorkspace = document.getElementById('studio-workspace');

    // Error Alert
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');
    const btnCloseError = document.getElementById('btn-close-error');

    // Metadata Strip
    const stripFilename = document.getElementById('strip-filename');
    const stripDims = document.getElementById('strip-dims');
    const stripRatio = document.getElementById('strip-ratio');
    const stripSize = document.getElementById('strip-size');
    const btnChangeImage = document.getElementById('btn-change-image');
    const btnRemoveImage = document.getElementById('btn-remove-image');

    // Preview Stage
    const previewCanvas = document.getElementById('preview-canvas') as HTMLCanvasElement | null;
    const canvasViewport = document.getElementById('canvas-viewport');
    const stageBadgeRatio = document.getElementById('stage-badge-ratio');
    const stageBadgeDims = document.getElementById('stage-badge-dims');
    const dragHint = document.getElementById('drag-hint');
    const zoomSlider = document.getElementById('zoom-slider') as HTMLInputElement | null;
    const zoomValueText = document.getElementById('zoom-value');
    const btnZoomOut = document.getElementById('btn-zoom-out');
    const btnZoomIn = document.getElementById('btn-zoom-in');
    const alignButtons = document.querySelectorAll('.btn-align');

    // Mode Buttons
    const modeCropBtn = document.getElementById('mode-crop');
    const modeFitBtn = document.getElementById('mode-fit');
    const bgOptionsPanel = document.getElementById('bg-options-panel');
    const bgSwatchBtns = document.querySelectorAll('.bg-swatch-btn');
    const customColorPicker = document.getElementById('custom-color-picker') as HTMLInputElement | null;
    const colorPickerIndicator = document.getElementById('color-picker-indicator');

    // Ratio Selection
    const ratioButtons = document.querySelectorAll('.ratio-pill-btn');
    const activeRatioName = document.getElementById('active-ratio-name');
    const customRatioRow = document.getElementById('custom-ratio-row');
    const customW = document.getElementById('custom-w') as HTMLInputElement | null;
    const customH = document.getElementById('custom-h') as HTMLInputElement | null;

    // Export Settings & Download
    const exportFormat = document.getElementById('export-format') as HTMLSelectElement | null;
    const exportQuality = document.getElementById('export-quality') as HTMLSelectElement | null;
    const qualitySelectGroup = document.getElementById('quality-select-group');
    const finalDimsText = document.getElementById('final-dims-text');
    const btnDownload = document.getElementById('btn-download');
    const downloadBtnText = document.getElementById('download-btn-text');
    const btnResetSettings = document.getElementById('btn-reset-settings');

    if (!fileInput || !dropzone || !previewCanvas) return;

    // State Variables
    let loadedImage: HTMLImageElement | null = null;
    let originalFile: File | null = null;
    let activeObjectUrl: string | null = null;

    let currentMode: 'crop' | 'fit' = 'crop';
    let currentRatioKey: string = '16:9';
    let currentTargetRatio: number = 16 / 9; // width / height
    let currentBgColor: string = 'transparent'; // 'transparent', '#ffffff', '#000000', 'blur', hex
    let currentZoom: number = 1.0; // 1.0 to 2.5
    let panOffsetX: number = 0; // pixel offset within output coordinates
    let panOffsetY: number = 0;

    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragStartPanX = 0;
    let dragStartPanY = 0;

    // Helper: Revoke blob memory
    function cleanupObjectUrl() {
      if (activeObjectUrl) {
        URL.revokeObjectURL(activeObjectUrl);
        activeObjectUrl = null;
      }
    }

    // Helper: Errors
    function showError(msg: string) {
      if (errorMessage) errorMessage.textContent = msg;
      if (errorBanner) errorBanner.style.display = 'flex';
    }

    function hideError() {
      if (errorBanner) errorBanner.style.display = 'none';
    }

    if (btnCloseError) btnCloseError.addEventListener('click', hideError);

    // Helpers: Formatting
    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    function getGcd(a: number, b: number): number {
      return b === 0 ? a : getGcd(b, a % b);
    }

    function getAspectRatioLabel(w: number, h: number): string {
      const gcd = getGcd(w, h);
      const rW = w / gcd;
      const rH = h / gcd;
      if (rW <= 30 && rH <= 30) return `${rW}:${rH}`;
      return `${(w / h).toFixed(2)}:1`;
    }

    // Trigger File Picker
    if (btnBrowseTrigger) {
      btnBrowseTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        fileInput.click();
      });
    }

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    if (btnChangeImage) btnChangeImage.addEventListener('click', () => fileInput.click());
    if (btnRemoveImage) btnRemoveImage.addEventListener('click', resetAll);

    // Drag & Drop
    ['dragenter', 'dragover'].forEach(evt => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach(evt => {
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dragover');
      });
    });

    dropzone.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        processSelectedFile(dt.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        processSelectedFile(fileInput.files[0]);
      }
    });

    // File Processing
    function processSelectedFile(file: File) {
      hideError();
      if (!file) return;

      const maxSizeBytes = 50 * 1024 * 1024;
      if (file.size > maxSizeBytes) {
        showError('File exceeds the 50 MB limit. Please select an image under 50 MB.');
        return;
      }

      const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/avif'];
      const ext = file.name.split('.').pop()?.toLowerCase() || '';
      const validExts = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'avif'];

      if ((file.type && !validTypes.includes(file.type)) && !validExts.includes(ext)) {
        showError('Unsupported file format. Please upload a JPG, PNG, WebP, AVIF, or GIF.');
        return;
      }

      cleanupObjectUrl();
      const objectUrl = URL.createObjectURL(file);
      activeObjectUrl = objectUrl;

      const img = new Image();
      img.onload = () => {
        const w = img.naturalWidth || img.width;
        const h = img.naturalHeight || img.height;
        if (!w || !h) {
          showError('Could not decode image dimensions. File may be corrupted.');
          return;
        }

        loadedImage = img;
        originalFile = file;

        // Populate Metadata Strip
        if (stripFilename) {
          stripFilename.textContent = file.name;
          stripFilename.title = file.name;
        }
        if (stripDims) stripDims.textContent = `${w} × ${h} px`;
        if (stripRatio) stripRatio.textContent = getAspectRatioLabel(w, h);
        if (stripSize) stripSize.textContent = formatBytes(file.size);

        // Reset Settings for New Image
        currentZoom = 1.0;
        panOffsetX = 0;
        panOffsetY = 0;
        if (zoomSlider) zoomSlider.value = '100';
        if (zoomValueText) zoomValueText.textContent = '100%';

        // If current ratio is original, update targetRatio to image's ratio
        if (currentRatioKey === 'original') {
          currentTargetRatio = w / h;
        }

        // Show Workspace
        if (uploadZoneWrapper) uploadZoneWrapper.style.display = 'none';
        if (studioWorkspace) studioWorkspace.style.display = 'flex';

        updateStudio();
      };

      img.onerror = () => {
        showError('Failed to load image. The file appears to be corrupted or invalid.');
      };

      img.src = objectUrl;
    }

    // Reset All
    function resetAll() {
      cleanupObjectUrl();
      loadedImage = null;
      originalFile = null;
      currentMode = 'crop';
      currentRatioKey = '16:9';
      currentTargetRatio = 16 / 9;
      currentBgColor = 'transparent';
      currentZoom = 1.0;
      panOffsetX = 0;
      panOffsetY = 0;

      if (fileInput) fileInput.value = '';
      hideError();

      if (studioWorkspace) studioWorkspace.style.display = 'none';
      if (uploadZoneWrapper) uploadZoneWrapper.style.display = 'block';
    }

    if (btnResetSettings) {
      btnResetSettings.addEventListener('click', () => {
        currentZoom = 1.0;
        panOffsetX = 0;
        panOffsetY = 0;
        if (zoomSlider) zoomSlider.value = '100';
        if (zoomValueText) zoomValueText.textContent = '100%';
        updateStudio();
      });
    }

    // Mode Buttons (Crop vs Fit)
    if (modeCropBtn && modeFitBtn) {
      modeCropBtn.addEventListener('click', () => {
        if (currentMode === 'crop') return;
        currentMode = 'crop';
        modeCropBtn.classList.add('active');
        modeFitBtn.classList.remove('active');
        if (bgOptionsPanel) bgOptionsPanel.style.display = 'none';
        if (dragHint) dragHint.style.display = 'flex';
        panOffsetX = 0;
        panOffsetY = 0;
        updateStudio();
      });

      modeFitBtn.addEventListener('click', () => {
        if (currentMode === 'fit') return;
        currentMode = 'fit';
        modeFitBtn.classList.add('active');
        modeCropBtn.classList.remove('active');
        if (bgOptionsPanel) bgOptionsPanel.style.display = 'flex';
        if (dragHint) dragHint.style.display = 'none';
        panOffsetX = 0;
        panOffsetY = 0;
        updateStudio();
      });
    }

    // Background Swatches (Fit Mode)
    bgSwatchBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        bgSwatchBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const color = btn.getAttribute('data-color') || 'transparent';
        currentBgColor = color;
        updateStudio();
      });
    });

    if (customColorPicker) {
      customColorPicker.addEventListener('input', () => {
        bgSwatchBtns.forEach(b => b.classList.remove('active'));
        currentBgColor = customColorPicker.value;
        if (colorPickerIndicator) colorPickerIndicator.style.background = customColorPicker.value;
        updateStudio();
      });
    }

    // Ratio Pill Buttons
    ratioButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        ratioButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const rKey = btn.getAttribute('data-ratio') || '16:9';
        currentRatioKey = rKey;

        if (rKey === 'custom') {
          if (customRatioRow) customRatioRow.style.display = 'flex';
          const w = parseFloat(customW?.value || '2') || 2;
          const h = parseFloat(customH?.value || '1') || 1;
          currentTargetRatio = w / h;
          if (activeRatioName) activeRatioName.textContent = `Custom (${w}:${h})`;
        } else {
          if (customRatioRow) customRatioRow.style.display = 'none';
          if (rKey === 'original') {
            const imgW = loadedImage?.naturalWidth || 1;
            const imgH = loadedImage?.naturalHeight || 1;
            currentTargetRatio = imgW / imgH;
            if (activeRatioName) activeRatioName.textContent = `Original (${getAspectRatioLabel(imgW, imgH)})`;
          } else {
            const preset = ratioPresets[rKey];
            if (preset) {
              currentTargetRatio = preset.ratio;
              if (activeRatioName) activeRatioName.textContent = `${preset.label} ${preset.use}`;
            }
          }
        }

        panOffsetX = 0;
        panOffsetY = 0;
        updateStudio();
      });
    });

    // Custom Ratio Number Inputs
    if (customW && customH) {
      [customW, customH].forEach(input => {
        input.addEventListener('input', () => {
          if (currentRatioKey === 'custom') {
            const w = Math.max(1, parseFloat(customW.value) || 1);
            const h = Math.max(1, parseFloat(customH.value) || 1);
            currentTargetRatio = w / h;
            if (activeRatioName) activeRatioName.textContent = `Custom (${w}:${h})`;
            panOffsetX = 0;
            panOffsetY = 0;
            updateStudio();
          }
        });
      });
    }

    // Zoom Controls
    if (zoomSlider) {
      zoomSlider.addEventListener('input', () => {
        currentZoom = parseFloat(zoomSlider.value) / 100;
        if (zoomValueText) zoomValueText.textContent = `${zoomSlider.value}%`;
        clampPanOffsets();
        updateStudio();
      });
    }

    if (btnZoomOut && zoomSlider) {
      btnZoomOut.addEventListener('click', () => {
        let val = Math.max(100, parseInt(zoomSlider.value, 10) - 10);
        zoomSlider.value = val.toString();
        currentZoom = val / 100;
        if (zoomValueText) zoomValueText.textContent = `${val}%`;
        clampPanOffsets();
        updateStudio();
      });
    }

    if (btnZoomIn && zoomSlider) {
      btnZoomIn.addEventListener('click', () => {
        let val = Math.min(250, parseInt(zoomSlider.value, 10) + 10);
        zoomSlider.value = val.toString();
        currentZoom = val / 100;
        if (zoomValueText) zoomValueText.textContent = `${val}%`;
        clampPanOffsets();
        updateStudio();
      });
    }

    // Quick Alignment Buttons
    alignButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const align = btn.getAttribute('data-align') || 'center';
        snapAlignment(align);
      });
    });

    function snapAlignment(align: string) {
      if (!loadedImage) return;
      const dims = computeTargetCanvasDimensions();
      const outW = dims.outW;
      const outH = dims.outH;
      const imgW = loadedImage.naturalWidth || loadedImage.width;
      const imgH = loadedImage.naturalHeight || loadedImage.height;

      if (currentMode === 'crop') {
        const baseScale = Math.max(outW / imgW, outH / imgH);
        const scale = baseScale * currentZoom;
        const drawW = imgW * scale;
        const drawH = imgH * scale;

        const maxPanX = Math.max(0, (drawW - outW) / 2);
        const maxPanY = Math.max(0, (drawH - outH) / 2);

        if (align === 'center') {
          panOffsetX = 0;
          panOffsetY = 0;
        } else if (align === 'top') {
          panOffsetY = maxPanY; // Shifts image down so top edge matches canvas top
        } else if (align === 'bottom') {
          panOffsetY = -maxPanY; // Shifts image up so bottom edge matches canvas bottom
        } else if (align === 'left') {
          panOffsetX = maxPanX;
        } else if (align === 'right') {
          panOffsetX = -maxPanX;
        }
      } else {
        // Fit mode alignment
        const fitScale = Math.min(outW / imgW, outH / imgH);
        const drawW = imgW * fitScale;
        const drawH = imgH * fitScale;

        const maxShiftX = (outW - drawW) / 2;
        const maxShiftY = (outH - drawH) / 2;

        if (align === 'center') {
          panOffsetX = 0;
          panOffsetY = 0;
        } else if (align === 'top') {
          panOffsetY = maxShiftY;
        } else if (align === 'bottom') {
          panOffsetY = -maxShiftY;
        } else if (align === 'left') {
          panOffsetX = -maxShiftX;
        } else if (align === 'right') {
          panOffsetX = maxShiftX;
        }
      }

      updateStudio();
    }

    // Clamp Pan Offsets to prevent empty margins in Crop mode
    function clampPanOffsets() {
      if (!loadedImage || currentMode !== 'crop') return;
      const dims = computeTargetCanvasDimensions();
      const outW = dims.outW;
      const outH = dims.outH;
      const imgW = loadedImage.naturalWidth || loadedImage.width;
      const imgH = loadedImage.naturalHeight || loadedImage.height;

      const baseScale = Math.max(outW / imgW, outH / imgH);
      const scale = baseScale * currentZoom;
      const drawW = imgW * scale;
      const drawH = imgH * scale;

      const maxPanX = Math.max(0, (drawW - outW) / 2);
      const maxPanY = Math.max(0, (drawH - outH) / 2);

      panOffsetX = Math.max(-maxPanX, Math.min(maxPanX, panOffsetX));
      panOffsetY = Math.max(-maxPanY, Math.min(maxPanY, panOffsetY));
    }

    // Interactive Drag / Pan on Canvas
    if (previewCanvas) {
      previewCanvas.addEventListener('pointerdown', (e: PointerEvent) => {
        if (!loadedImage) return;
        isDragging = true;
        previewCanvas.setPointerCapture(e.pointerId);
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        dragStartPanX = panOffsetX;
        dragStartPanY = panOffsetY;
      });

      previewCanvas.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDragging || !loadedImage) return;
        const deltaScreenX = e.clientX - dragStartX;
        const deltaScreenY = e.clientY - dragStartY;

        // Map screen pixels to target output canvas dimensions
        const rect = previewCanvas.getBoundingClientRect();
        const dims = computeTargetCanvasDimensions();
        const scaleFactorX = dims.outW / (rect.width || 1);
        const scaleFactorY = dims.outH / (rect.height || 1);

        panOffsetX = dragStartPanX + deltaScreenX * scaleFactorX;
        panOffsetY = dragStartPanY + deltaScreenY * scaleFactorY;

        clampPanOffsets();
        updateStudio();
      });

      const endDrag = (e: PointerEvent) => {
        if (isDragging) {
          isDragging = false;
          try {
            previewCanvas.releasePointerCapture(e.pointerId);
          } catch {
            // Ignore capture release errors
          }
        }
      };

      previewCanvas.addEventListener('pointerup', endDrag);
      previewCanvas.addEventListener('pointercancel', endDrag);
    }

    // Compute Native Output Dimensions
    function computeTargetCanvasDimensions(): { outW: number; outH: number } {
      if (!loadedImage) return { outW: 1920, outH: 1080 };
      const imgW = loadedImage.naturalWidth || loadedImage.width;
      const imgH = loadedImage.naturalHeight || loadedImage.height;
      const targetRatio = currentTargetRatio;
      const imgRatio = imgW / imgH;

      let outW: number;
      let outH: number;

      if (currentMode === 'crop') {
        if (imgRatio >= targetRatio) {
          outH = imgH;
          outW = Math.round(imgH * targetRatio);
        } else {
          outW = imgW;
          outH = Math.round(imgW / targetRatio);
        }
      } else {
        // Fit mode
        if (imgRatio >= targetRatio) {
          outW = imgW;
          outH = Math.round(imgW / targetRatio);
        } else {
          outH = imgH;
          outW = Math.round(imgH * targetRatio);
        }
      }

      // Ensure even integers
      if (outW % 2 !== 0) outW++;
      if (outH % 2 !== 0) outH++;

      return { outW, outH };
    }

    // Core Drawing Function onto Any Canvas (Preview or Export)
    function renderToCanvas(targetCanvas: HTMLCanvasElement, outW: number, outH: number) {
      if (!loadedImage) return;
      const ctx = targetCanvas.getContext('2d');
      if (!ctx) return;

      targetCanvas.width = outW;
      targetCanvas.height = outH;

      const imgW = loadedImage.naturalWidth || loadedImage.width;
      const imgH = loadedImage.naturalHeight || loadedImage.height;

      ctx.clearRect(0, 0, outW, outH);

      if (currentMode === 'crop') {
        const baseScale = Math.max(outW / imgW, outH / imgH);
        const scale = baseScale * currentZoom;
        const drawW = imgW * scale;
        const drawH = imgH * scale;

        const drawX = (outW - drawW) / 2 + panOffsetX;
        const drawY = (outH - drawH) / 2 + panOffsetY;

        ctx.drawImage(loadedImage, drawX, drawY, drawW, drawH);
      } else {
        // Fit mode
        // 1. Draw Background
        if (currentBgColor === 'blur') {
          // Draw blurred zoomed image in background
          ctx.save();
          const blurScale = Math.max(outW / imgW, outH / imgH);
          const bW = imgW * blurScale * 1.1;
          const bH = imgH * blurScale * 1.1;
          const bX = (outW - bW) / 2;
          const bY = (outH - bH) / 2;

          ctx.filter = 'blur(28px) brightness(0.85)';
          ctx.drawImage(loadedImage, bX, bY, bW, bH);
          ctx.restore();
        } else if (currentBgColor !== 'transparent') {
          ctx.fillStyle = currentBgColor;
          ctx.fillRect(0, 0, outW, outH);
        }

        // 2. Draw Centered Image
        const fitScale = Math.min(outW / imgW, outH / imgH);
        const drawW = imgW * fitScale;
        const drawH = imgH * fitScale;
        const drawX = (outW - drawW) / 2 + panOffsetX;
        const drawY = (outH - drawH) / 2 + panOffsetY;

        ctx.drawImage(loadedImage, drawX, drawY, drawW, drawH);
      }
    }

    // Update Studio Preview & UI Text
    function updateStudio() {
      if (!loadedImage || !previewCanvas) return;

      const dims = computeTargetCanvasDimensions();
      const outW = dims.outW;
      const outH = dims.outH;

      // Update Badges & Labels
      let ratioLabel = currentRatioKey.toUpperCase();
      if (currentRatioKey === 'custom') {
        const w = customW?.value || '2';
        const h = customH?.value || '1';
        ratioLabel = `${w}:${h}`;
      } else if (currentRatioKey === 'original') {
        ratioLabel = getAspectRatioLabel(loadedImage.naturalWidth || 1, loadedImage.naturalHeight || 1);
      }

      if (stageBadgeRatio) stageBadgeRatio.textContent = ratioLabel;
      if (stageBadgeDims) stageBadgeDims.textContent = `${outW.toLocaleString()} × ${outH.toLocaleString()} px`;
      if (finalDimsText) finalDimsText.textContent = `${outW.toLocaleString()} × ${outH.toLocaleString()} px (${ratioLabel})`;

      // Set CSS aspect ratio on canvas so container maintains proportions
      previewCanvas.style.aspectRatio = `${currentTargetRatio}`;

      // Render Preview Canvas (scaled appropriately for smooth display)
      const previewMaxDim = 900;
      let prevW = outW;
      let prevH = outH;
      if (outW > previewMaxDim || outH > previewMaxDim) {
        if (outW >= outH) {
          prevW = previewMaxDim;
          prevH = Math.round(previewMaxDim / currentTargetRatio);
        } else {
          prevH = previewMaxDim;
          prevW = Math.round(previewMaxDim * currentTargetRatio);
        }
      }

      renderToCanvas(previewCanvas, prevW, prevH);
    }

    // Toggle Quality Selector based on chosen Format
    if (exportFormat && qualitySelectGroup) {
      exportFormat.addEventListener('change', () => {
        const fmt = exportFormat.value;
        if (fmt === 'image/png') {
          qualitySelectGroup.style.opacity = '0.5';
          qualitySelectGroup.style.pointerEvents = 'none';
        } else {
          qualitySelectGroup.style.opacity = '1';
          qualitySelectGroup.style.pointerEvents = 'auto';
        }
      });
    }

    // Download Handler
    if (btnDownload) {
      btnDownload.addEventListener('click', () => {
        if (!loadedImage) {
          showError('Please upload an image first.');
          return;
        }

        const dims = computeTargetCanvasDimensions();
        const exportCanvas = document.createElement('canvas');

        // Render full native output resolution
        renderToCanvas(exportCanvas, dims.outW, dims.outH);

        const mimeType = exportFormat?.value || 'image/jpeg';
        const qualityVal = parseFloat(exportQuality?.value || '0.92');

        const originalName = originalFile?.name || 'image.jpg';
        let ratioLabel = currentRatioKey.replace(':', '-');
        if (currentRatioKey === 'custom') {
          ratioLabel = `${customW?.value || 'custom'}-${customH?.value || 'ratio'}`;
        }
        const modeLabel = currentMode;
        const ext = mimeType === 'image/png' ? 'png' : mimeType === 'image/webp' ? 'webp' : 'jpg';

        const baseName = originalName.replace(/\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_-]/g, '_');
        const filename = `${baseName}-${ratioLabel}-${modeLabel}.${ext}`;

        if (downloadBtnText) downloadBtnText.textContent = 'Generating...';

        exportCanvas.toBlob((blob) => {
          if (!blob) {
            showError('Could not generate exported image blob. Please try another format.');
            if (downloadBtnText) downloadBtnText.textContent = 'Download Image';
            return;
          }

          const blobUrl = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = blobUrl;
          link.download = filename;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);

          setTimeout(() => {
            URL.revokeObjectURL(blobUrl);
            if (downloadBtnText) downloadBtnText.textContent = 'Image Downloaded!';
            setTimeout(() => {
              if (downloadBtnText) downloadBtnText.textContent = 'Download Image';
            }, 2000);
          }, 300);
        }, mimeType, qualityVal);
      });
    }
  });
</script>

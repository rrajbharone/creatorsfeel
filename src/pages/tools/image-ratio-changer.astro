    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .chevron-svg {
    width: 18px;
    height: 18px;
  }

  .faq-card[open] .faq-chevron {
    transform: rotate(180deg);

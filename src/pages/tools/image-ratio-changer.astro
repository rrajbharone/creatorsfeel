  .meta-strip {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8rem;
    box-sizing: border-box;
  }

  .meta-strip-details {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-width: 0;
    color: var(--color-text);
  }

  .meta-filename {
    font-weight: 700;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }

  .meta-separator {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .meta-dims, .meta-ratio, .meta-size {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .meta-strip-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .strip-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 36px;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.775rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .strip-action-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .btn-danger-subtle {
    color: var(--color-text-muted);
  }

  .btn-danger-subtle:hover {
    border-color: #ef4444;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.05);
  }

  .strip-svg {
    width: 14px;
    height: 14px;
  }

  /* Main Dual Column Studio Grid */
  .studio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .studio-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Left Column: Visual Canvas Stage */
  .stage-column {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .stage-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(0.85rem, 2vw, 1.15rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  .stage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    gap: 0.5rem;
  }

  .stage-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stage-title {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stage-ratio-badge {
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .stage-dims-badge {
    font-size: 0.725rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  /* Canvas Viewport */
  .canvas-viewport {
    position: relative;
    width: 100%;
    min-height: 240px;
    max-height: 380px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    box-sizing: border-box;
    touch-action: none;
    user-select: none;
  }

  .canvas-backdrop-grid {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    box-sizing: border-box;
    /* Subtle checkerboard transparency pattern */
    background-image: 
      linear-gradient(45deg, rgba(125, 125, 125, 0.08) 25%, transparent 25%),
      linear-gradient(-45deg, rgba(125, 125, 125, 0.08) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, rgba(125, 125, 125, 0.08) 75%),
      linear-gradient(-45deg, transparent 75%, rgba(125, 125, 125, 0.08) 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
  }

  .preview-canvas {
    max-width: 100%;
    max-height: 350px;
    width: auto;
    height: auto;
    display: block;
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    cursor: grab;
  }

  .preview-canvas:active {
    cursor: grabbing;
  }

  .drag-hint {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    pointer-events: none;
    opacity: 0.9;
    transition: opacity var(--transition-fast);
  }

  .hint-svg {
    width: 12px;
    height: 12px;
  }

  /* Stage Controls Bar: Zoom & Alignment */
  .stage-controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-border);
  }

  .control-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.025em;
  }

  .zoom-control-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .btn-micro {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 800;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-micro:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .zoom-range {
    width: 90px;
    accent-color: var(--color-brand);
    cursor: pointer;
  }

  .zoom-value-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    min-width: 38px;
  }

  .align-control-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .align-buttons-row {
    display: flex;
    gap: 0.25rem;
  }

  .btn-align {
    min-height: 28px;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.725rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-align:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  /* Right Column: Settings & Export Controls */
  .controls-column {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .control-section {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(0.85rem, 2vw, 1.15rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    box-sizing: border-box;
  }

  .section-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .section-label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .section-hint {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand);
  }

  .sub-label {
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Mode Tabs */
  .mode-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .mode-tab-btn {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-card);
    border: 1.5px solid var(--color-border);
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-fast);
    min-width: 0;
  }

  .mode-tab-btn:hover {
    border-color: var(--color-brand);
  }

  .mode-tab-btn.active {
    border-color: var(--color-brand);
    background: rgba(99, 102, 241, 0.08);
    box-shadow: 0 0 0 1px var(--color-brand);
  }

  .tab-svg {
    width: 20px;
    height: 20px;
    color: var(--color-brand);
    flex-shrink: 0;
  }

  .tab-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tab-title {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tab-desc {
    font-size: 0.685rem;
    color: var(--color-text-muted);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Background Options Panel */
  .bg-options-panel {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
  }

  .bg-palette-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .bg-swatch-btn, .bg-color-picker-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 32px;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.725rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .bg-swatch-btn:hover, .bg-color-picker-label:hover {
    border-color: var(--color-brand);
  }

  .bg-swatch-btn.active {
    border-color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand);
  }

  .swatch-solid {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: inline-block;
    flex-shrink: 0;
  }

  .swatch-checkered {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background-image: 
      linear-gradient(45deg, #ccc 25%, transparent 25%),
      linear-gradient(-45deg, #ccc 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #ccc 75%),
      linear-gradient(-45deg, transparent 75%, #ccc 75%);
    background-size: 6px 6px;
    display: inline-block;
    flex-shrink: 0;
  }

  .swatch-blur-icon {
    display: flex;
    align-items: center;
  }

  .swatch-svg {
    width: 14px;
    height: 14px;
    color: var(--color-brand);
  }

  .color-picker-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .color-picker-indicator {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: inline-block;
    flex-shrink: 0;
  }

  /* Ratio Presets Grid */
  .ratios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(68px, 1fr));
    gap: 0.4rem;
  }

  .ratio-pill-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.35rem;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .ratio-pill-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .ratio-pill-btn.active {
    border-color: var(--color-brand);
    background: rgba(99, 102, 241, 0.12);
    color: var(--color-brand);
    box-shadow: 0 0 0 1px var(--color-brand);
  }

  .ratio-math {
    font-family: var(--font-heading);
    font-size: 0.825rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .ratio-use {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ratio-pill-btn.active .ratio-use {
    color: var(--color-brand);
  }

  /* Custom Ratio Inputs Row */
  .custom-ratio-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
  }

  .custom-input-box {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .input-tiny-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.025em;
  }

  .ratio-num-input {
    min-height: 38px;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 700;
    width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  .ratio-num-input:focus {
    outline: none;
    border-color: var(--color-brand);
  }

  .ratio-colon {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-muted);
    margin-top: 1rem;
  }

  /* Export Settings */
  .export-options-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  @media (min-width: 480px) {
    .export-options-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .format-select-group, .quality-select-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .format-select {
    min-height: 40px;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  .format-select:focus {
    outline: none;
    border-color: var(--color-brand);
  }

  /* Download Action Card */
  .download-action-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(0.85rem, 2vw, 1.15rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-sizing: border-box;
  }

  .summary-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .summary-label {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .summary-value {
    font-family: var(--font-heading);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .btn-download-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--gradient-brand);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.25);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
    width: 100%;
    box-sizing: border-box;
  }

  .btn-download-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.35);
    opacity: 0.95;
  }

  .btn-download-svg {
    width: 18px;
    height: 18px;
  }

  .download-sub-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.725rem;
    color: var(--color-text-muted);
  }

  .btn-text-subtle {
    background: none;
    border: none;
    color: var(--color-text-muted);
    text-decoration: underline;
    font-size: 0.725rem;
    cursor: pointer;
    padding: 0;
  }

  .btn-text-subtle:hover {
    color: var(--color-brand);
  }

  .download-privacy-pill {
    font-weight: 600;
  }

  .tool-card-note {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
    line-height: 1.45;
  }

  /* =========================================================
     3. SEO EDITORIAL CONTENT SECTION (Centered Max-Width 860px)
     ========================================================= */
  .tool-editorial-section {
    padding: clamp(2rem, 4vw, 3.5rem) 0 4rem;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .editorial-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .editorial-article {
    width: 100%;
    line-height: 1.7;
    color: var(--color-text);
  }

  .editorial-article h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 2.25rem 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .editorial-article h2:first-of-type {
    margin-top: 0;
  }

  .editorial-article p {
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .editorial-article ul,
  .editorial-article ol {
    margin: 1rem 0 1.5rem 1.25rem;
    padding-left: 0.5rem;
  }

  .editorial-article li {
    font-size: 0.975rem;
    margin-bottom: 0.65rem;
    color: var(--color-text);
  }

  .editorial-article code {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-family: monospace;
    font-size: 0.875rem;
  }

  .editorial-article a {
    color: var(--color-brand);
    text-decoration: underline;
    font-weight: 600;
  }

  .formula-box {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
    text-align: center;
  }

  .formula-box code {
    font-size: 1.05rem;
    font-weight: 700;
    background: none;
    border: none;
    padding: 0;
    color: var(--color-brand);
  }

  /* Strategy Callout Box */
  .strategy-callout {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-brand);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 1.75rem 0;
  }

  .callout-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .callout-svg {
    width: 18px;
    height: 18px;
  }

  .callout-text p {
    font-size: 0.925rem;
    margin: 0;
    color: var(--color-text);
    line-height: 1.5;
  }

  /* Responsive Comparison Table */
  .table-responsive-wrapper {
    width: 100%;
    overflow-x: auto;
    margin: 1.5rem 0 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    -webkit-overflow-scrolling: touch;
  }

  .content-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
    min-width: 580px;
  }

  .content-table th,
  .content-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .content-table th {
    background: var(--color-bg-alt);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
  }

  .content-table tr:last-child td {
    border-bottom: none;
  }

  .content-table tr:nth-child(even) td {
    background: var(--color-bg-alt);
  }

  /* FAQ Accordion */
  .faq-accordion-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

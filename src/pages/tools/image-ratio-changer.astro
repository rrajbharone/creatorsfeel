---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    question: "What is an image aspect ratio and how does it differ from pixel dimensions?",
    answer: "An image aspect ratio is the proportional relationship between an image's width and height, expressed as two numbers separated by a colon (such as 16:9, 1:1, or 4:5). Pixel dimensions refer to the exact number of horizontal and vertical pixels (such as 1920 × 1080 px). Two images can have completely different pixel resolutions while sharing the exact same aspect ratio. For example, 1920 × 1080 and 3840 × 2160 both have a 16:9 widescreen ratio."
  },
  {
    question: "What is the difference between 'Crop to Fit' and 'Fit Without Cropping'?",
    answer: "'Crop to Fit' fills the target aspect ratio completely by scaling the image and trimming away excess outer portions, eliminating any borders or blank margins. 'Fit Without Cropping' preserves 100% of the original photo by scaling it to fit entirely inside the target ratio, filling the remaining empty space with your choice of background color (such as white, black, custom color, matching blurred background, or transparent alpha for PNG and WebP)."
  },
  {
    question: "How do I change an image aspect ratio to 16:9 for YouTube?",
    answer: "To convert any photo or thumbnail to 16:9, upload your image into our Image Ratio Changer, click the '16:9 (Landscape)' preset, select 'Crop to Fit' or 'Fit Without Cropping', drag to position your subject within the frame, and click 'Download Image'. The tool generates a clean 16:9 image ready for YouTube thumbnails or video title cards."
  },
  {
    question: "Can I convert horizontal landscape photos into 9:16 vertical images for TikTok or Instagram Reels?",
    answer: "Yes. Simply select the '9:16 (Vertical)' preset. In 'Crop to Fit' mode, you can drag the image horizontally to frame your subject in vertical portrait orientation. In 'Fit Without Cropping' mode, your entire horizontal photo remains visible in the center while the top and bottom pillar areas are filled with a clean background or a stylish blurred reflection of your photo."
  },
  {
    question: "Does changing the aspect ratio reduce image quality or resolution?",
    answer: "No. Our Image Ratio Changer processes your photos at their highest native pixel resolution using browser-based HTML5 Canvas APIs. When cropping or padding, the tool maintains maximum pixel density without downscaling your original picture, ensuring sharp results for web publishing and high-resolution print."
  },
  {
    question: "Can I create a custom image aspect ratio not listed in the presets?",
    answer: "Yes. Click the 'Custom' preset button and enter your desired width and height ratio numbers (for example, 2:1 for panoramic banners, 7:5 for specialty photo frames, or exact pixel proportions). The live preview updates instantly to match your custom ratio."
  },
  {
    question: "Are my uploaded photos sent to any remote server or stored online?",
    answer: "No. The Image Ratio Changer operates 100% locally on your computer or mobile device inside your browser sandbox. Your personal photos, client graphics, and screenshots never leave your device, guaranteeing total data security and privacy."
  },
  {
    question: "Which image formats can I export, and is transparency supported?",
    answer: "You can download your adjusted image in JPG, PNG, or WebP format. When exporting to PNG or WebP with 'Fit Without Cropping' mode and the 'Transparent' background option selected, full alpha-channel transparency is preserved."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'Image Ratio Changer', item: '/tools/image-ratio-changer' }
];

const origin = Astro.site ? Astro.site.origin : "https://creatorsfeel.com";
const canonicalUrl = new URL(Astro.url.pathname, origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${canonicalUrl}#application`,
  "name": "Image Ratio Changer",
  "url": canonicalUrl,
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free online Image Ratio Changer. Change photo aspect ratio to 16:9, 1:1, 4:5, 9:16, 21:9, or custom ratios with Crop to Fit and Fit Without Cropping modes directly in your browser."
};
---

<BaseLayout
  title="Image Ratio Changer - Change Aspect Ratio Online (16:9, 1:1, 4:5, 9:16) | CreatorsFeel"
  description="Free online Image Ratio Changer. Crop to fit or fit without cropping to 16:9, 1:1, 4:5, 9:16, 21:9, or custom aspect ratios with instant live preview and 100% browser privacy."
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script type="application/ld+json" slot="meta" set:html={JSON.stringify(softwareSchema)} />

  <div class="tool-page-wrapper">
    <!-- 1. HERO SECTION (Centered Max-Width 860px) -->
    <header class="tool-hero-section">
      <div class="container hero-inner">
        <!-- Breadcrumbs -->
        <div class="hero-breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>

        <!-- Pill Badge -->
        <div class="hero-badge">
          <span class="badge-icon-tool" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tool-svg">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M9 21V9" />
            </svg>
          </span>
          <span class="badge-title">Media &amp; Image Studio</span>
          <span class="badge-pill-free">Free Web Utility</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-headline">
          Image <span class="gradient-text">Ratio Changer</span>
        </h1>

        <!-- Description -->
        <p class="hero-desc">
          Change image aspect ratio to 16:9, 1:1, 4:5, 9:16, 21:9, or custom dimensions online. Crop to fit or expand with clean borders with instant live preview and 100% client-side privacy.
        </p>

        <!-- Feature Chips Row (Zero Emojis - Professional SVG Icons) -->
        <div class="hero-features-row">
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Instant Live Preview
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
            Crop or Fit Modes
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            10+ Standard Presets
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            100% Client-Side Privacy
          </span>
        </div>
      </div>
    </header>

    <!-- 2. MAIN TOOL SECTION (Centered Max-Width 860px) -->
    <main class="tool-main-content">
      <div class="container tool-card-container">
        <!-- SaaS Tool Card -->
        <div class="saas-tool-card" id="ratio-tool-card">
          <!-- Card Header Bar -->
          <div class="card-header-bar">
            <div class="platform-indicator">
              <div class="platform-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="avatar-svg" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M9 21V9" />
                </svg>
              </div>
              <div class="platform-info">
                <span class="platform-name">Aspect Ratio &amp; Cropping Studio</span>
                <span class="platform-sub">Instant browser-based canvas engine</span>
              </div>
            </div>

            <div class="header-action-badge">
              <span class="badge-status-dot"></span>
              <span class="badge-status-text">Client-Side Engine Active</span>
            </div>
          </div>

          <!-- Error Alert Banner (Hidden by default) -->
          <div id="error-banner" class="alert-banner error-banner" style="display: none;" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="alert-icon" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <span id="error-message" class="alert-text">Please upload a valid image file.</span>
            <button type="button" id="btn-close-error" class="alert-close-btn" aria-label="Dismiss error notification">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="close-svg">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- A. INITIAL UPLOAD DROPZONE (Displayed when no image is loaded) -->
          <div id="upload-zone-wrapper" class="upload-zone-wrapper">
            <input 
              type="file" 
              id="image-file-input" 
              class="hidden-file-input" 
              accept="image/jpeg,image/png,image/webp,image/gif,image/avif,.jpg,.jpeg,.png,.webp,.gif,.avif" 
              aria-label="Upload image to change aspect ratio"
            />
            
            <div id="dropzone" class="dropzone" role="button" tabindex="0" aria-label="Drop image here or click to select image">
              <div class="dropzone-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="dropzone-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
                </svg>
              </div>

              <div class="dropzone-text-group">
                <strong class="dropzone-title">Drag &amp; drop an image here</strong>
                <p class="dropzone-subtitle">or choose a photo from your computer or phone</p>
              </div>

              <button type="button" id="btn-browse-trigger" class="btn-select-file">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>Select Image</span>
              </button>

              <div class="format-badges-row">
                <span class="fmt-pill">JPG</span>
                <span class="fmt-pill">PNG</span>
                <span class="fmt-pill">WebP</span>
                <span class="fmt-pill">AVIF</span>
                <span class="fmt-limit">Max 50 MB</span>
              </div>

              <div class="privacy-notice">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="privacy-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
                <span>100% Private. Photos are processed locally in your browser and never uploaded to any server.</span>
              </div>
            </div>
          </div>

          <!-- B. ACTIVE STUDIO WORKSPACE (Shown immediately once image is loaded) -->
          <div id="studio-workspace" class="studio-workspace" style="display: none;">
            <!-- Top Metadata Bar -->
            <div class="meta-strip">
              <div class="meta-strip-details">
                <span id="strip-filename" class="meta-filename" title="">image.jpg</span>
                <span class="meta-separator">•</span>
                <span id="strip-dims" class="meta-dims">0 × 0 px</span>
                <span class="meta-separator">•</span>
                <span id="strip-ratio" class="meta-ratio">0:0</span>
                <span class="meta-separator">•</span>
                <span id="strip-size" class="meta-size">0 KB</span>
              </div>

              <div class="meta-strip-actions">
                <button type="button" id="btn-change-image" class="strip-action-btn">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="strip-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                  </svg>
                  <span>Change Image</span>
                </button>
                <button type="button" id="btn-remove-image" class="strip-action-btn btn-danger-subtle" title="Remove image">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="strip-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
                  </svg>
                  <span>Remove</span>
                </button>
              </div>
            </div>

            <!-- Main Dual Column Workspace Grid -->
            <div class="studio-grid">
              <!-- Left Column: Visual Canvas Stage -->
              <div class="stage-column">
                <div class="stage-card">
                  <div class="stage-header">
                    <div class="stage-title-wrap">
                      <span class="stage-title">Live Ratio Preview</span>
                      <span id="stage-badge-ratio" class="stage-ratio-badge">16:9</span>
                    </div>
                    <span id="stage-badge-dims" class="stage-dims-badge">0 × 0 px</span>
                  </div>

                  <!-- Canvas Viewport Box -->
                  <div class="canvas-viewport" id="canvas-viewport">
                    <div class="canvas-backdrop-grid">
                      <canvas id="preview-canvas" class="preview-canvas"></canvas>
                    </div>

                    <!-- Drag to pan hint overlay (only in crop mode or zoomed) -->
                    <div id="drag-hint" class="drag-hint">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hint-svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                      </svg>
                      <span>Drag image to reposition</span>
                    </div>
                  </div>

                  <!-- Positioning & Zoom Controls Bar -->
                  <div class="stage-controls-bar">
                    <!-- Zoom Slider -->
                    <div class="zoom-control-group" id="zoom-control-group">
                      <span class="control-label">Zoom</span>
                      <button type="button" id="btn-zoom-out" class="btn-micro" aria-label="Zoom out">-</button>
                      <input type="range" id="zoom-slider" min="100" max="250" value="100" step="5" class="zoom-range" aria-label="Image zoom level" />
                      <button type="button" id="btn-zoom-in" class="btn-micro" aria-label="Zoom in">+</button>
                      <span id="zoom-value" class="zoom-value-text">100%</span>
                    </div>

                    <!-- Quick Alignment Buttons -->
                    <div class="align-control-group">
                      <span class="control-label">Snap</span>
                      <div class="align-buttons-row">
                        <button type="button" class="btn-align" data-align="center" title="Snap to Center">Center</button>
                        <button type="button" class="btn-align" data-align="top" title="Snap to Top">Top</button>
                        <button type="button" class="btn-align" data-align="bottom" title="Snap to Bottom">Bottom</button>
                        <button type="button" class="btn-align" data-align="left" title="Snap to Left">Left</button>
                        <button type="button" class="btn-align" data-align="right" title="Snap to Right">Right</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Column: Settings & Export Controls -->
              <div class="controls-column">
                <!-- Control Panel 1: Sizing Mode Selection -->
                <div class="control-section">
                  <div class="section-label-row">
                    <span class="section-label">Adjustment Mode</span>
                  </div>
                  <div class="mode-tabs">
                    <button type="button" id="mode-crop" class="mode-tab-btn active" data-mode="crop">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 003.75 6v1.5M3.75 16.5V18A2.25 2.25 0 006 20.25h1.5m9-16.5H18A2.25 2.25 0 0120.25 6v1.5m0 9V18A2.25 2.25 0 0118 20.25h-1.5" />
                      </svg>
                      <div class="tab-text">
                        <strong class="tab-title">Crop to Fit</strong>
                        <span class="tab-desc">Fill frame without borders</span>
                      </div>
                    </button>

                    <button type="button" id="mode-fit" class="mode-tab-btn" data-mode="fit">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-svg" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <rect x="6" y="8" width="12" height="8" rx="1"/>
                      </svg>
                      <div class="tab-text">
                        <strong class="tab-title">Fit (No Crop)</strong>
                        <span class="tab-desc">Keep full photo with padding</span>
                      </div>
                    </button>
                  </div>

                  <!-- Background Color Fill Palette (Visible only in Fit mode) -->
                  <div id="bg-options-panel" class="bg-options-panel" style="display: none;">
                    <span class="sub-label">Background Fill Color</span>
                    <div class="bg-palette-row">
                      <button type="button" class="bg-swatch-btn active" data-color="transparent" title="Transparent background">
                        <span class="swatch-checkered"></span>
                        <span class="swatch-label">Alpha</span>
                      </button>
                      <button type="button" class="bg-swatch-btn" data-color="#ffffff" title="White background">
                        <span class="swatch-solid" style="background:#ffffff;"></span>
                        <span class="swatch-label">White</span>
                      </button>
                      <button type="button" class="bg-swatch-btn" data-color="#000000" title="Black background">
                        <span class="swatch-solid" style="background:#000000;"></span>
                        <span class="swatch-label">Black</span>
                      </button>
                      <button type="button" class="bg-swatch-btn" data-color="#1e293b" title="Dark Slate background">
                        <span class="swatch-solid" style="background:#1e293b;"></span>
                        <span class="swatch-label">Dark</span>
                      </button>
                      <button type="button" class="bg-swatch-btn" data-color="blur" title="Blurred image reflection background">
                        <span class="swatch-blur-icon">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="swatch-svg"><circle cx="12" cy="12" r="9"/></svg>
                        </span>
                        <span class="swatch-label">Blur</span>
                      </button>
                      <label class="bg-color-picker-label" title="Custom Hex Color">
                        <input type="color" id="custom-color-picker" value="#6366f1" class="color-picker-input" />
                        <span class="color-picker-indicator" id="color-picker-indicator" style="background:#6366f1;"></span>
                        <span class="swatch-label">Custom</span>
                      </label>
                    </div>
                  </div>
                </div>

                <!-- Control Panel 2: Aspect Ratio Presets -->
                <div class="control-section">
                  <div class="section-label-row">
                    <span class="section-label">Select Aspect Ratio</span>
                    <span id="active-ratio-name" class="section-hint">16:9 Landscape</span>
                  </div>

                  <div class="ratios-grid" id="ratios-grid">
                    <button type="button" class="ratio-pill-btn" data-ratio="original">
                      <span class="ratio-math">Original</span>
                      <span class="ratio-use">Native</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="1:1">
                      <span class="ratio-math">1:1</span>
                      <span class="ratio-use">Square</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="4:5">
                      <span class="ratio-math">4:5</span>
                      <span class="ratio-use">IG Post</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="9:16">
                      <span class="ratio-math">9:16</span>
                      <span class="ratio-use">Reels / Shorts</span>
                    </button>
                    <button type="button" class="ratio-pill-btn active" data-ratio="16:9">
                      <span class="ratio-math">16:9</span>
                      <span class="ratio-use">YouTube</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="3:2">
                      <span class="ratio-math">3:2</span>
                      <span class="ratio-use">Classic</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="2:3">
                      <span class="ratio-math">2:3</span>
                      <span class="ratio-use">Portrait</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="4:3">
                      <span class="ratio-math">4:3</span>
                      <span class="ratio-use">Standard</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="5:4">
                      <span class="ratio-math">5:4</span>
                      <span class="ratio-use">Print</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="21:9">
                      <span class="ratio-math">21:9</span>
                      <span class="ratio-use">Cinema</span>
                    </button>
                    <button type="button" class="ratio-pill-btn" data-ratio="custom">
                      <span class="ratio-math">Custom</span>
                      <span class="ratio-use">Manual</span>
                    </button>
                  </div>

                  <!-- Custom Ratio Inputs Row (Shown only when 'custom' is active) -->
                  <div id="custom-ratio-row" class="custom-ratio-row" style="display: none;">
                    <div class="custom-input-box">
                      <label for="custom-w" class="input-tiny-label">Width Ratio</label>
                      <input type="number" id="custom-w" min="1" max="100" value="2" class="ratio-num-input" />
                    </div>
                    <span class="ratio-colon">:</span>
                    <div class="custom-input-box">
                      <label for="custom-h" class="input-tiny-label">Height Ratio</label>
                      <input type="number" id="custom-h" min="1" max="100" value="1" class="ratio-num-input" />
                    </div>
                  </div>
                </div>

                <!-- Control Panel 3: Format & Export Settings -->
                <div class="control-section">
                  <div class="section-label-row">
                    <span class="section-label">Export Format &amp; Quality</span>
                  </div>

                  <div class="export-options-grid">
                    <div class="format-select-group">
                      <label for="export-format" class="input-tiny-label">File Format</label>
                      <select id="export-format" class="format-select">
                        <option value="image/jpeg" selected>JPG (.jpg)</option>
                        <option value="image/png">PNG (.png) - Supports Transparency</option>
                        <option value="image/webp">WebP (.webp) - Optimized Web</option>
                      </select>
                    </div>

                    <div class="quality-select-group" id="quality-select-group">
                      <label for="export-quality" class="input-tiny-label">Quality</label>
                      <select id="export-quality" class="format-select">

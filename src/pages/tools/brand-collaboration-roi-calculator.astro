---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is Brand Collaboration ROI and how is it calculated?",
    answer: "Brand Collaboration ROI (Return on Investment) is a financial performance metric that evaluates the profitability of a sponsored partnership. For sales-focused campaigns, it is calculated as: ((Total Revenue - Total Campaign Cost) / Total Campaign Cost) * 100. For brand awareness campaigns, revenue is substituted with Earned Media Value (EMV)."
  },
  {
    question: "What is Earned Media Value (EMV) and how is it quantified?",
    answer: "Earned Media Value (EMV) is a marketing methodology that assigns a monetary value to organic or sponsored social media exposure. It calculates what it would have cost to purchase the same volume of impressions (at standard CPM rates), engagements (at CPE rates), and link clicks (at CPC rates) through programmatic paid advertising."
  },
  {
    question: "What is a healthy or good ROI for an influencer brand collaboration?",
    answer: "For direct-response sales campaigns, a healthy ROI typically ranges between 150% and 400% (a 1.5x to 4x return on total spend). For top-of-funnel brand awareness campaigns evaluated via Earned Media Value, a positive media ROI of 20% to 150% represents strong cost-efficiency compared to traditional digital ad channels."
  },
  {
    question: "What costs should be included in the total campaign expenditure?",
    answer: "To calculate an accurate ROI, you must include the creator's base fee, the retail value or Cost of Goods Sold (COGS) of gifted merchandise, sample shipping and packaging expenses, paid ad whitelisting spend, agency commissions, and software licensing fees."
  },
  {
    question: "What is Customer Acquisition Cost (CAC) in influencer marketing?",
    answer: "Customer Acquisition Cost (CAC) is the total amount spent on a collaboration divided by the total number of paying customers acquired. If an influencer campaign costs $1,000 in total and generates 50 direct customer purchases, the CAC is $20.00 per customer."
  },
  {
    question: "How can creators use this ROI calculator to charge higher rates?",
    answer: "Creators can input data from past brand partnerships into the calculator to measure their generated revenue, Earned Media Value, and conversion efficiency. Presenting proven positive ROI percentages and low CAC figures in a media kit provides powerful leverage to negotiate higher flat fees and long-term retainers."
  },
  {
    question: "What is the difference between ROI and ROAS in creator partnerships?",
    answer: "ROAS (Return on Ad Spend) measures gross revenue divided by campaign cost (e.g., $3,000 revenue / $1,000 cost = 3.0x or 300% ROAS). ROI measures net profitability after subtracting costs: (($3,000 - $1,000) / $1,000) * 100 = 200% net ROI."
  },
  {
    question: "Why do brand awareness campaigns sometimes have negative direct sales ROI?",
    answer: "Brand awareness campaigns focus on brand discovery, product education, and long-term brand equity rather than immediate impulse buying. While their immediate direct sales ROI may appear negative, their Earned Media Value (EMV) and multi-touch assisted conversions often yield high long-term business value."
  }
];
---

<ToolLayout
  title="Brand Collaboration ROI Calculator - Campaign Return & Profit Tracker"
  description="Calculate the Return on Investment (ROI) of your brand deals and influencer sponsorships. Free online calculator for Sales Conversions or Earned Media Value (EMV)."
  toolName="Brand Collaboration ROI Calculator"
  toolDescription="Measure campaign profitability. Toggle between Sales-focused or Brand Awareness (EMV) models, input cost and performance data, and review dynamic ROI scores."
  category="Calculators"
  faqs={faqs}
>
  <div slot="calculator" class="calc-card glass">
    <!-- Campaign Mode selector tabs -->
    <div class="calculator-mode-selector" role="tablist" aria-label="Campaign Goal">
      <button type="button" class="mode-tab active" data-mode="sales" role="tab" aria-selected="true" aria-controls="calc-form-container">
        <span>Sales & Conversions</span>
      </button>
      <button type="button" class="mode-tab" data-mode="awareness" role="tab" aria-selected="false" aria-controls="calc-form-container">
        <span>Brand Awareness (EMV)</span>
      </button>
    </div>

    <div class="calc-grid" id="calc-form-container">
      <!-- Input fields -->
      <form class="calc-form" id="roi-form" onsubmit="return false;">
        <input type="hidden" id="active-mode" value="sales" />

        <!-- Common Cost Inputs -->
        <div class="form-row-2">
          <div class="form-group">
            <div class="label-header">
              <label for="influencer-fee" class="icon-label">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                Influencer Fee ($)
              </label>
            </div>
            <input type="number" id="influencer-fee" class="form-input" placeholder="0" min="0" step="1" required />
          </div>

          <div class="form-group">
            <div class="label-header">
              <label for="additional-costs" class="icon-label">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h16.5M4.5 19.5h15M12 6.75v10.5m-3.75-3h7.5" />
                </svg>
                Additional Costs ($)
              </label>
            </div>
            <input type="number" id="additional-costs" class="form-input" placeholder="0" min="0" step="1" value="0" />
          </div>
        </div>

        <!-- Sales Mode Inputs (Visible by default) -->
        <div id="inputs-sales-box" class="inputs-group">
          <div class="form-row-2">
            <div class="form-group">
              <div class="label-header">
                <label for="conversions-count" class="icon-label">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                  </svg>
                  Total Sales (Conversions)
                </label>
              </div>
              <input type="number" id="conversions-count" class="form-input" placeholder="0" min="0" step="1" />
            </div>

            <div class="form-group">
              <div class="label-header">
                <label for="avg-order-value" class="icon-label">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                  </svg>
                  Average Order Value ($)
                </label>
              </div>
              <input type="number" id="avg-order-value" class="form-input" placeholder="0" min="1" step="0.01" />
            </div>
          </div>
        </div>

        <!-- Awareness Mode Inputs (Hidden by default) -->
        <div id="inputs-awareness-box" class="inputs-group hidden">
          <div class="form-row-2">
            <div class="form-group">
              <div class="label-header">
                <label for="impressions-count" class="icon-label">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                  Total Impressions
                </label>
              </div>
              <input type="number" id="impressions-count" class="form-input" placeholder="0" min="0" step="1" />
            </div>

            <div class="form-group">
              <div class="label-header">
                <label for="engagements-count" class="icon-label">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.896 0 1.7.393 2.287 1.026.549-.752 1.442-1.242 2.453-1.242 1.162 0 2.161.64 2.685 1.587l.006-.003c.524-.947 1.523-1.584 2.685-1.584 1.734 0 3.14 1.406 3.14 3.14 0 4.19-8.462 8.583-8.5 8.602a.498.498 0 0 1-.57 0c-.038-.019-8.5-4.412-8.5-8.602 0-1.734 1.406-3.14 3.14-3.14ZM6.47 5.61a.75.75 0 0 1 1.06-.02l3.47 3.28 3.47-3.28a.75.75 0 1 1 1.04 1.08l-4 3.78a.75.75 0 0 1-1.04 0l-4-3.78a.75.75 0 0 1-.02-1.06Z" />
                  </svg>
                  Total Engagements
                </label>
              </div>
              <input type="number" id="engagements-count" class="form-input" placeholder="0" min="0" step="1" />
            </div>
          </div>

          <div class="form-group" style="margin-top: 1.25rem;">
            <div class="label-header">
              <label for="clicks-count" class="icon-label">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                </svg>
                Total Link Clicks
              </label>
            </div>
            <input type="number" id="clicks-count" class="form-input" placeholder="0" min="0" step="1" />
          </div>
        </div>

        <div class="form-actions">
          <button type="button" id="calc-submit-btn" class="calc-btn" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" />
            </svg>
            Calculate Campaign ROI
          </button>
          <button type="button" id="calc-reset-btn" class="calc-btn-secondary" style="width: 100%;">Reset Form</button>
        </div>
      </form>

      <!-- Outputs Display -->
      <div class="calc-results" id="results-wrapper">
        <div class="empty-state text-center" id="res-empty-box">
          <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
          </svg>
          <h3>Awaiting ROI Metrics</h3>
          <p class="text-muted">Fill out your campaign expenditure and performance parameters, then click Calculate.</p>
        </div>

        <div class="results-active hidden" id="res-active-box">
          <div class="rate-range-box">
            <h4 class="rate-label">Return on Investment (ROI)</h4>
            <div class="rate-range" id="res-roi-val">+0.00%</div>
            <div class="grade-badge grade-low" id="res-status-badge">Break-Even</div>
          </div>

          <div class="breakdown-box">
            <h4 class="breakdown-title">Campaign Financial Breakdown</h4>
            <div class="breakdown-list">
              <div class="breakdown-item">
                <span class="breakdown-label">Total Spend:</span>
                <span class="breakdown-val" id="res-spend-val">-</span>
              </div>
              <div class="breakdown-item">
                <span class="breakdown-label" id="res-return-label">Total Revenue Generated:</span>
                <span class="breakdown-val" id="res-return-val">-</span>
              </div>
              <div class="breakdown-item">
                <span class="breakdown-label">Net Profit / Loss:</span>
                <span class="breakdown-val" id="res-profit-val">-</span>
              </div>
              <div class="breakdown-item" id="res-helper-row">
                <span class="breakdown-label" id="res-helper-label">Customer Acquisition Cost:</span>
                <span class="breakdown-val" id="res-helper-val">-</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div slot="about" class="editorial-content">
    <h2>The Complete Guide to Brand Collaboration ROI & Campaign Profitability</h2>
    <p>
      Influencer marketing and sponsored creator partnerships have transformed from experimental branding initiatives into primary performance growth channels for modern businesses. In an environment where consumer skepticism toward traditional digital ads is at an all-time high, creators offer brands an authentic bridge to highly engaged, targeted communities.
    </p>
    <p>
      However, as marketing investments in creator collaborations grow, so does the demand for concrete financial accountability. Both marketing directors and professional content creators need clear answers to a fundamental question: <strong>What is the actual Return on Investment (ROI) of this collaboration?</strong>
    </p>
    <p>
      Our <strong>Brand Collaboration ROI Calculator</strong> provides a dual-model audit framework. Whether you are running a direct-response sales campaign with custom promotional discount codes or evaluating a top-of-funnel brand awareness campaign using <strong>Earned Media Value (EMV)</strong>, this tool calculates net profitability, percentage ROI, and unit acquisition costs in real-time.
    </p>

    <div class="callout-box">
      <div class="callout-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon" style="display:inline-block; vertical-align:middle; color:var(--color-brand); margin-right:6px;"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg> Campaign Strategy & Optimization
      </div>
      <p style="margin: 0; font-size: 0.95rem;">
        Looking to structure high-converting sponsorship agreements and pitch decks? Explore our in-depth strategy guides: <a href="/blog/brand-collaboration-roi-calculator-guide">Brand Collaboration ROI Calculations & Campaign Auditing</a> and <a href="/blog/ultimate-brand-collaboration-guide">The Ultimate Brand Collaboration Guide for Creators</a>.
      </p>
    </div>

    <h2>How Brand Collaboration Deals & Payment Structures Work</h2>
    <p>
      Understanding campaign ROI begins with understanding how creator compensation is structured. Brand deals typically operate under five primary commercial models:
    </p>

    <div class="step-guide">
      <div class="step-item">
        <h3>1. Flat-Fee Sponsorships (Guaranteed Upfront Payment)</h3>
        <p>
          The most common structure in influencer marketing. The brand pays a fixed upfront fee for a defined set of deliverables (e.g., one dedicated YouTube video segment, two Instagram Reels, or a TikTok video). The creator is guaranteed payment regardless of downstream sales.
        </p>
      </div>

      <div class="step-item">
        <h3>2. Performance & Affiliate Hybrid Models</h3>
        <p>
          A balanced risk-sharing structure combining a lower guaranteed base fee with performance incentives (such as a 10% to 20% commission on all sales generated via a unique affiliate link or promo code). This aligns creator incentives directly with sales volume.
        </p>
      </div>

      <div class="step-item">
        <h3>3. Product Gifting & Seeding</h3>
        <p>
          Brands send free merchandise to creators in exchange for honest reviews or unboxing posts. While no cash changes hands, the brand incurs sample production (COGS) and shipping costs, which must be factored into the campaign's total expenditure.
        </p>
      </div>

      <div class="step-item">
        <h3>4. Monthly Ambassador Retainers</h3>
        <p>
          Long-term partnerships where a creator agrees to publish a recurring schedule of monthly deliverables (e.g., 2 dedicated videos and 4 Story posts per month) in exchange for a steady monthly retainer. These partnerships generally yield higher cumulative ROI through repeated audience exposure.
        </p>
      </div>

      <div class="step-item">
        <h3>5. Whitelisting, Creator Licensing & Paid Spark Ads</h3>
        <p>
          Brands pay an additional licensing fee for permission to run paid advertising campaigns directly through the creator's social media handle (dark posting). This combines creator authenticity with precision ad targeting to scale profitable return on ad spend (ROAS).
        </p>
      </div>
    </div>

    <h2>Key Metrics Used to Calculate Brand Collaboration ROI</h2>
    <p>
      Accurately auditing an influencer campaign requires tracking quantitative financial metrics and qualitative engagement data across the marketing funnel:
    </p>

    <div class="table-responsive-wrapper">
      <table class="content-table">
        <thead>
          <tr>
            <th>Metric Name</th>
            <th>Abbreviation</th>
            <th>Formula / Definition</th>
            <th>Strategic Importance</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Total Campaign Cost</strong></td>
            <td><strong>Cost</strong></td>
            <td><code>Influencer Fee + Product Samples + Shipping + Ad Boosts</code></td>
            <td>The complete capital invested to execute the collaboration.</td>
          </tr>
          <tr>
            <td><strong>Gross Revenue Generated</strong></td>
            <td><strong>Revenue</strong></td>
            <td><code>Total Conversions × Average Order Value (AOV)</code></td>
            <td>Total top-line sales attributed to the creator's promo code/link.</td>
          </tr>
          <tr>
            <td><strong>Net Campaign Profit</strong></td>
            <td><strong>Profit</strong></td>
            <td><code>Gross Revenue (or EMV) - Total Campaign Cost</code></td>
            <td>The net financial gain or loss produced by the partnership.</td>
          </tr>
          <tr>
            <td><strong>Return on Investment</strong></td>
            <td><strong>ROI (%)</strong></td>
            <td><code>((Revenue - Cost) / Cost) × 100</code></td>
            <td>The percentage net return generated per dollar invested.</td>
          </tr>
          <tr>
            <td><strong>Customer Acquisition Cost</strong></td>
            <td><strong>CAC</strong></td>
            <td><code>Total Campaign Cost / Total Paying Customers</code></td>
            <td>The exact cost required to acquire one new paying customer.</td>
          </tr>
          <tr>
            <td><strong>Earned Media Value</strong></td>
            <td><strong>EMV</strong></td>
            <td><code>(Impressions × $0.015) + (Engagements × $0.15) + (Clicks × $1.00)</code></td>
            <td>The dollar equivalent value of organic reach compared to paid ad spend.</td>
          </tr>
          <tr>
            <td><strong>Effective Cost Per Click</strong></td>
            <td><strong>eCPC</strong></td>
            <td><code>Total Campaign Cost / Total Outbound Link Clicks</code></td>
            <td>Measures the traffic cost-efficiency of the creator's audience.</td>
          </tr>
          <tr>
            <td><strong>Cost Per Engagement</strong></td>
            <td><strong>CPE</strong></td>
            <td><code>Total Campaign Cost / Total Interactions (Likes + Comments + Shares)</code></td>
            <td>Evaluates audience interest and active community participation.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>How This Brand Collaboration ROI Calculator Works</h2>
    <p>
      Our calculator offers two distinct analytical modes tailored to the campaign's primary objective:
    </p>

    <h3>Mode 1: Sales & Conversions (Direct-Response Attribution)</h3>
    <p>
      Ideal for campaigns focused on generating measurable e-commerce transactions, app installs, or subscription signups through dedicated promo codes and tracking links.
    </p>
    <div class="formula-box">
      Total Cost = Influencer Fee + Additional Campaign Spend
      <br />
      Gross Revenue = Total Conversions × Average Order Value (AOV)
      <br />
      Net Profit = Gross Revenue - Total Cost
      <br />
      Sales ROI (%) = ((Gross Revenue - Total Cost) / Total Cost) × 100
      <br />
      Customer Acquisition Cost (CAC) = Total Cost / Total Conversions
    </div>

    <h3>Mode 2: Brand Awareness & Earned Media Value (EMV)</h3>
    <p>
      Ideal for top-of-funnel branding, viral product launches, and brand awareness campaigns where views, conversations, and social proof are the primary objectives. It assigns benchmark market costs to audience interactions:
    </p>
    <ul>
      <li><strong>Impressions Valuation:</strong> $15.00 CPM ($0.015 per impression).</li>
      <li><strong>Engagements Valuation:</strong> $0.15 per active interaction (likes, comments, saves, shares).</li>
      <li><strong>Link Clicks Valuation:</strong> $1.00 per qualified outbound website visit.</li>
    </ul>
    <div class="formula-box">
      Earned Media Value (EMV) = (Impressions × 0.015) + (Engagements × 0.15) + (Clicks × 1.00)
      <br />
      Net Media Profit = Earned Media Value - Total Cost
      <br />
      Awareness ROI (%) = ((EMV - Total Cost) / Total Cost) × 100
      <br />
      Effective Cost Per Click (eCPC) = Total Cost / Total Link Clicks
    </div>

    <h2>Step-by-Step Guide: How to Use the Calculator</h2>
    <p>
      Audit any past or upcoming partnership in under one minute:
    </p>

    <div class="step-guide">
      <div class="step-item">
        <h3>Step 1: Choose Your Campaign Focus</h3>
        <p>
          Select <strong>Sales & Conversions</strong> if you have tracking data from affiliate dashboards, Shopify promo codes, or Stripe transactions. Select <strong>Brand Awareness (EMV)</strong> if you want to value impressions, likes, and link traffic.
        </p>
      </div>

      <div class="step-item">
        <h3>Step 2: Enter Campaign Costs</h3>
        <p>
          Input the <strong>Influencer Fee</strong> (the creator's contracted payment) and any <strong>Additional Costs</strong> (product sample COGS, courier shipping, packaging, agency fees, or whitelisting ad spend).
        </p>
      </div>

      <div class="step-item">
        <h3>Step 3: Sourcing and Entering Performance Metrics</h3>
        <p>
          Input your performance metrics from the post analytics:
        </p>
        <ul>
          <li><em>For Sales Mode:</em> Enter total verified purchases (Conversions) and your store's Average Order Value (AOV).</li>
          <li><em>For Awareness Mode:</em> Enter total post impressions/views, total engagements (likes + comments + shares + saves), and outbound link clicks.</li>
        </ul>
      </div>

      <div class="step-item">
        <h3>Step 4: Execute Calculation & Review Breakdown</h3>
        <p>
          Click <strong>Calculate Campaign ROI</strong> to review your net profit/loss, percentage ROI, and unit acquisition efficiency (CAC or eCPC).
        </p>
      </div>
    </div>

    <h2>Realistic ROI Calculation Scenarios</h2>
    <p>

  .btn-input-clear {
    position: absolute;
    right: 0.85rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: rgba(148, 163, 184, 0.2);
    color: var(--color-text-muted, #475569);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-input-clear:hover {
    background: rgba(148, 163, 184, 0.35);
  }

  .clear-svg {
    width: 14px;
    height: 14px;
  }

  /* Sample Domains Row */
  .sample-domains-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sample-label {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-text-muted, #64748b);
  }

  .sample-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sample-chip-btn {
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    border-radius: 8px;
    border: 1px solid var(--color-border, #e2e8f0);
    background: var(--color-bg, #f1f5f9);
    color: var(--color-text, #334155);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sample-chip-btn:hover {
    border-color: var(--color-brand, #2563eb);
    color: var(--color-brand, #2563eb);
    background: rgba(37, 99, 235, 0.08);
  }

  /* Action Buttons Row */
  .action-buttons-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.25rem;
  }

  .btn-action-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0.75rem 1.75rem;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
    border: none;
    border-radius: 14px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }

  .btn-action-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.4);
    opacity: 0.96;
  }

  .btn-action-primary:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .action-btn-svg {
    width: 18px;
    height: 18px;
  }

  .btn-action-reset {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted, #64748b);
    background: transparent;
    border: 1px solid var(--color-border, #cbd5e1);
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-action-reset:hover {
    border-color: #94a3b8;
    color: var(--color-text, #0f172a);
    background: var(--color-bg, #f1f5f9);
  }

  .reset-btn-svg {
    width: 16px;
    height: 16px;
  }

  /* In-Flight Loading State */
  .lookup-loading-state {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--color-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
  }

  .loading-spinner-ring {
    width: 36px;
    height: 36px;
    border: 3.5px solid rgba(37, 99, 235, 0.15);
    border-top-color: var(--color-brand, #2563eb);
    border-radius: 50%;
    animation: cf-spin 0.8s linear infinite;
    flex-shrink: 0;
  }

  @keyframes cf-spin {
    to { transform: rotate(360deg); }
  }

  .loading-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .loading-heading {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .loading-subtext {
    margin: 0;
    font-size: 0.825rem;
    color: var(--color-text-muted, #64748b);
  }

  /* Alerts */
  .alert-box-error {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background: #fef2f2;
    border: 1px solid #fee2e2;
    border-radius: 16px;
  }

  .alert-icon-wrap {
    color: #dc2626;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .alert-svg {
    width: 20px;
    height: 20px;
  }

  .alert-content-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .alert-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #991b1b;
  }

  .alert-message {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: #7f1d1d;
  }

  /* Subdomain Notice Box */
  .subdomain-notice-box {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: #eff6ff;
    border: 1px solid #dbeafe;
    border-radius: 14px;
  }

  .notice-icon-wrap {
    color: #2563eb;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .notice-svg {
    width: 18px;
    height: 18px;
  }

  .notice-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .notice-heading {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: #1e40af;
  }

  .notice-p {
    margin: 0;
    font-size: 0.825rem;
    line-height: 1.5;
    color: #1e3a8a;
  }

  /* ==========================================================================
     RESULTS PRESENTATION
     ========================================================================== */
  .results-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: cf-fade-in 0.25s ease-out;
  }

  @keyframes cf-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Hero Result Card */
  .result-hero-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.07) 0%, rgba(99, 102, 241, 0.07) 100%);
    border: 1.5px solid rgba(37, 99, 235, 0.25);
    border-radius: 20px;
    padding: clamp(1.25rem, 3.5vw, 2rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .result-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .hero-check-svg {
    width: 14px;
    height: 14px;
  }

  .result-domain-title {
    margin: 0.25rem 0 0 0;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    font-weight: 800;
    color: var(--color-text, #0f172a);
    word-break: break-all;
  }

  .result-primary-age {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.5rem, 4vw, 2.35rem);
    font-weight: 900;
    color: var(--color-brand, #2563eb);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .result-secondary-summary {
    margin: 0;
    font-size: 0.925rem;
    color: var(--color-text-muted, #64748b);
  }

  .result-secondary-summary strong {
    color: var(--color-text, #0f172a);
  }

  /* 4-Card Vivid Grid */
  .vivid-result-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 480px) {
    .vivid-result-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 820px) {
    .vivid-result-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    border-radius: 18px;
    padding: 1.25rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    min-width: 0;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.08);
  }

  /* Card Colors */
  .card-blue {
    background: #f0f7ff;
    border: 1px solid #cce3fe;
  }
  .card-purple {
    background: #fbf5ff;
    border: 1px solid #ebd4ff;
  }
  .card-green {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
  }
  .card-amber {
    background: #fffbeb;
    border: 1px solid #fde68a;
  }

  .stat-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    margin-bottom: 0.25rem;
  }

  .stat-icon-circle {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .circle-svg {
    width: 16px;
    height: 16px;
  }

  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-green { background: #dcfce7; color: #15803d; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .stat-badge-tag {
    font-size: 0.675rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .tag-blue { background: #dbeafe; color: #1e40af; }
  .tag-purple { background: #f3e8ff; color: #6b21a8; }
  .tag-green { background: #dcfce7; color: #166534; }
  .tag-amber { background: #fef3c7; color: #92400e; }

  .stat-number-display {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-text, #0f172a);
    word-break: break-word;
  }

  .stat-date-text {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .stat-label-text {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .stat-sub-info {
    font-size: 0.725rem;
    color: var(--color-text-muted, #64748b);
  }

  /* Technical Metadata Block */
  .tech-metadata-block {
    background: var(--color-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 18px;
    padding: 1.25rem;
  }

  .metadata-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .metadata-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .meta-svg {
    width: 17px;
    height: 17px;
    color: var(--color-brand, #2563eb);
  }

  .meta-pill-rfc {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--color-bg-card, #ffffff);
    border: 1px solid var(--color-border, #cbd5e1);
    color: var(--color-text-muted, #475569);
  }

  .metadata-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    text-align: left;
  }

  .metadata-data-table th {
    width: 32%;
    min-width: 170px;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: var(--color-text-muted, #475569);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    background: transparent;
  }

  .metadata-data-table td {
    padding: 0.75rem 1rem;
    color: var(--color-text, #0f172a);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    word-break: break-word;
  }

  .metadata-data-table tr:last-child th,
  .metadata-data-table tr:last-child td {
    border-bottom: none;
  }

  .mono-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
  }

  .break-all {
    word-break: break-all;
  }

  .status-tags-cell {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .status-tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    font-size: 0.725rem;
    font-weight: 600;
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-brand, #2563eb);
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  /* Disclaimer Callout */
  .disclaimer-callout-card {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 16px;
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .disclaimer-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #92400e;
  }

  .disc-svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }

  .disclaimer-header h4 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: #92400e;
  }

  .disclaimer-callout-card p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #78350f;
  }

  /* ==========================================================================
     3. EDITORIAL ARTICLE SECTION (Centered Max-Width 940px)
     ========================================================================== */
  .editorial-content-section {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .editorial-inner {
    max-width: 940px;
    margin: 0 auto;
    padding-left: clamp(0.75rem, 3vw, 1.5rem);
    padding-right: clamp(0.75rem, 3vw, 1.5rem);
    box-sizing: border-box;
  }

  .editorial-block {
    margin-bottom: 3rem;
  }

  .editorial-block h2 {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.4rem, 2.7vw, 1.85rem);
    font-weight: 800;
    color: var(--color-text, #0f172a);
    line-height: 1.25;
    margin: 0 0 1rem 0;
    letter-spacing: -0.015em;
  }

  .editorial-block h3 {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 700;
    color: var(--color-text, #0f172a);
    line-height: 1.35;
    margin: 1.75rem 0 0.65rem 0;
  }

  .editorial-block p {
    font-size: clamp(0.925rem, 1.8vw, 1rem);
    line-height: 1.75;
    color: var(--color-text, #334155);
    margin: 0 0 1.25rem 0;
  }

  .editorial-block p strong {
    color: var(--color-text, #0f172a);
  }

  .editorial-block a {
    color: var(--color-brand, #2563eb);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .editorial-block a:hover {
    color: #1d4ed8;
  }

  .editorial-block ul, .editorial-block ol {
    margin: 0 0 1.5rem 0;
    padding-left: 1.35rem;
  }

  .editorial-block li {
    font-size: clamp(0.925rem, 1.8vw, 1rem);
    line-height: 1.7;
    color: var(--color-text, #334155);
    margin-bottom: 0.65rem;
  }

  .editorial-block li strong {
    color: var(--color-text, #0f172a);
  }

  .editorial-block blockquote {
    margin: 1.5rem 0;
    padding: 1.15rem 1.5rem;
    border-left: 4px solid var(--color-brand, #2563eb);
    background: var(--color-bg, #f8fafc);
    border-radius: 0 14px 14px 0;
    font-style: italic;
  }

  .editorial-block blockquote p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text, #1e293b);
  }

  /* Editorial Data Table */
  .table-responsive {
    width: 100%;
    overflow-x: auto;
    margin: 1.5rem 0;
    border-radius: 14px;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .editorial-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
    white-space: nowrap;
  }

  .editorial-data-table th {
    background: var(--color-bg-alt, #f8fafc);
    padding: 0.85rem 1rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .editorial-data-table td {
    padding: 0.85rem 1rem;
    color: var(--color-text, #334155);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .editorial-data-table tr:last-child td {
    border-bottom: none;
  }

  .editorial-data-table tr:hover td {
    background: var(--color-bg-alt, #f8fafc);
  }

  /* Lifecycle 3-Card Grid */
  .lifecycle-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 768px) {
    .lifecycle-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lifecycle-card {
    background: var(--color-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .lifecycle-badge {
    align-self: flex-start;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .badge-green { background: #dcfce7; color: #166534; }
  .badge-blue { background: #dbeafe; color: #1e40af; }
  .badge-amber { background: #fef3c7; color: #92400e; }

  .lifecycle-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .lifecycle-card p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  /* ==========================================================================
     4. FAQ SECTION (Centered Max-Width 940px)
     ========================================================================== */
  .tool-faq-section {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-border, #e2e8f0);
  }

  .faq-inner {
    max-width: 940px;
    margin: 0 auto;
    padding-left: clamp(0.75rem, 3vw, 1.5rem);
    padding-right: clamp(0.75rem, 3vw, 1.5rem);
    box-sizing: border-box;
  }

  .faq-header-wrap {
    text-align: center;
    margin-bottom: 2rem;
  }

  .faq-headline {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--color-text, #0f172a);
    margin: 0 0 0.5rem 0;
  }

  .faq-subhead {
    font-size: 0.95rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  .faq-accordion-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-accordion-item {
    background: var(--color-bg-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .faq-accordion-item:hover {
    border-color: #cbd5e1;
  }

  .faq-accordion-item[open] {
    border-color: var(--color-brand, #2563eb);
    box-shadow: 0 4px 15px -3px rgba(37, 99, 235, 0.08);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.35rem;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.975rem;
    color: var(--color-text, #0f172a);
    user-select: none;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    width: 18px;
    height: 18px;
    color: var(--color-brand, #2563eb);
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-left: 0.75rem;
  }

  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-body {

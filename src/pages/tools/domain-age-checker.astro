<script>
  // Known second-level public suffixes for apex registered domain resolution
  const TWO_PART_SUFFIXES = new Set([
    'co.uk', 'org.uk', 'me.uk', 'gov.uk', 'ac.uk', 'net.uk', 'ltd.uk', 'plc.uk',
    'com.au', 'net.au', 'org.au', 'edu.au', 'gov.au',
    'co.nz', 'org.nz', 'net.nz',
    'co.za', 'org.za',
    'co.in', 'net.in', 'org.in', 'gen.in', 'ind.in',
    'com.br', 'net.br', 'org.br',
    'co.jp', 'ne.jp', 'or.jp',
    'com.sg', 'org.sg',
    'com.mx', 'org.mx',
    'com.tw', 'org.tw'
  ]);

  // Comprehensive static fallback dictionary for top TLDs (RFC 9083 compliance)
  const FALLBACK_REGISTRY: Record<string, string> = {
    'com': 'https://rdap.verisign.com/com/v1/',
    'net': 'https://rdap.verisign.com/net/v1/',
    'org': 'https://rdap.publicinterestregistry.org/rdap/',
    'io': 'https://rdap.identitydigital.services/rdap/',
    'co': 'https://rdap.identitydigital.services/rdap/',
    'me': 'https://rdap.identitydigital.services/rdap/',
    'info': 'https://rdap.identitydigital.services/rdap/',
    'biz': 'https://rdap.identitydigital.services/rdap/',
    'mobi': 'https://rdap.identitydigital.services/rdap/',
    'pro': 'https://rdap.identitydigital.services/rdap/',
    'dev': 'https://pubapi.registry.google/rdap/',
    'app': 'https://pubapi.registry.google/rdap/',
    'page': 'https://pubapi.registry.google/rdap/',
    'how': 'https://pubapi.registry.google/rdap/',
    'soy': 'https://pubapi.registry.google/rdap/',
    'xyz': 'https://rdap.centralnic.com/',
    'online': 'https://rdap.centralnic.com/',
    'site': 'https://rdap.centralnic.com/',
    'store': 'https://rdap.centralnic.com/',
    'tech': 'https://rdap.centralnic.com/',
    'website': 'https://rdap.centralnic.com/',
    'space': 'https://rdap.centralnic.com/',
    'fun': 'https://rdap.centralnic.com/',
    'icu': 'https://rdap.centralnic.com/',
    'uk': 'https://rdap.nominet.uk/uk/',
    'ca': 'https://rdap.cira.ca/',
    'fr': 'https://rdap.afnic.fr/',
    'in': 'https://rdap.registry.in/',
    'eu': 'https://rdap.eurid.eu/',
    'nl': 'https://rdap.sidn.nl/',
    'ai': 'https://rdap.identitydigital.services/rdap/',
    'tv': 'https://rdap.verisign.com/tv/v1/',
    'cc': 'https://rdap.verisign.com/cc/v1/',
    'us': 'https://rdap.nic.us/'
  };

  interface RdapEvent {
    eventAction: string;
    eventDate: string;
  }

  interface RdapEntity {
    roles?: string[];
    handle?: string;
    vcardArray?: any[];
  }

  interface RdapResponse {
    ldhName?: string;
    status?: string[];
    events?: RdapEvent[];
    entities?: RdapEntity[];
    nameservers?: Array<{ ldhName?: string }>;
    errorCode?: number;
    title?: string;
    description?: string[];
  }

  let ianaBootstrapData: { services: Array<[string[], string[]]> } | null = null;
  let activeAbortController: AbortController | null = null;

  async function loadIanaBootstrap(): Promise<{ services: Array<[string[], string[]]> } | null> {
    if (ianaBootstrapData) return ianaBootstrapData;

    // Check sessionStorage cache
    try {
      const cached = sessionStorage.getItem('cf_iana_rdap_dns_v1');
      if (cached) {
        const parsed = JSON.parse(cached);
        if (parsed && Array.isArray(parsed.services) && parsed.services.length > 0) {
          ianaBootstrapData = parsed;
          return ianaBootstrapData;
        }
      }
    } catch (_) {}

    // Fetch official IANA bootstrap registry
    try {
      const res = await fetch('https://data.iana.org/rdap/dns.json', { cache: 'default' });
      if (res.ok) {
        const data = await res.json();
        if (data && Array.isArray(data.services)) {
          ianaBootstrapData = data;
          try {
            sessionStorage.setItem('cf_iana_rdap_dns_v1', JSON.stringify(data));
          } catch (_) {}
          return ianaBootstrapData;
        }
      }
    } catch (err) {
      console.warn('Live IANA bootstrap lookup unavailable, using fallback registry map', err);
    }

    return null;
  }

  function resolveAuthoritativeRdapUrl(tldSuffix: string, bootstrap: { services: Array<[string[], string[]]> } | null): string | null {
    const cleanTld = tldSuffix.toLowerCase();

    // 1. Check IANA bootstrap services using longest-suffix matching
    if (bootstrap && Array.isArray(bootstrap.services)) {
      for (const service of bootstrap.services) {
        const [suffixes, urls] = service;
        if (Array.isArray(suffixes) && suffixes.includes(cleanTld)) {
          // Prefer HTTPS URL
          const httpsUrl = urls.find(u => u.startsWith('https://')) || urls[0];
          if (httpsUrl) {
            return httpsUrl.endsWith('/') ? httpsUrl : httpsUrl + '/';
          }
        }
      }
    }

    // 2. Check fallback registry dictionary
    if (FALLBACK_REGISTRY[cleanTld]) {
      const fbUrl = FALLBACK_REGISTRY[cleanTld];
      return fbUrl.endsWith('/') ? fbUrl : fbUrl + '/';
    }

    return null;
  }

  function normalizeDomainInput(rawInput: string): { 
    valid: boolean; 
    error?: string; 
    inputHost: string; 
    registeredDomain: string; 
    tld: string; 
    isSubdomain: boolean 
  } {
    let clean = rawInput.trim();
    if (!clean) {
      return { valid: false, error: 'Please enter a domain name to check.', inputHost: '', registeredDomain: '', tld: '', isSubdomain: false };
    }

    // Strip scheme, paths, query, fragments
    try {
      if (!clean.includes('://') && !clean.startsWith('//')) {
        clean = 'http://' + clean;
      }
      const parsedUrl = new URL(clean);
      clean = parsedUrl.hostname.toLowerCase();
    } catch (_) {
      // Clean manually if URL constructor fails on unconventional input
      clean = clean.replace(/^[a-zA-Z]+:\/\//, '').split('/')[0].split('?')[0].split('#')[0].toLowerCase();
    }

    // Remove trailing dot if present
    if (clean.endsWith('.')) clean = clean.slice(0, -1);

    // Reject IP addresses (IPv4 & IPv6)
    const ipv4Regex = /^(\d{1,3}\.){3}\d{1,3}$/;
    if (ipv4Regex.test(clean) || clean.includes(':')) {
      return { valid: false, error: 'IP addresses do not have domain registration records. Please enter a domain name (e.g., example.com).', inputHost: clean, registeredDomain: '', tld: '', isSubdomain: false };
    }

    // Reject localhost and local/private networks
    if (clean === 'localhost' || clean.endsWith('.local') || clean.endsWith('.internal') || clean.endsWith('.test') || clean.endsWith('.example') || clean.endsWith('.invalid')) {
      return { valid: false, error: 'Local and internal hostnames cannot be resolved via public RDAP registries.', inputHost: clean, registeredDomain: '', tld: '', isSubdomain: false };
    }

    // Ensure valid domain format with at least one dot
    if (!clean.includes('.') || clean.startsWith('.') || clean.endsWith('.')) {
      return { valid: false, error: 'Please enter a valid domain name with an extension (e.g., example.com or bbc.co.uk).', inputHost: clean, registeredDomain: '', tld: '', isSubdomain: false };
    }

    const parts = clean.split('.');

    // Determine apex registered domain
    let tld = parts[parts.length - 1];
    let registeredDomain = clean;
    let isSubdomain = false;

    // Check for two-part suffix (e.g. bbc.co.uk)
    if (parts.length >= 3) {
      const candidateTwoPart = parts.slice(parts.length - 2).join('.');
      if (TWO_PART_SUFFIXES.has(candidateTwoPart)) {
        tld = parts[parts.length - 1]; // In IANA bootstrap, Nominet registers 'uk'
        registeredDomain = parts.slice(parts.length - 3).join('.');
        isSubdomain = parts.length > 3;
      } else {
        registeredDomain = parts.slice(parts.length - 2).join('.');
        isSubdomain = parts.length > 2;
      }
    } else if (parts.length === 2) {
      registeredDomain = clean;
      isSubdomain = false;
    }

    return {
      valid: true,
      inputHost: clean,
      registeredDomain,
      tld,
      isSubdomain
    };
  }

  function calculateAge(regIsoString: string): { 
    valid: boolean; 
    error?: string; 
    years: number; 
    months: number; 
    days: number; 
    totalDays: number;
    regFormatted: string;
    regIso: string;
  } {
    const regDate = new Date(regIsoString);
    if (isNaN(regDate.getTime())) {
      return { valid: false, error: 'The registration date returned by RDAP is invalid or unreadable.', years: 0, months: 0, days: 0, totalDays: 0, regFormatted: '', regIso: '' };
    }

    const now = new Date();

    const regYear = regDate.getUTCFullYear();
    const regMonth = regDate.getUTCMonth();
    const regDay = regDate.getUTCDate();

    const nowYear = now.getUTCFullYear();
    const nowMonth = now.getUTCMonth();
    const nowDay = now.getUTCDate();

    const utcReg = Date.UTC(regYear, regMonth, regDay);
    const utcNow = Date.UTC(nowYear, nowMonth, nowDay);
    const totalDays = Math.floor((utcNow - utcReg) / (1000 * 60 * 60 * 24));

    if (totalDays < 0) {
      return { valid: false, error: 'The registration timestamp is reported in the future by the registry.', years: 0, months: 0, days: 0, totalDays: 0, regFormatted: '', regIso: '' };
    }

    let years = nowYear - regYear;
    let months = nowMonth - regMonth;
    let days = nowDay - regDay;

    if (days < 0) {
      months -= 1;
      // Days in previous month
      const prevMonthDays = new Date(Date.UTC(nowYear, nowMonth, 0)).getUTCDate();
      days += prevMonthDays;
    }

    if (months < 0) {
      years -= 1;
      months += 12;
    }

    const monthsNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const fullMonths = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    
    const regFormatted = `${fullMonths[regMonth]} ${regDay}, ${regYear}`;

    return {
      valid: true,
      years,
      months,
      days,
      totalDays,
      regFormatted,
      regIso: regDate.toISOString()
    };
  }

  function formatDateUtc(isoString: string): string {
    const d = new Date(isoString);
    if (isNaN(d.getTime())) return 'Not reported';
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return `${months[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`;
  }

  function initDomainAgeChecker() {
    const form = document.getElementById('domain-lookup-form') as HTMLFormElement | null;
    const input = document.getElementById('domain-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('btn-clear-input') as HTMLButtonElement | null;
    const submitBtn = document.getElementById('btn-submit-lookup') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text-label') as HTMLSpanElement | null;
    const resetBtn = document.getElementById('btn-reset-tool') as HTMLButtonElement | null;
    
    const loadingBox = document.getElementById('lookup-loading-box');
    const loadingStatus = document.getElementById('loading-status-message');
    const errorBanner = document.getElementById('lookup-error-banner');
    const errorTitle = document.getElementById('error-banner-title');
    const errorDesc = document.getElementById('error-banner-desc');
    const subdomainBox = document.getElementById('subdomain-notice-banner');
    const noticeInputHost = document.getElementById('notice-input-host');
    const noticeRootHost = document.getElementById('notice-root-host');
    
    const resultsContainer = document.getElementById('lookup-results-container');
    const sampleBtns = document.querySelectorAll('.sample-chip-btn');

    if (!form || !input) return;

    function showError(title: string, desc: string) {
      if (errorTitle) errorTitle.textContent = title;
      if (errorDesc) errorDesc.textContent = desc;
      errorBanner?.classList.remove('hidden');
      resultsContainer?.classList.add('hidden');
      subdomainBox?.classList.add('hidden');
    }

    function hideError() {
      errorBanner?.classList.add('hidden');
    }

    function resetUI() {
      hideError();
      subdomainBox?.classList.add('hidden');
      resultsContainer?.classList.add('hidden');
      loadingBox?.classList.add('hidden');
      if (input) input.value = '';
      clearBtn?.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Check Domain Age';
      if (activeAbortController) {
        activeAbortController.abort();
        activeAbortController = null;
      }
    }

    // Input text changes -> manage clear button visibility
    input.addEventListener('input', () => {
      if (input.value.trim().length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      clearBtn.classList.add('hidden');
      input.focus();
    });

    resetBtn?.addEventListener('click', resetUI);

    // Preset sample domain chips
    sampleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const domain = btn.getAttribute('data-sample');
        if (domain && input) {
          input.value = domain;
          clearBtn?.classList.remove('hidden');
          runLookup(domain);
        }
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      runLookup(input.value);
    });

    async function runLookup(rawQuery: string) {
      hideError();
      subdomainBox?.classList.add('hidden');
      resultsContainer?.classList.add('hidden');

      const norm = normalizeDomainInput(rawQuery);
      if (!norm.valid) {
        showError('Invalid Domain Format', norm.error || 'Please enter a valid domain name.');
        return;
      }

      // Abort previous in-flight request if any
      if (activeAbortController) {
        activeAbortController.abort();
      }
      activeAbortController = new AbortController();
      const signal = activeAbortController.signal;

      // Update button state & show loading
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Querying Registry...';
      loadingBox?.classList.remove('hidden');
      if (loadingStatus) loadingStatus.textContent = `Resolving IANA RDAP registry for .${norm.tld}...`;

      try {
        // Step 1: Load IANA DNS Bootstrap registry
        const bootstrap = await loadIanaBootstrap();

        // Step 2: Match TLD to Authoritative RDAP Service URL
        const rdapBaseUrl = resolveAuthoritativeRdapUrl(norm.tld, bootstrap);
        if (!rdapBaseUrl) {
          throw new Error(`The top-level domain '.${norm.tld}' is not listed in the IANA RDAP registry. Many ccTLDs and legacy registries have not yet deployed public RDAP endpoints.`);
        }

        if (loadingStatus) {
          loadingStatus.textContent = `Connecting to ${new URL(rdapBaseUrl).hostname}...`;
        }

        // Step 3: Query authoritative RDAP endpoint for registered apex domain
        const endpointUrl = `${rdapBaseUrl}domain/${encodeURIComponent(norm.registeredDomain)}`;

        // Set a 10s fetch timeout
        const timeoutId = setTimeout(() => {
          activeAbortController?.abort();
        }, 10000);

        let res: Response;
        try {
          res = await fetch(endpointUrl, {
            headers: { 'Accept': 'application/rdap+json, application/json' },
            signal
          });
        } catch (fetchErr: any) {
          clearTimeout(timeoutId);
          if (fetchErr.name === 'AbortError') {
            throw new Error(`Connection timed out while querying the authoritative RDAP server (${new URL(rdapBaseUrl).hostname}). The registry server may be experiencing high load.`);
          }
          throw new Error(`Network failure or browser security policy prevented connecting to ${rdapBaseUrl}. Please verify your connection or try again.`);
        }
        clearTimeout(timeoutId);

        // Handle HTTP response codes
        if (res.status === 404) {
          throw new Error(`Domain not found. '${norm.registeredDomain}' does not exist in the authoritative .${norm.tld} RDAP database or is currently available for registration.`);
        } else if (res.status === 429) {
          throw new Error(`Rate limit exceeded by authoritative RDAP service (${new URL(rdapBaseUrl).hostname}). Please wait a minute before querying again.`);
        } else if (res.status >= 500) {
          throw new Error(`The authoritative RDAP registry (${new URL(rdapBaseUrl).hostname}) encountered an internal server error (HTTP ${res.status}).`);
        } else if (!res.ok) {
          throw new Error(`RDAP query failed with HTTP status ${res.status} from ${new URL(rdapBaseUrl).hostname}.`);
        }

        // Step 4: Parse RDAP response JSON
        const rdapData: RdapResponse = await res.json();

        // Step 5: Locate registration event
        const events = Array.isArray(rdapData.events) ? rdapData.events : [];
        const regEvent = events.find(e => e.eventAction && e.eventAction.toLowerCase() === 'registration');

        if (!regEvent || !regEvent.eventDate) {
          throw new Error(`The authoritative registry returned domain records for '${norm.registeredDomain}', but omitted a verified 'registration' creation timestamp.`);
        }

        // Step 6: Accurate calendar age calculation
        const ageResult = calculateAge(regEvent.eventDate);
        if (!ageResult.valid) {
          throw new Error(ageResult.error || 'Unable to calculate domain age from registration date.');
        }

        // Extract optional lifecycle events
        const expEvent = events.find(e => e.eventAction && e.eventAction.toLowerCase() === 'expiration');
        const updatedEvent = events.find(e => e.eventAction && (e.eventAction.toLowerCase() === 'last changed' || e.eventAction.toLowerCase() === 'last update'));

        // Extract registrar name
        let registrarName = 'Not disclosed in public RDAP record';
        if (Array.isArray(rdapData.entities)) {
          const regEntity = rdapData.entities.find(ent => ent.roles && ent.roles.includes('registrar'));
          if (regEntity) {
            if (Array.isArray(regEntity.vcardArray) && regEntity.vcardArray[1]) {
              const fnEntry = regEntity.vcardArray[1].find((item: any) => item[0] === 'fn');
              if (fnEntry && fnEntry[3]) {
                registrarName = fnEntry[3];
              }
            }
            if (registrarName === 'Not disclosed in public RDAP record' && regEntity.handle) {
              registrarName = regEntity.handle;
            }
          }
        }

        // Step 7: Populate UI
        loadingBox?.classList.add('hidden');

        // Subdomain notice if user entered a subdomain
        if (norm.isSubdomain) {
          if (noticeInputHost) noticeInputHost.textContent = norm.inputHost;
          if (noticeRootHost) noticeRootHost.textContent = norm.registeredDomain;
          subdomainBox?.classList.remove('hidden');
        } else {
          subdomainBox?.classList.add('hidden');
        }

        // Hero result card
        const resDisplayDomain = document.getElementById('res-display-domain');
        const resPrimaryAge = document.getElementById('res-primary-age-badge');
        const resSecondary = document.getElementById('res-secondary-summary');

        if (resDisplayDomain) resDisplayDomain.textContent = norm.registeredDomain;
        if (resPrimaryAge) {
          const ageParts = [];
          if (ageResult.years > 0) ageParts.push(`${ageResult.years} ${ageResult.years === 1 ? 'Year' : 'Years'}`);
          if (ageResult.months > 0) ageParts.push(`${ageResult.months} ${ageResult.months === 1 ? 'Month' : 'Months'}`);
          ageParts.push(`${ageResult.days} ${ageResult.days === 1 ? 'Day' : 'Days'}`);
          resPrimaryAge.textContent = `${ageParts.join(', ')} Old`;
        }
        if (resSecondary) {
          resSecondary.innerHTML = `Registered on <strong>${ageResult.regFormatted}</strong> (${ageResult.totalDays.toLocaleString()} total days elapsed)`;
        }

        // Stat cards
        const statYears = document.getElementById('stat-calendar-years');
        const statMonthsDays = document.getElementById('stat-calendar-months-days');
        const statTotalDays = document.getElementById('stat-total-days');
        const statRegDate = document.getElementById('stat-reg-date');
        const statRegUtc = document.getElementById('stat-reg-utc');
        const statExpDate = document.getElementById('stat-exp-date');
        const statExpSub = document.getElementById('stat-exp-sub');

        if (statYears) statYears.textContent = `${ageResult.years} ${ageResult.years === 1 ? 'Year' : 'Years'}`;
        if (statMonthsDays) statMonthsDays.textContent = `${ageResult.months} Mo, ${ageResult.days} Days`;
        if (statTotalDays) statTotalDays.textContent = ageResult.totalDays.toLocaleString();
        if (statRegDate) statRegDate.textContent = formatDateUtc(regEvent.eventDate);
        if (statRegUtc) statRegUtc.textContent = `UTC: ${regEvent.eventDate.split('T')[0]}`;
        
        if (expEvent && expEvent.eventDate) {
          if (statExpDate) statExpDate.textContent = formatDateUtc(expEvent.eventDate);
          if (statExpSub) statExpSub.textContent = `Expires ${expEvent.eventDate.split('T')[0]}`;
        } else {
          if (statExpDate) statExpDate.textContent = 'Not Reported';
          if (statExpSub) statExpSub.textContent = 'Private or omitted by registry';
        }

        // Metadata Table
        const metaQueried = document.getElementById('meta-queried-host');
        const metaApex = document.getElementById('meta-apex-domain');
        const metaService = document.getElementById('meta-rdap-service');
        const metaRegTime = document.getElementById('meta-reg-timestamp');
        const metaUpdatedTime = document.getElementById('meta-updated-timestamp');
        const metaExpTime = document.getElementById('meta-exp-timestamp');
        const metaRegistrar = document.getElementById('meta-registrar-name');
        const metaStatus = document.getElementById('meta-domain-status');
        const metaNs = document.getElementById('meta-nameservers');

        if (metaQueried) metaQueried.textContent = norm.inputHost;
        if (metaApex) metaApex.textContent = norm.registeredDomain;
        if (metaService) metaService.textContent = rdapBaseUrl;
        if (metaRegTime) metaRegTime.textContent = regEvent.eventDate;
        if (metaUpdatedTime) metaUpdatedTime.textContent = updatedEvent ? updatedEvent.eventDate : 'Not reported by registry';
        if (metaExpTime) metaExpTime.textContent = expEvent ? expEvent.eventDate : 'Not reported by registry';
        if (metaRegistrar) metaRegistrar.textContent = registrarName;

        // Status tags
        if (metaStatus) {
          metaStatus.innerHTML = '';
          const statusList = Array.isArray(rdapData.status) && rdapData.status.length > 0 ? rdapData.status : ['active'];
          statusList.forEach(st => {
            const span = document.createElement('span');
            span.className = 'status-tag';
            span.textContent = st;
            metaStatus.appendChild(span);
          });
        }

        // Nameservers
        if (metaNs) {
          if (Array.isArray(rdapData.nameservers) && rdapData.nameservers.length > 0) {
            const nsList = rdapData.nameservers.map(ns => ns.ldhName).filter(Boolean);
            metaNs.textContent = nsList.length > 0 ? nsList.join(', ') : 'None reported';
          } else {
            metaNs.textContent = 'None reported by registry';
          }
        }

        resultsContainer?.classList.remove('hidden');

      } catch (err: any) {
        loadingBox?.classList.add('hidden');
        showError('Registration Lookup Notice', err.message || 'An unexpected error occurred while querying RDAP registration data.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Check Domain Age';
        activeAbortController = null;
      }
    }
  }

  initDomainAgeChecker();
  document.addEventListener('astro:after-swap', initDomainAgeChecker);
</script>

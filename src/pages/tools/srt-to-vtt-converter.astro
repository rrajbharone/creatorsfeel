  .verdict-icon {
    font-size: 1.4rem;
  }

  .verdict-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .verdict-title {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .verdict-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* 4 Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .metric-card {
    padding: 0.8rem 0.6rem;
    text-align: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: border-color var(--transition-fast);
  }

  .metric-card:hover {
    border-color: var(--color-border-hover);
  }

  .metric-value {
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-brand);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.2rem;
  }

  .metric-sub {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Converted WebVTT Output Code Box */
  .vtt-output-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .output-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .output-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .output-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .vtt-output-code {
    width: 100%;
    min-height: 180px;
    padding: 0.9rem;
    font-family: monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    outline: none;
    resize: vertical;
    box-sizing: border-box;
  }

  .output-actions-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  /* Editorial Content Styles */
  .editorial-section {
    padding-top: 1.5rem;
  }

  .editorial-section h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .editorial-section p {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .editorial-section ul, .editorial-section ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .editorial-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .editorial-section code, .editorial-section pre {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
    font-family: monospace;
  }

  .editorial-section pre {
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .editorial-section pre code {
    background: transparent;
    padding: 0;
    border: none;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .editorial-table th, .editorial-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .editorial-table th {
    background: var(--color-bg-alt);
    font-weight: 700;
  }

  .editorial-table tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .internal-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-link-card {
    display: block;
    padding: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedFileBar = document.getElementById('loaded-file-bar');
    const loadedFilename = document.getElementById('loaded-filename');
    const loadedFilesize = document.getElementById('loaded-filesize');
    const btnClearFile = document.getElementById('btn-clear-file');

    const srtInput = document.getElementById('srt-input') as HTMLTextAreaElement | null;
    const btnConvert = document.getElementById('btn-convert');
    const btnClearAll = document.getElementById('btn-clear-all');

    // Audit Displays
    const verdictBanner = document.getElementById('verdict-banner');
    const verdictIcon = document.getElementById('verdict-icon');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictDesc = document.getElementById('verdict-desc');

    const resCueCount = document.getElementById('res-cue-count');
    const resCueSub = document.getElementById('res-cue-sub');
    const resDuration = document.getElementById('res-duration');
    const vttOutput = document.getElementById('vtt-output') as HTMLTextAreaElement | null;

    const btnDownloadVtt = document.getElementById('btn-download-vtt');
    const btnCopyVtt = document.getElementById('btn-copy-vtt');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (!srtInput) return;

    let activeFileName = 'subtitles.vtt';

    // Drag & Drop Handling
    if (dropzone && fileInput) {
      ['dragenter', 'dragover'].forEach(evtName => {
        dropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach(evtName => {
        dropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e: DragEvent) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          readSrtFile(dt.files[0]);
        }
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          readSrtFile(fileInput.files[0]);
        }
      });
    }

    if (btnClearFile) {
      btnClearFile.addEventListener('click', (e) => {
        e.stopPropagation();
        if (fileInput) fileInput.value = '';
        if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
        if (loadedFileBar) loadedFileBar.style.display = 'none';
        activeFileName = 'subtitles.vtt';
      });
    }

    function readSrtFile(file: File) {
      if (!file) return;
      
      const kbSize = (file.size / 1024).toFixed(1);
      if (loadedFilename) loadedFilename.textContent = file.name;
      if (loadedFilesize) loadedFilesize.textContent = `${kbSize} KB`;

      const baseName = file.name.replace(/\.[^/.]+$/, "");
      activeFileName = `${baseName}.vtt`;

      const reader = new FileReader();
      reader.onload = (evt) => {
        const text = evt.target?.result as string;
        if (srtInput) srtInput.value = text;

        if (dropzonePrompt) dropzonePrompt.style.display = 'none';
        if (loadedFileBar) loadedFileBar.style.display = 'flex';

        processConversion();
      };
      reader.readAsText(file);
    }

    // High-Accuracy Client-Side SRT to WebVTT Conversion Engine
    function processConversion() {
      if (!srtInput || !vttOutput) return;

      const rawSrt = srtInput.value;
      if (!rawSrt.trim()) {
        showErrorVerdict('No Subtitle Text Entered', 'Please upload an SRT file or paste SRT text on the left.');
        vttOutput.value = '';
        if (resCueCount) resCueCount.textContent = '0 Cues';
        if (resDuration) resDuration.textContent = '00:00';
        return;
      }

      try {
        const result = convertSrtToVtt(rawSrt);
        vttOutput.value = result.vttText;

        if (resCueCount) resCueCount.textContent = `${result.cueCount} ${result.cueCount === 1 ? 'Cue' : 'Cues'}`;
        if (resCueSub) resCueSub.textContent = 'Parsed Blocks';
        if (resDuration) resDuration.textContent = result.durationStr;

        showSuccessVerdict(
          'Successfully Converted to WebVTT!',
          `Converted ${result.cueCount} subtitle cues with 100% W3C WebVTT syntax compliance.`
        );
      } catch (err: any) {
        vttOutput.value = '';
        if (resCueCount) resCueCount.textContent = '0 Cues';
        if (resDuration) resDuration.textContent = '00:00';
        showErrorVerdict('Invalid SRT Subtitle Format', err.message || 'The provided text does not contain valid SRT timestamps.');
      }
    }

    function convertSrtToVtt(srtText: string): { vttText: string; cueCount: number; durationStr: string } {
      const normalized = srtText.replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();
      if (!normalized) {
        throw new Error('Input text or file is empty.');
      }

      const blocks = normalized.split(/\n\s*\n/);
      const vttLines: string[] = ['WEBVTT', ''];
      let validCueCount = 0;
      let firstStartSec = Infinity;
      let lastEndSec = 0;

      for (let i = 0; i < blocks.length; i++) {
        const block = blocks[i].trim();
        if (!block) continue;

        const lines = block.split('\n').map(l => l.trim());
        let arrowLineIdx = -1;

        for (let j = 0; j < lines.length; j++) {
          if (lines[j].includes('-->')) {
            arrowLineIdx = j;
            break;
          }
        }

        if (arrowLineIdx === -1) continue;

        const cueId = lines.slice(0, arrowLineIdx).join(' ');
        const timeLine = lines[arrowLineIdx];

        // Replace comma timestamps with period timestamps
        const vttTimeLine = timeLine
          .replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, '$1.$2')
          .replace(/(\d{2}:\d{2}),(\d{3})/g, '$1.$2');

        const timeMatch = vttTimeLine.match(/(\d{2}:\d{2}:\d{2}\.\d{3}|\d{2}:\d{2}\.\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2}\.\d{3}|\d{2}:\d{2}\.\d{3})/);
        if (timeMatch) {
          const startSec = timeToSeconds(timeMatch[1]);
          const endSec = timeToSeconds(timeMatch[2]);
          if (startSec < firstStartSec) firstStartSec = startSec;
          if (endSec > lastEndSec) lastEndSec = endSec;
        }

        const payloadText = lines.slice(arrowLineIdx + 1).join('\n');

        if (cueId && !isNaN(Number(cueId))) {
          vttLines.push(cueId);
        }
        vttLines.push(vttTimeLine);
        vttLines.push(payloadText);
        vttLines.push('');
        validCueCount++;
      }

      if (validCueCount === 0) {
        throw new Error('No valid SRT timestamps (e.g. 00:00:01,000 --> 00:00:04,000) were found.');
      }

      const durationStr = formatDuration(lastEndSec);

      return {
        vttText: vttLines.join('\n').trim() + '\n',
        cueCount: validCueCount,
        durationStr: durationStr
      };
    }

    function timeToSeconds(tStr: string): number {
      const parts = tStr.split(':');
      if (parts.length === 3) {
        const h = parseFloat(parts[0]);
        const m = parseFloat(parts[1]);
        const s = parseFloat(parts[2]);
        return h * 3600 + m * 60 + s;
      } else if (parts.length === 2) {
        const m = parseFloat(parts[0]);
        const s = parseFloat(parts[1]);
        return m * 60 + s;
      }
      return 0;
    }

    function formatDuration(sec: number): string {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      const mm = m < 10 ? `0${m}` : `${m}`;
      const ss = s < 10 ? `0${s}` : `${s}`;
      return `${mm}:${ss}`;
    }

    function showSuccessVerdict(title: string, desc: string) {
      if (verdictBanner && verdictTitle && verdictDesc && verdictIcon) {
        verdictBanner.className = 'verdict-banner success-verdict';
        verdictIcon.textContent = '✅';
        verdictTitle.textContent = title;
        verdictDesc.textContent = desc;
      }
    }

    function showErrorVerdict(title: string, desc: string) {
      if (verdictBanner && verdictTitle && verdictDesc && verdictIcon) {
        verdictBanner.className = 'verdict-banner danger-verdict';
        verdictIcon.textContent = '❌';
        verdictTitle.textContent = title;
        verdictDesc.textContent = desc;
      }
    }

    // Convert button handler
    if (btnConvert) {
      btnConvert.addEventListener('click', processConversion);
    }

    // Live conversion on input typing/pasting
    ['input', 'change'].forEach(evt => {
      srtInput.addEventListener(evt, processConversion);
    });

    // Clear all handler
    if (btnClearAll) {
      btnClearAll.addEventListener('click', () => {
        srtInput.value = '';
        if (fileInput) fileInput.value = '';
        if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
        if (loadedFileBar) loadedFileBar.style.display = 'none';
        activeFileName = 'subtitles.vtt';
        processConversion();
      });
    }

    // Download VTT File Handler
    if (btnDownloadVtt) {
      btnDownloadVtt.addEventListener('click', () => {
        if (!vttOutput || !vttOutput.value.trim()) {
          alert('No converted WebVTT content available to download.');
          return;
        }

        const blob = new Blob([vttOutput.value], { type: 'text/vtt;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = activeFileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Copy VTT Text Handler
    if (btnCopyVtt) {
      btnCopyVtt.addEventListener('click', () => {
        if (!vttOutput || !vttOutput.value.trim()) return;

        navigator.clipboard.writeText(vttOutput.value).then(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = 'Copy VTT Text';
          }, 2000);
        });
      });
    }

    // Initial Conversion Audit
    processConversion();
  });
</script>

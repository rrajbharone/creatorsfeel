---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is the difference between SRT and WebVTT subtitle formats?",
    answer: "SRT (SubRip Subtitle) is a legacy text-based subtitle format that uses comma decimal separators in timestamps (00:00:01,500). WebVTT (Web Video Text Tracks) is the modern HTML5 W3C standard format that uses period decimal separators (00:00:01.500) and begins with a mandatory 'WEBVTT' header line."
  },
  {
    question: "How do I add a WebVTT (.vtt) subtitle track to an HTML5 video player?",
    answer: "Add an HTML5 <track> tag inside your <video> element: <video controls><source src='video.mp4' type='video/mp4' /><track kind='subtitles' src='subtitles.vtt' srclang='en' label='English' default /></video>."
  },
  {
    question: "Why do timestamps use periods (.) in VTT instead of commas (,) in SRT?",
    answer: "WebVTT follows standard web developer syntax specifications defined by W3C, which specify milliseconds separated by full stops/periods. Commas in SRT timestamps will cause WebVTT players to fail parsing."
  },
  {
    question: "Is my subtitle file uploaded or stored on any server?",
    answer: "No. Our SRT to VTT Converter processes all conversion entirely within your web browser using client-side JavaScript. Your subtitle files and video captions never touch any external server."
  },
  {
    question: "Can WebVTT files retain HTML formatting tags like <i>, <b>, and <u>?",
    answer: "Yes. WebVTT natively supports HTML styling tags such as <i> for italics, <b> for bold, <u> for underline, and <v Voice> for speaker identification tags."
  },
  {
    question: "What platforms require WebVTT (.vtt) subtitles instead of SRT?",
    answer: "Modern HTML5 video frameworks like Video.js, JW Player, HLS.js, Dash.js, Safari iOS video players, Vimeo, and custom WebGL video apps require WebVTT captions for browser compliance."
  }
];
---

<ToolLayout
  title="SRT to VTT Converter - Convert SubRip to WebVTT Online Free"
  description="Free online SRT to VTT Converter. Convert SubRip (.srt) subtitle files to WebVTT (.vtt) format instantly in your browser with 1-click download."

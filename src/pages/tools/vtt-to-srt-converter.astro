  /* Actions Row */
  .actions-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  .calc-btn-primary {
    flex: 2;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--gradient-brand);

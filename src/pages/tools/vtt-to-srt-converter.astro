    flex: 1;
    min-height: 48px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all var(--transition-fast);
  }

  .calc-btn-secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg);
  }

  .btn-svg {
    width: 18px;
    height: 18px;
  }

  /* Right Column: Results & Code Box */
  .calc-results {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: 100%;
  }

  /* Verdict Status Banner */
  .verdict-banner {
    padding: 0.9rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .verdict-banner.success-verdict {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.08);
  }

  .verdict-banner.danger-verdict {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.08);
  }

  .verdict-icon {
    font-size: 1.4rem;
  }

  .verdict-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .verdict-title {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .verdict-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* 4 Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .metric-card {
    padding: 0.8rem 0.6rem;
    text-align: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: border-color var(--transition-fast);
  }

  .metric-card:hover {
    border-color: var(--color-border-hover);
  }

  .metric-value {
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-brand);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.2rem;
  }

  .metric-sub {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Converted SubRip Output Code Box */
  .srt-output-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .output-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .output-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .output-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .srt-output-code {
    width: 100%;
    min-height: 180px;
    padding: 0.9rem;
    font-family: monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    outline: none;
    resize: vertical;
    box-sizing: border-box;
  }

  .output-actions-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  /* Editorial Content Styles */
  .editorial-section {
    padding-top: 1.5rem;
  }

  .editorial-section h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .editorial-section p {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .editorial-section ul, .editorial-section ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .editorial-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .editorial-section code, .editorial-section pre {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
    font-family: monospace;
  }

  .editorial-section pre {
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .editorial-section pre code {
    background: transparent;
    padding: 0;
    border: none;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .editorial-table th, .editorial-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .editorial-table th {
    background: var(--color-bg-alt);
    font-weight: 700;
  }

  .editorial-table tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .internal-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-link-card {
    display: block;
    padding: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedFileBar = document.getElementById('loaded-file-bar');
    const loadedFilename = document.getElementById('loaded-filename');
    const loadedFilesize = document.getElementById('loaded-filesize');
    const btnClearFile = document.getElementById('btn-clear-file');

    const vttInput = document.getElementById('vtt-input') as HTMLTextAreaElement | null;
    const btnConvert = document.getElementById('btn-convert');
    const btnClearAll = document.getElementById('btn-clear-all');

    // Audit Displays
    const verdictBanner = document.getElementById('verdict-banner');
    const verdictIcon = document.getElementById('verdict-icon');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictDesc = document.getElementById('verdict-desc');

    const resCueCount = document.getElementById('res-cue-count');
    const resCueSub = document.getElementById('res-cue-sub');
    const resDuration = document.getElementById('res-duration');
    const srtOutput = document.getElementById('srt-output') as HTMLTextAreaElement | null;

    const btnDownloadSrt = document.getElementById('btn-download-srt');
    const btnCopySrt = document.getElementById('btn-copy-srt');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (!vttInput) return;

    let activeFileName = 'subtitles.srt';

    // Drag & Drop Handling
    if (dropzone && fileInput) {
      ['dragenter', 'dragover'].forEach(evtName => {
        dropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach(evtName => {
        dropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e: DragEvent) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          readVttFile(dt.files[0]);
        }
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          readVttFile(fileInput.files[0]);
        }
      });
    }

    if (btnClearFile) {
      btnClearFile.addEventListener('click', (e) => {
        e.stopPropagation();
        if (fileInput) fileInput.value = '';
        if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
        if (loadedFileBar) loadedFileBar.style.display = 'none';
        activeFileName = 'subtitles.srt';
      });
    }

    function readVttFile(file: File) {
      if (!file) return;
      
      const kbSize = (file.size / 1024).toFixed(1);
      if (loadedFilename) loadedFilename.textContent = file.name;
      if (loadedFilesize) loadedFilesize.textContent = `${kbSize} KB`;

      const baseName = file.name.replace(/\.[^/.]+$/, "");
      activeFileName = `${baseName}.srt`;

      const reader = new FileReader();
      reader.onload = (evt) => {
        const text = evt.target?.result as string;
        if (vttInput) vttInput.value = text;

        if (dropzonePrompt) dropzonePrompt.style.display = 'none';
        if (loadedFileBar) loadedFileBar.style.display = 'flex';

        processConversion();
      };
      reader.readAsText(file);
    }

    // High-Accuracy Client-Side WebVTT to SubRip Conversion Engine
    function processConversion() {
      if (!vttInput || !srtOutput) return;

      const rawVtt = vttInput.value;
      if (!rawVtt.trim()) {
        showErrorVerdict('No Subtitle Text Entered', 'Please upload a VTT file or paste WebVTT text on the left.');
        srtOutput.value = '';
        if (resCueCount) resCueCount.textContent = '0 Cues';
        if (resDuration) resDuration.textContent = '00:00';
        return;
      }

      try {
        const result = convertVttToSrt(rawVtt);
        srtOutput.value = result.srtText;

        if (resCueCount) resCueCount.textContent = `${result.cueCount} ${result.cueCount === 1 ? 'Cue' : 'Cues'}`;
        if (resCueSub) resCueSub.textContent = 'Parsed Blocks';
        if (resDuration) resDuration.textContent = result.durationStr;

        showSuccessVerdict(
          'Successfully Converted to SubRip (.srt)!',
          `Converted ${result.cueCount} subtitle cues with 100% SubRip syntax compliance.`
        );
      } catch (err: any) {
        srtOutput.value = '';
        if (resCueCount) resCueCount.textContent = '0 Cues';
        if (resDuration) resDuration.textContent = '00:00';
        showErrorVerdict('Invalid WebVTT Subtitle Format', err.message || 'The provided text does not contain valid WebVTT timestamps.');
      }
    }

    function convertVttToSrt(vttText: string): { srtText: string; cueCount: number; durationStr: string } {
      const normalized = vttText.replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();
      if (!normalized) {
        throw new Error('Input text or file is empty.');
      }

      const lines = normalized.split('\n');
      let firstCueIdx = 0;

      for (let i = 0; i < lines.length; i++) {
        const trimmed = lines[i].trim();
        if (trimmed.toUpperCase().startsWith('WEBVTT')) {
          firstCueIdx = i + 1;
          break;
        }
      }

      const bodyText = lines.slice(firstCueIdx).join('\n').trim();
      if (!bodyText) {
        throw new Error('File starts with WEBVTT but contains no subtitle content or cues.');
      }

      const rawBlocks = bodyText.split(/\n\s*\n/);
      const srtLines: string[] = [];
      let cueCounter = 1;
      let firstStartSec = Infinity;
      let lastEndSec = 0;

      for (let i = 0; i < rawBlocks.length; i++) {
        const block = rawBlocks[i].trim();
        if (!block) continue;

        const blockLines = block.split('\n').map(l => l.trim());

        if (blockLines[0].toUpperCase().startsWith('NOTE') ||
            blockLines[0].toUpperCase().startsWith('STYLE') ||
            blockLines[0].toUpperCase().startsWith('REGION')) {
          continue;
        }

        let timeLineIdx = -1;
        for (let j = 0; j < blockLines.length; j++) {
          if (blockLines[j].includes('-->')) {
            timeLineIdx = j;
            break;
          }
        }

        if (timeLineIdx === -1) continue;

        const rawTimeLine = blockLines[timeLineIdx];
        const cleanTimeLineStr = rawTimeLine.split(/\s+align:|\s+position:|\s+size:|\s+line:|\s+region:/)[0].trim();
        const timeMatch = cleanTimeLineStr.match(/(\d{2}:\d{2}:\d{2}\.\d{3}|\d{2}:\d{2}\.\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2}\.\d{3}|\d{2}:\d{2}\.\d{3})/);

        if (!timeMatch) continue;

        const srtTime1 = formatVttTimestampToSrt(timeMatch[1]);
        const srtTime2 = formatVttTimestampToSrt(timeMatch[2]);
        const srtTimestampLine = `${srtTime1} --> ${srtTime2}`;

        const startSec = parseVttSec(timeMatch[1]);
        const endSec = parseVttSec(timeMatch[2]);
        if (startSec < firstStartSec) firstStartSec = startSec;
        if (endSec > lastEndSec) lastEndSec = endSec;

        let textPayload = blockLines.slice(timeLineIdx + 1).join('\n');
        textPayload = textPayload.replace(/<v\s+([^>]+)>(.*?)<\/v>/gi, '$1: $2');
        textPayload = textPayload.replace(/<v\s+([^>]+)>/gi, '$1: ');

        srtLines.push(cueCounter.toString());
        srtLines.push(srtTimestampLine);
        srtLines.push(textPayload);
        srtLines.push('');
        cueCounter++;
      }

      const validCueCount = cueCounter - 1;
      if (validCueCount === 0) {
        throw new Error('No valid WebVTT subtitle cues (e.g. 00:00:01.000 --> 00:00:04.000) were found.');
      }

      const durationStr = formatDuration(lastEndSec);

      return {
        srtText: srtLines.join('\n').trim() + '\n',
        cueCount: validCueCount,
        durationStr: durationStr
      };
    }

    function formatVttTimestampToSrt(tStr: string): string {
      let s = tStr.replace('.', ',');
      const parts = s.split(':');
      if (parts.length === 2) {
        s = `00:${s}`;
      }
      return s;
    }

    function parseVttSec(tStr: string): number {
      const parts = tStr.split(':');
      if (parts.length === 3) {
        return parseFloat(parts[0]) * 3600 + parseFloat(parts[1]) * 60 + parseFloat(parts[2]);
      } else if (parts.length === 2) {
        return parseFloat(parts[0]) * 60 + parseFloat(parts[1]);
      }
      return 0;
    }

    function formatDuration(sec: number): string {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      const mm = m < 10 ? `0${m}` : `${m}`;
      const ss = s < 10 ? `0${s}` : `${s}`;
      return `${mm}:${ss}`;
    }

    function showSuccessVerdict(title: string, desc: string) {
      if (verdictBanner && verdictTitle && verdictDesc && verdictIcon) {
        verdictBanner.className = 'verdict-banner success-verdict';
        verdictIcon.textContent = '✅';
        verdictTitle.textContent = title;
        verdictDesc.textContent = desc;
      }
    }

    function showErrorVerdict(title: string, desc: string) {
      if (verdictBanner && verdictTitle && verdictDesc && verdictIcon) {
        verdictBanner.className = 'verdict-banner danger-verdict';
        verdictIcon.textContent = '❌';
        verdictTitle.textContent = title;
        verdictDesc.textContent = desc;
      }
    }

    // Convert button handler
    if (btnConvert) {
      btnConvert.addEventListener('click', processConversion);
    }

    // Live conversion on input typing/pasting
    ['input', 'change'].forEach(evt => {
      vttInput.addEventListener(evt, processConversion);
    });

    // Clear all handler
    if (btnClearAll) {
      btnClearAll.addEventListener('click', () => {
        vttInput.value = '';
        if (fileInput) fileInput.value = '';
        if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
        if (loadedFileBar) loadedFileBar.style.display = 'none';
        activeFileName = 'subtitles.srt';
        processConversion();
      });
    }

    // Download SRT File Handler
    if (btnDownloadSrt) {
      btnDownloadSrt.addEventListener('click', () => {
        if (!srtOutput || !srtOutput.value.trim()) {
          alert('No converted SubRip SRT content available to download.');
          return;
        }

        const blob = new Blob([srtOutput.value], { type: 'text/plain;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = activeFileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Copy SRT Text Handler
    if (btnCopySrt) {
      btnCopySrt.addEventListener('click', () => {
        if (!srtOutput || !srtOutput.value.trim()) return;

        navigator.clipboard.writeText(srtOutput.value).then(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = 'Copy SRT Text';
          }, 2000);
        });
      });
    }

    // Initial Conversion Audit
    processConversion();
  });
</script>

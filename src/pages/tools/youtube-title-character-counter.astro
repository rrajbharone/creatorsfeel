</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const titleInput = document.getElementById('title-input') as HTMLTextAreaElement | null;
    const btnUpper = document.getElementById('btn-upper');
    const btnLower = document.getElementById('btn-lower');
    const btnTitleCase = document.getElementById('btn-title-case');
    const btnCopy = document.getElementById('btn-copy');
    const btnClear = document.getElementById('btn-clear');

    // Status elements
    const statusCard = document.getElementById('status-card');
    const statusBadgeText = document.getElementById('status-badge-text');
    const statusDescription = document.getElementById('status-description');
    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');

    // Metric elements
    const metricTotalChars = document.getElementById('metric-total-chars');
    const metricWithSpaces = document.getElementById('metric-with-spaces');
    const metricNoSpaces = document.getElementById('metric-no-spaces');
    const metricWords = document.getElementById('metric-words');
    const metricLetters = document.getElementById('metric-letters');
    const metricNumbers = document.getElementById('metric-numbers');
    const metricSpecial = document.getElementById('metric-special');
    const metricEmojis = document.getElementById('metric-emojis');

    // Previews
    const previewDesktopTitle = document.getElementById('preview-desktop-title');
    const previewMobileTitle = document.getElementById('preview-mobile-title');

    if (!titleInput) return;

    // Unicode Grapheme Cluster Count Helper
    function getGraphemeLength(str: string): number {
      if (!str) return 0;
      if (typeof Intl !== 'undefined' && (Intl as any).Segmenter) {
        const segmenter = new (Intl as any).Segmenter(undefined, { granularity: 'grapheme' });
        return [...segmenter.segment(str)].length;
      }
      return Array.from(str).length;
    }

    // Emoji Count Helper using Unicode Extended Pictographic Regex
    function countEmojis(str: string): number {
      if (!str) return 0;
      try {
        const emojiMatches = str.match(/\p{Extended_Pictographic}/gu);
        return emojiMatches ? emojiMatches.length : 0;
      } catch (e) {
        // Fallback emoji regex if Unicode property escape fails in older environments
        const fallbackRegex = /(?:[\u2700-\u27BF]|[\uE000-\uF8FF]|\uD83C[\uDC00-\uDFFF]|\uD83D[\uDC00-\uDFFF]|[\u2011-\u26FF]|\uD83E[\uDD10-\uDDFF])/g;
        const matches = str.match(fallbackRegex);
        return matches ? matches.length : 0;
      }
    }

    // Letters Count Helper (Unicode Letter Property \p{L} with fallback)
    function countLetters(str: string): number {
      if (!str) return 0;
      try {
        const matches = str.match(/[\p{L}]/gu);
        return matches ? matches.length : 0;
      } catch (e) {
        const matches = str.match(/[a-zA-Z]/g);
        return matches ? matches.length : 0;
      }
    }

    // Numbers Count Helper
    function countNumbers(str: string): number {
      if (!str) return 0;
      const matches = str.match(/\d/g);
      return matches ? matches.length : 0;
    }

    // Special Characters Count Helper (Punctuation and Symbols \p{P}\p{S})
    function countSpecialChars(str: string): number {
      if (!str) return 0;
      try {
        const matches = str.match(/[\p{P}\p{S}]/gu);
        return matches ? matches.length : 0;
      } catch (e) {
        const matches = str.match(/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/g);
        return matches ? matches.length : 0;
      }
    }

    // Main Update Function
    function updateMetrics() {
      const val = titleInput ? titleInput.value : '';
      const totalChars = getGraphemeLength(val);
      const charsWithSpaces = totalChars;
      
      // Remove spaces for no-space count
      const textNoSpaces = val.replace(/\s+/g, '');
      const charsNoSpaces = getGraphemeLength(textNoSpaces);

      // Word count
      const trimmed = val.trim();
      const wordCount = trimmed ? trimmed.split(/\s+/).length : 0;

      // Letters, Numbers, Special, Emojis
      const lettersCount = countLetters(val);
      const numbersCount = countNumbers(val);
      const specialCount = countSpecialChars(val);
      const emojiCount = countEmojis(val);

      // Update Metric Displays
      if (metricTotalChars) metricTotalChars.textContent = totalChars.toLocaleString();
      if (metricWithSpaces) metricWithSpaces.textContent = charsWithSpaces.toLocaleString();
      if (metricNoSpaces) metricNoSpaces.textContent = charsNoSpaces.toLocaleString();
      if (metricWords) metricWords.textContent = wordCount.toLocaleString();
      if (metricLetters) metricLetters.textContent = lettersCount.toLocaleString();
      if (metricNumbers) metricNumbers.textContent = numbersCount.toLocaleString();
      if (metricSpecial) metricSpecial.textContent = specialCount.toLocaleString();
      if (metricEmojis) metricEmojis.textContent = emojiCount.toLocaleString();

      // Progress bar & Percentage calculation relative to 100 limit
      const percentage = Math.min(100, Math.round((totalChars / 100) * 100));
      if (progressFill) {
        progressFill.style.width = `${percentage}%`;
        if (totalChars > 100) {
          progressFill.style.background = 'var(--color-danger)';
        } else if (totalChars > 75) {
          progressFill.style.background = 'var(--color-warning)';
        } else {
          progressFill.style.background = 'var(--gradient-brand)';
        }
      }
      if (progressText) {
        progressText.textContent = `${totalChars} / 100 Chars (${percentage}%)`;
      }

      // Status indicator logic
      if (!statusCard || !statusBadgeText || !statusDescription) return;

      if (totalChars === 0) {
        statusCard.setAttribute('data-status', 'empty');
        statusBadgeText.textContent = 'Enter Title';
        statusDescription.textContent = 'Start typing or paste your video title above to get an instant length audit.';
      } else if (totalChars < 30) {
        statusCard.setAttribute('data-status', 'short');
        statusBadgeText.textContent = 'Short Title (<30 Chars)';
        statusDescription.textContent = 'Your title is concise! Consider adding secondary keywords or context if relevant.';
      } else if (totalChars <= 60) {
        statusCard.setAttribute('data-status', 'good');
        statusBadgeText.textContent = 'Good Length (30–60 Chars)';
        statusDescription.textContent = 'Optimal title length! Excellent visibility across YouTube search, desktop feeds, and mobile apps.';
      } else if (totalChars <= 75) {
        statusCard.setAttribute('data-status', 'getting-long');
        statusBadgeText.textContent = 'Getting Long (61–75 Chars)';
        statusDescription.textContent = 'Getting long! Ensure your primary hook is front-loaded so it does not get truncated on smaller screens.';
      } else {
        statusCard.setAttribute('data-status', 'too-long');
        statusBadgeText.textContent = totalChars > 100 ? 'Exceeds 100-Char Limit!' : 'Too Long (>75 Chars)';
        statusDescription.textContent = totalChars > 100 
          ? 'Warning: YouTube Studio will not allow titles longer than 100 characters. Trim your text before saving.'
          : 'High risk of title truncation in mobile feeds and recommendation grids. Trim secondary text.';
      }

      // Previews Update
      const previewText = val.trim() || 'Your Video Title Will Appear Here...';
      if (previewDesktopTitle) previewDesktopTitle.textContent = previewText;
      if (previewMobileTitle) previewMobileTitle.textContent = previewText;
    }

    // Event Listeners for Input
    ['input', 'keyup', 'paste', 'change'].forEach(evt => {
      titleInput.addEventListener(evt, updateMetrics);
    });

    // Initial calculation
    updateMetrics();

    // Text Transformation Action Handlers
    if (btnUpper) {
      btnUpper.addEventListener('click', () => {
        if (!titleInput.value) return;
        titleInput.value = titleInput.value.toUpperCase();
        updateMetrics();
      });
    }

    if (btnLower) {
      btnLower.addEventListener('click', () => {
        if (!titleInput.value) return;
        titleInput.value = titleInput.value.toLowerCase();
        updateMetrics();
      });
    }

    if (btnTitleCase) {
      btnTitleCase.addEventListener('click', () => {
        if (!titleInput.value) return;
        titleInput.value = titleInput.value
          .toLowerCase()
          .split(' ')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');
        updateMetrics();
      });
    }

    // Copy Button Handler
    if (btnCopy) {
      btnCopy.addEventListener('click', async () => {
        if (!titleInput.value) return;
        try {
          await navigator.clipboard.writeText(titleInput.value);
          const originalHTML = btnCopy.innerHTML;
          btnCopy.innerHTML = `<span>Copied!</span>`;
          setTimeout(() => {
            btnCopy.innerHTML = originalHTML;
          }, 2000);
        } catch (err) {
          titleInput.select();
          document.execCommand('copy');
        }
      });
    }

    // Clear Button Handler
    if (btnClear) {
      btnClear.addEventListener('click', () => {
        titleInput.value = '';
        titleInput.focus();
        updateMetrics();
      });
    }
  });
</script>

---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is the official character limit for a YouTube video title?",
    answer: "YouTube allows a maximum of 100 characters for a video title. However, titles longer than 50 to 60 characters are usually truncated (cut off with '...') in YouTube search results, desktop recommendations, and mobile app feeds."
  },
  {
    question: "What is the recommended title length for YouTube SEO and high CTR?",
    answer: "The recommended title length for YouTube is between 50 and 60 characters. Keeping your title within this range ensures that viewers on both desktop and mobile screens can read your complete hook and main keyword before deciding to click."
  },
  {
    question: "How do emojis count towards the YouTube title character count?",
    answer: "Emojis count as characters in YouTube titles. Standard emojis generally count as 1 to 2 characters, while multi-byte or compound emojis (such as skin tone variations or country flags) may take up 2 to 4 Unicode code points. Our tool uses Unicode-aware grapheme counting to measure emojis accurately."
  },
  {
    question: "Do spaces count in the YouTube title limit?",
    answer: "Yes, spaces, spaces between words, punctuation marks, and special symbols all count toward YouTube's strict 100-character title limit. Our counter breaks down your title into characters with spaces, characters without spaces, and total word count."
  },
  {
    question: "Why does YouTube truncate long titles in recommendations?",
    answer: "YouTube truncates titles to fit various screen sizes, grid layouts, and video cards across desktop browsers, mobile apps, smart TVs, and sidebars. Truncation typically occurs after approximately 50–60 characters depending on character width."
  },
  {
    question: "Can changing a YouTube title hurt or help video rankings?",
    answer: "Updating a YouTube video title can significantly improve your click-through rate (CTR) if the new title is clearer, more compelling, or better aligned with search intent. YouTube re-indexes the new title keywords immediately after saving."
  }
];
---

<ToolLayout
  title="YouTube Title Character Counter - Live Length & Emoji Checker"
  description="Free YouTube Title Character Counter. Instantly count total characters, spaces, words, letters, numbers, symbols, and emojis for your YouTube video title."
  toolName="YouTube Title Character Counter"
  toolDescription="Analyze your YouTube title in real-time. Verify 100-character limit compliance, count emojis & spaces, and preview desktop/mobile feed truncation."
  category="Writing Tools"
  faqs={faqs}
>
  <!-- Calculator Slot -->
  <div slot="calculator" class="calc-card glass">
    <div class="counter-main-grid">
      
      <!-- Left Column: Inputs & Status -->
      <div class="counter-input-panel">
        <div class="form-group">
          <div class="label-row">
            <label for="title-input" class="input-label">Enter YouTube Video Title</label>
            <span class="max-badge" id="max-limit-badge">Max: 100 Characters</span>
          </div>
          <div class="textarea-wrapper">
            <textarea 
              id="title-input" 
              class="title-textarea" 
              placeholder="e.g., How I Built a $10K/Month Business in 90 Days 🚀 (Step-by-Step Guide)"
              rows="3"
              aria-describedby="title-help-note"
            ></textarea>
            
            <!-- Quick Utility Action Toolbar -->
            <div class="textarea-actions">
              <div class="case-btn-group">
                <button type="button" id="btn-upper" class="text-action-btn" title="Convert to UPPERCASE">UPPER</button>
                <button type="button" id="btn-lower" class="text-action-btn" title="Convert to lowercase">lower</button>
                <button type="button" id="btn-title-case" class="text-action-btn" title="Convert to Title Case">Title Case</button>
              </div>
              <div class="main-btn-group">
                <button type="button" id="btn-copy" class="text-action-btn action-copy">
                  <svg xmlns="http://www.w3.org/2000/svg" class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span>Copy Title</span>
                </button>
                <button type="button" id="btn-clear" class="text-action-btn action-clear">
                  <svg xmlns="http://www.w3.org/2000/svg" class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  <span>Clear</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Status Indicator Card -->
        <div class="status-card" id="status-card" data-status="empty">
          <div class="status-header">
            <span class="status-indicator-dot" id="status-dot"></span>
            <span class="status-badge-text" id="status-badge-text">Enter Title</span>
          </div>
          <p class="status-description" id="status-description">Start typing or paste your video title above to get an instant length audit.</p>
        </div>

        <!-- Character Progress Bar -->
        <div class="progress-container">
          <div class="progress-label-row">
            <span class="progress-title">YouTube Title Capacity</span>
            <span class="progress-percentage-text" id="progress-text">0 / 100 Chars (0%)</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill" id="progress-fill" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Helpful Explanatory Note -->
        <div class="help-note-box" id="title-help-note">
          <div class="note-icon">💡</div>
          <div class="note-text">
            <strong>YouTube Technical Limit vs. Recommended Length:</strong> YouTube allows up to <strong>100 characters</strong> in a title, but titles longer than <strong>50–60 characters</strong> are usually cut off (truncated) on mobile and desktop search feeds. Focus on placing your primary hook and main keywords in the first 50 characters!
          </div>
        </div>
      </div>

      <!-- Right Column: Metrics Breakdown & Previews -->
      <div class="counter-metrics-panel">
        <h3 class="panel-heading">Character & Word Metrics</h3>
        <div class="metrics-grid">
          
          <div class="metric-card highlight-card">
            <span class="metric-value" id="metric-total-chars">0</span>
            <span class="metric-label">Total Characters</span>
            <span class="metric-sub text-muted">Unicode Graphemes</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="metric-with-spaces">0</span>
            <span class="metric-label">With Spaces</span>
            <span class="metric-sub text-muted">Full length count</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="metric-no-spaces">0</span>
            <span class="metric-label">Without Spaces</span>
            <span class="metric-sub text-muted">Characters only</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="metric-words">0</span>
            <span class="metric-label">Total Words</span>
            <span class="metric-sub text-muted">Separated terms</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="metric-letters">0</span>
            <span class="metric-label">Letters</span>
            <span class="metric-sub text-muted">Alphabetic text</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="metric-numbers">0</span>
            <span class="metric-label">Numbers</span>
            <span class="metric-sub text-muted">Digits & figures</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="metric-special">0</span>
            <span class="metric-label">Special Chars</span>
            <span class="metric-sub text-muted">Symbols & punctuation</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="metric-emojis">0</span>
            <span class="metric-label">Emojis</span>
            <span class="metric-sub text-muted">Pictographic icons</span>
          </div>

        </div>

        <!-- YouTube Feed Previews -->
        <div class="previews-section">
          <h4 class="previews-title">Live YouTube Snippet Previews</h4>
          
          <!-- Desktop Preview Mockup -->
          <div class="mockup-card">
            <div class="mockup-header">
              <span class="device-icon">💻</span>
              <span class="mockup-label">Desktop Search & Recommendations</span>
            </div>
            <div class="yt-desktop-item">
              <div class="yt-thumb-box">
                <span class="yt-duration">10:45</span>
              </div>
              <div class="yt-info-box">
                <h5 class="yt-preview-title" id="preview-desktop-title">Your Video Title Will Appear Here...</h5>
                <span class="yt-preview-channel">Creator Channel • 250K views</span>
                <p class="yt-preview-desc text-muted">Preview how your video title displays to viewers browsing YouTube search results and home feeds...</p>
              </div>
            </div>
          </div>

          <!-- Mobile App Preview Mockup -->
          <div class="mockup-card">
            <div class="mockup-header">
              <span class="device-icon">📱</span>
              <span class="mockup-label">Mobile App Feed Snippet</span>
            </div>
            <div class="yt-mobile-item">
              <div class="yt-mobile-thumb-box">
                <span class="yt-duration">10:45</span>
              </div>
              <div class="yt-mobile-info-box">
                <div class="yt-mobile-avatar"></div>
                <div class="yt-mobile-details">
                  <h5 class="yt-mobile-preview-title" id="preview-mobile-title">Your Video Title Will Appear Here...</h5>
                  <span class="yt-mobile-subtext">Creator Channel • 250K views • 3 days ago</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Editorial & SEO Content Slot -->
  <div slot="about" class="editorial-content">
    <section class="editorial-section">
      <h2>Complete Guide to YouTube Title Character Counting and SEO Optimization</h2>
      <p>
        Writing an enticing, high-converting video title is one of the most critical steps in growing a successful YouTube channel. Your title serves as the primary gateway for viewers, search engines, and YouTube's recommendation algorithm. Whether someone discovers your video through YouTube search, recommended sidebar videos, or mobile app feeds, your title combined with your thumbnail dictates your click-through rate (CTR).
      </p>
      <p>
        Our <strong>YouTube Title Character Counter</strong> is built to give content creators, video editors, and digital marketers immediate, real-time feedback on title length, character breakdown, emoji density, and feed truncation risk. By auditing your titles before uploading, you ensure your main keywords and emotional hooks remain visible across every device screen.
      </p>

      <h2>What is a YouTube Title Counter?</h2>
      <p>
        A YouTube Title Counter is a specialized client-side tool designed to calculate the precise length, character breakdown, and structural composition of YouTube video titles. Unlike basic text counters that rely on simplified string length checks, a true YouTube Title Counter uses Unicode-aware grapheme cluster logic. This allows it to correctly evaluate complex multi-byte characters, skin-tone variant emojis, non-Latin scripts, punctuation marks, and spacing.
      </p>
      <p>
        Beyond simple character tallying, our tool provides an instant <strong>YouTube title length status</strong>—categorizing your title as <em>Short</em>, <em>Good Length</em>, <em>Getting Long</em>, or <em>Too Long</em>—while giving you real-time desktop and mobile feed previews.
      </p>

      <h2>Why YouTube Title Length Matters for Creators and SEO</h2>
      <p>
        Title length directly impacts two foundational metrics on YouTube: <strong>Search Indexing (SEO)</strong> and <strong>Click-Through Rate (CTR)</strong>.
      </p>
      <ul>
        <li>
          <strong>Search Indexing & Context:</strong> YouTube's search crawlers scan your title to understand the core subject of your video. A title that is too short may fail to include target keywords or secondary phrases, reducing your opportunities to rank in YouTube search.
        </li>
        <li>
          <strong>Click-Through Rate (CTR):</strong> YouTube recommendations are driven by human viewer behavior. If your title is cut off prematurely, viewers miss the central premise or curiosity gap of your video, causing them to scroll past.
        </li>
        <li>
          <strong>Cross-Device Consistency:</strong> Over 70% of YouTube watch time originates from mobile devices, smart TVs, and tablets. Each device platform enforces different character display bounds before truncating text with an ellipsis (...).
        </li>
      </ul>

      <h2>YouTube Title Limit vs. Recommended Display Length</h2>
      <p>
        One of the most common understandings among new YouTubers is confusing the platform's <strong>maximum character limit</strong> with the <strong>optimal display length</strong>:
      </p>
      <div class="comparison-box glass">
        <div class="comp-column">
          <h3 class="comp-heading text-danger">Official Character Limit: 100 Characters</h3>
          <p>
            YouTube allows creators to enter up to 100 characters into the title input field in YouTube Studio. However, filling all 100 characters usually results in severe title truncation across search results and home feeds.
          </p>
        </div>
        <div class="comp-column">
          <h3 class="comp-heading text-success">Recommended Length: 50 to 60 Characters</h3>
          <p>
            The optimal sweet spot for YouTube video titles is between 50 and 60 characters. Within this range, your full title is displayed across desktop sidebars, mobile app cards, and TV feeds without being cut off.
          </p>
        </div>
      </div>

      <h2>How Unicode Character Counting Works (Spaces, Emojis, and Symbols)</h2>
      <p>
        In modern web development and social media platforms, not all characters are stored equally. Basic string counting methods (such as JavaScript's default <code>string.length</code>) often produce inaccurate counts when processing emojis or non-English alphabets because they measure UTF-16 code units rather than visual characters (graphemes).
      </p>
      <p>
        Here is how different components of a YouTube title are processed:
      </p>
      <ul>
        <li>
          <strong>Spaces & Whitespace:</strong> Every space between words, tabs, and line breaks consumes 1 character against your 100-character limit. Multiple consecutive spaces increase character count without adding descriptive value.
        </li>
        <li>
          <strong>Punctuation & Special Symbols:</strong> Symbols like pipes (<code>|</code>), dashes (<code>-</code>), brackets (<code>[ ]</code>), and parentheses (<code>( )</code>) count as individual characters. They are helpful for separating keywords and series titles.
        </li>
        <li>
          <strong>Emojis:</strong> Emojis (e.g. 🚀, 🔥, 👨‍💻) are essential visual tools for boosting CTR. Standard emojis count as 1 character in Unicode grapheme segmenters, but complex emojis (like flags or emojis with skin tone modifiers) consist of multiple code points joined by Zero Width Joiners (ZWJ). Our counter uses native <code>Intl.Segmenter</code> technology to ensure emojis are accurately counted.
        </li>
      </ul>

      <h2>How Title Truncation Affects Desktop vs. Mobile Viewers</h2>
      <p>
        When YouTube renders your video card across different interfaces, it allocates a specific width for title text based on font size and container dimensions:
      </p>
      <div class="table-responsive">
        <table class="editorial-table">
          <thead>
            <tr>
              <th>Platform / Display Location</th>
              <th>Visible Character Limit</th>
              <th>Truncation Behavior</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Mobile App Feed</strong></td>
              <td>~45 to 55 Characters</td>
              <td>Truncates after 2 lines of text on most iOS & Android screens.</td>
            </tr>
            <tr>
              <td><strong>Desktop Search Results</strong></td>
              <td>~60 to 65 Characters</td>
              <td>Displays on 1 to 2 lines depending on screen resolution.</td>
            </tr>
            <tr>
              <td><strong>Desktop Suggested Videos (Sidebar)</strong></td>
              <td>~45 to 50 Characters</td>
              <td>Narrow sidebar container cuts off long title tails.</td>
            </tr>
            <tr>
              <td><strong>Smart TV & Gaming Consoles</strong></td>
              <td>~50 to 60 Characters</td>
              <td>Large bold typography limits visible character count.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>How to Write Clear, High-CTR YouTube Titles</h2>
      <p>
        Achieving a high click-through rate requires balancing search engine optimization with human psychology. Follow these proven copywriting strategies when drafting your titles:
      </p>
      <ol>
        <li>
          <strong>Front-Load Your Hook and Main Keyword:</strong> Place your primary keyword or emotional hook in the first 30–40 characters so it is never truncated, regardless of device.
        </li>
        <li>
          <strong>Create a Curiosity Gap:</strong> Tease an outcome, mystery, or transformation without resorting to dishonest clickbait. Make the viewer ask "How?" or "Why?".
        </li>
        <li>
          <strong>Use Numbers and Specific Data:</strong> Titles with specific figures (e.g., "7 Ways to...", "$5,000 in 30 Days") outperform vague, general claims.
        </li>
        <li>
          <strong>Add Brackets or Parentheses:</strong> Adding structural tags at the end of a title (e.g., <code>(Full Guide)</code> or <code>[2026 Strategy]</code>) adds context without cluttering the main hook.
        </li>
        <li>
          <strong>Limit Emojis to 1 or 2:</strong> Use emojis to draw visual attention, but avoid emoji overload, which can look spammy and reduce readability.
        </li>
      </ol>

      <h2>Examples of Good vs. Poor YouTube Title Structures</h2>
      <p>
        Compare how subtle structural adjustments dramatically improve title clarity and truncation safety:
      </p>
      <div class="table-responsive">
        <table class="editorial-table">
          <thead>
            <tr>
              <th>Title Example</th>
              <th>Char Count</th>
              <th>Status</th>
              <th>Analysis</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>Video Editing Tutorial</code></td>
              <td>22</td>
              <td><span class="badge-amber">Short</span></td>
              <td>Too generic. Lacks benefit, specificity, and curiosity.</td>
            </tr>
            <tr>
              <td><code>How to Edit YouTube Videos Fast in Premiere Pro (2026 Beginner Guide)</code></td>
              <td>73</td>
              <td><span class="badge-yellow">Getting Long</span></td>
              <td>Strong keywords, but tail might truncate on mobile feeds.</td>
            </tr>
            <tr>
              <td><code>Edit YouTube Videos 2x Faster in Premiere Pro (2026) 🎬</code></td>
              <td>58</td>
              <td><span class="badge-green">Good Length</span></td>
              <td>Perfect! High CTR hook, target keywords, emoji, and zero truncation.</td>
            </tr>
            <tr>
              <td><code>This Is The Absolute Best Way To Make Money Online In 2026 For Beginners Who Have No Experience At All And Want To Quit Their Job</code></td>
              <td>142</td>
              <td><span class="badge-red">Too Long</span></td>
              <td>Exceeds 100-char max limit, highly spammy, cut off everywhere.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Step-by-Step Guide: How to Use the CreatorsFeel YouTube Title Counter</h2>
      <p>
        Using our tool to polish your titles takes only a few seconds:
      </p>
      <ul class="steps-list">
        <li><strong>Step 1: Paste or Type Your Draft Title:</strong> Enter your working video title directly into the main input box.</li>
        <li><strong>Step 2: Review Instant Character & Word Breakdown:</strong> Check your total character count, characters with/without spaces, total words, and emoji tally in real-time.</li>
        <li><strong>Step 3: Check Title Length Status:</strong> Look at the visual status indicator to see whether your title falls within the optimal 30–60 character range.</li>
        <li><strong>Step 4: Inspect Live Layout Previews:</strong> Verify how your title appears on desktop search grids and mobile feed cards.</li>
        <li><strong>Step 5: Refine & Copy:</strong> Adjust your text, use quick case formatting buttons if needed, and click <strong>Copy Title</strong> to transfer it directly to YouTube Studio.</li>
      </ul>

      <h2>Common YouTube Title Mistakes to Avoid</h2>
      <ul>
        <li><strong>Keyword Stuffing:</strong> Repeating keywords unnaturally (e.g. "YouTube SEO Tutorial | YouTube SEO Tips | YouTube SEO 2026") alienates viewers and triggers spam filters.</li>
        <li><strong>Capitalizing Every Word (ALL CAPS):</strong> Writing entire titles in upper case feels aggressive and is harder to read than Sentence Case or Title Case.</li>
        <li><strong>Putting Brand Name First:</strong> Unless you are a massive global brand, put the video topic first and your channel name at the end or in your thumbnail.</li>
        <li><strong>Misleading Clickbait:</strong> Creating titles that promise content not delivered in the video causes viewers to abandon the video in the first 10 seconds, lowering your Average Percentage Viewed (APV).</li>
      </ul>

      <h2>Explore Related Creator Tools on CreatorsFeel</h2>
      <p>
        Enhance your YouTube publishing workflow with our suite of free, high-performance creator tools:
      </p>
      <div class="internal-links-grid">
        <a href="/tools/youtube-title-length-checker" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Title Length Checker</div>
          <div class="tool-link-desc">Audit title character bounds, scan for high-converting power words, and evaluate CTR optimization scores.</div>
        </a>
        <a href="/tools/youtube-description-formatter" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Description Formatter</div>
          <div class="tool-link-desc">Format clean descriptions, build clickable timestamps, normalize link formatting, and avoid truncation.</div>
        </a>
        <a href="/tools/youtube-watch-time-calculator" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Watch Time Calculator</div>
          <div class="tool-link-desc">Calculate public watch hours and forecast your channel timeline toward the 4,000-hour YPP threshold.</div>
        </a>
        <a href="/tools/youtube-keyword-generator" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Keyword Generator</div>
          <div class="tool-link-desc">Discover high-volume, low-competition keywords for video titles, descriptions, and channel tags.</div>
        </a>
        <a href="/tools/youtube-tag-generator" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Tag Generator</div>
          <div class="tool-link-desc">Generate character-optimized SEO metadata tags for YouTube videos and Shorts to improve search indexing.</div>
        </a>
      </div>
    </section>
  </div>
</ToolLayout>

<style>
  /* Base Card Container */
  .calc-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Two-Column Grid System */
  .counter-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3.5vw, 2.25rem);
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 992px) {
    .counter-main-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
    }
  }

  /* Left Panel: Inputs & Form Controls */
  .counter-input-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .input-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .max-badge {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* Integrated Textarea Wrapper */
  .textarea-wrapper {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .textarea-wrapper:focus-within {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .title-textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
    background: transparent;
    border: none;
    resize: vertical;
    outline: none;
    box-sizing: border-box;
  }

  .textarea-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .case-btn-group, .main-btn-group {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .text-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    min-height: 32px;
  }

  .text-action-btn:hover {

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedFileBar = document.getElementById('loaded-file-bar');
    const loadedFilename = document.getElementById('loaded-filename');
    const loadedFilesize = document.getElementById('loaded-filesize');
    const btnClearFile = document.getElementById('btn-clear-file');

    const trimmerEditorBox = document.getElementById('trimmer-editor-box');
    const sourceVideoPlayer = document.getElementById('source-video-player') as HTMLVideoElement | null;
    const trimDurationBadge = document.getElementById('trim-duration-badge');

    const inputStartTime = document.getElementById('input-start-time') as HTMLInputElement | null;
    const inputEndTime = document.getElementById('input-end-time') as HTMLInputElement | null;
    const btnSetStart = document.getElementById('btn-set-start');
    const btnSetEnd = document.getElementById('btn-set-end');
    const btnPreviewTrim = document.getElementById('btn-preview-trim');

    const btnTrimVideo = document.getElementById('btn-trim-video');
    const btnClearAll = document.getElementById('btn-clear-all');

    // Results & Progress Displays
    const emptyStateCard = document.getElementById('empty-state-card');
    const progressCard = document.getElementById('progress-card');
    const progressStatusText = document.getElementById('progress-status-text');
    const progressPctText = document.getElementById('progress-pct-text');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressSubText = document.getElementById('progress-sub-text');

    const resultsDisplayBox = document.getElementById('results-display-box');
    const resTrimDuration = document.getElementById('res-trim-duration');
    const resOrigDuration = document.getElementById('res-orig-duration');
    const resTrimmedSize = document.getElementById('res-trimmed-size');
    const resResolution = document.getElementById('res-resolution');

    const trimmedVideoPlayer = document.getElementById('trimmed-video-player') as HTMLVideoElement | null;
    const btnDownloadTrimmed = document.getElementById('btn-download-trimmed');

    if (!dropzone || !fileInput) return;

    let currentVideoFile: File | null = null;
    let sourceVideoUrl: string | null = null;
    let trimmedBlobUrl: string | null = null;
    let outputDownloadName = 'trimmed_video.webm';
    let isProcessing = false;
    let totalDuration = 0;

    // Drag & Drop Handling
    ['dragenter', 'dragover'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dragover');
      });
    });

    dropzone.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFileSelection(dt.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFileSelection(fileInput.files[0]);
      }
    });

    if (btnClearFile) btnClearFile.addEventListener('click', resetState);
    if (btnClearAll) btnClearAll.addEventListener('click', resetState);

    function resetState() {
      currentVideoFile = null;
      isProcessing = false;
      totalDuration = 0;
      if (fileInput) fileInput.value = '';
      if (sourceVideoUrl) {
        URL.revokeObjectURL(sourceVideoUrl);
        sourceVideoUrl = null;
      }
      if (trimmedBlobUrl) {
        URL.revokeObjectURL(trimmedBlobUrl);
        trimmedBlobUrl = null;
      }
      if (sourceVideoPlayer) sourceVideoPlayer.src = '';
      if (trimmedVideoPlayer) trimmedVideoPlayer.src = '';
      if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
      if (loadedFileBar) loadedFileBar.style.display = 'none';
      if (trimmerEditorBox) trimmerEditorBox.style.display = 'none';
      if (progressCard) progressCard.style.display = 'none';
      if (resultsDisplayBox) resultsDisplayBox.style.display = 'none';
      if (emptyStateCard) emptyStateCard.style.display = 'flex';
    }

    function formatTime(seconds: number): string {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      const ms = Math.floor((seconds % 1) * 100);
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;
    }

    function parseTime(timeStr: string): number {
      const parts = timeStr.trim().split(':');
      if (parts.length === 2) {
        const mins = parseFloat(parts[0]) || 0;
        const secs = parseFloat(parts[1]) || 0;
        return mins * 60 + secs;
      }
      return parseFloat(timeStr) || 0;
    }

    function updateTrimBadge() {
      if (!inputStartTime || !inputEndTime || !trimDurationBadge) return;
      const start = parseTime(inputStartTime.value);
      const end = parseTime(inputEndTime.value);
      const selected = Math.max(0, end - start);
      trimDurationBadge.textContent = `${formatTime(selected)} / ${formatTime(totalDuration)}`;
    }

    function handleFileSelection(file: File) {
      if (!file || !file.type.startsWith('video/')) {
        alert('Please upload a valid video file (MP4, WebM, MOV, MKV).');
        return;
      }

      currentVideoFile = file;
      const mbSize = (file.size / (1024 * 1024)).toFixed(2);
      if (loadedFilename) loadedFilename.textContent = file.name;
      outputDownloadName = `trimmed_${file.name.replace(/\.[^/.]+$/, "")}.webm`;

      if (sourceVideoUrl) URL.revokeObjectURL(sourceVideoUrl);
      sourceVideoUrl = URL.createObjectURL(file);

      if (sourceVideoPlayer) {
        sourceVideoPlayer.src = sourceVideoUrl;
        sourceVideoPlayer.onloadedmetadata = () => {
          totalDuration = sourceVideoPlayer.duration || 1;
          const durStr = formatTime(totalDuration);

          if (loadedFilesize) {
            loadedFilesize.textContent = `${mbSize} MB • ${durStr} Duration`;
          }

          if (inputStartTime) inputStartTime.value = '00:00.00';
          if (inputEndTime) inputEndTime.value = durStr;
          updateTrimBadge();

          if (dropzonePrompt) dropzonePrompt.style.display = 'none';
          if (loadedFileBar) loadedFileBar.style.display = 'flex';
          if (trimmerEditorBox) trimmerEditorBox.style.display = 'flex';
        };
      }
    }

    // Set Start / End Buttons
    if (btnSetStart && sourceVideoPlayer && inputStartTime) {
      btnSetStart.addEventListener('click', () => {
        const cur = sourceVideoPlayer.currentTime;
        inputStartTime.value = formatTime(cur);
        updateTrimBadge();
      });
    }

    if (btnSetEnd && sourceVideoPlayer && inputEndTime) {
      btnSetEnd.addEventListener('click', () => {
        const cur = sourceVideoPlayer.currentTime;
        inputEndTime.value = formatTime(cur);
        updateTrimBadge();
      });
    }

    if (inputStartTime) inputStartTime.addEventListener('input', updateTrimBadge);
    if (inputEndTime) inputEndTime.addEventListener('input', updateTrimBadge);

    // Preview Trim Selection
    let previewInterval: any = null;
    if (btnPreviewTrim && sourceVideoPlayer && inputStartTime && inputEndTime) {
      btnPreviewTrim.addEventListener('click', async () => {
        const start = parseTime(inputStartTime.value);
        const end = parseTime(inputEndTime.value);

        if (end <= start) {
          alert('End time must be greater than Start time.');
          return;
        }

        sourceVideoPlayer.currentTime = start;
        await sourceVideoPlayer.play();

        if (previewInterval) clearInterval(previewInterval);
        previewInterval = setInterval(() => {
          if (sourceVideoPlayer.currentTime >= end) {
            sourceVideoPlayer.pause();
            clearInterval(previewInterval);
          }
        }, 50);
      });
    }

    // High-Precision Client-Side Video Trimming Engine
    async function startTrimming() {
      if (!currentVideoFile || !sourceVideoUrl || !sourceVideoPlayer || !inputStartTime || !inputEndTime) {
        alert('Please upload a video file first.');
        return;
      }

      const startTime = parseTime(inputStartTime.value);
      const endTime = parseTime(inputEndTime.value);

      if (endTime <= startTime) {
        alert('End time must be greater than Start time.');
        return;
      }

      if (isProcessing) return;
      isProcessing = true;

      // Show Progress UI
      if (emptyStateCard) emptyStateCard.style.display = 'none';
      if (resultsDisplayBox) resultsDisplayBox.style.display = 'none';
      if (progressCard) progressCard.style.display = 'flex';
      updateProgress(0, 'Preparing video trimmer...');

      try {
        const video = document.createElement('video');
        video.src = sourceVideoUrl;
        video.muted = false;
        video.crossOrigin = 'anonymous';
        video.playsInline = true;

        await new Promise((res) => {
          video.onloadedmetadata = res;
        });

        const targetW = video.videoWidth || 1280;
        const targetH = video.videoHeight || 720;
        const trimDuration = endTime - startTime;

        // Setup Offscreen Canvas
        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d', { alpha: false });
        if (!ctx) throw new Error('Canvas 2D context creation failed.');

        // Setup MediaStream
        const stream = canvas.captureStream(30);

        // Setup Audio Stream
        let audioContext: AudioContext | null = null;
        try {
          audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
          const source = audioContext.createMediaElementSource(video);
          const destination = audioContext.createMediaStreamDestination();
          source.connect(destination);
          const audioTrack = destination.stream.getAudioTracks()[0];
          if (audioTrack) {
            stream.addTrack(audioTrack);
          }
        } catch (e) {
          console.warn('Audio extraction warning:', e);
        }

        // Determine Supported MimeType
        let mimeType = 'video/webm';
        if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus')) {
          mimeType = 'video/webm;codecs=vp9,opus';
        } else if (MediaRecorder.isTypeSupported('video/webm;codecs=vp8,opus')) {
          mimeType = 'video/webm;codecs=vp8,opus';
        }

        const recorder = new MediaRecorder(stream, {
          mimeType,
          videoBitsPerSecond: 2500000,
          audioBitsPerSecond: 96000
        });

        const recordedChunks: Blob[] = [];
        recorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) {
            recordedChunks.push(e.data);
          }
        };

        // Seek to start time
        video.currentTime = startTime;
        await new Promise((res) => {
          video.onseeked = res;
        });

        let isEnded = false;
        recorder.start(100);
        await video.play();

        const renderFrame = () => {
          if (isEnded) return;

          ctx.drawImage(video, 0, 0, targetW, targetH);
          const progressTime = video.currentTime - startTime;
          const pct = Math.min(99, Math.max(0, Math.round((progressTime / trimDuration) * 100)));
          updateProgress(pct, `Trimming video frames... (${pct}%)`);

          if (video.currentTime >= endTime || video.ended || video.paused) {
            if (!isEnded) {
              isEnded = true;
              video.pause();
              recorder.stop();
            }
          } else {
            requestAnimationFrame(renderFrame);
          }
        };

        requestAnimationFrame(renderFrame);

        // Wait for recorder to finish
        await new Promise((res) => {
          recorder.onstop = res;
        });

        if (audioContext) {
          audioContext.close();
        }

        // Finalize Trimmed Blob
        const trimmedBlob = new Blob(recordedChunks, { type: mimeType });
        if (trimmedBlobUrl) URL.revokeObjectURL(trimmedBlobUrl);
        trimmedBlobUrl = URL.createObjectURL(trimmedBlob);

        const trimmedSizeMB = (trimmedBlob.size / (1024 * 1024)).toFixed(2);

        // Update UI Results
        if (resTrimDuration) resTrimDuration.textContent = formatTime(trimDuration);
        if (resOrigDuration) resOrigDuration.textContent = formatTime(totalDuration);
        if (resTrimmedSize) resTrimmedSize.textContent = `${trimmedSizeMB} MB`;
        if (resResolution) resResolution.textContent = `${targetW} × ${targetH}`;

        if (trimmedVideoPlayer) {
          trimmedVideoPlayer.src = trimmedBlobUrl;
        }

        if (progressCard) progressCard.style.display = 'none';
        if (resultsDisplayBox) {
          resultsDisplayBox.style.display = 'flex';
          if (window.innerWidth < 992) {
            resultsDisplayBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        isProcessing = false;

      } catch (err: any) {
        isProcessing = false;
        alert(`Trimming Error: ${err.message || 'Unable to trim video file.'}`);
        if (progressCard) progressCard.style.display = 'none';
        if (emptyStateCard) emptyStateCard.style.display = 'flex';
      }
    }

    function updateProgress(pct: number, msg: string) {
      if (progressPctText) progressPctText.textContent = `${pct}%`;
      if (progressBarFill) progressBarFill.style.width = `${pct}%`;
      if (progressStatusText) progressStatusText.textContent = msg;
    }

    if (btnTrimVideo) {
      btnTrimVideo.addEventListener('click', startTrimming);
    }

    // Download Trimmed Video Handler
    if (btnDownloadTrimmed) {
      btnDownloadTrimmed.addEventListener('click', () => {
        if (!trimmedBlobUrl) return;

        const a = document.createElement('a');
        a.href = trimmedBlobUrl;
        a.download = outputDownloadName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
    }
  });

---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "How many words can you fit in a standard 280-character tweet?",
    answer: "A standard 280-character tweet typically fits between 40 and 55 words, depending on average word length and punctuation."
  },
  {
    question: "What is the word limit for X Premium posts?",
    answer: "X Premium (formerly Twitter Blue) subscribers can publish long-form posts of up to 25,000 characters, which equals approximately 3,500 to 4,500 words."
  },
  {
    question: "How does Twitter/X count URLs and links?",
    answer: "Twitter automatically wraps every web URL with its 't.co' link shortener. Regardless of how long or short the original URL is, it counts as exactly 23 characters against your limit."
  },
  {
    question: "Do emojis count as words or characters on Twitter?",
    answer: "Emojis do not count as separate words, but under X's parser rules, every emoji counts as 2 characters against your character limit."
  },
  {
    question: "Why should I use a Twitter word counter instead of just checking character count?",
    answer: "While Twitter enforces a hard character limit, reader comprehension and engagement are driven by word count and pacing. Tracking word counts helps you write tighter hooks, format clean threads, and improve readability."
  },
  {
    question: "What is the ideal tweet length for maximum engagement?",
    answer: "Studies show that tweets between 70 and 100 characters (around 12 to 20 words) receive higher retweets and click-through rates because they are punchy and easy to consume on mobile feeds."
  }
];
---

<ToolLayout
  title="Twitter Post Word Counter - X Post Length & Word Limit Checker"
  description="Free Twitter Post Word Counter. Count words, characters, URLs, and emojis in your tweets and X Premium posts in real time."
  toolName="Twitter Post Word Counter"
  toolDescription="Count words, standard characters, X-weighted characters, spaces, letters, and emojis for tweets and long-form X Premium posts."
  category="Writing Tools"
  faqs={faqs}
>
  <!-- Main Calculator Interface -->
  <div slot="calculator" class="calc-card glass">
    
    <!-- Account Mode Selection Tabs -->
    <div class="tabs-container">
      <button type="button" class="preset-tab active" data-limit="280" data-label="Standard Tweet">Standard (280 Limit)</button>
      <button type="button" class="preset-tab" data-limit="25000" data-label="X Premium Post">X Premium (25K Limit)</button>
    </div>

    <!-- 2-Column Desktop Grid -->
    <div class="calc-grid">
      
      <!-- Left Column: Input Editor & Action Buttons -->
      <form class="calc-form" id="counter-form" onsubmit="return false;">
        <div class="form-group">
          <div class="label-row" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.35rem;">
            <label for="tweet-input" class="input-label" style="margin: 0;">Draft Your Tweet / X Post</label>
            <!-- Quick Format Buttons -->
            <div class="format-toolbar" style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
              <button type="button" class="format-btn" id="btn-uppercase" title="Convert to ALL CAPS">UPPERCASE</button>
              <button type="button" class="format-btn" id="btn-lowercase" title="Convert to lowercase">lowercase</button>
              <button type="button" class="format-btn" id="btn-titlecase" title="Convert to Title Case">Title Case</button>
              <button type="button" class="format-btn" id="btn-cleanspace" title="Trim extra spaces">Clean Spacing</button>
            </div>
          </div>
          <textarea 
            id="tweet-input" 
            class="editor-textarea" 
            placeholder="Type or paste your post here..."
            rows="8"
          ></textarea>
        </div>

        <!-- Prominent Action Buttons Row -->
        <div class="main-actions-row">
          <button type="button" id="btn-copy" class="calc-btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
            </svg>
            <span id="copy-text">Copy Tweet</span>
          </button>
          <button type="button" id="btn-clear" class="calc-btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            Clear All
          </button>
        </div>
      </form>

      <!-- Right Column: Live Results Display & Progress Ring -->
      <div class="calc-results" id="results-wrapper">
        
        <!-- Progress Ring Header Box -->
        <div class="progress-ring-card">
          <div class="ring-container">
            <svg class="ring-svg" viewBox="0 0 100 100">
              <circle class="ring-bg" cx="50" cy="50" r="42"></circle>
              <circle class="ring-fill" id="ring-fill" cx="50" cy="50" r="42" stroke-dasharray="263.89" stroke-dashoffset="263.89"></circle>
            </svg>
            <div class="ring-center-text">
              <span class="ring-num" id="ring-remaining-num">280</span>
              <span class="ring-sub" id="ring-remaining-label">Left</span>
            </div>
          </div>

          <div class="ring-details">
            <div class="ring-title-row">
              <strong class="ring-mode-title" id="limit-preset-name">Standard Tweet Limit</strong>
              <span class="ring-pct-badge" id="limit-count-val">0 / 280 (0% used)</span>
            </div>
            <p class="ring-desc-text" id="ring-desc-text">
              Standard tweets allow 280 characters (~45-55 words). URLs automatically count as 23 characters via t.co, and emojis count as 2 characters.
            </p>
          </div>
        </div>

        <!-- 8 Metrics Cards Grid (2x4 Grid inside right column) -->
        <div class="metrics-grid">
          <div class="metric-card highlight-card">
            <span class="metric-value" id="count-words">0</span>
            <span class="metric-label">Total Words</span>
            <span class="metric-sub text-muted">Word count</span>
          </div>

          <div class="metric-card highlight-card">
            <span class="metric-value" id="count-x-weighted">0</span>
            <span class="metric-label">X-Weighted Chars</span>
            <span class="metric-sub text-muted">t.co & emoji weights</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="count-with-spaces">0</span>
            <span class="metric-label">Standard Chars</span>
            <span class="metric-sub text-muted">Raw count</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="count-no-spaces">0</span>
            <span class="metric-label">Without Spaces</span>
            <span class="metric-sub text-muted">Visible text only</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="count-reading-time">0s</span>
            <span class="metric-label">Est. Read Time</span>
            <span class="metric-sub text-muted">Based on 200 wpm</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="count-letters">0</span>
            <span class="metric-label">Total Letters</span>
            <span class="metric-sub text-muted">Alphabetic</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="count-numbers">0</span>
            <span class="metric-label">Total Numbers</span>
            <span class="metric-sub text-muted">Numeric digits</span>
          </div>

          <div class="metric-card">
            <span class="metric-value" id="count-emojis">0</span>
            <span class="metric-label">Total Emojis</span>
            <span class="metric-sub text-muted">Unicode emojis</span>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Editorial & SEO Content Slot -->
  <div slot="about" class="editorial-content">
    <section class="editorial-section">
      
      <h2>What Is a Twitter Post Word Counter?</h2>
      <p>
        A <strong>Twitter Post Word Counter</strong> is a specialized online writing tool designed to analyze the exact word count, character count, link weights, and formatting parameters of content created for Twitter (now officially known as X).
      </p>
      <p>
        Unlike generic text counters, a dedicated Twitter word counter incorporates X's unique parsing algorithms—such as automatic 23-character URL shortening via <code>t.co</code> and 2-character emoji weights—while measuring total words to ensure your copy is punchy, concise, and structured for maximum audience engagement.
      </p>

      <h2>How Does the Twitter Post Word Counter Work?</h2>
      <p>
        Our Twitter Post Word Counter evaluates your text in real time using a multi-layered parsing engine:
      </p>
      <ul>
        <li><strong>Word Boundary Segmentation:</strong> Scans text for whitespace and punctuation breaks to calculate accurate total words.</li>
        <li><strong>X-Weighted Character Parsing:</strong> Identifies web URLs (HTTP/HTTPS links) and replaces their raw length with X's fixed 23-character <code>t.co</code> weight.</li>
        <li><strong>Unicode Emoji Matching:</strong> Detects emojis and attributes a 2-character weight per emoji symbol in accordance with Twitter's official text rules.</li>
        <li><strong>Reading Time Estimation:</strong> Calculates estimated reading duration based on an average human reading speed of 200 words per minute.</li>
      </ul>

      <h2>Twitter Character Limit and Post Length</h2>
      <p>
        Over the years, Twitter has expanded its character boundaries to accommodate different user tiers and content formats:
      </p>
      <div class="table-responsive">
        <table class="editorial-table">
          <thead>
            <tr>
              <th>Account Tier / Format</th>
              <th>Character Limit</th>
              <th>Average Word Count</th>
              <th>Recommended Use Case</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Standard Free Account</strong></td>
              <td>280 characters</td>
              <td>40–55 words</td>
              <td>Quick updates, hooks, commentary & thread steps</td>
            </tr>
            <tr>
              <td><strong>X Premium (Twitter Blue)</strong></td>
              <td>25,000 characters</td>
              <td>3,500–4,500 words</td>
              <td>Long-form essays, in-depth tutorials & newsletters</td>
            </tr>
            <tr>
              <td><strong>Direct Messages (DMs)</strong></td>
              <td>10,000 characters</td>
              <td>1,500–1,800 words</td>
              <td>Private networking & client outreach</td>
            </tr>
            <tr>
              <td><strong>Profile Bio</strong></td>
              <td>160 characters</td>
              <td>25–35 words</td>
              <td>Account positioning & call-to-action</td>
            </tr>
            <tr>
              <td><strong>Display Name</strong></td>
              <td>50 characters</td>
              <td>3–8 words</td>
              <td>Personal or brand identity</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>How to Count Words and Characters on Twitter/X</h2>
      <p>
        Counting words and characters manually on Twitter can lead to costly posting errors due to hidden formatting rules. Here is how to audit your text effectively:
      </p>
      <ol>
        <li><strong>Paste Your Draft into the Counter:</strong> Type or paste your copy into the editor above.</li>
        <li><strong>Check X-Weighted vs. Standard Counts:</strong> Compare raw characters with X-weighted characters to see how links and emojis impact your limit.</li>
        <li><strong>Verify Word Pacing:</strong> Keep standard single tweets between 15 and 35 words for optimal readability on mobile screens.</li>
        <li><strong>Audit Thread Sections:</strong> Break longer thoughts into distinct 40-word paragraphs if publishing a multi-tweet thread.</li>
      </ol>

      <h2>Why Twitter Post Length Matters</h2>
      <p>
        Twitter is a fast-paced, feed-driven platform where users scroll through hundreds of posts per minute. Post length directly impacts how your audience interacts with your content:
      </p>
      <ul>
        <li><strong>Hook Efficiency:</strong> The first 5 to 10 words dictate whether a user stops scrolling or passes by.</li>
        <li><strong>Mobile Readability:</strong> Over 80% of Twitter users browse on smartphones. Concise 20-to-40 word posts fit comfortably on mobile screens without requiring expansion.</li>
        <li><strong>Algorithmic Engagement:</strong> Posts that generate quick replies, retweets, and bookmarking are prioritized by X's recommendation algorithm.</li>
      </ul>

      <h2>Tips for Writing Better Twitter/X Posts</h2>
      <p>
        To maximize engagement and clarity on Twitter/X, implement these practical writing techniques:
      </p>
      <ol>
        <li>
          <strong>Lead with a Strong Hook:</strong> Start with a bold statement, surprising data point, or thought-provoking question in the first 50 characters.
        </li>
        <li>
          <strong>Use Clean White Space:</strong> Avoid dense blocks of text. Insert clean line breaks between sentences. Format your text easily using our <a href="/tools/linkedin-post-formatter">LinkedIn Post Formatter</a> or inspect character limits with our <a href="/tools/twitter-character-counter">Twitter Character Counter</a>.
        </li>
        <li>
          <strong>Limit Links to One Per Tweet:</strong> Multiple URLs consume 23 characters each and can reduce post reach. Track your post performance with our <a href="/tools/twitter-engagement-calculator">Twitter Engagement Calculator</a>.
        </li>
        <li>
          <strong>Cross-Post to Other Platforms:</strong> Adapt your top-performing tweets into short social captions using our <a href="/tools/instagram-caption-character-counter">Instagram Caption Character Counter</a> or titles using our <a href="/tools/youtube-title-character-counter">YouTube Title Character Counter</a>.
        </li>
      </ol>

      <h2>Common Twitter Post Counting Mistakes</h2>
      <ul>
        <li><strong>Assuming URLs Count by Character Length:</strong> Pasting a long 100-character URL does not waste 100 characters; X automatically shortens it to 23 characters.</li>
        <li><strong>Ignoring Emoji Character Weights:</strong> Emojis count as 2 characters, so using 10 emojis consumes 20 characters of your limit.</li>
        <li><strong>Overpacking Hashtags:</strong> Adding 5 or 6 hashtags eats up valuable word count while looking spammy to human readers. Stick to 1 or 2 targeted hashtags.</li>
        <li><strong>Neglecting Line Breaks:</strong> Line breaks count as characters (1-2 characters per enter key). Make sure extra spacing doesn't push you over 280.</li>
      </ul>

      <h2>Explore More Free Creator Tools on CreatorsFeel</h2>
      <div class="internal-links-grid">
        <a href="/tools/twitter-character-counter" class="tool-link-card glass">
          <div class="tool-link-title">Twitter Character Counter</div>
          <div class="tool-link-desc">Audit tweet character limits, t.co link shortening weights, and emoji counts in real time.</div>
        </a>
        <a href="/tools/twitter-engagement-calculator" class="tool-link-card glass">
          <div class="tool-link-title">Twitter Engagement Calculator</div>
          <div class="tool-link-desc">Measure your Twitter engagement rate based on likes, retweets, replies, and follower counts.</div>
        </a>
        <a href="/tools/linkedin-post-formatter" class="tool-link-card glass">
          <div class="tool-link-title">LinkedIn Post Formatter</div>
          <div class="tool-link-desc">Add bold, italic, and bulleted formatting to your social media posts to boost visual appeal.</div>
        </a>
        <a href="/tools/instagram-caption-character-counter" class="tool-link-card glass">
          <div class="tool-link-title">Instagram Caption Character Counter</div>
          <div class="tool-link-desc">Check the 2,200 character limit and 125-character mobile feed crop for Instagram captions.</div>
        </a>
        <a href="/tools/youtube-title-character-counter" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Title Character Counter</div>
          <div class="tool-link-desc">Count characters, words, and emojis in your YouTube titles while auditing mobile truncation.</div>
        </a>
      </div>

    </section>
  </div>
</ToolLayout>

<style>
  /* Base Card Container */
  .calc-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Preset Limit Selector Tabs */
  .tabs-container {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    background: var(--color-bg-alt);
    padding: 0.35rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .preset-tab {
    flex: 1;
    padding: 0.55rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
  }

  .preset-tab:hover {
    color: var(--color-text);
  }

  .preset-tab.active {
    background: var(--color-brand);
    color: #ffffff;
  }

  /* 2-Column Grid Layout */
  .calc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 992px) {
    .calc-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Left Form & Editor */
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .input-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .editor-textarea {
    width: 100%;
    min-height: 220px;
    padding: 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    outline: none;
    resize: vertical;
    box-sizing: border-box;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .editor-textarea:focus {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  /* Action Toolbar */
  .action-toolbar {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .format-btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .format-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  /* Prominent Main Action Buttons Row */
  .main-actions-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .calc-btn-primary {
    flex: 2;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--gradient-brand);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: transform var(--transition-fast), opacity var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
  }

  .calc-btn-primary:hover {
    opacity: 0.95;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
  }

  .calc-btn-secondary {
    flex: 1;
    min-height: 48px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all var(--transition-fast);
  }

  .calc-btn-secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg);
  }

  .btn-svg {
    width: 18px;
    height: 18px;
  }

  /* Right Column: Results Panel */
  .calc-results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  /* Progress Ring Card */
  .progress-ring-card {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .ring-container {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ring-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .ring-bg {
    fill: transparent;
    stroke: var(--color-border);
    stroke-width: 8;
  }

  .ring-fill {
    fill: transparent;
    stroke: var(--color-brand);
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dashoffset var(--transition-fast), stroke var(--transition-fast);
  }

  .ring-center-text {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .ring-num {
    font-size: 1.15rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-text);
  }

  .ring-sub {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-top: 0.15rem;
  }

  .ring-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 180px;
  }

  .ring-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ring-mode-title {
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .ring-pct-badge {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brand);
  }

  .ring-desc-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* 8 Metric Cards Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .metric-card {
    padding: 0.8rem 0.6rem;
    text-align: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: border-color var(--transition-fast);
  }

  .metric-card:hover {
    border-color: var(--color-border-hover);
  }

  .metric-card.highlight-card {
    background: rgba(99, 102, 241, 0.06);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .metric-value {
    font-size: 1.3rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-brand);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.2rem;
  }

  .metric-sub {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Editorial Content Styles */
  .editorial-section {
    padding-top: 1.5rem;
  }

  .editorial-section h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .editorial-section p {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .editorial-section ul, .editorial-section ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .editorial-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .editorial-section code {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .editorial-table th, .editorial-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .editorial-table th {
    background: var(--color-bg-alt);
    font-weight: 700;
  }

  .editorial-table tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .faq-editorial-list p {
    margin-bottom: 1rem;
    background: var(--color-bg-alt);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .internal-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-link-card {
    display: block;
    padding: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tweetInput = document.getElementById('tweet-input') as HTMLTextAreaElement | null;
    const presetTabs = document.querySelectorAll('.preset-tab');

    // Toolbar Action Buttons
    const btnUppercase = document.getElementById('btn-uppercase');
    const btnLowercase = document.getElementById('btn-lowercase');
    const btnTitlecase = document.getElementById('btn-titlecase');
    const btnCleanspace = document.getElementById('btn-cleanspace');
    const btnCopy = document.getElementById('btn-copy');
    const copyTextSpan = document.getElementById('copy-text');
    const btnClear = document.getElementById('btn-clear');

    // Progress Ring Elements
    const ringFill = document.getElementById('ring-fill');
    const ringRemainingNum = document.getElementById('ring-remaining-num');
    const limitPresetName = document.getElementById('limit-preset-name');
    const limitCountVal = document.getElementById('limit-count-val');
    const ringDescText = document.getElementById('ring-desc-text');

    // 8 Metric Count Displays
    const countWords = document.getElementById('count-words');
    const countXWeighted = document.getElementById('count-x-weighted');
    const countWithSpaces = document.getElementById('count-with-spaces');
    const countNoSpaces = document.getElementById('count-no-spaces');
    const countReadingTime = document.getElementById('count-reading-time');
    const countLetters = document.getElementById('count-letters');
    const countNumbers = document.getElementById('count-numbers');
    const countEmojis = document.getElementById('count-emojis');

    if (!tweetInput) return;

    let currentLimit = 280;
    let currentPresetLabel = 'Standard Tweet';

    // Regex matchers
    const urlRegex = /https?:\/\/[^\s]+/g;
    const emojiRegex = /[\u{1F300}-\u{1F9FF}]|[\u{1F600}-\u{1F64F}]|[\u{1F680}-\u{1F6FF}]|[\u{2600}-\u{26FF}]|[\u{2700}-\u{27BF}]|[\u{1F1E6}-\u{1F1FF}]|[\u{1F900}-\u{1F9FF}]|[\u{1FA70}-\u{1FAFF}]/gu;

    // Calculate Twitter X-Weighted Character Count
    function calculateXWeightedLength(text: string): number {
      if (!text) return 0;
      
      // Replace URLs with 23 placeholder characters (t.co length)
      let parsed = text.replace(urlRegex, 'x'.repeat(23));

      // Standard characters length
      let length = Array.from(parsed).length;

      // Emojis count as 2 characters on Twitter
      const emojiMatches = text.match(emojiRegex);
      if (emojiMatches) {
        length += emojiMatches.length;
      }

      return length;
    }

    // Main Live Metric Calculation Engine
    function updateMetrics() {
      const rawText = tweetInput?.value || '';

      // 1. Total Words
      const trimmedText = rawText.trim();
      const words = trimmedText ? trimmedText.split(/\s+/).filter(Boolean).length : 0;

      // 2. X-Weighted Characters
      const xWeightedChars = calculateXWeightedLength(rawText);

      // 3. Characters With Spaces (Raw)
      const charsWithSpaces = Array.from(rawText).length;

      // 4. Characters Without Spaces
      const noSpacesText = rawText.replace(/\s+/g, '');
      const charsNoSpaces = Array.from(noSpacesText).length;

      // 5. Estimated Reading Time (based on 200 WPM)
      const secondsRead = Math.ceil((words / 200) * 60);
      let readingTimeStr = '0s';
      if (words > 0) {
        if (secondsRead < 60) {
          readingTimeStr = `${secondsRead}s`;
        } else {
          const mins = Math.floor(secondsRead / 60);
          const secs = secondsRead % 60;
          readingTimeStr = secs > 0 ? `${mins}m ${secs}s` : `${mins}m`;
        }
      }

      // 6. Letter Count (\p{L})
      const letterMatches = rawText.match(/\p{L}/gu);
      const letterCount = letterMatches ? letterMatches.length : 0;

      // 7. Number Count (\p{N})
      const numberMatches = rawText.match(/\p{N}/gu);
      const numberCount = numberMatches ? numberMatches.length : 0;

      // 8. Emoji Count
      const emojiMatches = rawText.match(emojiRegex);
      const emojiCount = emojiMatches ? emojiMatches.length : 0;

      // Format Numbers into UI Elements
      if (countWords) countWords.textContent = words.toLocaleString();
      if (countXWeighted) countXWeighted.textContent = xWeightedChars.toLocaleString();
      if (countWithSpaces) countWithSpaces.textContent = charsWithSpaces.toLocaleString();
      if (countNoSpaces) countNoSpaces.textContent = charsNoSpaces.toLocaleString();
      if (countReadingTime) countReadingTime.textContent = readingTimeStr;
      if (countLetters) countLetters.textContent = letterCount.toLocaleString();
      if (countNumbers) countNumbers.textContent = numberCount.toLocaleString();
      if (countEmojis) countEmojis.textContent = emojiCount.toLocaleString();

      // Update Progress Ring & Remaining Allowance
      const remainingChars = currentLimit - xWeightedChars;
      const pctUsed = Math.min(100, Math.max(0, Math.round((xWeightedChars / currentLimit) * 100)));

      if (ringRemainingNum) {
        ringRemainingNum.textContent = remainingChars >= 0 ? remainingChars.toLocaleString() : `-${Math.abs(remainingChars).toLocaleString()}`;
        ringRemainingNum.style.color = remainingChars < 0 ? 'var(--color-danger)' : 'var(--color-text)';
      }

      if (limitPresetName) limitPresetName.textContent = `${currentPresetLabel} Limit`;
      if (limitCountVal) limitCountVal.textContent = `${xWeightedChars.toLocaleString()} / ${currentLimit.toLocaleString()} (${pctUsed}%)`;

      if (ringDescText) {
        if (currentLimit === 280) {
          ringDescText.textContent = `Standard tweets allow 280 characters (~45-55 words). URLs automatically count as 23 characters via t.co, and emojis count as 2 characters.`;
        } else {
          ringDescText.textContent = `X Premium long-form posts allow up to 25,000 characters (~3,500-4,500 words). Great for in-depth essays, guides, and newsletters.`;
        }
      }

      // Update Circle Ring Offset (Perimeter = 2 * PI * r = 2 * 3.14159 * 42 = 263.89)
      const circumference = 263.89;
      if (ringFill) {
        const offset = circumference - (pctUsed / 100) * circumference;
        ringFill.style.strokeDashoffset = `${offset}`;
        
        if (remainingChars < 0) {
          ringFill.style.stroke = 'var(--color-danger)';
        } else if (pctUsed >= 85) {
          ringFill.style.stroke = 'var(--color-warning)';
        } else {
          ringFill.style.stroke = 'var(--color-brand)';
        }
      }
    }

    // Attach Event Listeners to Input
    ['input', 'change', 'keyup'].forEach(evt => {
      tweetInput.addEventListener(evt, updateMetrics);
    });

    // Preset Tabs Switch Handler
    presetTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const limit = tab.getAttribute('data-limit');
        const label = tab.getAttribute('data-label');
        if (limit && label) {
          currentLimit = parseInt(limit, 10);
          currentPresetLabel = label;

          presetTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          updateMetrics();
        }
      });
    });

    // Toolbar Action 1: UPPERCASE
    if (btnUppercase) {
      btnUppercase.addEventListener('click', () => {
        if (!tweetInput) return;
        tweetInput.value = tweetInput.value.toUpperCase();
        updateMetrics();
      });
    }

    // Toolbar Action 2: lowercase
    if (btnLowercase) {
      btnLowercase.addEventListener('click', () => {
        if (!tweetInput) return;
        tweetInput.value = tweetInput.value.toLowerCase();
        updateMetrics();
      });
    }

    // Toolbar Action 3: Title Case
    if (btnTitlecase) {
      btnTitlecase.addEventListener('click', () => {
        if (!tweetInput) return;
        tweetInput.value = tweetInput.value.replace(/\w\S*/g, (txt) => {
          return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();
        });
        updateMetrics();
      });
    }

    // Toolbar Action 4: Clean Spacing
    if (btnCleanspace) {
      btnCleanspace.addEventListener('click', () => {
        if (!tweetInput) return;
        tweetInput.value = tweetInput.value
          .split('\n')
          .map(line => line.replace(/[ \t]+/g, ' ').trim())
          .join('\n');
        updateMetrics();
      });
    }

    // Toolbar Action 5: Copy Tweet
    if (btnCopy) {
      btnCopy.addEventListener('click', () => {
        if (!tweetInput) return;
        navigator.clipboard.writeText(tweetInput.value).then(() => {
          if (copyTextSpan) copyTextSpan.textContent = 'Copied!';
          setTimeout(() => {
            if (copyTextSpan) copyTextSpan.textContent = 'Copy Tweet';
          }, 2000);
        }).catch(() => {
          tweetInput.select();
          document.execCommand('copy');
          if (copyTextSpan) copyTextSpan.textContent = 'Copied!';
          setTimeout(() => {
            if (copyTextSpan) copyTextSpan.textContent = 'Copy Tweet';
          }, 2000);
        });
      });
    }

    // Toolbar Action 6: Clear
    if (btnClear) {
      btnClear.addEventListener('click', () => {
        if (!tweetInput) return;
        tweetInput.value = '';
        updateMetrics();
        tweetInput.focus();
      });
    }

    // Initial calculation on page load
    updateMetrics();
  });
</script>

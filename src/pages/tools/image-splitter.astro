    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: border-color var(--transition-fast);
  }

  .metric-card:hover {
    border-color: var(--color-border-hover);
  }

  .metric-value {
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-brand);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.2rem;
  }

  .metric-sub {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Overlay Stage */
  .overlay-stage-card {
    padding: 1rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stage-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stage-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stage-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .stage-canvas-wrapper {
    width: 100%;
    max-height: 260px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .grid-overlay-canvas {
    max-width: 100%;
    max-height: 260px;
    object-fit: contain;
  }

  /* Slices Gallery Card */
  .slices-gallery-card {
    padding: 1rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gallery-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .gallery-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .gallery-sub {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .tiles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    max-height: 280px;
    overflow-y: auto;
  }

  :global(.tile-item) {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
  }

  :global(.tile-img) {
    width: 100%;
    height: 70px;
    object-fit: cover;
  }

  :global(.tile-btn) {
    width: 100%;
    padding: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-brand);
    background: var(--color-bg-alt);
    border: none;
    border-top: 1px solid var(--color-border);
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
  }

  :global(.tile-btn:hover) {
    background: rgba(99, 102, 241, 0.1);
  }

  .output-actions-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  /* Editorial Content Styles */
  .editorial-section {
    padding-top: 1.5rem;
  }

  .editorial-section h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .editorial-section p {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .editorial-section ul, .editorial-section ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .editorial-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .editorial-section code {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .editorial-table th, .editorial-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .editorial-table th {
    background: var(--color-bg-alt);
    font-weight: 700;
  }

  .editorial-table tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .internal-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-link-card {
    display: block;
    padding: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  declare const JSZip: any;

  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedFileBar = document.getElementById('loaded-file-bar');
    const loadedThumbImg = document.getElementById('loaded-thumb-img') as HTMLImageElement | null;
    const loadedFilename = document.getElementById('loaded-filename');
    const loadedFilesize = document.getElementById('loaded-filesize');
    const btnClearFile = document.getElementById('btn-clear-file');

    const inputRows = document.getElementById('input-rows') as HTMLInputElement | null;
    const inputCols = document.getElementById('input-cols') as HTMLInputElement | null;
    const inputFormat = document.getElementById('input-format') as HTMLSelectElement | null;
    const presetBtns = document.querySelectorAll('.preset-btn');

    const btnSplit = document.getElementById('btn-split');
    const btnClearAll = document.getElementById('btn-clear-all');

    // Audit Displays
    const emptyStateCard = document.getElementById('empty-state-card');
    const resultsDisplayBox = document.getElementById('results-display-box');
    const resOrigDims = document.getElementById('res-orig-dims');
    const resGridLayout = document.getElementById('res-grid-layout');
    const resTileDims = document.getElementById('res-tile-dims');
    const resTotalTiles = document.getElementById('res-total-tiles');

    const gridOverlayCanvas = document.getElementById('grid-overlay-canvas') as HTMLCanvasElement | null;
    const tilesGrid = document.getElementById('tiles-grid');
    const btnDownloadZip = document.getElementById('btn-download-zip');

    if (!dropzone || !fileInput) return;

    let loadedImageObj: HTMLImageElement | null = null;
    let loadedFileName = 'image';
    let generatedTileBlobs: { name: string; blob: Blob; url: string }[] = [];

    // Drag & Drop Handling
    ['dragenter', 'dragover'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dragover');
      });
    });

    dropzone.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFileSelection(dt.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFileSelection(fileInput.files[0]);
      }
    });

    if (btnClearFile) btnClearFile.addEventListener('click', resetState);
    if (btnClearAll) btnClearAll.addEventListener('click', resetState);

    // Preset Buttons
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const r = btn.getAttribute('data-rows');
        const c = btn.getAttribute('data-cols');
        if (r && inputRows) inputRows.value = r;
        if (c && inputCols) inputCols.value = c;
        if (loadedImageObj) processImageSplitting();
      });
    });

    function resetState() {
      loadedImageObj = null;
      if (fileInput) fileInput.value = '';
      if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
      if (loadedFileBar) loadedFileBar.style.display = 'none';
      if (resultsDisplayBox) resultsDisplayBox.style.display = 'none';
      if (emptyStateCard) emptyStateCard.style.display = 'flex';
      cleanupBlobUrls();
    }

    function cleanupBlobUrls() {
      generatedTileBlobs.forEach(t => URL.revokeObjectURL(t.url));
      generatedTileBlobs = [];
    }

    function handleFileSelection(file: File) {
      if (!file || !file.type.startsWith('image/')) {
        alert('Please select a valid image file (PNG, JPG, WEBP).');
        return;
      }

      const mbSize = (file.size / (1024 * 1024)).toFixed(2);
      if (loadedFilename) loadedFilename.textContent = file.name;
      if (loadedFilesize) loadedFilesize.textContent = `${mbSize} MB`;
      loadedFileName = file.name.replace(/\.[^/.]+$/, "");

      const reader = new FileReader();
      reader.onload = (evt) => {
        const dataUrl = evt.target?.result as string;
        if (loadedThumbImg) loadedThumbImg.src = dataUrl;

        const img = new Image();
        img.onload = () => {
          loadedImageObj = img;
          if (dropzonePrompt) dropzonePrompt.style.display = 'none';
          if (loadedFileBar) loadedFileBar.style.display = 'flex';
          processImageSplitting();
        };
        img.src = dataUrl;
      };
      reader.readAsDataURL(file);
    }

    // High-Accuracy Canvas Image Slicing Engine
    async function processImageSplitting() {
      if (!loadedImageObj) return;

      const rows = Math.max(1, Math.min(10, parseInt(inputRows?.value || '3', 10)));
      const cols = Math.max(1, Math.min(10, parseInt(inputCols?.value || '3', 10)));
      const format = inputFormat?.value || 'png';
      const ext = format === 'jpeg' ? 'jpg' : 'png';
      const mime = format === 'jpeg' ? 'image/jpeg' : 'image/png';

      const imgW = loadedImageObj.naturalWidth || loadedImageObj.width;
      const imgH = loadedImageObj.naturalHeight || loadedImageObj.height;

      const tileW = Math.floor(imgW / cols);
      const tileH = Math.floor(imgH / rows);

      cleanupBlobUrls();

      // Update Audit Cards
      if (resOrigDims) resOrigDims.textContent = `${imgW} x ${imgH} px`;
      if (resGridLayout) resGridLayout.textContent = `${rows} x ${cols}`;
      if (resTileDims) resTileDims.textContent = `${tileW} x ${tileH} px`;
      if (resTotalTiles) resTotalTiles.textContent = `${rows * cols}`;

      // Render Grid Overlay Preview Stage
      if (gridOverlayCanvas) {
        gridOverlayCanvas.width = imgW;
        gridOverlayCanvas.height = imgH;
        const ctx = gridOverlayCanvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(loadedImageObj, 0, 0);

          // Draw Grid Overlay Lines
          ctx.strokeStyle = '#6366f1';
          ctx.lineWidth = Math.max(2, Math.floor(imgW / 300));

          // Vertical lines
          for (let c = 1; c < cols; c++) {
            ctx.beginPath();
            ctx.moveTo(c * tileW, 0);
            ctx.lineTo(c * tileW, imgH);
            ctx.stroke();
          }

          // Horizontal lines
          for (let r = 1; r < rows; r++) {
            ctx.beginPath();
            ctx.moveTo(0, r * tileH);
            ctx.lineTo(imgW, r * tileH);
            ctx.stroke();
          }

          // Draw Tile Index Numbers
          let tileNum = 1;
          const fontSize = Math.max(16, Math.floor(tileH / 4));
          ctx.font = `bold ${fontSize}px sans-serif`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';

          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const centerX = c * tileW + tileW / 2;
              const centerY = r * tileH + tileH / 2;

              // Number Badge Circle
              ctx.fillStyle = 'rgba(99, 102, 241, 0.85)';
              ctx.beginPath();
              ctx.arc(centerX, centerY, fontSize * 0.8, 0, 2 * Math.PI);
              ctx.fill();

              ctx.fillStyle = '#ffffff';
              ctx.fillText(`${tileNum}`, centerX, centerY);
              tileNum++;
            }
          }
        }
      }

      // Generate Tile Slices
      if (tilesGrid) tilesGrid.innerHTML = '';
      let tileIndex = 1;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const tileCanvas = document.createElement('canvas');
          tileCanvas.width = tileW;
          tileCanvas.height = tileH;
          const tileCtx = tileCanvas.getContext('2d');

          if (tileCtx) {
            tileCtx.drawImage(
              loadedImageObj,
              c * tileW, r * tileH, tileW, tileH,
              0, 0, tileW, tileH
            );

            const blob: Blob = await new Promise(res => tileCanvas.toBlob(b => res(b!), mime, 0.92));
            const blobUrl = URL.createObjectURL(blob);
            const tileFileName = `${loadedFileName}_tile_${tileIndex}.${ext}`;

            generatedTileBlobs.push({
              name: tileFileName,
              blob: blob,
              url: blobUrl
            });

            // Create Tile Gallery Item
            const tileCard = document.createElement('div');
            tileCard.className = 'tile-item';

            const tileImg = document.createElement('img');
            tileImg.className = 'tile-img';
            tileImg.src = blobUrl;
            tileImg.alt = `Tile ${tileIndex}`;

            const tileBtn = document.createElement('button');
            tileBtn.type = 'button';
            tileBtn.className = 'tile-btn';
            tileBtn.textContent = `Tile #${tileIndex} (Save)`;
            tileBtn.addEventListener('click', () => {
              downloadSingleBlob(blobUrl, tileFileName);
            });

            tileCard.appendChild(tileImg);
            tileCard.appendChild(tileBtn);
            if (tilesGrid) tilesGrid.appendChild(tileCard);

            tileIndex++;
          }
        }
      }

      if (emptyStateCard) emptyStateCard.style.display = 'none';
      if (resultsDisplayBox) {
        resultsDisplayBox.style.display = 'flex';
        if (window.innerWidth < 992) {
          resultsDisplayBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function downloadSingleBlob(url: string, filename: string) {
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    // Trigger image re-splitting when inputs change
    if (inputRows) inputRows.addEventListener('change', () => { if (loadedImageObj) processImageSplitting(); });
    if (inputCols) inputCols.addEventListener('change', () => { if (loadedImageObj) processImageSplitting(); });
    if (inputFormat) inputFormat.addEventListener('change', () => { if (loadedImageObj) processImageSplitting(); });
    if (btnSplit) btnSplit.addEventListener('click', processImageSplitting);

    // Download All Slices (ZIP)
    if (btnDownloadZip) {
      btnDownloadZip.addEventListener('click', async () => {
        if (generatedTileBlobs.length === 0) return;

        if (typeof JSZip !== 'undefined') {
          const zip = new JSZip();
          generatedTileBlobs.forEach(tile => {
            zip.file(tile.name, tile.blob);
          });

          const zipBlob = await zip.generateAsync({ type: 'blob' });
          const zipUrl = URL.createObjectURL(zipBlob);
          downloadSingleBlob(zipUrl, `${loadedFileName}_split_tiles.zip`);
          setTimeout(() => URL.revokeObjectURL(zipUrl), 3000);
        } else {
          // Fallback sequential download
          generatedTileBlobs.forEach((tile, i) => {
            setTimeout(() => {
              downloadSingleBlob(tile.url, tile.name);
            }, i * 300);
          });
        }
      });
    }
  });
</script>

  }

  .verdict-icon {
    font-size: 1.4rem;
  }

  .verdict-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .verdict-title {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .verdict-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* 4 Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .metric-card {
    padding: 0.8rem 0.6rem;
    text-align: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);

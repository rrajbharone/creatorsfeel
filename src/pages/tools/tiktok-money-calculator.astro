    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
  }

  .tool-link-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnCalculate = document.getElementById('btn-calculate');
    const btnReset = document.getElementById('btn-reset');
    const emptyState = document.getElementById('empty-state');
    const resultsBox = document.getElementById('results-box');

    const inputViews = document.getElementById('avg-views') as HTMLInputElement | null;
    const inputVideos = document.getElementById('videos-per-month') as HTMLInputElement | null;
    const selectLength = document.getElementById('video-length') as HTMLSelectElement | null;
    const selectEngagement = document.getElementById('engagement-rate') as HTMLSelectElement | null;

    const elRangeMin = document.getElementById('range-min');
    const elRangeMax = document.getElementById('range-max');
    const elSub = document.getElementById('earnings-sub');
    const elTotalViews = document.getElementById('res-total-views');
    const elPerVideo = document.getElementById('res-per-video');
    const elCpmUsed = document.getElementById('res-cpm-used');
    const elEngLabel = document.getElementById('res-engagement-label');
    const elBrandRange = document.getElementById('brand-deal-range');
    const elBrandTotal = document.getElementById('brand-total-range');

    // CPM ranges per program type (per 1,000 views, in USD)
    const cpmRanges = {
      short: { min: 0.020, max: 0.040 }, // Creator Fund
      long:  { min: 0.400, max: 1.000 }, // Creator Rewards Program
    };

    // Engagement multiplier on CPM (higher engagement = slightly higher effective CPM)
    const engMult: Record<string, { label: string; mult: number }> = {
      low:     { label: 'Low (<3%)',      mult: 0.80 },
      average: { label: 'Average (3–6%)', mult: 1.00 },
      high:    { label: 'High (6–12%)',   mult: 1.25 },
      viral:   { label: 'Viral (12%+)',   mult: 1.60 },
    };

    // Brand deal ranges (per sponsored post, USD) based on average views
    function brandDealRange(avgViews: number): { min: number; max: number } {
      if (avgViews < 10_000)  return { min: 50,   max: 200  };
      if (avgViews < 50_000)  return { min: 150,  max: 600  };
      if (avgViews < 200_000) return { min: 500,  max: 2000 };
      if (avgViews < 1_000_000) return { min: 1500, max: 6000 };
      return { min: 5000, max: 20000 };
    }

    function formatMoney(val: number): string {
      if (val < 1) return '<$1';
      if (val >= 1000) return '$' + (val / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
      return '$' + Math.round(val).toLocaleString();
    }

    function formatViews(val: number): string {
      if (val >= 1_000_000) return (val / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
      if (val >= 1_000) return (val / 1_000).toFixed(0) + 'K';
      return val.toLocaleString();
    }

    function calculate() {
      const avgViews = parseFloat(inputViews?.value || '0');
      const videosPerMonth = parseFloat(inputVideos?.value || '0');
      const videoLength = selectLength?.value || 'long';
      const engKey = selectEngagement?.value || 'average';

      if (!avgViews || !videosPerMonth || avgViews < 0 || videosPerMonth < 0) {
        alert('Please enter valid positive numbers for views and video count.');
        return;
      }

      const totalViews = avgViews * videosPerMonth;
      const { min: cpmMin, max: cpmMax } = cpmRanges[videoLength as 'short' | 'long'];
      const { label: engLabel, mult } = engMult[engKey] || engMult.average;

      const effectiveCpmMin = cpmMin * mult;
      const effectiveCpmMax = cpmMax * mult;

      const earningsMin = (totalViews / 1000) * effectiveCpmMin;
      const earningsMax = (totalViews / 1000) * effectiveCpmMax;
      const perVideoMin = (avgViews / 1000) * effectiveCpmMin;
      const perVideoMax = (avgViews / 1000) * effectiveCpmMax;
      const avgCpm = ((effectiveCpmMin + effectiveCpmMax) / 2);

      const brand = brandDealRange(avgViews);
      const brandMonthlyMin = brand.min; // 1 deal per month conservative
      const brandMonthlyMax = brand.max * 2; // up to 2 deals

      // Update DOM
      if (elRangeMin) elRangeMin.textContent = formatMoney(earningsMin);
      if (elRangeMax) elRangeMax.textContent = formatMoney(earningsMax);
      if (elSub) elSub.textContent = videoLength === 'long' ? 'From TikTok Creator Rewards Program' : 'From TikTok Creator Fund';
      if (elTotalViews) elTotalViews.textContent = formatViews(totalViews);
      if (elPerVideo) elPerVideo.textContent = `${formatMoney(perVideoMin)}–${formatMoney(perVideoMax)}`;
      if (elCpmUsed) elCpmUsed.textContent = `$${effectiveCpmMin.toFixed(2)}–$${effectiveCpmMax.toFixed(2)}`;
      if (elEngLabel) elEngLabel.textContent = engLabel;
      if (elBrandRange) elBrandRange.textContent = `${formatMoney(brand.min)}–${formatMoney(brand.max)}`;
      if (elBrandTotal) elBrandTotal.textContent = `${formatMoney(earningsMin + brandMonthlyMin)}–${formatMoney(earningsMax + brandMonthlyMax)}`;

      // Show results
      if (emptyState) emptyState.style.display = 'none';
      if (resultsBox) resultsBox.style.display = 'flex';
    }

    function reset() {
      if (inputViews) inputViews.value = '50000';
      if (inputVideos) inputVideos.value = '15';
      if (selectLength) selectLength.value = 'long';
      if (selectEngagement) selectEngagement.value = 'average';
      if (emptyState) emptyState.style.display = 'flex';
      if (resultsBox) resultsBox.style.display = 'none';
    }

    if (btnCalculate) btnCalculate.addEventListener('click', calculate);
    if (btnReset) btnReset.addEventListener('click', reset);

    // Auto-calculate on load with defaults
    calculate();
  });
</script>

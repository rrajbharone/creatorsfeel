  .editorial-section h3 {
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text);
  }

  .editorial-section h4 {

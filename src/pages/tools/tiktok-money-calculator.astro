<script>
  function initTikTokMoneyCalculator() {
    // Mode Switcher Elements
    const tabRewards = document.getElementById('tab-mode-rewards');
    const tabSponsorships = document.getElementById('tab-mode-sponsorships');
    const formRewards = document.getElementById('form-mode-rewards');
    const formSponsorships = document.getElementById('form-mode-sponsorships');
    const benchmarkStrip = document.getElementById('benchmark-strip-rewards');

    // Controls
    const selectCurrency = document.getElementById('calc-currency');
    const btnReset = document.getElementById('btn-reset');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const copySummaryLabel = document.getElementById('copy-summary-label');

    // Mode 1 Inputs
    const inputMonthlyViews = document.getElementById('input-monthly-views');
    const inputRpm = document.getElementById('input-rpm');
    const inputQualifiedRate = document.getElementById('input-qualified-rate');
    const labelQualifiedRate = document.getElementById('label-qualified-rate');
    const presetChips = document.querySelectorAll('.preset-chip');

    // Mode 2 Inputs
    const inputSponViews = document.getElementById('input-spon-views');
    const inputSponDealsCount = document.getElementById('input-spon-deals-count');
    const selectSponNiche = document.getElementById('select-spon-niche');

    // Result Metric Elements
    const titleResPrimary = document.getElementById('title-res-primary');
    const valMonthlyEarnings = document.getElementById('res-monthly-earnings');
    const subMonthlyDetail = document.getElementById('res-monthly-sub');

    const titleResSecondary = document.getElementById('title-res-secondary');
    const valYearlyEarnings = document.getElementById('res-yearly-earnings');

    const titleResTertiary = document.getElementById('title-res-tertiary');
    const valTertiary = document.getElementById('res-tertiary-val');
    const subTertiary = document.getElementById('res-tertiary-sub');

    const titleResQuaternary = document.getElementById('title-res-quaternary');
    const valQuaternary = document.getElementById('res-quaternary-val');
    const subQuaternary = document.getElementById('res-quaternary-sub');

    // Benchmarks
    const bmCurrentRpm = document.getElementById('bm-current-rpm');
    const bm10k = document.getElementById('bm-10k');
    const bm50k = document.getElementById('bm-50k');
    const bm100k = document.getElementById('bm-100k');
    const bm1m = document.getElementById('bm-1m');

    // Formula text
    const calcFormulaText = document.getElementById('calculation-formula-text');

    let currentMode = 'rewards'; // 'rewards' | 'sponsorships'

    const currencyConfig = {
      USD: { symbol: '$', rate: 1.0 },
      EUR: { symbol: '€', rate: 0.92 },
      GBP: { symbol: '£', rate: 0.79 },
      CAD: { symbol: 'CA$', rate: 1.36 },
      AUD: { symbol: 'A$', rate: 1.52 },
      INR: { symbol: '₹', rate: 83.5 }
    };

    function formatNumber(num) {
      if (isNaN(num) || !isFinite(num)) return '0';
      return Math.round(num).toLocaleString('en-US');
    }

    function formatCurrency(amount, currKey) {
      if (isNaN(amount) || !isFinite(amount)) amount = 0;
      const conf = currencyConfig[currKey] || currencyConfig.USD;
      const formatted = amount.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      return `${conf.symbol}${formatted}`;
    }

    function updateCurrencyLabels() {
      const currKey = selectCurrency ? selectCurrency.value : 'USD';
      const conf = currencyConfig[currKey] || currencyConfig.USD;
      const labels = document.querySelectorAll('.currency-symbol-label');
      labels.forEach((el) => {
        el.textContent = conf.symbol;
      });
    }

    function calculate() {
      const currKey = selectCurrency ? selectCurrency.value : 'USD';
      const conf = currencyConfig[currKey] || currencyConfig.USD;

      if (currentMode === 'rewards') {
        let totalViews = parseFloat(inputMonthlyViews ? inputMonthlyViews.value : '0') || 0;
        let rpm = parseFloat(inputRpm ? inputRpm.value : '0') || 0;
        let qualifiedRate = parseFloat(inputQualifiedRate ? inputQualifiedRate.value : '60') || 60;

        if (totalViews < 0) totalViews = 0;
        if (rpm < 0) rpm = 0;
        if (qualifiedRate < 1) qualifiedRate = 1;
        if (qualifiedRate > 100) qualifiedRate = 100;

        const qualifiedViews = totalViews * (qualifiedRate / 100);
        const monthlyEarnings = (qualifiedViews / 1000) * rpm;
        const yearlyEarnings = monthlyEarnings * 12;

        // Benchmarks at current RPM
        const val10k = (10000 / 1000) * rpm;
        const val50k = (50000 / 1000) * rpm;
        const val100k = (100000 / 1000) * rpm;
        const val1m = (1000000 / 1000) * rpm;

        // Card 1
        if (titleResPrimary) titleResPrimary.textContent = 'Estimated Monthly Earnings';
        if (valMonthlyEarnings) valMonthlyEarnings.textContent = formatCurrency(monthlyEarnings, currKey);
        if (subMonthlyDetail) {
          subMonthlyDetail.textContent = `Based on ${formatNumber(qualifiedViews)} qualified views at ${conf.symbol}${rpm.toFixed(2)} RPM`;
        }

        // Card 2
        if (titleResSecondary) titleResSecondary.textContent = 'Estimated Yearly Earnings';
        if (valYearlyEarnings) valYearlyEarnings.textContent = formatCurrency(yearlyEarnings, currKey);

        // Card 3
        if (titleResTertiary) titleResTertiary.textContent = 'Monetized Qualified Views';
        if (valTertiary) valTertiary.textContent = formatNumber(qualifiedViews);
        if (subTertiary) subTertiary.textContent = `${qualifiedRate}% of ${formatNumber(totalViews)} monthly views`;

        // Card 4
        if (titleResQuaternary) titleResQuaternary.textContent = 'Applied Creator RPM';
        if (valQuaternary) valQuaternary.textContent = `${conf.symbol}${rpm.toFixed(2)}`;
        if (subQuaternary) subQuaternary.textContent = `Net payout per 1,000 qualified views (${currKey})`;

        // Benchmarks
        if (bmCurrentRpm) bmCurrentRpm.textContent = `${conf.symbol}${rpm.toFixed(2)}`;
        if (bm10k) bm10k.textContent = formatCurrency(val10k, currKey);
        if (bm50k) bm50k.textContent = formatCurrency(val50k, currKey);
        if (bm100k) bm100k.textContent = formatCurrency(val100k, currKey);
        if (bm1m) bm1m.textContent = formatCurrency(val1m, currKey);

        // Formula text
        if (calcFormulaText) {
          calcFormulaText.innerHTML = `Formula: (${formatNumber(qualifiedViews)} qualified views ÷ 1,000) × ${conf.symbol}${rpm.toFixed(2)} RPM = <strong>${formatCurrency(monthlyEarnings, currKey)} monthly earnings</strong>. Annual projection: ${formatCurrency(monthlyEarnings, currKey)} × 12 = <strong>${formatCurrency(yearlyEarnings, currKey)} yearly</strong>.`;
        }

      } else {
        // Sponsorship Mode
        let sponViews = parseFloat(inputSponViews ? inputSponViews.value : '0') || 0;
        let dealsCount = parseFloat(inputSponDealsCount ? inputSponDealsCount.value : '1') || 1;
        const nicheTier = selectSponNiche ? selectSponNiche.value : 'tier1';

        if (sponViews < 0) sponViews = 0;
        if (dealsCount < 0) dealsCount = 0;

        // Estimated sponsorship CPM per niche tier
        let sponCpm = 25.0; // Tier 1: $25 CPM average ($18-$35)
        if (nicheTier === 'tier2') sponCpm = 15.0; // Tier 2: $15 CPM ($10-$20)
        if (nicheTier === 'tier3') sponCpm = 8.0;  // Tier 3: $8 CPM ($5-$12)

        const ratePerPost = (sponViews / 1000) * sponCpm;
        const monthlySponEarnings = ratePerPost * dealsCount;
        const yearlySponEarnings = monthlySponEarnings * 12;

        // Card 1
        if (titleResPrimary) titleResPrimary.textContent = 'Est. Monthly Brand Deals';
        if (valMonthlyEarnings) valMonthlyEarnings.textContent = formatCurrency(monthlySponEarnings, currKey);
        if (subMonthlyDetail) {
          subMonthlyDetail.textContent = `Based on ${dealsCount} sponsored posts @ ${formatCurrency(ratePerPost, currKey)} / post`;
        }

        // Card 2
        if (titleResSecondary) titleResSecondary.textContent = 'Annual Sponsorship Potential';
        if (valYearlyEarnings) valYearlyEarnings.textContent = formatCurrency(yearlySponEarnings, currKey);

        // Card 3
        if (titleResTertiary) titleResTertiary.textContent = 'Est. Rate Per Sponsored Post';
        if (valTertiary) valTertiary.textContent = formatCurrency(ratePerPost, currKey);
        if (subTertiary) subTertiary.textContent = `For ~${formatNumber(sponViews)} average video views`;

        // Card 4
        if (titleResQuaternary) titleResQuaternary.textContent = 'Benchmark Sponsor CPM';
        if (valQuaternary) valQuaternary.textContent = `${conf.symbol}${sponCpm.toFixed(2)}`;
        if (subQuaternary) subQuaternary.textContent = `Advertiser rate per 1,000 views (${currKey})`;

        // Formula text
        if (calcFormulaText) {
          calcFormulaText.innerHTML = `Sponsorship Model: (${formatNumber(sponViews)} views ÷ 1,000) × ${conf.symbol}${sponCpm.toFixed(2)} CPM = <strong>${formatCurrency(ratePerPost, currKey)} per post</strong>. At ${dealsCount} posts/mo: <strong>${formatCurrency(monthlySponEarnings, currKey)} monthly</strong> (${formatCurrency(yearlySponEarnings, currKey)} yearly).`;
        }
      }
    }

    // Switch calculation mode
    function setMode(mode) {
      currentMode = mode;
      if (mode === 'rewards') {
        if (tabRewards) {
          tabRewards.classList.add('active');
          tabRewards.setAttribute('aria-selected', 'true');
        }
        if (tabSponsorships) {
          tabSponsorships.classList.remove('active');
          tabSponsorships.setAttribute('aria-selected', 'false');
        }
        if (formRewards) formRewards.style.display = 'block';
        if (formSponsorships) formSponsorships.style.display = 'none';
        if (benchmarkStrip) benchmarkStrip.style.display = 'block';
      } else {
        if (tabSponsorships) {
          tabSponsorships.classList.add('active');
          tabSponsorships.setAttribute('aria-selected', 'true');
        }
        if (tabRewards) {
          tabRewards.classList.remove('active');
          tabRewards.setAttribute('aria-selected', 'false');
        }
        if (formRewards) formRewards.style.display = 'none';
        if (formSponsorships) formSponsorships.style.display = 'block';
        if (benchmarkStrip) benchmarkStrip.style.display = 'none';
      }
      calculate();
    }

    if (tabRewards) {
      tabRewards.addEventListener('click', () => setMode('rewards'));
    }
    if (tabSponsorships) {
      tabSponsorships.addEventListener('click', () => setMode('sponsorships'));
    }

    // Slider sync with label
    if (inputQualifiedRate && labelQualifiedRate) {
      inputQualifiedRate.addEventListener('input', () => {
        labelQualifiedRate.textContent = `${inputQualifiedRate.value}%`;
        calculate();
      });
    }

    // Live update listeners
    if (inputMonthlyViews) inputMonthlyViews.addEventListener('input', calculate);
    if (inputRpm) inputRpm.addEventListener('input', calculate);
    if (inputSponViews) inputSponViews.addEventListener('input', calculate);
    if (inputSponDealsCount) inputSponDealsCount.addEventListener('input', calculate);
    if (selectSponNiche) selectSponNiche.addEventListener('change', calculate);

    if (selectCurrency) {
      selectCurrency.addEventListener('change', () => {
        updateCurrencyLabels();
        calculate();
      });
    }

    // Preset chips
    presetChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        presetChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        const rpmVal = chip.getAttribute('data-rpm');
        if (inputRpm && rpmVal) {
          inputRpm.value = rpmVal;
          calculate();
        }
      });
    });

    // Reset button
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (inputMonthlyViews) inputMonthlyViews.value = '150000';
        if (inputRpm) inputRpm.value = '0.75';
        if (inputQualifiedRate) {
          inputQualifiedRate.value = '60';
          if (labelQualifiedRate) labelQualifiedRate.textContent = '60%';
        }
        if (inputSponViews) inputSponViews.value = '50000';
        if (inputSponDealsCount) inputSponDealsCount.value = '2';
        if (selectSponNiche) selectSponNiche.value = 'tier1';
        if (selectCurrency) selectCurrency.value = 'USD';

        presetChips.forEach((c) => {
          if (c.getAttribute('data-rpm') === '0.75') {
            c.classList.add('active');
          } else {
            c.classList.remove('active');
          }
        });

        updateCurrencyLabels();
        setMode('rewards');
      });
    }

    // Copy Summary Action
    if (btnCopySummary && copySummaryLabel) {
      btnCopySummary.addEventListener('click', async () => {
        const currKey = selectCurrency ? selectCurrency.value : 'USD';
        const conf = currencyConfig[currKey] || currencyConfig.USD;
        let summaryText = '';

        if (currentMode === 'rewards') {
          const views = inputMonthlyViews ? inputMonthlyViews.value : '0';
          const rpm = inputRpm ? inputRpm.value : '0.75';
          const qualRate = inputQualifiedRate ? inputQualifiedRate.value : '60';
          const monthly = valMonthlyEarnings ? valMonthlyEarnings.textContent : '$0.00';
          const yearly = valYearlyEarnings ? valYearlyEarnings.textContent : '$0.00';

          summaryText = `TikTok Creator Rewards Projection (${currKey}):\n` +
            `• Monthly Views: ${formatNumber(parseFloat(views))}\n` +
            `• Qualified Views Rate: ${qualRate}%\n` +
            `• Estimated RPM: ${conf.symbol}${parseFloat(rpm).toFixed(2)} per 1K qualified views\n` +
            `• Estimated Monthly Earnings: ${monthly}\n` +
            `• Estimated Yearly Earnings: ${yearly}\n` +
            `Calculated with CreatorsFeel TikTok Money Calculator: https://creatorsfeel.com/tools/tiktok-money-calculator`;
        } else {
          const sponViews = inputSponViews ? inputSponViews.value : '0';
          const deals = inputSponDealsCount ? inputSponDealsCount.value : '2';
          const perPost = valTertiary ? valTertiary.textContent : '$0.00';
          const monthly = valMonthlyEarnings ? valMonthlyEarnings.textContent : '$0.00';
          const yearly = valYearlyEarnings ? valYearlyEarnings.textContent : '$0.00';

          summaryText = `TikTok Sponsorship Projection (${currKey}):\n` +
            `• Average Views / Video: ${formatNumber(parseFloat(sponViews))}\n` +
            `• Sponsored Posts / Month: ${deals}\n` +
            `• Rate Per Sponsored Post: ${perPost}\n` +
            `• Estimated Monthly Sponsorships: ${monthly}\n` +
            `• Estimated Yearly Sponsorships: ${yearly}\n` +
            `Calculated with CreatorsFeel TikTok Money Calculator: https://creatorsfeel.com/tools/tiktok-money-calculator`;
        }

        try {
          await navigator.clipboard.writeText(summaryText);
          const original = copySummaryLabel.textContent;
          copySummaryLabel.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copySummaryLabel.textContent = original;
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    // Initial Execution
    updateCurrencyLabels();
    calculate();
  }

  // Handle both standard DOM load and Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTikTokMoneyCalculator);
  } else {
    initTikTokMoneyCalculator();
  }

  document.addEventListener('astro:after-swap', initTikTokMoneyCalculator);
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    question: "How much does TikTok pay per 1,000 views in 2026?",
    answer: "Under the TikTok Creator Rewards Program (which replaced the legacy Creator Fund for videos longer than 1 minute), creators typically earn between $0.40 and $1.20 per 1,000 qualified views, averaging around $0.75 RPM. Top-performing niches such as personal finance, technology, and business targeting Tier-1 countries (US, UK, Canada, Australia) can command $1.50 to $2.00+ RPM, while general entertainment in mixed global regions averages $0.30 to $0.60."
  },
  {
    question: "What is the difference between total views and qualified views on TikTok?",
    answer: "Total views represent every single playback recorded on your video, including quick scrolls, looped plays, and non-FYP traffic. Qualified views—the only views monetized by the Creator Rewards Program—require the viewer to watch for at least 5 continuous seconds, arrive from the 'For You' feed, be unique per viewer per 24-hour period, and watch an original video that is at least 60 seconds long. Typically, 40% to 70% of total views count as qualified."
  },
  {
    question: "What are the exact requirements to join the TikTok Creator Rewards Program?",
    answer: "To qualify for the TikTok Creator Rewards Program, your account must have at least 10,000 followers, have accumulated at least 100,000 authentic video views within the past 30 days, be based in an eligible country (such as the United States, United Kingdom, France, Germany, Japan, South Korea, or Brazil), be owned by an individual at least 18 years old, and maintain good standing with community guidelines."
  },
  {
    question: "How much money does 1 million views make on TikTok?",
    answer: "For 1,000,000 total views with a typical 60% qualification rate (600,000 qualified views), a creator with an average $0.75 RPM earns approximately $450. Depending on geographic audience concentration and watch completion rates, payout for 1 million total views typically ranges between $240 (at a conservative $0.40 RPM) and $960+ (at a high $1.60 RPM). If 100% of views are qualified, 1 million views yields $750 at standard rates."
  },
  {
    question: "Can you make money on TikTok without having 10,000 followers?",
    answer: "Yes. While TikTok's Creator Rewards Program requires 10,000 followers, creators can monetize immediately with fewer followers through TikTok Shop affiliate commissions (in regions with zero or low follower thresholds), brand sponsorships (especially User Generated Content/UGC deals), driving traffic to digital products or external storefronts, and receiving virtual gifts during LIVE broadcasts once live streaming is unlocked."
  },
  {
    question: "How do TikTok earnings compare to YouTube AdSense earnings?",
    answer: "YouTube long-form videos pay significantly higher rates—typically $2.00 to $12.00+ RPM compared to TikTok's $0.40 to $1.20 RPM—because YouTube serves multiple long-form mid-roll advertisements and has a mature auction system. However, TikTok views are often much easier to accumulate rapidly through the algorithmic For You page. YouTube Shorts pay comparable or slightly lower rates ($0.04 to $0.15 RPM) compared to TikTok's 1-minute+ Creator Rewards."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'TikTok Money Calculator', item: '/tools/tiktok-money-calculator' }
];

const origin = Astro.site ? Astro.site.origin : "https://creatorsfeel.com";
const canonicalUrl = new URL(Astro.url.pathname, origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${canonicalUrl}#application`,
  "name": "TikTok Money Calculator",
  "url": canonicalUrl,
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "description": "Free TikTok Money Calculator. Estimate monthly and yearly TikTok Creator Rewards earnings and brand sponsorship income based on video views, qualified views, and RPM.",
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout
  title="TikTok Money Calculator - Estimate TikTok Earnings & Creator RPM"
  description="Free TikTok Money Calculator. Estimate your monthly and yearly TikTok Creator Rewards earnings and brand deal income from video views, qualified view rates, and RPM."
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script type="application/ld+json" slot="meta" set:html={JSON.stringify(softwareSchema)} />

  <div class="tool-page-wrapper">

    <!-- 1. HERO SECTION (Centered Max-Width 820px) -->
    <header class="tool-hero-section">
      <div class="container hero-inner">

        <!-- Breadcrumbs at top -->
        <div class="hero-breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>

        <!-- Pill Badge with SVG Icon (Zero Emojis) -->
        <div class="hero-badge">
          <span class="badge-icon-tool">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tool-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </span>
          <span class="badge-title">TikTok Creator Rewards &amp; Revenue Analytics</span>
          <span class="badge-pill-free">Free Tool</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-headline">
          TikTok Money <span class="gradient-text">Calculator</span>
        </h1>

        <!-- Short Description -->
        <p class="hero-desc">
          Estimate your monthly and annual TikTok Creator Rewards earnings and brand sponsorship income. Model qualified view rates, RPM tiers, and multi-currency projections with transparent math.
        </p>

        <!-- Feature Chips Row (Zero Emojis - Clean SVG Icons) -->
        <div class="hero-features-row">
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Creator Rewards Model
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
            </svg>
            Qualified Views Filter
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            Sponsorship Estimates
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
            </svg>
            Multi-Currency Support
          </span>
        </div>
      </div>
    </header>

    <!-- 2. MAIN TOOL SECTION (Container Max-Width 940px) -->
    <section class="tool-main-section" aria-label="TikTok Money Calculator Interface">
      <div class="container tool-card-container">

        <!-- The Prominent SaaS Tool Card -->
        <div class="saas-tool-card">

          <!-- Card Header Bar: Mode Switcher & Controls -->
          <div class="card-header-bar">
            <div class="mode-switcher-wrap" role="tablist" aria-label="Calculation Mode">
              <button
                type="button"
                class="mode-tab active"
                id="tab-mode-rewards"
                data-mode="rewards"
                role="tab"
                aria-selected="true"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <span>Creator Rewards (Views &amp; RPM)</span>
              </button>

              <button
                type="button"
                class="mode-tab"
                id="tab-mode-sponsorships"
                data-mode="sponsorships"
                role="tab"
                aria-selected="false"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
                <span>Brand Deals &amp; Sponsorships</span>
              </button>
            </div>

            <!-- Currency & Reset Cluster -->
            <div class="header-controls-cluster">
              <div class="currency-select-wrap">
                <label for="calc-currency" class="sr-only">Currency</label>
                <select id="calc-currency" class="currency-select" aria-label="Select currency">
                  <option value="USD" selected>USD ($)</option>
                  <option value="EUR">EUR (€)</option>
                  <option value="GBP">GBP (£)</option>
                  <option value="CAD">CAD (CA$)</option>
                  <option value="AUD">AUD (A$)</option>
                  <option value="INR">INR (₹)</option>
                </select>
              </div>

              <button type="button" class="btn-reset-tool" id="btn-reset" title="Reset calculator inputs">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="reset-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                <span>Reset</span>
              </button>
            </div>
          </div>

          <!-- ============================================== -->
          <!-- MODE 1: CREATOR REWARDS (VIEWS & RPM) -->
          <!-- ============================================== -->
          <div class="form-inputs-container" id="form-mode-rewards">
            <div class="calculator-inputs-grid">

              <!-- Input 1: Monthly Video Views -->
              <div class="input-field-group">
                <div class="field-label-row">
                  <label for="input-monthly-views" class="field-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="label-svg" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.573 16.49 16.638 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    <span>Total Monthly Video Views</span>
                  </label>
                  <span class="field-badge-required">Required</span>
                </div>
                <div class="input-wrapper">
                  <input
                    type="number"
                    id="input-monthly-views"
                    class="styled-number-input"
                    placeholder="Enter monthly video views"
                    value="150000"
                    min="0"
                    step="5000"
                    aria-describedby="desc-monthly-views"
                  />
                </div>
                <p class="field-helper-text" id="desc-monthly-views">
                  Total views across all your TikTok uploads in a month (e.g., 10 videos × 15,000 views = 150,000).
                </p>
              </div>

              <!-- Input 2: Estimated RPM per 1,000 Views -->
              <div class="input-field-group">
                <div class="field-label-row">
                  <label for="input-rpm" class="field-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="label-svg" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span>Estimated RPM (<span class="currency-symbol-label">$</span> per 1,000 views)</span>
                  </label>
                  <span class="field-badge-optional">Editable</span>
                </div>
                <div class="input-wrapper">
                  <span class="input-prefix currency-symbol-label" aria-hidden="true">$</span>
                  <input
                    type="number"
                    id="input-rpm"
                    class="styled-number-input has-prefix"
                    placeholder="0.75"
                    value="0.75"
                    min="0.01"
                    step="0.05"
                    aria-describedby="desc-rpm"
                  />
                </div>
                <!-- Quick Preset Chips -->
                <div class="preset-chips-row" role="group" aria-label="RPM Quick Presets">
                  <span class="preset-label">Presets:</span>
                  <button type="button" class="preset-chip" data-rpm="0.40" title="Conservative rate for general global entertainment">
                    Conservative (0.40)
                  </button>
                  <button type="button" class="preset-chip active" data-rpm="0.75" title="Average TikTok Creator Rewards RPM">
                    Average (0.75)
                  </button>
                  <button type="button" class="preset-chip" data-rpm="1.20" title="High RPM for finance, tech, business or US audience">
                    High (1.20)
                  </button>
                </div>
                <p class="field-helper-text" id="desc-rpm">
                  Net earnings per 1,000 qualified views on videos 1-minute or longer in Creator Rewards.
                </p>
              </div>

              <!-- Input 3: Qualified Views Percentage -->
              <div class="input-field-group full-width-field">
                <div class="field-label-row">
                  <label for="input-qualified-rate" class="field-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="label-svg" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                    </svg>
                    <span>Estimated Qualified Views Rate: <span id="label-qualified-rate" class="rate-highlight">60%</span></span>
                  </label>
                  <span class="field-badge-optional">Adjustable</span>
                </div>
                <div class="slider-wrapper">
                  <input
                    type="range"
                    id="input-qualified-rate"
                    class="styled-range-slider"
                    min="20"
                    max="100"
                    step="5"
                    value="60"
                    aria-describedby="desc-qualified-rate"
                  />
                  <div class="slider-ticks">
                    <span>20% (Low)</span>
                    <span>60% (Typical)</span>
                    <span>100% (All Eligible)</span>
                  </div>
                </div>
                <p class="field-helper-text" id="desc-qualified-rate">
                  TikTok only pays on views lasting at least 5 seconds from the For You page on videos over 1 minute. Most creators see 50%–70% qualified. Set to 100% if your views are already pre-filtered.
                </p>
              </div>

            </div>
          </div>

          <!-- ============================================== -->
          <!-- MODE 2: BRAND DEALS & SPONSORSHIPS -->
          <!-- ============================================== -->
          <div class="form-inputs-container" id="form-mode-sponsorships" style="display: none;">
            <div class="calculator-inputs-grid">

              <!-- Input S1: Average Views per Video -->
              <div class="input-field-group">
                <div class="field-label-row">
                  <label for="input-spon-views" class="field-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="label-svg" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.573 16.49 16.638 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    <span>Average Views Per Video</span>
                  </label>
                  <span class="field-badge-required">Required</span>
                </div>
                <div class="input-wrapper">
                  <input
                    type="number"
                    id="input-spon-views"
                    class="styled-number-input"
                    placeholder="e.g. 50000"
                    value="50000"
                    min="1000"
                    step="5000"
                    aria-describedby="desc-spon-views"
                  />
                </div>
                <p class="field-helper-text" id="desc-spon-views">
                  Median organic views across your recent 10–20 standard TikTok uploads.
                </p>
              </div>

              <!-- Input S2: Sponsored Posts Per Month -->
              <div class="input-field-group">
                <div class="field-label-row">
                  <label for="input-spon-deals-count" class="field-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="label-svg" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                    </svg>
                    <span>Sponsored Posts / Month</span>
                  </label>
                  <span class="field-badge-optional">Editable</span>
                </div>
                <div class="input-wrapper">
                  <input
                    type="number"
                    id="input-spon-deals-count"
                    class="styled-number-input"
                    placeholder="2"
                    value="2"
                    min="1"
                    max="30"
                    step="1"
                    aria-describedby="desc-spon-deals"
                  />
                </div>
                <p class="field-helper-text" id="desc-spon-deals">
                  How many dedicated or integrated sponsored videos you plan to publish monthly.
                </p>
              </div>

              <!-- Input S3: Content Niche Tier -->
              <div class="input-field-group full-width-field">
                <div class="field-label-row">
                  <label for="select-spon-niche" class="field-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="label-svg" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
                    </svg>
                    <span>Content Niche &amp; Commercial Intent</span>
                  </label>
                </div>
                <div class="select-wrapper">
                  <select id="select-spon-niche" class="styled-select" aria-label="Select sponsorship niche">
                    <option value="tier1" selected>High Commercial Intent (Finance, Tech, SaaS, B2B, Health) — $18–$35 CPM</option>
                    <option value="tier2">Medium Commercial Intent (Beauty, Fashion, Fitness, Food, Travel) — $10–$20 CPM</option>
                    <option value="tier3">Broad Entertainment (Comedy, Gaming, Memes, Dance, Vlogs) — $5–$12 CPM</option>
                  </select>
                  <div class="select-chevron-box" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chevron-svg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </div>
                <p class="field-helper-text">
                  Advertisers pay premium sponsorship rates for niches with direct purchase and lead-conversion intent.
                </p>
              </div>

            </div>
          </div>

          <!-- Divider -->
          <div class="card-divider"></div>

          <!-- ============================================== -->
          <!-- 4 ESSENTIAL RESULT CARDS -->
          <!-- ============================================== -->
          <div class="results-display-area" aria-live="polite">
            
            <div class="results-header-row">
              <h2 class="results-title">Estimated TikTok Earnings</h2>
              <div class="results-live-indicator">
                <span class="live-dot" aria-hidden="true"></span>
                <span>Live Projection</span>
              </div>
            </div>

            <!-- Primary Metric Cards Grid -->
            <div class="results-grid-four">
              
              <!-- Card 1: Estimated Monthly Earnings (Highlighted) -->
              <div class="result-metric-card highlight-card">
                <div class="metric-top-row">
                  <span class="metric-title" id="title-res-primary">Estimated Monthly Earnings</span>
                  <div class="metric-icon-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="metric-svg">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                  </div>
                </div>
                <div class="metric-primary-value" id="res-monthly-earnings">$67.50</div>
                <p class="metric-sub-label" id="res-monthly-sub">Based on 90,000 qualified views at $0.75 RPM</p>
              </div>

              <!-- Card 2: Estimated Annual Earnings -->
              <div class="result-metric-card">
                <div class="metric-top-row">
                  <span class="metric-title" id="title-res-secondary">Estimated Yearly Earnings</span>
                  <div class="metric-icon-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="metric-svg">

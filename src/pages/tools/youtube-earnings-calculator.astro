<script>
  function initYouTubeEarningsCalculator() {
    const inputMonthlyViews = document.getElementById('input-monthly-views') as HTMLInputElement | null;
    const inputRpm = document.getElementById('input-rpm') as HTMLInputElement | null;
    const selectCurrency = document.getElementById('select-currency') as HTMLSelectElement | null;

    const valMonthlyEarnings = document.getElementById('val-monthly-earnings');
    const subMonthlyDetail = document.getElementById('sub-monthly-detail');
    const valYearlyEarnings = document.getElementById('val-yearly-earnings');
    const valViewsUsed = document.getElementById('val-views-used');
    const subDailyViewsEquiv = document.getElementById('sub-daily-views-equiv');
    const valRpmRate = document.getElementById('val-rpm-rate');
    const subRpmDetail = document.getElementById('sub-rpm-detail');

    const bmValDaily = document.getElementById('bm-val-daily');
    const bmVal10k = document.getElementById('bm-val-10k');
    const bmVal100k = document.getElementById('bm-val-100k');
    const bmVal1m = document.getElementById('bm-val-1m');

    const resExplanationText = document.getElementById('res-explanation-text');
    const btnReset = document.getElementById('btn-reset');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const copySummaryLabel = document.getElementById('copy-summary-label');

    if (!inputMonthlyViews || !inputRpm || !selectCurrency) return;

    // Currency symbol and formatting configuration
    const currencyConfig: Record<string, { symbol: string; code: string }> = {
      USD: { symbol: '$', code: 'USD' },
      EUR: { symbol: '€', code: 'EUR' },
      GBP: { symbol: '£', code: 'GBP' },
      CAD: { symbol: 'CA$', code: 'CAD' },
      AUD: { symbol: 'A$', code: 'AUD' },
      INR: { symbol: '₹', code: 'INR' }
    };

    function formatNumber(num: number): string {
      if (isNaN(num) || !isFinite(num)) return '0';
      return Math.round(num).toLocaleString('en-US');
    }

    function formatCurrency(amount: number, currKey: string): string {
      if (isNaN(amount) || !isFinite(amount)) amount = 0;
      const conf = currencyConfig[currKey] || currencyConfig.USD;
      const formatted = amount.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      return `${conf.symbol}${formatted}`;
    }

    function calculateEarnings() {
      let views = parseFloat(inputMonthlyViews?.value || '0');
      let rpm = parseFloat(inputRpm?.value || '0');
      const currKey = selectCurrency?.value || 'USD';
      const conf = currencyConfig[currKey] || currencyConfig.USD;

      if (isNaN(views) || views < 0) views = 0;
      if (isNaN(rpm) || rpm < 0) rpm = 0;

      // Transparent core calculations
      const monthlyEarnings = (views / 1000) * rpm;
      const yearlyEarnings = monthlyEarnings * 12;
      const dailyEarnings = monthlyEarnings / 30.4167;
      const dailyViews = views / 30.4167;

      // Benchmark values
      const earn10k = 10 * rpm;
      const earn100k = 100 * rpm;
      const earn1m = 1000 * rpm;

      // Update 4 Essential Result Metric Cards
      if (valMonthlyEarnings) {
        valMonthlyEarnings.textContent = formatCurrency(monthlyEarnings, currKey);
      }

      if (subMonthlyDetail) {
        subMonthlyDetail.textContent = `Based on ${formatNumber(views)} views at ${conf.symbol}${rpm.toFixed(2)} RPM`;
      }

      if (valYearlyEarnings) {
        valYearlyEarnings.textContent = formatCurrency(yearlyEarnings, currKey);
      }

      if (valViewsUsed) {
        valViewsUsed.textContent = formatNumber(views);
      }

      if (subDailyViewsEquiv) {
        subDailyViewsEquiv.textContent = `~${formatNumber(dailyViews)} views / day`;
      }

      if (valRpmRate) {
        valRpmRate.textContent = `${conf.symbol}${rpm.toFixed(2)}`;
      }

      if (subRpmDetail) {
        subRpmDetail.textContent = `Net creator earnings per 1,000 views (${currKey})`;
      }

      // Update Benchmarks Row
      if (bmValDaily) bmValDaily.textContent = `${formatCurrency(dailyEarnings, currKey)} / day`;
      if (bmVal10k) bmVal10k.textContent = formatCurrency(earn10k, currKey);
      if (bmVal100k) bmVal100k.textContent = formatCurrency(earn100k, currKey);
      if (bmVal1m) bmVal1m.textContent = formatCurrency(earn1m, currKey);

      // Update Explanation Sentence
      if (resExplanationText) {
        resExplanationText.innerHTML = `Calculation: <span class="formula-text">(${formatNumber(views)} views ÷ 1,000) × ${conf.symbol}${rpm.toFixed(2)} RPM = ${formatCurrency(monthlyEarnings, currKey)} monthly</span>. Annual projection: <span class="formula-text">${formatCurrency(monthlyEarnings, currKey)} × 12 = ${formatCurrency(yearlyEarnings, currKey)} yearly</span>.`;
      }
    }

    // Live update event listeners
    inputMonthlyViews.addEventListener('input', calculateEarnings);
    inputRpm.addEventListener('input', calculateEarnings);
    selectCurrency.addEventListener('change', calculateEarnings);

    // Reset button handler
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (inputMonthlyViews) inputMonthlyViews.value = '50000';
        if (inputRpm) inputRpm.value = '3.50';
        if (selectCurrency) selectCurrency.value = 'USD';
        calculateEarnings();
      });
    }

    // Copy Summary Action
    if (btnCopySummary && copySummaryLabel) {
      btnCopySummary.addEventListener('click', async () => {
        const views = inputMonthlyViews.value || '0';
        const rpm = inputRpm.value || '0';
        const currKey = selectCurrency.value || 'USD';
        const conf = currencyConfig[currKey] || currencyConfig.USD;
        const monthly = valMonthlyEarnings?.textContent || '$0.00';
        const yearly = valYearlyEarnings?.textContent || '$0.00';

        const summaryText = `YouTube Earnings Breakdown (${currKey}):\n` +
          `• Monthly Views: ${formatNumber(parseFloat(views))}\n` +
          `• Estimated RPM: ${conf.symbol}${parseFloat(rpm).toFixed(2)} per 1K views\n` +
          `• Estimated Monthly Earnings: ${monthly}\n` +
          `• Estimated Yearly Earnings: ${yearly}\n` +
          `• Formula: (${formatNumber(parseFloat(views))} ÷ 1,000) × ${conf.symbol}${parseFloat(rpm).toFixed(2)}\n` +
          `Calculated with CreatorsFeel YouTube Earnings Calculator: https://creatorsfeel.com/tools/youtube-earnings-calculator`;

        try {
          await navigator.clipboard.writeText(summaryText);
          const original = copySummaryLabel.textContent;
          copySummaryLabel.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copySummaryLabel.textContent = original;
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    // Initial Execution
    calculateEarnings();
  }

  // Handle both DOMContentLoaded and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYouTubeEarningsCalculator);
  } else {
    initYouTubeEarningsCalculator();
  }

  document.addEventListener('astro:after-swap', initYouTubeEarningsCalculator);
</script>

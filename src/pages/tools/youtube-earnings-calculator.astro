    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Mode Switcher Tabs
    const tabMonthly = document.getElementById('tab-monthly');
    const tabDaily = document.getElementById('tab-daily');
    const viewsLabel = document.getElementById('views-label');
    const viewsInput = document.getElementById('views-input') as HTMLInputElement | null;

    // Inputs
    const nicheSelect = document.getElementById('niche-select') as HTMLSelectElement | null;
    const rpmSlider = document.getElementById('rpm-slider') as HTMLInputElement | null;
    const rpmInput = document.getElementById('rpm-input') as HTMLInputElement | null;
    const rpmBadge = document.getElementById('rpm-badge');
    const monetizedSlider = document.getElementById('monetized-slider') as HTMLInputElement | null;
    const monetizedBadge = document.getElementById('monetized-badge');

    // Buttons
    const btnSubmit = document.getElementById('calc-submit-btn');
    const btnReset = document.getElementById('calc-reset-btn');

    // Results Boxes
    const emptyStateCard = document.getElementById('empty-state-card');
    const resultsDisplayBox = document.getElementById('results-display-box');

    // Results Text Fields
    const resDailyRange = document.getElementById('res-daily-range');
    const resMonthlyRange = document.getElementById('res-monthly-range');
    const resYearlyRange = document.getElementById('res-yearly-range');
    const resMonetizedViews = document.getElementById('res-monetized-views');
    const resAvgRpm = document.getElementById('res-avg-rpm');
    const resPer1k = document.getElementById('res-per-1k');
    const resPer1m = document.getElementById('res-per-1m');

    let currentMode: 'monthly' | 'daily' = 'monthly';

    // Switch View Mode
    if (tabMonthly && tabDaily) {
      tabMonthly.addEventListener('click', () => {
        currentMode = 'monthly';
        tabMonthly.classList.add('active');
        tabDaily.classList.remove('active');
        if (viewsLabel) viewsLabel.textContent = 'Total Monthly Video Views';
        if (viewsInput && (viewsInput.value === '1666' || viewsInput.value === '1670')) {
          viewsInput.value = '50000';
        }
      });

      tabDaily.addEventListener('click', () => {
        currentMode = 'daily';
        tabDaily.classList.add('active');
        tabMonthly.classList.remove('active');
        if (viewsLabel) viewsLabel.textContent = 'Total Daily Video Views';
        if (viewsInput && viewsInput.value === '50000') {
          viewsInput.value = '1670';
        }
      });
    }

    // Niche Preset Selector Handler
    if (nicheSelect) {
      nicheSelect.addEventListener('change', () => {
        const val = nicheSelect.value;
        if (val !== 'custom') {
          const numVal = parseFloat(val);
          if (rpmSlider) rpmSlider.value = numVal.toString();
          if (rpmInput) rpmInput.value = numVal.toFixed(2);
          if (rpmBadge) rpmBadge.textContent = `$${numVal.toFixed(2)}`;
        }
      });
    }

    // RPM Slider Handler
    if (rpmSlider && rpmInput && rpmBadge) {
      rpmSlider.addEventListener('input', () => {
        const val = parseFloat(rpmSlider.value);
        rpmInput.value = val.toFixed(2);
        rpmBadge.textContent = `$${val.toFixed(2)}`;
        if (nicheSelect) nicheSelect.value = 'custom';
      });

      rpmInput.addEventListener('input', () => {
        const val = parseFloat(rpmInput.value) || 0;
        rpmSlider.value = val.toString();
        rpmBadge.textContent = `$${val.toFixed(2)}`;
        if (nicheSelect) nicheSelect.value = 'custom';
      });
    }

    // Monetized Slider Handler
    if (monetizedSlider && monetizedBadge) {
      monetizedSlider.addEventListener('input', () => {
        monetizedBadge.textContent = `${monetizedSlider.value}%`;
      });
    }

    // Core Calculation Logic
    function performCalculation() {
      if (!viewsInput || !rpmInput || !monetizedSlider) return;

      const viewsVal = Math.max(0, parseFloat(viewsInput.value) || 0);
      const rpmVal = Math.max(0, parseFloat(rpmInput.value) || 0);
      const monetizedPctVal = Math.max(10, Math.min(100, parseFloat(monetizedSlider.value) || 60)) / 100;

      // Calculate total monthly and daily views
      let monthlyViews = 0;
      let dailyViews = 0;

      if (currentMode === 'monthly') {
        monthlyViews = viewsVal;
        dailyViews = viewsVal / 30.4167;
      } else {
        dailyViews = viewsVal;
        monthlyViews = viewsVal * 30.4167;
      }

      const yearlyViews = monthlyViews * 12;

      // Base net RPM revenue calculation
      const baseMonthlyEarnings = (monthlyViews / 1000) * rpmVal;
      const baseDailyEarnings = (dailyViews / 1000) * rpmVal;
      const baseYearlyEarnings = (yearlyViews / 1000) * rpmVal;

      // Range estimate: Low (-20%) to High (+25%) variance for realism
      const lowMonthly = baseMonthlyEarnings * 0.80;
      const highMonthly = baseMonthlyEarnings * 1.25;

      const lowDaily = baseDailyEarnings * 0.80;
      const highDaily = baseDailyEarnings * 1.25;

      const lowYearly = baseYearlyEarnings * 0.80;
      const highYearly = baseYearlyEarnings * 1.25;

      // Monetized Views Count
      const monetizedViewsCount = Math.round(monthlyViews * monetizedPctVal);

      // Revenue per 1K and per 1M total views
      const payPer1k = rpmVal;
      const payPer1m = rpmVal * 1000;

      // Currency Formatter
      const fmtCurr = (num: number) => `$${num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      const fmtNum = (num: number) => Math.round(num).toLocaleString('en-US');

      // Update UI Text Elements
      if (resDailyRange) resDailyRange.textContent = `${fmtCurr(lowDaily)} – ${fmtCurr(highDaily)}`;
      if (resMonthlyRange) resMonthlyRange.textContent = `${fmtCurr(lowMonthly)} – ${fmtCurr(highMonthly)}`;
      if (resYearlyRange) resYearlyRange.textContent = `${fmtCurr(lowYearly)} – ${fmtCurr(highYearly)}`;
      
      if (resMonetizedViews) resMonetizedViews.textContent = fmtNum(monetizedViewsCount);
      if (resAvgRpm) resAvgRpm.textContent = fmtCurr(rpmVal);
      if (resPer1k) resPer1k.textContent = fmtCurr(payPer1k);
      if (resPer1m) resPer1m.textContent = fmtCurr(payPer1m);

      // Reveal Results Display Panel
      if (emptyStateCard) emptyStateCard.style.display = 'none';
      if (resultsDisplayBox) {
        resultsDisplayBox.style.display = 'flex';
        // Auto-scroll on mobile devices
        if (window.innerWidth < 992) {
          resultsDisplayBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    // Attach Submit Button Handler
    if (btnSubmit) {
      btnSubmit.addEventListener('click', performCalculation);
    }

    // Attach Reset Button Handler
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (viewsInput) viewsInput.value = currentMode === 'monthly' ? '50000' : '1670';
        if (nicheSelect) nicheSelect.value = '3.50';
        if (rpmSlider) rpmSlider.value = '3.50';
        if (rpmInput) rpmInput.value = '3.50';
        if (rpmBadge) rpmBadge.textContent = '$3.50';
        if (monetizedSlider) monetizedSlider.value = '60';
        if (monetizedBadge) monetizedBadge.textContent = '60%';

        if (resultsDisplayBox) resultsDisplayBox.style.display = 'none';
        if (emptyStateCard) emptyStateCard.style.display = 'flex';
      });
    }
  });
</script>

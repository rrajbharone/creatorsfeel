---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    question: "What is a Video Frame Grabber and how does it work?",
    answer: "A Video Frame Grabber is a high-precision, browser-based media tool that extracts individual video frames and exports them as crystal-clear still images in lossless PNG or compressed JPG formats. By leveraging native HTML5 Canvas and video decoding APIs, the tool reads uncompressed pixels directly from the video buffer at full native resolution (such as 1080p, 1440p, or 4K Ultra HD) without relying on external server uploads or screen capture downsampling."
  },
  {
    question: "Why is using a video frame grabber better than taking a screenshot?",
    answer: "Standard computer and phone screenshots only capture your screen's current display resolution and device pixel ratio, often introducing display scaling blur, player progress bars, cursor graphics, and color compression. In contrast, our Video Frame Grabber extracts raw source pixels at the video's genuine recording resolution regardless of the screen size you are viewing on."
  },
  {
    question: "Can I extract 4K Ultra HD frames from my videos without quality loss?",
    answer: "Yes. If your source video was filmed in 4K UHD (3840×2160) or Full HD (1920×1080), the frame grabber renders an exact 1:1 pixel match into the HTML5 canvas. When you choose PNG format, the exported still is saved completely lossless with maximum fidelity for professional thumbnail design, print graphics, and video production archives."
  },
  {
    question: "How do I navigate frame-by-frame to find the perfect blur-free moment?",
    answer: "You can scrub through the video using the custom timeline slider, jump directly by entering any timestamp, or use our micro-stepping toolbar. Clicking the -1 Frame and +1 Frame buttons (or pressing the Left and Right arrow keys on your keyboard) steps through the footage in exact 0.0416-second increments (1/24th of a second), allowing you to bypass motion blur and isolate the crispest visual moment."
  },
  {
    question: "Which format should I choose: PNG or JPG?",
    answer: "Choose PNG if you plan to design YouTube thumbnails in Photoshop, create cutouts, add text overlays, or demand 100% uncompressed pixel accuracy. Choose JPG if you need smaller file sizes for fast social media sharing, email newsletters, or blog publishing, and adjust our JPG quality slider between 70% and 100% to balance file size and visual fidelity."
  },
  {
    question: "Are my uploaded videos private, and does this tool upload files to any server?",
    answer: "Your videos are 100% private and confidential. All video playback, frame scrubbing, and canvas image extraction happen entirely client-side inside your own web browser. No video data, still images, or file metadata are ever transmitted, uploaded, or stored on any remote cloud server or external database."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'Video Frame Grabber', item: '/tools/video-frame-grabber' }
];

const origin = Astro.site ? Astro.site.origin : "https://creatorsfeel.com";
const canonicalUrl = new URL(Astro.url.pathname, origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `${canonicalUrl}#application`,
      "name": "Video Frame Grabber",
      "url": canonicalUrl,
      "operatingSystem": "All",
      "applicationCategory": "MultimediaApplication",
      "description": "Free online Video Frame Grabber. Extract full-resolution still images and photos from MP4, WebM, and MOV videos in PNG or JPG. 100% private, browser-based frame extractor.",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Video Frame Grabber - Extract High-Res Images from Video Free"
  description="Free online Video Frame Grabber. Extract full-resolution still images and photos from MP4, WebM, and MOV videos in PNG or JPG. 100% private, browser-based frame extractor."
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script type="application/ld+json" slot="meta" set:html={JSON.stringify(softwareSchema)} />

  <div class="tool-page-wrapper">
    
    <!-- 1. HERO SECTION (Centered Max-Width 820px) -->
    <header class="tool-hero-section">
      <div class="container hero-inner">
        
        <!-- Breadcrumbs at top -->
        <div class="hero-breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>

        <!-- Pill Badge with SVG Icon (Zero Emojis) -->
        <div class="hero-badge">
          <span class="badge-icon-tool">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tool-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </span>
          <span class="badge-title">Video & Photo Extraction Studio</span>
          <span class="badge-pill-free">Free Tool</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-headline">
          Video Frame <span class="gradient-text">Grabber</span>
        </h1>

        <!-- Short Description -->
        <p class="hero-desc">
          Extract crisp, high-resolution still images and photos from your videos in seconds. Step frame-by-frame with micro-precision and download lossless PNG or JPG frames instantly.
        </p>

        <!-- Feature Chips Row (Zero Emojis - Clean SVG Icons) -->
        <div class="hero-features-row">
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
            Native Resolution (4K / 1080p)
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            Lossless PNG & JPG Export
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 4.5l7.5 7.5-7.5 7.5m-6-15l7.5 7.5-7.5 7.5" />
            </svg>
            Frame-by-Frame Stepping
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            100% In-Browser Privacy
          </span>
        </div>
      </div>
    </header>

    <!-- 2. MAIN TOOL SECTION (Container Max-Width 940px matching Twitter Hashtag Counter & Rate Calculator) -->
    <section class="tool-main-section" aria-label="Video Frame Grabber Studio Interface">
      <div class="container tool-card-container">
        
        <!-- The Prominent SaaS Tool Card -->
        <div class="saas-tool-card">
          
          <!-- Dropzone & Video File Header Area -->
          <div class="card-upload-area" id="group-upload">
            
            <!-- File Picker Hidden Input -->
            <input
              type="file"
              id="video-input"
              class="file-hidden-input"
              accept="video/mp4, video/webm, video/quicktime, video/mov, .mp4, .webm, .mov"
              aria-label="Upload video file"
            />
            
            <!-- 1. Idle Dropzone State -->
            <div class="dropzone-box" id="video-dropzone" role="button" tabindex="0" aria-label="Drop video file or click to browse">
              <div class="dropzone-inner" id="video-idle">
                <div class="dropzone-icon-circle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="dropzone-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
                  </svg>
                </div>
                <div class="dropzone-text-block">
                  <strong class="dropzone-main-text">Click to upload or drag & drop video</strong>
                  <span class="dropzone-sub-text">Supports MP4, WebM, and MOV up to 1GB</span>
                </div>
                <div class="dropzone-security-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lock-svg" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <span>100% In-Browser Processing • Video Never Leaves Your Device</span>
                </div>
              </div>
            </div>

            <!-- Error Alert State (Hidden by default) -->
            <div class="video-error-alert" id="video-error-alert" style="display: none;" role="alert">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="alert-svg" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <div class="alert-text-wrap">
                <strong class="alert-title">Unable to decode video file</strong>
                <p class="alert-desc" id="video-error-msg">Please select a valid browser-compatible video format (MP4, WebM, or MOV).</p>
              </div>
              <button type="button" class="btn-alert-dismiss" id="btn-error-retry">Try Another File</button>
            </div>

            <!-- 2. Loaded Video Header Bar (Shown once video is loaded) -->
            <div class="video-loaded-bar" id="video-loaded-bar" style="display: none;">
              <div class="loaded-file-meta">
                <div class="file-icon-box">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="loaded-file-svg" aria-hidden="true">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </div>
                <div class="file-info-text">
                  <span class="file-name-text" id="video-filename">sample-video.mp4</span>
                  <span class="file-meta-pills" id="video-filemeta">00:00.000 • 0.0 MB</span>
                </div>
              </div>

              <button type="button" class="btn-change-video" id="btn-change-video" title="Select a different video file">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-change-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                <span>Change Video</span>
              </button>
            </div>

          </div>

          <!-- Video Player Studio Stage (Revealed after video loads) -->
          <div class="player-stage-card" id="player-stage-card" style="display: none;">
            
            <!-- Video Display Container -->
            <div class="video-screen-container" id="video-container">
              <video id="source-video" class="source-video" playsinline preload="auto"></video>
              
              <!-- Floating Overlay Badges -->
              <div class="video-overlay-badge badge-top-left" id="video-timecode-badge">00:00.000</div>
              <div class="video-overlay-badge badge-top-right" id="video-res-badge">1920 × 1080</div>
            </div>

            <!-- Custom Timeline Scrubbing Track -->
            <div class="timeline-scrub-block">
              <div class="timeline-slider-row">
                <input
                  type="range"
                  id="timeline-slider"
                  class="timeline-slider"
                  min="0"
                  max="100"
                  value="0"
                  step="0.001"
                  aria-label="Video scrubber timeline"
                />
              </div>

              <div class="timeline-time-row">
                <span class="time-label-current" id="time-current">00:00.000</span>
                <span class="time-label-divider">/</span>
                <span class="time-label-total" id="time-total">00:00.000</span>
              </div>
            </div>

            <!-- Micro-Stepping and Playback Controls Toolbar -->
            <div class="player-controls-toolbar">
              
              <!-- Stepper Button Group -->
              <div class="stepper-buttons-group">
                <button type="button" class="btn-step" id="btn-jump-back" title="Rewind 1 second (Shift + Left Arrow)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="step-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m18.75 4.5-7.5 7.5 7.5 7.5m-6-15L5.25 12l7.5 7.5" />
                  </svg>
                  <span>-1s</span>
                </button>

                <button type="button" class="btn-step" id="btn-step-back" title="Step backward 1 frame (Left Arrow)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="step-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                  </svg>
                  <span>-1 Frame</span>
                </button>

                <button type="button" class="btn-play-pause" id="btn-play-pause" title="Play or pause video (Spacebar)">
                  <span id="play-pause-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="play-svg" aria-hidden="true">
                      <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                  </span>
                  <span id="txt-play-pause">Play</span>
                </button>

                <button type="button" class="btn-step" id="btn-step-fwd" title="Step forward 1 frame (Right Arrow)">
                  <span>+1 Frame</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="step-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </button>

                <button type="button" class="btn-step" id="btn-jump-fwd" title="Fast forward 1 second (Shift + Right Arrow)">
                  <span>+1s</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="step-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5" />
                  </svg>
                </button>
              </div>

              <!-- Jump to Exact Timestamp Form -->
              <div class="timestamp-jump-box">
                <label for="input-jump-time" class="jump-label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="jump-label-svg" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span>Go to time:</span>
                </label>
                <div class="jump-input-group">
                  <input
                    type="text"
                    id="input-jump-time"
                    class="jump-text-input"
                    placeholder="00:00.000"
                    aria-label="Enter timestamp"
                  />
                  <button type="button" class="btn-jump-go" id="btn-jump-go">Jump</button>
                </div>
              </div>

            </div>

            <!-- Export Settings & Capture Action Bar -->
            <div class="capture-settings-bar" id="format-settings-grid">
              
              <div class="settings-left-col">
                <!-- Image Format Selector -->
                <div class="setting-item">
                  <label for="select-format" class="setting-label">Export Format</label>
                  <div class="select-wrapper">
                    <select id="select-format" class="styled-select" aria-label="Select export format">
                      <option value="png" selected>PNG (Lossless Quality)</option>
                      <option value="jpeg">JPG (Compressed Photo)</option>
                    </select>
                    <div class="select-chevron-box" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chevron-svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>
                </div>

                <!-- JPG Quality Slider (Shown only when JPG is chosen) -->
                <div class="setting-item" id="group-jpg-quality" style="display: none;">
                  <div class="setting-label-row">
                    <label for="slider-quality" class="setting-label">JPG Quality</label>
                    <span class="setting-val-badge" id="val-quality">92%</span>
                  </div>
                  <input
                    type="range"
                    id="slider-quality"
                    class="styled-range"
                    min="60"
                    max="100"
                    value="92"
                    step="1"
                    aria-label="JPG compression quality percentage"
                  />
                </div>
              </div>

              <!-- Main Capture Action Button -->
              <div class="capture-cta-wrap">
                <button type="button" id="btn-capture-frame" class="btn-capture-cta" title="Capture still image at current video frame">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="capture-camera-svg" aria-hidden="true">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                    <circle cx="12" cy="13" r="4"/>
                  </svg>
                  <span>Capture Frame</span>
                </button>
              </div>

            </div>

            <!-- Video Specifications Strip -->
            <div class="video-specs-strip" id="video-metrics-grid">
              
              <div class="spec-mini-card">
                <span class="spec-label">Native Resolution</span>
                <strong class="spec-value" id="spec-resolution">1920 × 1080</strong>
              </div>

              <div class="spec-mini-card">
                <span class="spec-label">Total Duration</span>
                <strong class="spec-value" id="spec-duration">00:00.000</strong>
              </div>

              <div class="spec-mini-card">
                <span class="spec-label">Aspect Ratio</span>
                <strong class="spec-value" id="spec-aspect">16:9 Landscape</strong>
              </div>

              <div class="spec-mini-card">
                <span class="spec-label">Processing Mode</span>
                <strong class="spec-value highlight-mode" id="spec-fps">100% In-Browser</strong>
              </div>

            </div>

          </div>

          <!-- Divider -->
          <div class="card-divider"></div>

          <!-- Captured Frames Showcase Section -->
          <div class="captured-output-container">
            
            <!-- Empty Output State (Shown before any frame is captured) -->
            <div class="empty-frames-card" id="empty-state-card">
              <div class="empty-icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="empty-svg" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                  <circle cx="12" cy="13" r="4"/>
                </svg>
              </div>
              <strong class="empty-title">No frames captured yet</strong>
              <p class="empty-desc">
                Upload a video file, scrub or micro-step to your desired scene, and click <strong>Capture Frame</strong> to generate high-resolution still images.
              </p>
            </div>

            <!-- Latest Captured Frame Showcase (Shown once at least one frame is captured) -->
            <div class="latest-frame-card" id="latest-frame-card" style="display: none;">
              
              <div class="latest-card-header">
                <div class="latest-header-title">
                  <span class="pulse-dot" aria-hidden="true"></span>
                  <strong>Latest Captured Frame</strong>
                </div>

                <div class="latest-meta-badges">
                  <span class="badge-timecode" id="latest-timecode">00:00.000</span>
                  <span class="badge-resolution" id="latest-res">1920 × 1080 • PNG</span>
                </div>
              </div>

              <!-- Preview Image Viewport -->
              <div class="latest-image-viewport">
                <img id="latest-frame-img" class="latest-frame-img" alt="Captured video frame preview" />
              </div>

              <!-- Action Buttons Row -->
              <div class="latest-actions-row">
                <a id="btn-download-latest" class="btn-download-primary" download="captured_frame.png">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-btn-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  <span>Download Frame</span>
                </a>

                <button type="button" id="btn-copy-latest" class="btn-copy-secondary" title="Copy captured frame to clipboard">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-btn-svg" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                  <span id="copy-latest-text">Copy Image</span>
                </button>
              </div>

            </div>

            <!-- Session Frame Gallery (Grid of all frames taken in this session) -->
            <div class="gallery-card" id="gallery-card" style="display: none;">
              
              <div class="gallery-header-row">
                <div class="gallery-title-wrap">
                  <h3 class="gallery-heading">Session Frame Gallery</h3>
                  <span class="gallery-count-badge" id="gallery-count">0 frames</span>
                </div>

                <div class="gallery-header-actions">
                  <button type="button" class="gallery-action-btn btn-bulk-download" id="btn-download-all" title="Download all captured frames">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="gallery-action-svg" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    <span>Download All</span>
                  </button>

                  <button type="button" class="gallery-action-btn btn-clear-all" id="btn-clear-gallery" title="Clear all frames from session">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="gallery-action-svg" aria-hidden="true">

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // DOM Elements
    const videoInput = document.getElementById('video-input') as HTMLInputElement | null;
    const videoIdle = document.getElementById('video-idle');
    const videoLoadedBar = document.getElementById('video-loaded-bar');
    const videoFilename = document.getElementById('video-filename');
    const videoFilemeta = document.getElementById('video-filemeta');
    const btnChangeVideo = document.getElementById('btn-change-video');

    const playerStageCard = document.getElementById('player-stage-card');
    const sourceVideo = document.getElementById('source-video') as HTMLVideoElement | null;
    const videoTimecodeBadge = document.getElementById('video-timecode-badge');
    const timelineSlider = document.getElementById('timeline-slider') as HTMLInputElement | null;
    const timeCurrent = document.getElementById('time-current');
    const timeTotal = document.getElementById('time-total');

    const btnJumpBack = document.getElementById('btn-jump-back');
    const btnStepBack = document.getElementById('btn-step-back');
    const btnPlayPause = document.getElementById('btn-play-pause');
    const txtPlayPause = document.getElementById('txt-play-pause');
    const btnStepFwd = document.getElementById('btn-step-fwd');
    const btnJumpFwd = document.getElementById('btn-jump-fwd');

    const formatSettingsGrid = document.getElementById('format-settings-grid');
    const selectFormat = document.getElementById('select-format') as HTMLSelectElement | null;
    const groupJpgQuality = document.getElementById('group-jpg-quality');
    const sliderQuality = document.getElementById('slider-quality') as HTMLInputElement | null;
    const valQuality = document.getElementById('val-quality');

    const captureActionWrap = document.getElementById('capture-action-wrap');
    const btnCaptureFrame = document.getElementById('btn-capture-frame');

    const videoMetricsGrid = document.getElementById('video-metrics-grid');
    const specResolution = document.getElementById('spec-resolution');
    const specDuration = document.getElementById('spec-duration');
    const specAspect = document.getElementById('spec-aspect');
    const specFps = document.getElementById('spec-fps');

    const emptyStateCard = document.getElementById('empty-state-card');
    const latestFrameCard = document.getElementById('latest-frame-card');
    const latestTimecode = document.getElementById('latest-timecode');
    const latestRes = document.getElementById('latest-res');
    const latestFrameImg = document.getElementById('latest-frame-img') as HTMLImageElement | null;
    const btnDownloadLatest = document.getElementById('btn-download-latest') as HTMLAnchorElement | null;

    const galleryCard = document.getElementById('gallery-card');
    const galleryCount = document.getElementById('gallery-count');
    const galleryGrid = document.getElementById('gallery-grid');
    const btnClearGallery = document.getElementById('btn-clear-gallery');

    const offscreenCanvas = document.getElementById('offscreen-canvas') as HTMLCanvasElement | null;

    if (!sourceVideo || !offscreenCanvas) return;
    const ctx = offscreenCanvas.getContext('2d');

    // State Variables
    let videoFile: File | null = null;
    let videoSrcUrl: string | null = null;
    let isSeeking = false;
    const capturedFrames: Array<{ id: string; time: number; timeStr: string; dataUrl: string; format: string; res: string }> = [];

    // Format millisecond time string (HH:MM:SS.mmm or MM:SS.mmm)
    function formatTimecode(seconds: number): string {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      const ms = Math.floor((seconds % 1) * 1000);
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
    }

    // Greatest Common Divisor for Aspect Ratio
    function gcd(a: number, b: number): number {
      return b === 0 ? a : gcd(b, a % b);
    }

    function getAspectRatio(w: number, h: number): string {
      if (!w || !h) return '16:9';
      const d = gcd(w, h);
      const rw = w / d;
      const rh = h / d;
      if (rw === 16 && rh === 9) return '16:9 Landscape';
      if (rw === 9 && rh === 16) return '9:16 Vertical';
      if (rw === 1 && rh === 1) return '1:1 Square';
      if (rw === 4 && rh === 3) return '4:3 Standard';
      return `${rw}:${rh}`;
    }

    // Video Upload Handler
    if (videoInput) {
      videoInput.addEventListener('change', () => {
        if (videoInput.files && videoInput.files.length > 0) {
          loadVideoFile(videoInput.files[0]);
        }
      });
    }

    if (btnChangeVideo && videoInput) {
      btnChangeVideo.addEventListener('click', (e) => {
        e.stopPropagation();
        videoInput.click();
      });
    }

    function loadVideoFile(file: File) {
      if (!file || !file.type.startsWith('video/')) {
        alert('Please select a valid video file (MP4, WebM, MOV).');
        return;
      }

      videoFile = file;
      const mbSize = (file.size / (1024 * 1024)).toFixed(1);
      if (videoFilename) videoFilename.textContent = file.name;

      if (videoSrcUrl) URL.revokeObjectURL(videoSrcUrl);
      videoSrcUrl = URL.createObjectURL(file);
      sourceVideo.src = videoSrcUrl;

      sourceVideo.onloadedmetadata = () => {
        const dur = sourceVideo.duration || 0;
        const width = sourceVideo.videoWidth || 1920;
        const height = sourceVideo.videoHeight || 1080;

        if (videoFilemeta) videoFilemeta.textContent = `${formatTimecode(dur).split('.')[0]} • ${mbSize} MB`;
        if (timeTotal) timeTotal.textContent = formatTimecode(dur);
        if (timelineSlider) {
          timelineSlider.max = dur.toString();
          timelineSlider.value = '0';
        }

        // Populate Metadata Specs
        if (specResolution) specResolution.textContent = `${width} × ${height}`;
        if (specDuration) specDuration.textContent = formatTimecode(dur).split('.')[0];
        if (specAspect) specAspect.textContent = getAspectRatio(width, height);
        if (specFps) specFps.textContent = width >= 3840 ? '4K UHD' : width >= 1920 ? 'Full HD 1080p' : 'Standard HD';

        // Reveal Studio Panels
        if (videoIdle) videoIdle.style.display = 'none';
        if (videoLoadedBar) videoLoadedBar.style.display = 'flex';
        if (playerStageCard) playerStageCard.style.display = 'flex';
        if (formatSettingsGrid) formatSettingsGrid.style.display = 'grid';
        if (captureActionWrap) captureActionWrap.style.display = 'block';
        if (videoMetricsGrid) videoMetricsGrid.style.display = 'grid';

        updateTimeDisplays(0);
      };
    }

    function updateTimeDisplays(currentTime: number) {
      const tc = formatTimecode(currentTime);
      if (timeCurrent) timeCurrent.textContent = tc;
      if (videoTimecodeBadge) videoTimecodeBadge.textContent = tc;
    }

    // Video Playback & Timeline Listeners
    sourceVideo.addEventListener('timeupdate', () => {
      if (!isSeeking && timelineSlider) {
        timelineSlider.value = sourceVideo.currentTime.toString();
        updateTimeDisplays(sourceVideo.currentTime);
      }
    });

    sourceVideo.addEventListener('play', () => {
      if (txtPlayPause) txtPlayPause.textContent = '⏸ Pause';
    });

    sourceVideo.addEventListener('pause', () => {
      if (txtPlayPause) txtPlayPause.textContent = '▶ Play';
    });

    if (timelineSlider) {
      timelineSlider.addEventListener('input', () => {
        isSeeking = true;
        const targetTime = parseFloat(timelineSlider.value);
        sourceVideo.currentTime = targetTime;
        updateTimeDisplays(targetTime);
      });

      timelineSlider.addEventListener('change', () => {
        isSeeking = false;
      });
    }

    // Step Toolbar Actions
    function seekDelta(seconds: number) {
      sourceVideo.pause();
      const newTime = Math.max(0, Math.min(sourceVideo.duration || 0, sourceVideo.currentTime + seconds));
      sourceVideo.currentTime = newTime;
      if (timelineSlider) timelineSlider.value = newTime.toString();
      updateTimeDisplays(newTime);
    }

    if (btnJumpBack) btnJumpBack.addEventListener('click', () => seekDelta(-1.0));
    if (btnStepBack) btnStepBack.addEventListener('click', () => seekDelta(-0.0416)); // ~1 frame at 24/30fps
    if (btnStepFwd) btnStepFwd.addEventListener('click', () => seekDelta(0.0416));
    if (btnJumpFwd) btnJumpFwd.addEventListener('click', () => seekDelta(1.0));

    if (btnPlayPause) {
      btnPlayPause.addEventListener('click', () => {
        if (sourceVideo.paused) {
          sourceVideo.play();
        } else {
          sourceVideo.pause();
        }
      });
    }

    // Format & Quality Controls
    if (selectFormat && groupJpgQuality) {
      selectFormat.addEventListener('change', () => {
        groupJpgQuality.style.display = selectFormat.value === 'jpeg' ? 'flex' : 'none';
      });
    }

    if (sliderQuality && valQuality) {
      sliderQuality.addEventListener('input', () => {
        valQuality.textContent = `${sliderQuality.value}%`;
      });
    }

    // Frame Extraction Logic
    if (btnCaptureFrame) {
      btnCaptureFrame.addEventListener('click', () => {
        if (!sourceVideo || !ctx || !offscreenCanvas) return;
        sourceVideo.pause();

        const width = sourceVideo.videoWidth || 1920;
        const height = sourceVideo.videoHeight || 1080;
        const curTime = sourceVideo.currentTime || 0;
        const timeStr = formatTimecode(curTime);

        // Configure offscreen canvas to match native video resolution
        offscreenCanvas.width = width;
        offscreenCanvas.height = height;

        // Draw native video frame
        ctx.drawImage(sourceVideo, 0, 0, width, height);

        // Convert to selected format
        const format = selectFormat?.value || 'png';
        const quality = format === 'jpeg' ? (parseInt(sliderQuality?.value || '92', 10) / 100) : 1.0;
        const mimeType = format === 'jpeg' ? 'image/jpeg' : 'image/png';
        const dataUrl = offscreenCanvas.toDataURL(mimeType, quality);

        const frameItem = {
          id: 'frame_' + Date.now(),
          time: curTime,
          timeStr: timeStr,
          dataUrl: dataUrl,
          format: format.toUpperCase(),
          res: `${width}×${height}`
        };

        capturedFrames.unshift(frameItem);
        renderLatestFrame(frameItem);
        renderGallery();
      });
    }

    function renderLatestFrame(item: { timeStr: string; dataUrl: string; format: string; res: string }) {
      if (emptyStateCard) emptyStateCard.style.display = 'none';
      if (latestFrameCard) latestFrameCard.style.display = 'flex';

      if (latestTimecode) latestTimecode.textContent = item.timeStr;
      if (latestRes) latestRes.textContent = `${item.res} • ${item.format}`;
      if (latestFrameImg) latestFrameImg.src = item.dataUrl;

      if (btnDownloadLatest) {
        btnDownloadLatest.href = item.dataUrl;
        const baseName = videoFile ? videoFile.name.replace(/\.[^/.]+$/, "") : 'frame';
        const cleanTc = item.timeStr.replace(/[:.]/g, '-');
        btnDownloadLatest.download = `${baseName}_frame_${cleanTc}.${item.format.toLowerCase()}`;
      }
    }

    const btnDownloadAll = document.getElementById('btn-download-all');

    function renderGallery() {
      if (!galleryCard || !galleryGrid || !galleryCount) return;

      if (capturedFrames.length === 0) {
        galleryCard.style.display = 'none';
        return;
      }

      galleryCard.style.display = 'flex';
      galleryCount.textContent = `${capturedFrames.length} ${capturedFrames.length === 1 ? 'frame' : 'frames'}`;
      galleryGrid.innerHTML = '';

      capturedFrames.forEach((frame, idx) => {
        const card = document.createElement('div');
        card.className = 'gallery-item-card';

        const baseName = videoFile ? videoFile.name.replace(/\.[^/.]+$/, "") : 'frame';
        const cleanTc = frame.timeStr.replace(/[:.]/g, '-');
        const filename = `${baseName}_frame_${cleanTc}.${frame.format.toLowerCase()}`;

        card.innerHTML = `
          <div class="gallery-thumb-wrap">
            <img src="${frame.dataUrl}" class="gallery-thumb-img" alt="Captured frame at ${frame.timeStr}" />
            <span class="gallery-format-badge">${frame.format}</span>
          </div>
          <div class="gallery-item-meta">
            <span class="gallery-timecode" title="${frame.timeStr}">${frame.timeStr}</span>
            <div class="gallery-actions">
              <a href="${frame.dataUrl}" download="${filename}" class="gallery-btn-action gallery-btn-download" title="Download Frame (${frame.format})">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-svg" style="width: 14px; height: 14px; display: block; flex-shrink: 0;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
              </a>
              <button type="button" class="gallery-btn-action gallery-btn-del" data-id="${frame.id}" title="Delete Frame">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-svg" style="width: 14px; height: 14px; display: block; flex-shrink: 0;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              </button>
            </div>
          </div>
        `;

        const delBtn = card.querySelector('.gallery-btn-del');
        if (delBtn) {
          delBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const id = delBtn.getAttribute('data-id');
            const foundIdx = capturedFrames.findIndex(f => f.id === id);
            if (foundIdx > -1) {
              capturedFrames.splice(foundIdx, 1);
              renderGallery();
              if (capturedFrames.length === 0) {
                if (latestFrameCard) latestFrameCard.style.display = 'none';
                if (emptyStateCard) emptyStateCard.style.display = 'flex';
              } else {
                renderLatestFrame(capturedFrames[0]);
              }
            }
          });
        }

        galleryGrid.appendChild(card);
      });
    }

    if (btnDownloadAll) {
      btnDownloadAll.addEventListener('click', () => {
        if (capturedFrames.length === 0) return;

        capturedFrames.forEach((frame, idx) => {
          setTimeout(() => {
            const a = document.createElement('a');
            a.href = frame.dataUrl;
            const baseName = videoFile ? videoFile.name.replace(/\.[^/.]+$/, "") : 'frame';
            const cleanTc = frame.timeStr.replace(/[:.]/g, '-');
            a.download = `${baseName}_frame_${cleanTc}.${frame.format.toLowerCase()}`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }, idx * 180);
        });
      });
    }

    if (btnClearGallery) {
      btnClearGallery.addEventListener('click', () => {
        capturedFrames.length = 0;
        renderGallery();
        if (latestFrameCard) latestFrameCard.style.display = 'none';
        if (emptyStateCard) emptyStateCard.style.display = 'flex';
      });
    }

    // Keyboard Arrow Shortcuts for Fast Frame Grabbing
    window.addEventListener('keydown', (e) => {
      // Don't trigger if user is in an input or select
      if (document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'SELECT') return;

      if (!sourceVideo || !videoFile) return;

      if (e.code === 'Space') {
        e.preventDefault();
        if (sourceVideo.paused) {
          sourceVideo.play();
        } else {
          sourceVideo.pause();
        }
      } else if (e.code === 'ArrowLeft') {
        e.preventDefault();
        seekDelta(-0.0416);
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        seekDelta(0.0416);
      }
    });

  });
</script>

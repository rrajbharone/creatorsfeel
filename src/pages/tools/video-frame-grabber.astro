---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is a Video Frame Grabber and how does it work?",
    answer: "A Video Frame Grabber is a browser-based tool that extracts exact, individual video frames and saves them as high-resolution still images (PNG or JPG). It uses HTML5 Canvas APIs to capture the full native sensor resolution of the video file (such as 4K 3840×2160 or 1080p 1920×1080) without the compression or display scaling loss of regular computer screenshots."
  },
  {
    question: "Why should I use a frame grabber instead of taking a screenshot?",
    answer: "Standard computer screenshots only capture your monitor's current display resolution and scale factor, often including player UI controls, black bars, and compression artifacts. Our Video Frame Grabber reads the raw video stream directly, delivering true uncompressed pixels at the exact native dimensions of the original video."
  },
  {
    question: "How do I navigate frame-by-frame to find the perfect micro-moment?",
    answer: "Use our micro-step frame buttons (-0.04s and +0.04s) to advance or rewind one frame at a time (standard 24fps/30fps interval). You can also use your keyboard's left and right arrow keys to jump through frames until you locate the exact blur-free moment."
  },
  {
    question: "Which format should I choose: PNG or JPG?",
    answer: "Choose PNG for maximum lossless clarity, sharp graphics, text overlays, and YouTube thumbnail creation in Photoshop. Choose JPG if you need smaller file sizes for quick social media sharing or email delivery."
  },
  {
    question: "Is my video uploaded to any server or kept private?",
    answer: "Your video is 100% private. All decoding, playback, and frame extraction occur entirely within your device's web browser using native client-side APIs. Not a single frame or byte is ever transmitted or stored on any external server."
  },
  {
    question: "What video file formats are supported?",
    answer: "Our tool supports all major browser-compatible video formats including MP4 (H.264 / AAC), WebM (VP8 / VP9), and MOV (QuickTime) files across desktop, tablet, and mobile devices."
  },
  {
    question: "Can I extract 4K Ultra HD frames from my videos?",
    answer: "Yes! If you upload a 4K UHD video (3840×2160), our frame grabber extracts crisp 8.3-megapixel still images at full 3840×2160 resolution regardless of whether you are viewing on a 1080p laptop or a mobile phone screen."
  }
];
---

<ToolLayout
  title="Video Frame Grabber - Extract High-Res Images from Video Free"
  description="Free online Video Frame Grabber. Extract full-resolution still images and photos from MP4, WebM, and MOV videos in PNG or JPG. 100% private, browser-based frame extractor."
  toolName="Video Frame Grabber"
  toolDescription="Extract crisp, high-resolution still photos and frames from your videos. Step frame-by-frame with micro-precision and download lossless PNG or JPG images instantly."
  category="Calculators"
  faqs={faqs}
>
  <!-- Main Frame Grabber Studio Interface -->
  <div slot="calculator" class="calc-card glass">
    
    <!-- 2-Column Desktop Grid Layout -->
    <div class="calc-grid">
      
      <!-- Left Column: Video Player & Extraction Controls -->
      <div class="calc-form">
        
        <!-- Video Upload Dropzone -->
        <div class="form-group" id="group-upload">
          <label class="input-label">1. Upload Video File</label>
          <div class="dropzone-box" id="video-dropzone">
            <input type="file" id="video-input" class="file-hidden-input" accept="video/mp4, video/webm, video/quicktime, video/mov, .mp4, .webm, .mov" />
            
            <div class="dropzone-idle" id="video-idle">
              <div class="dropzone-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="dropzone-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
              </div>
              <strong class="dropzone-heading">Choose or drop video file</strong>
              <span class="dropzone-sub">MP4, WebM, MOV up to 500MB • 100% Client-Side</span>
            </div>

            <!-- Loaded Video Header Bar -->
            <div class="loaded-bar" id="video-loaded-bar" style="display: none;">
              <div class="loaded-info">
                <span class="loaded-title" id="video-filename">video.mp4</span>
                <span class="loaded-meta" id="video-filemeta">0:00 • 0.0 MB</span>
              </div>
              <button type="button" class="btn-change-file" id="btn-change-video">Change</button>
            </div>
          </div>
        </div>

        <!-- Video Player Stage (Shown after video load) -->
        <div class="player-stage-card" id="player-stage-card" style="display: none;">
          
          <!-- Native Video Element Container -->
          <div class="video-container" id="video-container">
            <video id="source-video" class="source-video" playsinline preload="auto"></video>
            
            <!-- Video Overlay Controls -->
            <div class="video-overlay-badge" id="video-timecode-badge">00:00.000</div>
          </div>

          <!-- Custom Scrubbing & Timeline Controls -->
          <div class="timeline-controls-wrap">
            
            <div class="timeline-row">
              <input
                type="range"
                id="timeline-slider"
                class="timeline-slider"
                min="0"
                max="100"
                step="0.01"
                value="0"
              />
            </div>

            <div class="time-display-row">
              <span class="time-current" id="time-current">00:00.000</span>
              <span class="time-total" id="time-total">00:00.000</span>
            </div>

            <!-- Frame-by-Frame Stepping Toolbar -->
            <div class="stepping-toolbar">
              <button type="button" class="step-btn" id="btn-jump-back" title="Jump Backward 1s">
                <span class="step-icon">⏮</span> −1s
              </button>
              
              <button type="button" class="step-btn step-btn-micro" id="btn-step-back" title="Step Back 1 Frame (-0.04s)">
                <span class="step-icon">◀</span> −1 Frame
              </button>

              <button type="button" class="step-btn step-btn-play" id="btn-play-pause" title="Play / Pause">
                <span id="txt-play-pause">▶ Play</span>
              </button>

              <button type="button" class="step-btn step-btn-micro" id="btn-step-fwd" title="Step Forward 1 Frame (+0.04s)">
                +1 Frame <span class="step-icon">▶</span>
              </button>

              <button type="button" class="step-btn" id="btn-jump-fwd" title="Jump Forward 1s">
                +1s <span class="step-icon">⏭</span>
              </button>
            </div>

          </div>

        </div>

        <!-- Format & Quality Settings -->
        <div class="format-settings-grid" id="format-settings-grid" style="display: none;">
          
          <div class="form-group">
            <label for="select-format" class="input-label">Image Output Format</label>
            <select id="select-format" class="calc-select">
              <option value="png" selected>PNG (Lossless Clarity - Best for Thumbnails)</option>
              <option value="jpeg">JPG (Compressed - Smaller File Size)</option>
            </select>
          </div>

          <div class="form-group" id="group-jpg-quality" style="display: none;">
            <div class="setting-label-row">
              <label for="slider-quality" class="input-label">JPG Quality</label>
              <span class="setting-val-badge" id="val-quality">92%</span>
            </div>
            <input type="range" id="slider-quality" class="calc-range" min="50" max="100" step="1" value="92" />
          </div>

        </div>

        <!-- Capture Frame Action Button -->
        <div class="capture-action-wrap" id="capture-action-wrap" style="display: none;">
          <button type="button" id="btn-capture-frame" class="calc-btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
            </svg>
            Capture Current Frame
          </button>
        </div>

        <!-- Video Metadata Specs Badges -->
        <div class="metrics-grid" id="video-metrics-grid" style="display: none;">
          <div class="metric-card">
            <span class="metric-value" id="spec-resolution">-- × --</span>
            <span class="metric-label">Native Resolution</span>
          </div>
          <div class="metric-card">
            <span class="metric-value" id="spec-duration">0:00</span>
            <span class="metric-label">Video Length</span>
          </div>
          <div class="metric-card">
            <span class="metric-value" id="spec-aspect">16:9</span>
            <span class="metric-label">Aspect Ratio</span>
          </div>
          <div class="metric-card">
            <span class="metric-value" id="spec-fps">~30 FPS</span>
            <span class="metric-label">Est. Frame Rate</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Latest Captured Frame & Gallery -->
      <div class="calc-results">
        
        <!-- Empty Placeholder State (Before capture) -->
        <div class="empty-state-card" id="empty-state-card">
          <div class="empty-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="empty-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
          </div>
          <strong class="empty-title">No Frames Captured Yet</strong>
          <p class="empty-desc">Upload a video, pause or step to your desired frame, and click "Capture Current Frame" to extract high-resolution stills.</p>
        </div>

        <!-- Latest Captured Frame Card (Shown after capture) -->
        <div class="latest-frame-card" id="latest-frame-card" style="display: none;">
          
          <div class="frame-card-header">
            <div class="frame-title-wrap">
              <span class="frame-badge-success">Latest Frame Grabbed</span>
              <span class="frame-timecode-tag" id="latest-timecode">00:00.000</span>
            </div>
            <span class="frame-res-tag" id="latest-res">1920 × 1080</span>
          </div>

          <!-- Frame Preview Image -->
          <div class="frame-img-preview-wrap">
            <img id="latest-frame-img" class="latest-frame-img" alt="Captured video frame preview" />
          </div>

          <!-- Download Action Button -->
          <div class="frame-download-row">
            <a id="btn-download-latest" class="calc-btn-primary download-link" download="frame.png">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Download Full-Res Still
            </a>
          </div>

        </div>

        <!-- Captured Frames Gallery Strip -->
        <div class="gallery-card" id="gallery-card" style="display: none;">
          
          <div class="gallery-header">
            <div class="gallery-title-wrap">
              <span class="gallery-title">Captured Gallery</span>
              <span class="gallery-count-badge" id="gallery-count">0 frames</span>
            </div>
            <div class="gallery-header-actions">
              <button type="button" class="btn-download-all" id="btn-download-all" title="Download all captured frames">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-mini-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Download All
              </button>
              <button type="button" class="btn-clear-gallery" id="btn-clear-gallery" title="Clear all frames">Clear All</button>
            </div>
          </div>

          <div class="gallery-grid" id="gallery-grid">
            <!-- Captured frame thumbnail cards rendered dynamically -->
          </div>

        </div>

      </div>

    </div>

    <!-- Hidden Offscreen Canvas for True Native Extraction -->
    <canvas id="offscreen-canvas" style="display: none;"></canvas>

  </div>

  <!-- Editorial & SEO Content Slot -->
  <div slot="about" class="editorial-content">
    <section class="editorial-section">
      
      <h2>What Is a Video Frame Grabber?</h2>
      <p>
        A <strong>Video Frame Grabber</strong> (also called a video to image extractor or frame capture tool) is a specialized application that extracts individual photographic still images from a video stream with pixel-for-pixel accuracy. Rather than relying on approximate screen captures, a frame grabber decodes the video's internal frame timeline, allowing creators to isolate a single 1/30th or 1/60th of a second micro-moment and save it as an uncompressed, full-resolution image file.
      </p>
      <p>
        Whether you are designing a high-CTR YouTube thumbnail, pulling color grading reference stills for a film project, extracting sports biomechanics data, or creating social media photo posts from 4K drone footage, our <strong>free online video frame grabber</strong> delivers instant, lossless image extraction directly inside your web browser.
      </p>

      <h2>How to Extract High-Resolution Stills from Any Video Step-by-Step</h2>
      <ol>
        <li><strong>Upload Your Video:</strong> Drag and drop your MP4, WebM, or MOV video file into the dropzone above. The video loads instantly with 100% browser-side privacy.</li>
        <li><strong>Scrub to the Approximate Moment:</strong> Use the interactive timeline slider to scrub forward to the scene you want to capture.</li>
        <li><strong>Use Micro-Step Navigation:</strong> Click the <strong>-1 Frame (-0.04s)</strong> or <strong>+1 Frame (+0.04s)</strong> buttons (or use keyboard arrow keys) to step through individual frames until you find a moment free of unwanted motion blur.</li>
        <li><strong>Select Output Format:</strong> Choose <strong>PNG</strong> for lossless pixel fidelity (recommended for YouTube thumbnails) or <strong>JPG</strong> for smaller file sizes.</li>
        <li><strong>Click Capture Current Frame:</strong> Extract the frame instantly at original video resolution (e.g. 1080p, 1440p, or 4K UHD).</li>
        <li><strong>Download Your Still:</strong> Click <strong>Download Full-Res Still</strong> or grab multiple frames from the built-in gallery strip below.</li>
      </ol>

      <h2>Top Use Cases for Content Creators & Filmmakers</h2>

      <h3>1. High-CTR YouTube Thumbnail Creation</h3>
      <p>
        YouTube thumbnails determine over 80% of a viewer's decision to click on your video. Rather than staging a separate photoshoot with different lighting and wardrobe, top creators scrub through their 4K recording to pull authentic, high-emotion facial expressions and dynamic action shots to use as thumbnail backgrounds.
      </p>

      <h3>2. Film Editing & Color Grading Reference Stills</h3>
      <p>
        Directors of photography (DPs) and colorists regularly extract uncompressed stills from raw footage to create look-books, client approval sheets, and lighting continuity logs across multiple shooting days.
      </p>

      <h3>3. Social Media Carousel & Photo Posts</h3>
      <p>
        Repurposing video into photo carousels on Instagram, LinkedIn, Pinterest, and Twitter/X is one of the fastest ways to scale social reach. A single 10-minute video can yield 15 to 20 high-quality photographic stills suitable for multi-platform distribution.
      </p>

      <h3>4. Sports Coaching, Motion Analysis & Proof Extraction</h3>
      <p>
        Athletes, golf coaches, and fitness creators use frame-by-frame extraction to analyze swing mechanics, running form, and weightlifting bar paths at specific millisecond intervals.
      </p>

      <h2>Why Canvas Frame Grabbing Outperforms Standard OS Screenshots</h2>
      <p>
        Many creators attempt to capture video stills by pausing a media player and pressing <code>Print Screen</code> or <code>Cmd + Shift + 4</code>. Here is why native canvas frame extraction is fundamentally superior:
      </p>
      <div class="table-responsive">
        <table class="editorial-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Standard OS Screenshot</th>
              <th>CreatorsFeel Frame Grabber</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Captured Resolution</strong></td>
              <td>Limited to your monitor's display scaling (often 720p or downscaled)</td>
              <td><strong>True 100% Native Video Resolution (1080p, 4K UHD, 8K)</strong></td>
            </tr>
            <tr>
              <td><strong>Interface Artifacts</strong></td>
              <td>Captures player scrubbers, timestamps, mouse cursor, and play buttons</td>
              <td><strong>Zero UI Overlays — 100% Clean Video Stream</strong></td>
            </tr>
            <tr>
              <td><strong>Color Accuracy</strong></td>
              <td>Subject to monitor ICC color profiles and operating system display tone-mapping</td>
              <td><strong>Lossless RGB / sRGB Video Buffer Extraction</strong></td>
            </tr>
            <tr>
              <td><strong>Aspect Ratio Distortion</strong></td>
              <td>Captures black letterbox/pillarbox bars</td>
              <td><strong>Extracts exact video dimensions with no padding</strong></td>
            </tr>
            <tr>
              <td><strong>Precision Navigation</strong></td>
              <td>Difficult to pause on exact millisecond</td>
              <td><strong>Precision ±0.04s Frame-by-Frame Navigation</strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Best Practices for Crisp, Blur-Free Video Stills</h2>
      <ul>
        <li><strong>Understand Shutter Speed vs Motion Blur:</strong> Videos shot with a standard 180-degree shutter rule (e.g. 1/50s at 24fps) have natural motion blur on fast-moving subjects. Step backward 2 to 3 frames to find moments where the subject's head or hands momentarily pause between motions.</li>
        <li><strong>Shoot at Higher Frame Rates for Action:</strong> If you plan to extract stills from sports or fast vlogs, record in 60fps or 120fps with a fast shutter speed (1/250s or higher) to ensure razor-sharp freeze frames.</li>
        <li><strong>Always Select PNG for Graphics & Editing:</strong> PNG uses lossless DEFLATE compression, preserving subtle skin tones and edge sharpness needed for Photoshop masking and cutout tools.</li>
      </ul>

      <h2>Zero Server Uploads: 100% Client-Side Privacy and Speed</h2>
      <p>
        Unlike cloud-based conversion websites that require you to upload hundreds of megabytes over slow internet connections and store your private footage on third-party servers, our <strong>Video Frame Grabber</strong> processes everything locally in memory.
      </p>
      <p>
        The tool uses hardware-accelerated HTML5 video decoding to render frames directly onto an offscreen HTML5 <code>&lt;canvas&gt;</code> element, converting the raw canvas buffer into a high-speed data blob. Your videos never leave your computer, laptop, tablet, or smartphone.
      </p>

      <h2>Complementary Creator Tools on CreatorsFeel</h2>
      <p>
        Streamline your entire post-production and publishing workflow with our suite of free creator tools:
      </p>
      <ul>
        <li>Check thumbnail resolution and file compliance with the <a href="/tools/youtube-thumbnail-size-checker">YouTube Thumbnail Size Checker</a>.</li>
        <li>Cut and trim video start and end points using the <a href="/tools/online-video-trimmer">Online Video Trimmer</a>.</li>
        <li>Reduce large video file sizes without losing quality with our <a href="/tools/video-compressor">Video Compressor</a>.</li>
        <li>Inspect image dimensions and aspect ratios with the <a href="/tools/image-dimensions-checker">Image Dimensions Checker</a>.</li>
        <li>Convert audio clips and music into dynamic waveforms using the <a href="/tools/audio-visualizer-generator">Audio Visualizer Generator</a>.</li>
      </ul>

      <h2>Explore More Free Creator Tools</h2>
      <div class="internal-links-grid">
        <a href="/tools/youtube-thumbnail-size-checker" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Thumbnail Size Checker</div>
          <div class="tool-link-desc">Verify 1280x720 resolution, 16:9 aspect ratio, and 2MB file size limits for thumbnails.</div>
        </a>
        <a href="/tools/online-video-trimmer" class="tool-link-card glass">
          <div class="tool-link-title">Online Video Trimmer</div>
          <div class="tool-link-desc">Cut, trim, and clip MP4, WebM, and MOV video clips directly in your browser.</div>
        </a>
        <a href="/tools/video-compressor" class="tool-link-card glass">
          <div class="tool-link-title">Video Compressor</div>
          <div class="tool-link-desc">Compress video files for Discord, email, and social media with 100% privacy.</div>
        </a>
        <a href="/tools/image-dimensions-checker" class="tool-link-card glass">
          <div class="tool-link-title">Image Dimensions Checker</div>
          <div class="tool-link-desc">Audit width, height, resolution, and aspect ratio for any image or screenshot.</div>
        </a>
        <a href="/tools/audio-visualizer-generator" class="tool-link-card glass">
          <div class="tool-link-title">Audio Visualizer Generator</div>
          <div class="tool-link-desc">Convert MP3 music and podcast audio into animated video waveforms and audiograms.</div>
        </a>
      </div>

    </section>
  </div>
</ToolLayout>

<style>
  /* Base Card Container */
  .calc-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    max-width: 100%;
    box-sizing: border-box;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 992px) {
    .calc-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.05fr);
      align-items: start;
    }
  }

  /* Left Form & Controls */
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
  }

  .input-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  /* Dropzone Boxes */
  .dropzone-box {
    min-height: 110px;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    position: relative;
    transition: all var(--transition-fast);
    box-sizing: border-box;
  }

  .dropzone-box:hover {
    border-color: var(--color-brand);
    background: rgba(99, 102, 241, 0.04);
  }

  .file-hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .dropzone-idle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .dropzone-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dropzone-svg {
    width: 22px;
    height: 22px;
  }

  .dropzone-heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .dropzone-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Loaded File Bar */
  .loaded-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);

    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .alert-svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: #dc2626;
  }

  .alert-text-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .alert-title {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .alert-desc {
    font-size: 0.8rem;
    margin: 0;
    color: #b91c1c;
  }

  .btn-alert-dismiss {
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid #fca5a5;
    color: #991b1b;
    font-size: 0.775rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .btn-alert-dismiss:hover {
    background: #fee2e2;
  }

  /* Loaded Video Header Bar */
  .video-loaded-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.15rem;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .loaded-file-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .file-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #eef2ff;
    color: var(--color-brand, #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .loaded-file-svg {
    width: 16px;
    height: 16px;
  }

  .file-info-text {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .file-name-text {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }

  .file-meta-pills {
    font-size: 0.75rem;
    color: var(--color-text-muted, #64748b);
  }

  .btn-change-video {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text, #0f172a);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-change-video:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
  }

  .btn-change-svg {
    width: 14px;
    height: 14px;
    color: var(--color-brand, #4f46e5);
  }

  /* Video Studio Stage */
  .player-stage-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .video-screen-container {
    position: relative;
    width: 100%;
    background: #0f172a;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.2);
  }

  .source-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000000;
    display: block;
  }

  .video-overlay-badge {
    position: absolute;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .badge-top-left {
    top: 0.85rem;
    left: 0.85rem;
  }

  .badge-top-right {
    top: 0.85rem;
    right: 0.85rem;
    font-family: inherit;
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  /* Timeline Scrubbing */
  .timeline-scrub-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-slider-row {
    width: 100%;
  }

  .timeline-slider {
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: #e2e8f0;
    outline: none;
    cursor: pointer;
    -webkit-appearance: none;
    accent-color: var(--color-brand, #4f46e5);
  }

  .timeline-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-brand, #4f46e5);
    cursor: pointer;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease;
  }

  .timeline-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .timeline-time-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    font-family: monospace;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-text, #0f172a);
  }

  .time-label-current {
    color: var(--color-brand, #4f46e5);
  }

  .time-label-divider {
    color: #94a3b8;
  }

  .time-label-total {
    color: var(--color-text-muted, #64748b);
  }

  /* Controls Toolbar */
  .player-controls-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    background: #f8fafc;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .stepper-buttons-group {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .btn-step {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.75rem;
    border-radius: 9px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text, #0f172a);
    font-size: 0.775rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .btn-step:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }

  .step-svg {
    width: 13px;
    height: 13px;
    color: var(--color-brand, #4f46e5);
    flex-shrink: 0;
  }

  .btn-play-pause {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: 9px;
    background: var(--color-brand, #4f46e5);
    border: 1px solid var(--color-brand, #4f46e5);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .btn-play-pause:hover {
    background: var(--color-brand-hover, #4338ca);
  }

  .play-svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Jump to Timestamp Form */
  .timestamp-jump-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .jump-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-text-muted, #64748b);
  }

  .jump-label-svg {
    width: 13px;
    height: 13px;
  }

  .jump-input-group {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .jump-text-input {
    width: 86px;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--color-text, #0f172a);
    text-align: center;
  }

  .jump-text-input:focus {
    outline: none;
    border-color: var(--color-brand, #4f46e5);
  }

  .btn-jump-go {
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text, #0f172a);
    font-size: 0.775rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-jump-go:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  /* Capture Settings & CTA Bar */
  .capture-settings-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 1.25rem;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(124, 58, 237, 0.03) 100%);
    border: 1px solid #e0e7ff;
  }

  .settings-left-col {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .setting-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .setting-label {
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .setting-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .setting-val-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand, #4f46e5);
  }

  .select-wrapper {
    position: relative;
    display: inline-block;
  }

  .styled-select {
    appearance: none;
    -webkit-appearance: none;
    padding: 0.5rem 2.25rem 0.5rem 0.85rem;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text, #0f172a);
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .styled-select:focus {
    border-color: var(--color-brand, #4f46e5);
  }

  .select-chevron-box {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #64748b;
    display: flex;
    align-items: center;
  }

  .chevron-svg {
    width: 14px;
    height: 14px;
  }

  .styled-range {
    width: 130px;
    height: 6px;
    border-radius: 3px;
    background: #cbd5e1;
    outline: none;
    cursor: pointer;
    accent-color: var(--color-brand, #4f46e5);
  }

  .capture-cta-wrap {
    display: flex;
    align-items: center;
  }

  .btn-capture-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.6rem;
    border-radius: 12px;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    border: none;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
    transition: all 0.2s ease;
    user-select: none;
  }

  .btn-capture-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
  }

  .btn-capture-cta:active {
    transform: translateY(0);
  }

  .capture-camera-svg {
    width: 18px;
    height: 18px;
  }

  /* Video Specs Strip */
  .video-specs-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .video-specs-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .spec-mini-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .spec-label {
    font-size: 0.725rem;
    color: var(--color-text-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .spec-value {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    font-family: monospace;
  }

  .highlight-mode {
    color: #059669;
    font-family: inherit;
  }

  /* Divider */
  .card-divider {
    height: 1px;
    background: var(--color-border, #e2e8f0);
    width: 100%;
    margin: 0.25rem 0;
  }

  /* Captured Output Area */
  .captured-output-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-frames-card {
    text-align: center;
    padding: clamp(2rem, 4vw, 3rem) 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border-radius: 18px;
    border: 1px dashed #cbd5e1;
  }

  .empty-icon-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #eef2ff;
    color: var(--color-brand, #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .empty-svg {
    width: 24px;
    height: 24px;
  }

  .empty-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin-bottom: 0.35rem;
  }

  .empty-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted, #64748b);
    max-width: 480px;
    margin: 0;
    line-height: 1.5;
  }

  /* Latest Frame Card */
  .latest-frame-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid #c7d2fe;
    box-shadow: 0 4px 18px rgba(99, 102, 241, 0.08);
  }

  .latest-card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .latest-header-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    display: inline-block;
  }

  .latest-meta-badges {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .badge-timecode {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: #eef2ff;
    color: var(--color-brand, #4f46e5);
  }

  .badge-resolution {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: #f1f5f9;
    color: #475569;
  }

  .latest-image-viewport {
    width: 100%;
    max-height: 480px;
    border-radius: 14px;
    overflow: hidden;
    background: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .latest-frame-img {
    max-width: 100%;
    max-height: 480px;
    object-fit: contain;
    display: block;
  }

  .latest-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-download-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.35rem;
    border-radius: 10px;
    background: var(--color-brand, #4f46e5);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-download-primary:hover {
    background: var(--color-brand-hover, #4338ca);
  }

  .btn-copy-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.15rem;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text, #0f172a);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-copy-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .action-btn-svg {
    width: 16px;
    height: 16px;
  }

  /* Gallery Card */
  .gallery-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
    padding-top: 1.25rem;
  }

  .gallery-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .gallery-title-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .gallery-heading {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    margin: 0;
  }

  .gallery-count-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    background: #eef2ff;
    color: var(--color-brand, #4f46e5);
  }

  .gallery-header-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gallery-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
    font-size: 0.775rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-bulk-download {
    background: #eef2ff;
    border: 1px solid #c7d2fe;
    color: var(--color-brand, #4f46e5);
  }

  .btn-bulk-download:hover {
    background: #e0e7ff;
  }

  .btn-clear-all {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    color: #ef4444;
  }

  .btn-clear-all:hover {
    background: #fef2f2;
    border-color: #fca5a5;
  }

  .gallery-action-svg {
    width: 14px;
    height: 14px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 860px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  :global(.gallery-item-card) {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  :global(.gallery-item-card:hover) {
    border-color: #c7d2fe;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.08);
  }

  :global(.gallery-thumb-wrap) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0f172a;
    overflow: hidden;
  }

  :global(.gallery-thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.gallery-format-badge) {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    background: rgba(15, 23, 42, 0.8);
    color: #ffffff;
  }

  :global(.gallery-item-meta) {
    padding: 0.5rem 0.65rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    background: #f8fafc;
  }

  :global(.gallery-timecode) {
    font-family: monospace;
    font-size: 0.725rem;
    font-weight: 600;
    color: var(--color-text, #0f172a);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.gallery-actions) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  :global(.gallery-btn-action) {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border, #e2e8f0);
    background: #ffffff;
    cursor: pointer;
    text-decoration: none;
    color: var(--color-text-muted, #64748b);
    transition: all 0.15s ease;
  }

  :global(.gallery-btn-download:hover) {
    color: var(--color-brand, #4f46e5);
    border-color: #c7d2fe;

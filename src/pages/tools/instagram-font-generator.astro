---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "How do you change fonts on your Instagram bio?",
    answer: "To change your Instagram bio font, type your text into our Instagram Font Generator above, choose your favorite stylish font, click 'Copy Font', and paste it directly into your Instagram profile bio settings."
  },
  {
    question: "Are Instagram copy-and-paste fonts safe to use?",
    answer: "Yes! The stylish text generated by our tool consists of official Unicode character symbols supported natively by iOS, Android, and web browsers. They are completely safe and will not violate Instagram's terms of service."
  },
  {
    question: "Do fancy fonts affect the 150-character limit on Instagram bios?",
    answer: "Some Unicode symbols (like bold or script characters) require 2 to 4 bytes in Unicode encoding. While Instagram counts most symbols as single characters against your 150-character bio limit, complex symbols may occasionally take extra character space."
  },
  {
    question: "Why do some devices show blank boxes or question marks [?] instead of stylish fonts?",
    answer: "Older mobile operating systems or outdated browsers may lack support for newer Unicode mathematical symbols. Sticking to popular styles like Bold, Sans, Italic, and Monospace ensures maximum compatibility across all devices."
  },
  {
    question: "Can screen readers read Instagram fonts for visually impaired users?",
    answer: "Screen readers interpret fancy Unicode symbols as mathematical characters rather than standard English letters. It is best practice to use stylish fonts for key words, hooks, or headings rather than entire long paragraphs."
  },
  {
    question: "Can I use stylish fonts in my Instagram username?",
    answer: "Instagram only permits standard alphanumeric characters (letters, numbers, underscores, and periods) in official @usernames. However, you can use any stylish font for your Instagram 'Display Name' and bio."
  }
];
---

<ToolLayout
  title="Instagram Font Generator - Copy & Paste Stylish Fonts for Bio & Captions"
  description="Free Instagram Font Generator. Convert normal text into 25+ cool, fancy, and stylish Unicode fonts for Instagram bios, captions, usernames, and DMs with 1-click copy."
  toolName="Instagram Font Generator"
  toolDescription="Generate 25+ stylish, cool, and fancy Unicode fonts for Instagram bios, captions, stories, and usernames with instant 1-click copy buttons."
  category="Writing Tools"
  faqs={faqs}
>
  <!-- Main Calculator Interface -->
  <div slot="calculator" class="calc-card glass">
    
    <!-- 2-Column Desktop Grid -->
    <div class="calc-grid">
      
      <!-- Left Column: Input Editor & Action Buttons -->
      <form class="calc-form" id="font-form" onsubmit="return false;">
        <div class="form-group">
          <div class="label-row" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.35rem;">
            <label for="text-input" class="input-label" style="margin: 0;">Type Your Text to Generate Fonts</label>
            <!-- Quick Case Conversion Buttons -->
            <div class="format-toolbar" style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
              <button type="button" class="format-btn" id="btn-uppercase" title="Convert to ALL CAPS">UPPERCASE</button>
              <button type="button" class="format-btn" id="btn-lowercase" title="Convert to lowercase">lowercase</button>
              <button type="button" class="format-btn" id="btn-titlecase" title="Convert to Title Case">Title Case</button>
              <button type="button" class="format-btn" id="btn-cleanspace" title="Trim extra spaces">Clean Spacing</button>
            </div>
          </div>
          <textarea 
            id="text-input" 
            class="editor-textarea" 
            placeholder="Type or paste your text here..."
            rows="6"
          >Design your dream life</textarea>
        </div>

        <!-- Filter Category Tabs -->
        <div class="filter-toolbar">
          <span class="filter-label">Filter Category:</span>
          <div class="filter-pills">
            <button type="button" class="filter-btn active" data-category="all">All Styles</button>
            <button type="button" class="filter-btn" data-category="bold">Bold</button>
            <button type="button" class="filter-btn" data-category="script">Script</button>
            <button type="button" class="filter-btn" data-category="gothic">Gothic</button>
            <button type="button" class="filter-btn" data-category="fancy">Decorative</button>
            <button type="button" class="filter-btn" data-category="enclosed">Circled & Boxed</button>
          </div>
        </div>

        <!-- Prominent Main Action Buttons Row -->
        <div class="main-actions-row">
          <button type="button" id="btn-copy-input" class="calc-btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
            </svg>
            <span id="copy-input-text">Copy Input Text</span>
          </button>
          <button type="button" id="btn-clear" class="calc-btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            Clear All
          </button>
        </div>
      </form>

      <!-- Right Column: Generated Fonts Feed -->
      <div class="calc-results" id="results-wrapper">
        
        <div class="feed-header-row">
          <strong class="feed-title">Generated Instagram Fonts</strong>
          <span class="feed-badge" id="styles-count-badge">25 Styles</span>
        </div>

        <!-- Generated Font Cards Container -->
        <div class="font-cards-feed" id="font-cards-feed">
          <!-- Dynamically populated via JS -->
        </div>

        <!-- Unicode Compatibility Note Box -->
        <div class="compatibility-note-box">
          <div class="note-header-row">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon" style="display:inline-block; vertical-align:middle; color:var(--color-brand); margin-right:6px;"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            <strong>Unicode Compatibility Note</strong>
          </div>
          <p class="note-desc-text">
            These text styles use official Unicode mathematical alphanumeric symbols. They work across Instagram bios, post captions, comments, reels, and stories without installing custom fonts.
          </p>
        </div>

      </div>

    </div>
  </div>

  <!-- Editorial & SEO Content Slot -->
  <div slot="about" class="editorial-content">
    <section class="editorial-section">
      
      <h2>What Is an Instagram Font Generator?</h2>
      <p>
        An <strong>Instagram Font Generator</strong> (also known as an Instagram Text Generator or Instagram Font Changer) is a free web tool that converts plain text into stylish, eye-catching text fonts designed for Instagram profiles.
      </p>
      <p>
        Because Instagram's app native editor offers limited font options, millions of creators use an <strong>Instagram font generator copy and paste</strong> tool to craft customized bios, unique captions, highlight titles, and comments that stand out on mobile feeds.
      </p>

      <h2>How Does the Instagram Font Generator Work?</h2>
      <p>
        Contrary to popular belief, an Instagram font generator does not install new font files (.TTF or .OTF) on your smartphone. Instead, it leverages the global <strong>Unicode Standard</strong>:
      </p>
      <ul>
        <li><strong>Unicode Character Mapping:</strong> Unicode contains over 149,000 character symbols, including Mathematical Alphanumeric Symbols (bold, italic, script, gothic, double-struck).</li>
        <li><strong>Real-Time Transformation:</strong> When you type normal text like <code>"Hello"</code>, our engine instantly maps each Latin character to its corresponding Unicode symbol counterpart (e.g. <code>"𝐻𝑒𝓁𝓁𝑜"</code> or <code>"𝕳𝔢𝔩𝔩𝔬"</code>).</li>
        <li><strong>Universal Cross-Platform Support:</strong> Because these symbols are built into universal device software, they render seamlessly on Instagram for iOS, Android, and web.</li>
      </ul>

      <h2>How to Use Instagram Fonts</h2>
      <p>
        Using custom fonts on Instagram takes only a few seconds. Follow this step-by-step process:
      </p>
      <ol>
        <li><strong>Type Your Text:</strong> Type or paste your desired bio, caption, or display name into the editor above.</li>
        <li><strong>Select Your Favorite Style:</strong> Browse through 25+ font styles—including Bold Sans, Cursive Script, Gothic Blackletter, and Circled text.</li>
        <li><strong>Click Copy Font:</strong> Click the <strong>Copy Font</strong> button next to your chosen style.</li>
        <li><strong>Paste into Instagram:</strong> Open Instagram, navigate to <em>Edit Profile</em> or your post caption editor, and paste the generated text.</li>
      </ol>

      <h2>Instagram Fonts Copy and Paste</h2>
      <p>
        Our <strong>Instagram fonts copy and paste</strong> tool supports a wide variety of aesthetic text styles tailored for different creator niches:
      </p>

      <div class="table-responsive">
        <table class="editorial-table">
          <thead>
            <tr>
              <th>Font Style Category</th>
              <th>Sample Generated Output</th>
              <th>Recommended Instagram Use Case</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Bold Sans & Serif</strong></td>
              <td><code>𝗕𝗼𝗹𝗱 𝗦𝗮𝗻𝘀 / 𝐁𝐨𝐥𝐝 𝐒𝐞𝐫𝐢𝐟</code></td>
              <td>Bio hooks, call-to-actions & caption headlines</td>
            </tr>
            <tr>
              <td><strong>Cursive / Script</strong></td>
              <td><code>𝒮𝒸𝓇𝒾𝓅𝓉 𝒞𝓊𝓇𝓈𝒾𝓋ℯ</code></td>
              <td>Lifestyle, beauty, fashion & aesthetic quotes</td>
            </tr>
            <tr>
              <td><strong>Gothic Blackletter</strong></td>
              <td><code>𝔊𝔬𝔱𝔥𝔦𝔠 𝔅𝔩𝔞𝔠𝔨𝔩𝔢𝔱𝔱𝔢𝔯</code></td>
              <td>Streetwear, gaming, fitness & music accounts</td>
            </tr>
            <tr>
              <td><strong>Monospace / Code</strong></td>
              <td><code>𝙼𝚘𝚗𝚘𝚜𝚙𝚊𝚌𝚎 𝚃𝚎𝚡𝚝</code></td>
              <td>Tech, developer, minimal & modern brand bios</td>
            </tr>
            <tr>
              <td><strong>Double Struck / Outline</strong></td>
              <td><code>𝔻𝕠𝕦𝕓𝕝𝕖 𝕊𝕥𝕣𝕦𝕔𝕜</code></td>
              <td>Highlight titles & artistic profile display names</td>
            </tr>
            <tr>
              <td><strong>Circled & Boxed</strong></td>
              <td><code>Ⓒⓘⓡⓒⓛⓔⓓ / 🅂🅀🅄🄰🅁🄴🅁</code></td>
              <td>Special announcements & bullet points</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Best Instagram Fonts for Bios and Captions</h2>
      <p>
        Choosing the right font style depends on your brand identity and audience expectations:
      </p>
      <ul>
        <li><strong>For Personal Brands & Influencers:</strong> Clean <em>Bold Sans</em> or elegant <em>Script Cursive</em> creates an approachable, professional look.</li>
        <li><strong>For Businesses & E-commerce:</strong> Use <em>Bold Sans</em> for primary category headings and pair with standard text for maximum readability.</li>
        <li><strong>For Artists & Designers:</strong> Experiment with <em>Double Struck</em> or <em>Fullwidth Vaporwave</em> for a creative flair.</li>
      </ul>

      <h2>How to Make Your Instagram Bio Stand Out</h2>
      <p>
        Your Instagram bio is your digital business card. Combine stylish fonts with proper profile auditing:
      </p>
      <ol>
        <li>
          <strong>Audit Your Bio Character Limit:</strong> Instagram limits profile bios to 150 characters. Audit your bio length using our <a href="/tools/instagram-bio-character-counter">Instagram Bio Character Counter</a>.
        </li>
        <li>
          <strong>Check Caption Truncation:</strong> On mobile feeds, captions truncate after 125 characters with a "...more" button. Inspect mobile truncation with our <a href="/tools/instagram-caption-character-counter">Instagram Caption Character Counter</a>.
        </li>
        <li>
          <strong>Format Clean Line Breaks:</strong> Prevent messy text formatting by adding invisible spacing with our <a href="/tools/instagram-line-break-generator">Instagram Line Break Generator</a>.
        </li>
        <li>
          <strong>Generate Cool Usernames:</strong> Audit display names and username ideas using our <a href="/tools/instagram-username-generator">Instagram Username Generator</a>.
        </li>
        <li>
          <strong>Cross-Format for Other Networks:</strong> Format post copy for LinkedIn using our <a href="/tools/linkedin-post-formatter">LinkedIn Post Formatter</a>.
        </li>
      </ol>

      <h2>Instagram Font Generator vs Traditional Fonts</h2>
      <p>
        Understanding the technical distinction between standard web typography and copy-paste Unicode fonts prevents common publishing mistakes:
      </p>
      <ul>
        <li><strong>Traditional Fonts (CSS / TTF):</strong> Require web servers or system installations. They cannot be pasted into native mobile input fields like Instagram or TikTok.</li>
        <li><strong>Unicode Stylish Fonts:</strong> Universal character codes native to unicode spec. They paste directly into any social media app input field.</li>
      </ul>

      <h2>Are Instagram Fonts Safe to Use?</h2>
      <p>
        Yes, using an Instagram font changer is completely safe. Because generated characters are standard Unicode symbols, they are recognized as plain text by Instagram's servers and will not cause account flags, shadowbans, or penalty actions.
      </p>

      <h2>Common Problems With Instagram Fonts</h2>
      <ul>
        <li><strong>Overusing Complex Symbols:</strong> Writing long 100-word paragraphs in heavy Gothic fonts makes copy difficult to read on small screens.</li>
        <li><strong>Screen Reader Accessibility:</strong> Visually impaired users relying on screen readers hear Unicode symbols read out as mathematical characters. Use stylish fonts selectively for hooks and titles.</li>
        <li><strong>Device Rendering Variations:</strong> Very old smartphone OS versions may render newer Unicode characters as empty rectangles ``.</li>
      </ul>

      <h2>Tips for Using Stylish Fonts on Instagram</h2>
      <ol>
        <li><strong>Highlight Important Words:</strong> Use bold or script fonts for the first 2-3 words of your bio to create visual hierarchy.</li>
        <li><strong>Keep Contact Info Legible:</strong> Always write email addresses, website links, and phone numbers in standard legible text.</li>
        <li><strong>Test Across Light & Dark Modes:</strong> Preview how your chosen font style appears in both dark mode and light mode on mobile.</li>
      </ol>

      <h2>Explore More Free Creator Tools on CreatorsFeel</h2>
      <div class="internal-links-grid">
        <a href="/tools/instagram-bio-character-counter" class="tool-link-card glass">
          <div class="tool-link-title">Instagram Bio Character Counter</div>
          <div class="tool-link-desc">Audit your 150-character Instagram bio limit, line breaks, link counts, and emoji usage.</div>
        </a>
        <a href="/tools/instagram-caption-character-counter" class="tool-link-card glass">
          <div class="tool-link-title">Instagram Caption Character Counter</div>
          <div class="tool-link-desc">Check the 2,200 character limit and 125-character mobile feed crop for Instagram captions.</div>
        </a>
        <a href="/tools/instagram-username-generator" class="tool-link-card glass">
          <div class="tool-link-title">Instagram Username Generator</div>
          <div class="tool-link-desc">Generate cool, available, and search-optimized Instagram username ideas.</div>
        </a>
        <a href="/tools/instagram-line-break-generator" class="tool-link-card glass">
          <div class="tool-link-title">Instagram Line Break Generator</div>
          <div class="tool-link-desc">Add clean invisible line breaks and paragraph spacing to Instagram captions and bios.</div>
        </a>
        <a href="/tools/linkedin-post-formatter" class="tool-link-card glass">
          <div class="tool-link-title">LinkedIn Post Formatter</div>
          <div class="tool-link-desc">Format social media posts with bold, italic, and bulleted Unicode text styles.</div>
        </a>
      </div>

    </section>
  </div>
</ToolLayout>

<style is:global>
  /* Base Card Container */
  .calc-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    max-width: 100%;
    box-sizing: border-box;
  }

  /* 2-Column Grid Layout */
  .calc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 992px) {
    .calc-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Left Form & Editor */
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .input-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .editor-textarea {
    width: 100%;
    min-height: 160px;
    padding: 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    outline: none;
    resize: vertical;
    box-sizing: border-box;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .editor-textarea:focus {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .format-btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .format-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  /* Filter Category Toolbar */
  .filter-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .filter-btn {
    padding: 0.3rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
  }

  .filter-btn.active {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #ffffff;
  }

  /* Prominent Main Action Buttons Row */
  .main-actions-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .calc-btn-primary {
    flex: 2;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--gradient-brand);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: transform var(--transition-fast), opacity var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
  }

  .calc-btn-primary:hover {
    opacity: 0.95;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
  }

  .calc-btn-secondary {
    flex: 1;
    min-height: 48px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all var(--transition-fast);
  }

  .calc-btn-secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg);
  }

  .btn-svg {
    width: 18px;
    height: 18px;
  }

  /* Right Column: Generated Fonts Feed */
  .calc-results {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .feed-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .feed-title {
    font-size: 1rem;
    color: var(--color-text);
  }

  .feed-badge {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  /* Dynamic Font Styles Feed Cards */
  .font-cards-feed {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 560px;
    overflow-y: auto;
    padding-right: 0.35rem;
  }

  .font-style-card {
    padding: 0.9rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .font-style-card:hover {
    border-color: rgba(99, 102, 241, 0.3);
  }

  .font-info-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }

  .font-name-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .font-sample-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    word-break: break-word;
    line-height: 1.4;
  }

  /* Copy Font Button - Outlined Reference Style */
  .copy-style-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.45rem !important;
    padding: 0.5rem 1rem !important;
    min-height: 36px !important;
    font-size: 0.85rem !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    border: 1px solid rgba(99, 102, 241, 0.4) !important;
    border-radius: var(--radius-md) !important;
    background: var(--color-bg-alt) !important;
    color: var(--color-brand) !important;
    cursor: pointer !important;
    flex-shrink: 0 !important;
    white-space: nowrap !important;
    transition: all var(--transition-fast) !important;
  }

  .copy-style-btn:hover {
    border-color: var(--color-brand) !important;
    background: rgba(99, 102, 241, 0.08) !important;
    transform: translateY(-1px) !important;
  }

  .copy-style-btn.copied-state {
    border-color: #10b981 !important;
    color: #10b981 !important;
    background: rgba(16, 185, 129, 0.08) !important;
  }

  @media (max-width: 576px) {
    .font-style-card {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .copy-style-btn {
      width: 100% !important;
      min-height: 40px !important;
    }
  }

  /* Compatibility Note Box */
  .compatibility-note-box {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .note-header-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .note-desc-text {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* Editorial Content Styles */
  .editorial-section {
    padding-top: 1.5rem;
  }

  .editorial-section h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .editorial-section p {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .editorial-section ul, .editorial-section ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .editorial-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .editorial-section code {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .editorial-table th, .editorial-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .editorial-table th {
    background: var(--color-bg-alt);
    font-weight: 700;
  }

  .editorial-table tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .internal-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-link-card {
    display: block;
    padding: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const textInput = document.getElementById('text-input') as HTMLTextAreaElement | null;
    const fontCardsFeed = document.getElementById('font-cards-feed');
    const stylesCountBadge = document.getElementById('styles-count-badge');

    // Case formatting buttons
    const btnUppercase = document.getElementById('btn-uppercase');
    const btnLowercase = document.getElementById('btn-lowercase');
    const btnTitlecase = document.getElementById('btn-titlecase');
    const btnCleanspace = document.getElementById('btn-cleanspace');
    const btnCopyInput = document.getElementById('btn-copy-input');
    const copyInputTextSpan = document.getElementById('copy-input-text');
    const btnClear = document.getElementById('btn-clear');

    // Category Filter Pills
    const filterBtns = document.querySelectorAll('.filter-btn');

    if (!textInput || !fontCardsFeed) return;

    let activeFilter = 'all';

    // Comprehensive Unicode Font Generators Engine
    const charMaps: Record<string, { name: string; category: string; fn: (text: string) => string }> = {
      boldSans: {
        name: 'Bold Sans',
        category: 'bold',
        fn: (str) => mapChars(str, {
          A: 0x1D5D4, a: 0x1D5EE, 0: 0x1D7EC
        })
      },
      boldSerif: {
        name: 'Bold Serif',
        category: 'bold',
        fn: (str) => mapChars(str, {
          A: 0x1D400, a: 0x1D41A, 0: 0x1D7CE
        })
      },
      italicSans: {
        name: 'Italic Sans',
        category: 'bold',
        fn: (str) => mapChars(str, {
          A: 0x1D608, a: 0x1D622
        })
      },
      boldItalic: {
        name: 'Bold Italic',
        category: 'bold',
        fn: (str) => mapChars(str, {
          A: 0x1D63C, a: 0x1D656
        })
      },
      scriptCursive: {
        name: 'Script Cursive',
        category: 'script',
        fn: (str) => mapChars(str, {
          A: 0x1D49C, a: 0x1D4B6
        }, scriptOverrides)
      },
      boldScript: {
        name: 'Bold Script',
        category: 'script',
        fn: (str) => mapChars(str, {
          A: 0x1D4D0, a: 0x1D4EA
        })
      },
      gothic: {
        name: 'Gothic Blackletter',
        category: 'gothic',
        fn: (str) => mapChars(str, {
          A: 0x1D504, a: 0x1D51E
        }, gothicOverrides)
      },
      boldGothic: {
        name: 'Bold Gothic',
        category: 'gothic',
        fn: (str) => mapChars(str, {
          A: 0x1D56C, a: 0x1D586
        })
      },
      doubleStruck: {
        name: 'Double Struck (Outline)',
        category: 'fancy',
        fn: (str) => mapChars(str, {
          A: 0x1D538, a: 0x1D552, 0: 0x1D7D8
        }, doubleStruckOverrides)
      },
      monospace: {
        name: 'Monospace Code',
        category: 'fancy',
        fn: (str) => mapChars(str, {
          A: 0x1D670, a: 0x1D68A, 0: 0x1D7F6
        })
      },
      circled: {
        name: 'Circled Text',
        category: 'enclosed',
        fn: (str) => mapEnclosed(str, 0x24B6, 0x24D0, 0x2460)
      },
      negativeCircled: {
        name: 'Negative Circled',
        category: 'enclosed',
        fn: (str) => mapEnclosed(str, 0x1F150, 0x1F150, 0x278A)
      },
      squared: {
        name: 'Squared Boxed',
        category: 'enclosed',
        fn: (str) => mapEnclosed(str, 0x1F130, 0x1F130, 0x2460)
      },
      fullwidth: {
        name: 'Fullwidth Vaporwave',
        category: 'fancy',
        fn: (str) => {
          return str.split('').map(ch => {
            const code = ch.charCodeAt(0);
            if (code >= 33 && code <= 126) {
              return String.fromCharCode(code + 65248);
            }
            return ch === ' ' ? '  ' : ch;
          }).join('');
        }
      },
      smallCaps: {
        name: 'Small Caps',
        category: 'fancy',
        fn: (str) => {
          const smallCapsMap: Record<string, string> = {
            a: 'ᴀ', b: 'ʙ', c: 'ᴄ', d: 'ᴅ', e: 'ᴇ', f: 'ғ', g: 'ɢ', h: 'ʜ', i: 'ɪ',
            j: 'ᴊ', k: 'ᴋ', l: 'ʟ', m: 'ᴍ', n: 'ɴ', o: 'ᴏ', p: 'ᴘ', q: 'ǫ', r: 'ʀ',
            s: 's', t: 'ᴛ', u: 'ᴜ', v: 'ᴠ', w: 'ᴡ', x: 'x', y: 'ʏ', z: 'ᴢ'
          };
          return str.split('').map(c => smallCapsMap[c.toLowerCase()] || c).join('');
        }
      },
      strikethrough: {
        name: 'Strikethrough',
        category: 'fancy',
        fn: (str) => str.split('').map(c => c + '\u0336').join('')
      },
      underlined: {
        name: 'Underline',
        category: 'fancy',
        fn: (str) => str.split('').map(c => c + '\u0332').join('')
      },
      doubleUnderline: {
        name: 'Double Underline',
        category: 'fancy',
        fn: (str) => str.split('').map(c => c + '\u0333').join('')
      },
      sparkles: {
        name: 'Sparkle Frame',
        category: 'fancy',
        fn: (str) => `[ ${str} ]`
      },
      hearts: {
        name: 'Heart Frame',
        category: 'fancy',
        fn: (str) => `[ ${str} ]`
      },
      stars: {
        name: 'Star Frame',
        category: 'fancy',
        fn: (str) => `[ ${str} ]`
      },
      arrows: {
        name: 'Arrow Accents',
        category: 'fancy',
        fn: (str) => `▶ ${str} ◀`
      },
      reversed: {
        name: 'Reversed Flip',
        category: 'fancy',
        fn: (str) => {
          const flipMap: Record<string, string> = {
            a: 'ɐ', b: 'q', c: 'ɔ', d: 'p', e: 'ǝ', f: 'ɟ', g: 'ƃ', h: 'ɥ', i: 'ı',
            j: 'ɾ', k: 'ʞ', l: 'l', m: 'ɯ', n: 'u', o: 'o', p: 'd', q: 'b', r: 'ɹ',
            s: 's', t: 'ʇ', u: 'n', v: 'ʌ', w: 'ʍ', x: 'x', y: 'ʎ', z: 'z',
            A: '∀', B: 'q', C: 'Ɔ', D: 'p', E: 'Ǝ', F: 'Ⅎ', G: '⅁', H: 'H', I: 'I',
            J: 'ſ', K: 'ʞ', L: '˥', M: 'W', N: 'N', O: 'O', P: 'Ԁ', Q: 'Ὁ', R: 'y',
            S: 'S', T: '┴', U: '∩', V: 'Λ', W: 'M', X: 'X', Y: '⅄', Z: 'Z'
          };
          return str.split('').reverse().map(c => flipMap[c] || c).join('');
        }
      }
    };

    const scriptOverrides: Record<string, string> = {
      B: 'ℬ', E: 'ℰ', F: 'ℱ', H: 'ℋ', I: 'ℐ', L: 'ℒ', M: 'ℳ', R: 'ℛ',
      e: 'ℯ', g: 'ℊ', o: 'ℴ'
    };

    const gothicOverrides: Record<string, string> = {
      C: 'ℭ', H: 'ℌ', I: 'ℑ', R: 'ℜ', Z: 'ℨ'
    };

    const doubleStruckOverrides: Record<string, string> = {
      C: 'ℂ', H: 'ℍ', N: 'ℕ', P: 'ℙ', Q: 'ℚ', R: 'ℝ', Z: 'ℤ'
    };

    // Generic Unicode offsetting helper with overrides
    function mapChars(
      str: string, 
      baseCodes: { A: number; a: number; 0?: number }, 
      overrides?: Record<string, string>
    ): string {
      return str.split('').map(ch => {
        if (overrides && overrides[ch]) {
          return overrides[ch];
        }
        const code = ch.charCodeAt(0);
        if (code >= 65 && code <= 90) { // A-Z
          return String.fromCodePoint(baseCodes.A + (code - 65));
        }
        if (code >= 97 && code <= 122) { // a-z
          return String.fromCodePoint(baseCodes.a + (code - 97));
        }
        if (baseCodes[0] !== undefined && code >= 48 && code <= 57) { // 0-9
          return String.fromCodePoint(baseCodes[0] + (code - 48));
        }
        return ch;
      }).join('');
    }

    function mapEnclosed(str: string, baseUpper: number, baseLower: number, baseNum: number): string {
      return str.split('').map(ch => {
        const code = ch.charCodeAt(0);
        if (code >= 65 && code <= 90) {
          return String.fromCodePoint(baseUpper + (code - 65));
        }
        if (code >= 97 && code <= 122) {
          return String.fromCodePoint(baseLower + (code - 97));
        }
        if (code >= 49 && code <= 57) {
          return String.fromCodePoint(baseNum + (code - 49));
        }
        return ch;
      }).join('');
    }

    // Main Render Function for Font Styles Cards
    function renderFontFeed() {
      const text = textInput?.value || '';
      if (!fontCardsFeed) return;

      fontCardsFeed.innerHTML = '';
      let count = 0;

      Object.keys(charMaps).forEach(key => {
        const item = charMaps[key];

        // Filter Check
        if (activeFilter !== 'all' && item.category !== activeFilter) {
          return;
        }

        count++;
        const transformedText = text ? item.fn(text) : item.fn('Sample Text');

        const card = document.createElement('div');
        card.className = 'font-style-card';

        const infoWrap = document.createElement('div');
        infoWrap.className = 'font-info-wrap';

        const nameLabel = document.createElement('span');
        nameLabel.className = 'font-name-label';
        nameLabel.textContent = item.name;

        const sampleText = document.createElement('div');
        sampleText.className = 'font-sample-text';
        sampleText.textContent = transformedText;

        infoWrap.appendChild(nameLabel);
        infoWrap.appendChild(sampleText);

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'copy-style-btn';
        copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" style="width:16px;height:16px;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" /></svg><span>Copy Font</span>`;

        const setCopiedState = () => {
          copyBtn.classList.add('copied-state');
          copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:16px;height:16px;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg><span>Copied!</span>`;
          setTimeout(() => {
            copyBtn.classList.remove('copied-state');
            copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" style="width:16px;height:16px;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" /></svg><span>Copy Font</span>`;
          }, 1800);
        };

        copyBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(transformedText).then(() => {
            setCopiedState();
          }).catch(() => {
            const textarea = document.createElement('textarea');
            textarea.value = transformedText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            setCopiedState();
          });
        });

        card.appendChild(infoWrap);
        card.appendChild(copyBtn);

        fontCardsFeed.appendChild(card);
      });

      if (stylesCountBadge) {
        stylesCountBadge.textContent = `${count} Styles`;
      }
    }

    // Event listeners on Input
    ['input', 'change', 'keyup'].forEach(evt => {
      textInput.addEventListener(evt, renderFontFeed);
    });

    // Filter Buttons Handler
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');
        if (category) {
          activeFilter = category;
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          renderFontFeed();
        }
      });
    });

    // Toolbar 1: UPPERCASE
    if (btnUppercase) {
      btnUppercase.addEventListener('click', () => {
        if (!textInput) return;
        textInput.value = textInput.value.toUpperCase();
        renderFontFeed();
      });
    }

    // Toolbar 2: lowercase
    if (btnLowercase) {
      btnLowercase.addEventListener('click', () => {
        if (!textInput) return;
        textInput.value = textInput.value.toLowerCase();
        renderFontFeed();
      });
    }

    // Toolbar 3: Title Case
    if (btnTitlecase) {
      btnTitlecase.addEventListener('click', () => {
        if (!textInput) return;
        textInput.value = textInput.value.replace(/\w\S*/g, (txt) => {
          return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();
        });
        renderFontFeed();
      });
    }

    // Toolbar 4: Clean Spacing
    if (btnCleanspace) {
      btnCleanspace.addEventListener('click', () => {
        if (!textInput) return;
        textInput.value = textInput.value
          .split('\n')
          .map(line => line.replace(/[ \t]+/g, ' ').trim())
          .join('\n');
        renderFontFeed();
      });
    }

    // Toolbar 5: Copy Input Text
    if (btnCopyInput) {
      btnCopyInput.addEventListener('click', () => {
        if (!textInput) return;
        navigator.clipboard.writeText(textInput.value).then(() => {
          if (copyInputTextSpan) copyInputTextSpan.textContent = 'Copied!';
          setTimeout(() => {
            if (copyInputTextSpan) copyInputTextSpan.textContent = 'Copy Input Text';
          }, 2000);
        });
      });
    }

    // Toolbar 6: Clear All
    if (btnClear) {
      btnClear.addEventListener('click', () => {
        if (!textInput) return;
        textInput.value = '';
        renderFontFeed();
        textInput.focus();
      });
    }

    // Initial render
    renderFontFeed();
  });
</script>

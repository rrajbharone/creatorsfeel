</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs & Elements
    const audioInput = document.getElementById('audio-input') as HTMLInputElement | null;
    const audioIdle = document.getElementById('audio-idle');
    const audioLoadedBar = document.getElementById('audio-loaded-bar');
    const audioFilename = document.getElementById('audio-filename');
    const audioFilemeta = document.getElementById('audio-filemeta');
    const btnChangeAudio = document.getElementById('btn-change-audio');

    const logoInput = document.getElementById('logo-input') as HTMLInputElement | null;
    const logoIdle = document.getElementById('logo-idle');
    const logoLoadedBar = document.getElementById('logo-loaded-bar');
    const logoFilename = document.getElementById('logo-filename');
    const logoThumb = document.getElementById('logo-thumb') as HTMLImageElement | null;
    const btnRemoveLogo = document.getElementById('btn-remove-logo');

    const selectStyle = document.getElementById('select-style') as HTMLSelectElement | null;
    const selectRatio = document.getElementById('select-ratio') as HTMLSelectElement | null;
    const colorWave = document.getElementById('color-wave') as HTMLInputElement | null;
    const colorBg = document.getElementById('color-bg') as HTMLInputElement | null;
    const inputTitle = document.getElementById('input-title') as HTMLInputElement | null;
    const inputArtist = document.getElementById('input-artist') as HTMLInputElement | null;

    const btnTogglePreview = document.getElementById('btn-toggle-preview');
    const txtPreviewBtn = document.getElementById('txt-preview-btn');
    const btnExportVideo = document.getElementById('btn-export-video');

    const canvasViewport = document.getElementById('canvas-viewport');
    const canvas = document.getElementById('visualizer-canvas') as HTMLCanvasElement | null;
    const canvasPlaceholder = document.getElementById('canvas-placeholder');
    const canvasAspectBadge = document.getElementById('canvas-aspect-badge');
    const audioPlayer = document.getElementById('audio-player') as HTMLAudioElement | null;

    const exportProgressCard = document.getElementById('export-progress-card');
    const progressStatusText = document.getElementById('progress-status-text');
    const progressPctText = document.getElementById('progress-pct-text');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressSubText = document.getElementById('progress-sub-text');

    const exportResultCard = document.getElementById('export-result-card');
    const outputVideoPlayer = document.getElementById('output-video-player') as HTMLVideoElement | null;
    const btnDownloadVideo = document.getElementById('btn-download-video');

    if (!canvas || !audioPlayer) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // State Variables
    let audioFile: File | null = null;
    let audioSrcUrl: string | null = null;
    let logoImage: HTMLImageElement | null = null;
    let audioContext: AudioContext | null = null;
    let analyserNode: AnalyserNode | null = null;
    let audioSourceNode: MediaElementAudioSourceNode | null = null;
    let isPreviewPlaying = false;
    let isRecording = false;
    let animFrameId: number | null = null;
    let exportedBlobUrl: string | null = null;

    let waveColor = '#6366f1';
    let bgColor = '#0f172a';
    let currentStyle = 'circular';
    let currentRatio = '16-9';
    let trackTitle = '';
    let trackArtist = '';

    // Color preset pill clicks
    document.querySelectorAll<HTMLButtonElement>('.color-dot').forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const color = dot.getAttribute('data-color') || '#6366f1';
        const parent = dot.closest('.form-group');
        if (parent?.contains(colorWave) && colorWave) {
          colorWave.value = color;
          waveColor = color;
        } else if (parent?.contains(colorBg) && colorBg) {
          colorBg.value = color;
          bgColor = color;
        }
        drawFrame();
      });
    });

    if (colorWave) {
      colorWave.addEventListener('input', () => {
        waveColor = colorWave.value;
        drawFrame();
      });
    }

    if (colorBg) {
      colorBg.addEventListener('input', () => {
        bgColor = colorBg.value;
        drawFrame();
      });
    }

    if (inputTitle) {
      inputTitle.addEventListener('input', () => {
        trackTitle = inputTitle.value.trim();
        drawFrame();
      });
    }

    if (inputArtist) {
      inputArtist.addEventListener('input', () => {
        trackArtist = inputArtist.value.trim();
        drawFrame();
      });
    }

    if (selectStyle) {
      selectStyle.addEventListener('change', () => {
        currentStyle = selectStyle.value;
        drawFrame();
      });
    }

    // Aspect Ratio Changer
    if (selectRatio && canvas && canvasViewport && canvasAspectBadge) {
      selectRatio.addEventListener('change', () => {
        currentRatio = selectRatio.value;
        canvasViewport.classList.remove('ratio-9-16', 'ratio-1-1');

        if (currentRatio === '9-16') {
          canvas.width = 720;
          canvas.height = 1280;
          canvasViewport.classList.add('ratio-9-16');
          canvasAspectBadge.textContent = '9:16 Vertical (TikTok/Reels)';
        } else if (currentRatio === '1-1') {
          canvas.width = 720;
          canvas.height = 720;
          canvasViewport.classList.add('ratio-1-1');
          canvasAspectBadge.textContent = '1:1 Square (Instagram)';
        } else {
          canvas.width = 1280;
          canvas.height = 720;
          canvasAspectBadge.textContent = '16:9 Landscape (YouTube)';
        }
        drawFrame();
      });
    }

    // Handle Audio File Selection
    if (audioInput) {
      audioInput.addEventListener('change', () => {
        if (audioInput.files && audioInput.files.length > 0) {
          loadAudioFile(audioInput.files[0]);
        }
      });
    }

    if (btnChangeAudio && audioInput) {
      btnChangeAudio.addEventListener('click', (e) => {
        e.stopPropagation();
        audioInput.click();
      });
    }

    function formatTime(seconds: number): string {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    }

    function loadAudioFile(file: File) {
      if (!file || !file.type.startsWith('audio/')) {
        alert('Please upload a valid audio file (MP3, WAV, M4A).');
        return;
      }

      audioFile = file;
      const mbSize = (file.size / (1024 * 1024)).toFixed(1);
      if (audioFilename) audioFilename.textContent = file.name;

      if (audioSrcUrl) URL.revokeObjectURL(audioSrcUrl);
      audioSrcUrl = URL.createObjectURL(file);
      audioPlayer.src = audioSrcUrl;

      audioPlayer.onloadedmetadata = () => {
        const dur = formatTime(audioPlayer.duration || 0);
        if (audioFilemeta) audioFilemeta.textContent = `${dur} • ${mbSize} MB`;
        if (audioIdle) audioIdle.style.display = 'none';
        if (audioLoadedBar) audioLoadedBar.style.display = 'flex';
        if (canvasPlaceholder) canvasPlaceholder.style.display = 'none';
        drawFrame();
      };
    }

    // Handle Logo Artwork Selection
    if (logoInput) {
      logoInput.addEventListener('change', () => {
        if (logoInput.files && logoInput.files.length > 0) {
          const file = logoInput.files[0];
          const img = new Image();
          img.src = URL.createObjectURL(file);
          img.onload = () => {
            logoImage = img;
            if (logoThumb) logoThumb.src = img.src;
            if (logoFilename) logoFilename.textContent = file.name;
            if (logoIdle) logoIdle.style.display = 'none';
            if (logoLoadedBar) logoLoadedBar.style.display = 'flex';
            drawFrame();
          };
        }
      });
    }

    if (btnRemoveLogo && logoInput) {
      btnRemoveLogo.addEventListener('click', (e) => {
        e.stopPropagation();
        logoImage = null;
        logoInput.value = '';
        if (logoIdle) logoIdle.style.display = 'flex';
        if (logoLoadedBar) logoLoadedBar.style.display = 'none';
        drawFrame();
      });
    }

    // Init Web Audio API
    function initWebAudio() {
      if (audioContext) return;
      try {
        audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
        analyserNode = audioContext.createAnalyser();
        analyserNode.fftSize = 256;
        analyserNode.smoothingTimeConstant = 0.8;

        audioSourceNode = audioContext.createMediaElementSource(audioPlayer);
        audioSourceNode.connect(analyserNode);
        analyserNode.connect(audioContext.destination);
      } catch (e) {
        console.warn('AudioContext init warning:', e);
      }
    }

    // Render Canvas Frame
    function drawFrame() {
      if (!ctx || !canvas) return;
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h / 2;

      // 1. Draw Background
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, w, h);

      // Subtle Radial Ambient Glow in background
      const glowGrad = ctx.createRadialGradient(cx, cy, 10, cx, cy, Math.max(w, h) * 0.6);
      glowGrad.addColorStop(0, waveColor + '25'); // 15% opacity
      glowGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = glowGrad;
      ctx.fillRect(0, 0, w, h);

      // 2. Fetch Frequency Data
      let freqArray = new Uint8Array(64);
      if (analyserNode && !audioPlayer.paused) {
        analyserNode.getByteFrequencyData(freqArray);
      } else {
        // Idle ambient data
        for (let i = 0; i < 64; i++) {
          freqArray[i] = 12 + Math.sin(i * 0.3) * 8;
        }
      }

      // 3. Render Visualizer Style
      if (currentStyle === 'circular') {
        drawCircularVisualizer(ctx, cx, cy, freqArray);
      } else if (currentStyle === 'linear') {
        drawLinearVisualizer(ctx, w, h, freqArray);
      } else if (currentStyle === 'pulse') {
        drawPulseVisualizer(ctx, cx, cy, freqArray);
      }

      // 4. Draw Center Logo / Artwork
      const logoRadius = Math.min(w, h) * 0.16;
      if (logoImage && logoImage.complete) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, logoRadius, 0, Math.PI * 2);
        ctx.closePath();
        ctx.clip();
        ctx.drawImage(logoImage, cx - logoRadius, cy - logoRadius, logoRadius * 2, logoRadius * 2);
        ctx.restore();

        // Border around logo
        ctx.beginPath();
        ctx.arc(cx, cy, logoRadius, 0, Math.PI * 2);
        ctx.lineWidth = 4;
        ctx.strokeStyle = waveColor;
        ctx.shadowColor = waveColor;
        ctx.shadowBlur = 12;
        ctx.stroke();
        ctx.shadowBlur = 0;
      } else if (currentStyle === 'circular' || currentStyle === 'pulse') {
        // Default glowing core if no logo
        ctx.beginPath();
        ctx.arc(cx, cy, logoRadius * 0.7, 0, Math.PI * 2);
        ctx.fillStyle = waveColor + '30';
        ctx.fill();
        ctx.lineWidth = 3;
        ctx.strokeStyle = waveColor;
        ctx.stroke();
      }

      // 5. Draw Track Title and Artist Text
      if (trackTitle || trackArtist) {
        ctx.save();
        ctx.textAlign = 'center';
        ctx.shadowColor = 'rgba(0, 0, 0, 0.8)';
        ctx.shadowBlur = 8;

        if (trackTitle) {
          ctx.font = `bold ${Math.round(h * 0.042)}px system-ui, sans-serif`;
          ctx.fillStyle = '#ffffff';
          const titleY = currentStyle === 'linear' ? h * 0.28 : h * 0.85;
          ctx.fillText(trackTitle, cx, titleY);
        }

        if (trackArtist) {
          ctx.font = `600 ${Math.round(h * 0.028)}px system-ui, sans-serif`;
          ctx.fillStyle = '#94a3b8';
          const artistY = currentStyle === 'linear' ? h * 0.34 : h * 0.90;
          ctx.fillText(trackArtist, cx, artistY);
        }
        ctx.restore();
      }
    }

    // Circular Spectrum Bars
    function drawCircularVisualizer(ctx: CanvasRenderingContext2D, cx: number, cy: number, freqArray: Uint8Array) {
      const radius = Math.min(cx, cy) * 0.38;
      const barsCount = 64;
      const angleStep = (Math.PI * 2) / barsCount;

      ctx.save();
      for (let i = 0; i < barsCount; i++) {
        const value = freqArray[i % freqArray.length] || 10;
        const barHeight = (value / 255) * (Math.min(cx, cy) * 0.45) + 4;
        const angle = i * angleStep;

        const x1 = cx + Math.cos(angle) * radius;
        const y1 = cy + Math.sin(angle) * radius;
        const x2 = cx + Math.cos(angle) * (radius + barHeight);
        const y2 = cy + Math.sin(angle) * (radius + barHeight);

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.lineWidth = Math.max(3, (radius * Math.PI) / barsCount - 2);
        ctx.lineCap = 'round';
        ctx.strokeStyle = waveColor;
        ctx.shadowColor = waveColor;
        ctx.shadowBlur = 8;
        ctx.stroke();
      }
      ctx.restore();
    }

    // Linear Spectrum Bars (Bottom Anchored)
    function drawLinearVisualizer(ctx: CanvasRenderingContext2D, w: number, h: number, freqArray: Uint8Array) {
      const barsCount = 48;
      const barWidth = (w * 0.85) / barsCount;
      const startX = w * 0.075;
      const baseY = h * 0.88;

      ctx.save();
      for (let i = 0; i < barsCount; i++) {
        const value = freqArray[i % freqArray.length] || 10;
        const barHeight = (value / 255) * (h * 0.45) + 4;
        const x = startX + i * barWidth;

        const barGrad = ctx.createLinearGradient(x, baseY, x, baseY - barHeight);
        barGrad.addColorStop(0, waveColor);
        barGrad.addColorStop(1, waveColor + 'cc');

        ctx.fillStyle = barGrad;
        ctx.shadowColor = waveColor;
        ctx.shadowBlur = 6;
        ctx.fillRect(x + 2, baseY - barHeight, barWidth - 4, barHeight);
      }
      ctx.restore();
    }

    // Glowing Radial Pulse (Ring)
    function drawPulseVisualizer(ctx: CanvasRenderingContext2D, cx: number, cy: number, freqArray: Uint8Array) {
      const baseRadius = Math.min(cx, cy) * 0.36;
      let sum = 0;
      for (let i = 0; i < freqArray.length; i++) sum += freqArray[i];
      const avg = sum / freqArray.length;
      const pulseRadius = baseRadius + (avg / 255) * 45;

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, pulseRadius, 0, Math.PI * 2);
      ctx.lineWidth = 6;
      ctx.strokeStyle = waveColor;
      ctx.shadowColor = waveColor;
      ctx.shadowBlur = 24;
      ctx.stroke();

      // Outer delicate echo ring
      ctx.beginPath();
      ctx.arc(cx, cy, pulseRadius + 16, 0, Math.PI * 2);
      ctx.lineWidth = 2;
      ctx.strokeStyle = waveColor + '66';
      ctx.stroke();
      ctx.restore();
    }

    // Animation Loop
    function animateLoop() {
      drawFrame();
      if (isPreviewPlaying || isRecording) {
        animFrameId = requestAnimationFrame(animateLoop);
      }
    }

    // Preview Toggle
    if (btnTogglePreview && txtPreviewBtn) {
      btnTogglePreview.addEventListener('click', async () => {
        if (!audioFile) {
          alert('Please upload an audio file (MP3/WAV) first.');
          return;
        }

        initWebAudio();
        if (audioContext && audioContext.state === 'suspended') {
          await audioContext.resume();
        }

        if (isPreviewPlaying) {
          audioPlayer.pause();
          isPreviewPlaying = false;
          txtPreviewBtn.textContent = 'Play Preview';
          if (animFrameId) cancelAnimationFrame(animFrameId);
          drawFrame();
        } else {
          audioPlayer.play();
          isPreviewPlaying = true;
          txtPreviewBtn.textContent = 'Pause Preview';
          animateLoop();
        }
      });

      audioPlayer.addEventListener('ended', () => {
        isPreviewPlaying = false;
        txtPreviewBtn.textContent = 'Play Preview';
        if (animFrameId) cancelAnimationFrame(animFrameId);
        drawFrame();
      });
    }

    // High-Performance Client-Side Video Export (MediaRecorder)
    if (btnExportVideo) {
      btnExportVideo.addEventListener('click', async () => {
        if (!audioFile || !audioSrcUrl) {
          alert('Please upload an audio file first before exporting video.');
          return;
        }

        if (isRecording) return;
        isRecording = true;

        initWebAudio();
        if (audioContext && audioContext.state === 'suspended') {
          await audioContext.resume();
        }

        // Pause preview if playing
        audioPlayer.pause();
        isPreviewPlaying = false;
        if (txtPreviewBtn) txtPreviewBtn.textContent = 'Play Preview';

        if (exportResultCard) exportResultCard.style.display = 'none';
        if (exportProgressCard) exportProgressCard.style.display = 'flex';
        updateProgress(0, 'Preparing canvas stream & audio recorder...');

        try {
          // 1. Capture Canvas Stream
          const stream = canvas.captureStream(30);

          // 2. Add Audio Stream to Canvas Video Stream
          if (audioContext && audioSourceNode) {
            const dest = audioContext.createMediaStreamDestination();
            audioSourceNode.connect(dest);
            const audioTrack = dest.stream.getAudioTracks()[0];
            if (audioTrack) {
              stream.addTrack(audioTrack);
            }
          }

          // 3. Determine MimeType
          let mimeType = 'video/webm';
          if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus')) {
            mimeType = 'video/webm;codecs=vp9,opus';
          } else if (MediaRecorder.isTypeSupported('video/webm;codecs=vp8,opus')) {
            mimeType = 'video/webm;codecs=vp8,opus';
          }

          const recorder = new MediaRecorder(stream, {
            mimeType,
            videoBitsPerSecond: 3000000,
            audioBitsPerSecond: 128000
          });

          const recordedChunks: Blob[] = [];
          recorder.ondataavailable = (e) => {
            if (e.data && e.data.size > 0) {
              recordedChunks.push(e.data);
            }
          };

          // Reset audio to start
          audioPlayer.currentTime = 0;
          recorder.start(100);
          await audioPlayer.play();
          animateLoop();

          const totalDuration = audioPlayer.duration || 10;

          // Progress tracker
          const progressInterval = setInterval(() => {
            if (!isRecording) {
              clearInterval(progressInterval);
              return;
            }
            const pct = Math.min(99, Math.round((audioPlayer.currentTime / totalDuration) * 100));
            updateProgress(pct, `Recording visualizer video... (${pct}%)`);
          }, 150);

          // On Audio Finish
          await new Promise((resolve) => {
            audioPlayer.onended = () => {
              clearInterval(progressInterval);
              recorder.stop();
              resolve(true);
            };
          });

          // Wait for recorder to finalize
          await new Promise((resolve) => {
            recorder.onstop = resolve;
          });

          // Finalize Video Blob
          const videoBlob = new Blob(recordedChunks, { type: mimeType });
          if (exportedBlobUrl) URL.revokeObjectURL(exportedBlobUrl);
          exportedBlobUrl = URL.createObjectURL(videoBlob);

          if (outputVideoPlayer) {
            outputVideoPlayer.src = exportedBlobUrl;
          }

          if (exportProgressCard) exportProgressCard.style.display = 'none';
          if (exportResultCard) {
            exportResultCard.style.display = 'flex';
            if (window.innerWidth < 992) {
              exportResultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }

          isRecording = false;

        } catch (err: any) {
          isRecording = false;
          alert(`Export Error: ${err.message || 'Unable to record visualizer video.'}`);
          if (exportProgressCard) exportProgressCard.style.display = 'none';
        }
      });
    }

    function updateProgress(pct: number, msg: string) {
      if (progressPctText) progressPctText.textContent = `${pct}%`;
      if (progressBarFill) progressBarFill.style.width = `${pct}%`;
      if (progressStatusText) progressStatusText.textContent = msg;
    }

    // Download Video Handler
    if (btnDownloadVideo) {
      btnDownloadVideo.addEventListener('click', () => {
        if (!exportedBlobUrl) return;
        const a = document.createElement('a');
        a.href = exportedBlobUrl;
        const name = audioFile ? audioFile.name.replace(/\.[^/.]+$/, "") : 'visualizer';
        a.download = `${name}_visualizer.webm`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
    }

    // Initial canvas render
    drawFrame();
  });
</script>

---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "What is an audio visualizer and how does it work?",
    answer: "An audio visualizer is a digital animation tool that translates sound frequencies into dynamic visual waveforms, circular spectrum bars, or pulsing sound rings in real time. It allows musicians, podcasters, and creators to convert audio tracks (MP3/WAV) into engaging video clips for social media."
  },
  {
    question: "How do I turn a podcast clip or song into an Instagram Reel or TikTok video?",
    answer: "Upload your MP3 or WAV audio snippet to our Audio Visualizer Generator, select the '9:16 Vertical' aspect ratio, upload your podcast cover art or logo, pick a neon waveform color, and click 'Export Video'. The tool generates a ready-to-post video clip with moving sound waves."
  },
  {
    question: "Which aspect ratio should I choose for my video visualizer?",
    answer: "Choose 16:9 Landscape for YouTube and desktop videos, 9:16 Vertical for TikTok, Instagram Reels, and YouTube Shorts, or 1:1 Square for classic Instagram feed carousels, Twitter/X posts, and Facebook feeds."
  },
  {
    question: "Is my audio file or artwork uploaded to any remote server?",
    answer: "No. Our Audio Visualizer Generator runs 100% locally in your web browser using HTML5 Canvas, Web Audio API, and MediaRecorder. Your audio tracks, voice recordings, and images never leave your computer or phone."
  },
  {
    question: "What audio and image formats are supported?",
    answer: "You can upload MP3, WAV, M4A, AAC, and OGG audio files, and JPG, PNG, WebP, and SVG images for your center logo and custom background."
  },
  {
    question: "How long does it take to render and download the visualizer video?",
    answer: "Because rendering happens in real time directly inside your browser via hardware acceleration, exporting takes exactly the duration of your audio clip. Once playback finishes, your high-definition video is ready for instant download."
  }
];
---

<ToolLayout
  title="Audio Visualizer Generator - Turn Audio into Video Online Free"
  description="Free online Audio Visualizer Generator. Convert MP3 and WAV audio into dynamic video visualizers with custom artwork for YouTube, TikTok, and Instagram Reels."
  toolName="Audio Visualizer Generator"
  toolDescription="Turn audio files and music into animated video visualizers. Customize waveforms, add center artwork, and export web-ready videos directly in your browser."
  category="Calculators"
  faqs={faqs}
>
  <!-- Main Visualizer Interface -->
  <div slot="calculator" class="calc-card glass">
    
    <!-- 2-Column Desktop Grid Layout -->
    <div class="calc-grid">
      
      <!-- Left Column: Controls & Uploads -->
      <div class="calc-form">
        
        <!-- Audio File Upload Box -->
        <div class="form-group">
          <label class="input-label">1. Upload Audio File (MP3 / WAV)</label>
          <div class="dropzone-box" id="audio-dropzone">
            <input type="file" id="audio-input" class="file-hidden-input" accept="audio/*, .mp3, .wav, .m4a, .ogg, .aac" />
            
            <div class="dropzone-idle" id="audio-idle">
              <div class="dropzone-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="dropzone-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z" />
                </svg>
              </div>
              <strong class="dropzone-heading">Choose or drop audio file</strong>
              <span class="dropzone-sub">MP3, WAV, M4A up to 50MB</span>
            </div>

            <!-- Loaded Audio Info Bar -->
            <div class="loaded-bar" id="audio-loaded-bar" style="display: none;">
              <div class="loaded-info">
                <span class="loaded-title" id="audio-filename">audio.mp3</span>
                <span class="loaded-meta" id="audio-filemeta">0:00 • 0.0 MB</span>
              </div>
              <button type="button" class="btn-change-file" id="btn-change-audio">Change</button>
            </div>
          </div>
        </div>

        <!-- Optional Center Logo / Artwork Upload -->
        <div class="form-group">
          <label class="input-label">2. Center Artwork / Logo (Optional)</label>
          <div class="dropzone-box" id="logo-dropzone">
            <input type="file" id="logo-input" class="file-hidden-input" accept="image/*, .png, .jpg, .jpeg, .webp, .svg" />
            
            <div class="dropzone-idle" id="logo-idle">
              <div class="dropzone-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="dropzone-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
              </div>
              <strong class="dropzone-heading">Upload cover art or avatar</strong>
              <span class="dropzone-sub">Square image recommended (PNG, JPG)</span>
            </div>

            <!-- Loaded Logo Bar -->
            <div class="loaded-bar" id="logo-loaded-bar" style="display: none;">
              <img id="logo-thumb" class="loaded-thumb" alt="Center artwork thumbnail" />
              <div class="loaded-info">
                <span class="loaded-title" id="logo-filename">cover.png</span>
                <span class="loaded-meta">Center Artwork Active</span>
              </div>
              <button type="button" class="btn-change-file btn-remove-logo" id="btn-remove-logo">Remove</button>
            </div>
          </div>
        </div>

        <!-- Visualizer Settings Grid -->
        <div class="settings-row-grid">
          
          <!-- Visualizer Style -->
          <div class="form-group">
            <label for="select-style" class="input-label">Visualizer Style</label>
            <select id="select-style" class="calc-select">
              <option value="circular" selected>Circular Spectrum Bars (Radial)</option>
              <option value="linear">Linear Waveform Spectrum (Bottom)</option>
              <option value="pulse">Glowing Radial Pulse (Ring)</option>
            </select>
          </div>

          <!-- Aspect Ratio -->
          <div class="form-group">
            <label for="select-ratio" class="input-label">Video Aspect Ratio</label>
            <select id="select-ratio" class="calc-select">
              <option value="16-9" selected>16:9 Landscape (YouTube / Desktop)</option>
              <option value="9-16">9:16 Vertical (TikTok / Reels / Shorts)</option>
              <option value="1-1">1:1 Square (Instagram / Twitter)</option>
            </select>
          </div>

        </div>

        <!-- Color Customizer Grid -->
        <div class="colors-row-grid">
          
          <!-- Visualizer Wave Color -->
          <div class="form-group">
            <label for="color-wave" class="input-label">Waveform Color</label>
            <div class="color-picker-wrap">
              <input type="color" id="color-wave" class="calc-color-input" value="#6366f1" />
              <div class="preset-colors">
                <button type="button" class="color-dot" style="background: #6366f1;" data-color="#6366f1" title="Indigo"></button>
                <button type="button" class="color-dot" style="background: #06b6d4;" data-color="#06b6d4" title="Cyan"></button>
                <button type="button" class="color-dot" style="background: #f97316;" data-color="#f97316" title="Sunset Orange"></button>
                <button type="button" class="color-dot" style="background: #10b981;" data-color="#10b981" title="Emerald Green"></button>
                <button type="button" class="color-dot" style="background: #ec4899;" data-color="#ec4899" title="Neon Pink"></button>
              </div>
            </div>
          </div>

          <!-- Background Color -->
          <div class="form-group">
            <label for="color-bg" class="input-label">Background Color</label>
            <div class="color-picker-wrap">
              <input type="color" id="color-bg" class="calc-color-input" value="#0f172a" />
              <div class="preset-colors">
                <button type="button" class="color-dot" style="background: #0f172a;" data-color="#0f172a" title="Dark Slate"></button>
                <button type="button" class="color-dot" style="background: #000000;" data-color="#000000" title="Pure Black"></button>
                <button type="button" class="color-dot" style="background: #1e1b4b;" data-color="#1e1b4b" title="Deep Indigo"></button>
                <button type="button" class="color-dot" style="background: #18181b;" data-color="#18181b" title="Charcoal"></button>
              </div>
            </div>
          </div>

        </div>

        <!-- Optional Text Overlays -->
        <div class="settings-row-grid">
          <div class="form-group">
            <label for="input-title" class="input-label">Track Title (Optional)</label>
            <input type="text" id="input-title" class="calc-text-input" placeholder="Enter episode title..." />
          </div>

          <div class="form-group">
            <label for="input-artist" class="input-label">Artist / Host (Optional)</label>
            <input type="text" id="input-artist" class="calc-text-input" placeholder="Enter podcast or show title..." />
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons-row">
          <button type="button" id="btn-toggle-preview" class="calc-btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
            </svg>
            <span id="txt-preview-btn">Play Preview</span>
          </button>
          
          <button type="button" id="btn-export-video" class="calc-btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
            Export Video (.webm)
          </button>
        </div>

      </div>

      <!-- Right Column: Live Visualizer Stage & Results -->
      <div class="calc-results">
        
        <!-- Live Visualizer Canvas Stage Card -->
        <div class="canvas-stage-card">
          <div class="stage-header">
            <span class="stage-title">Live Visualizer Preview</span>
            <span class="stage-badge" id="canvas-aspect-badge">16:9 Landscape</span>
          </div>

          <div class="canvas-viewport" id="canvas-viewport">
            <canvas id="visualizer-canvas" class="visualizer-canvas" width="1280" height="720"></canvas>
            
            <!-- Canvas Placeholder Hint before audio load -->
            <div class="canvas-placeholder" id="canvas-placeholder">
              <div class="placeholder-pulse-circle">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="placeholder-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z" />
                </svg>
              </div>
              <strong>Upload an audio track to preview visualizer</strong>
              <p>Supports MP3, WAV, M4A with animated sound frequencies</p>
            </div>
          </div>

          <audio id="audio-player" class="hidden-audio" playsinline></audio>
        </div>

        <!-- Export Recording Progress Card (Shown during recording) -->
        <div class="progress-card" id="export-progress-card" style="display: none;">
          <div class="progress-header">
            <span class="progress-title" id="progress-status-text">Recording Visualizer Video...</span>
            <span class="progress-pct" id="progress-pct-text">0%</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" id="progress-bar-fill" style="width: 0%;"></div>
          </div>
          <span class="progress-sub" id="progress-sub-text">Capturing audio and canvas frames in real time...</span>
        </div>

        <!-- Exported Video Result Card (Shown after export completes) -->
        <div class="result-card" id="export-result-card" style="display: none;">
          
          <div class="verdict-banner success-verdict">
            <span class="verdict-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon" style="display:inline-block; vertical-align:middle; color:var(--color-brand); margin-right:6px;"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m7 3 3 18"/><path d="m14 3 3 18"/><path d="M3 8.5h18"/><path d="M3 14h18"/></svg></span>
            <div class="verdict-text-wrap">
              <strong class="verdict-title">Visualizer Video Ready!</strong>
              <span class="verdict-desc">Rendered with synchronized audio and high-definition canvas graphics.</span>
            </div>
          </div>

          <!-- Video Preview Player -->
          <div class="player-wrapper">
            <video id="output-video-player" class="output-video-player" controls playsinline></video>
          </div>

          <!-- Download Action -->
          <button type="button" id="btn-download-video" class="calc-btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="btn-svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            Download Video (.webm)
          </button>

        </div>

      </div>

    </div>

  </div>

  <!-- Editorial & SEO Content Slot -->
  <div slot="about" class="editorial-content">
    <section class="editorial-section">
      
      <h2>What Is an Audio Visualizer?</h2>
      <p>
        An <strong>Audio Visualizer</strong> is a dynamic multimedia tool that translates audio signals and sound frequencies into real-time visual motion graphics. By analyzing rhythmic bass pulses, mid-range vocals, and treble frequencies, an audio visualizer animates glowing waveforms, circular frequency spectrum bars, and pulsating rings synchronized with your music or podcast audio.
      </p>
      <p>
        For digital creators, podcasters, independent musicians, and beatmakers, an <strong>audio to video generator</strong> solves a major distribution challenge: social media algorithms on YouTube, Instagram, TikTok, and Twitter prioritize video content while completely ignoring raw audio files. By converting audio into engaging visualizer videos, creators can distribute podcasts, audiobooks, songs, and voice clips across all major video platforms effortlessly.
      </p>

      <h2>How to Create an Audio Visualizer Video Online Step-by-Step</h2>
      <ol>
        <li><strong>Upload Your Audio Track:</strong> Select an MP3, WAV, or M4A audio file from your device. Our tool automatically inspects audio duration and prepares the frequency analyzer.</li>
        <li><strong>Add Center Artwork or Logo:</strong> Upload your podcast cover art, album cover, brand logo, or avatar to anchor the center of the visualizer.</li>
        <li><strong>Choose Visualizer Style & Aspect Ratio:</strong> Select between Circular Spectrum Bars, Linear Waveform Spectrum, or Glowing Radial Pulse. Pick 16:9 for YouTube, 9:16 for TikTok/Reels/Shorts, or 1:1 for Instagram feeds.</li>
        <li><strong>Customize Colors & Title:</strong> Pick custom waveform and background colors, and optionally enter your Track Title and Artist name.</li>
        <li><strong>Preview & Export:</strong> Click <strong>Play Preview</strong> to test the sound wave animations in real time. When ready, click <strong>Export Video (.webm)</strong> to record and download your video.</li>
      </ol>

      <h2>Choosing the Best Aspect Ratio: YouTube (16:9) vs TikTok/Reels (9:16) vs Instagram (1:1)</h2>
      <p>
        Formatting your video visualizer to match your target platform's native canvas ensures maximum engagement and prevents awkward black letterboxing bars:
      </p>
      <div class="table-responsive">
        <table class="editorial-table">
          <thead>
            <tr>
              <th>Aspect Ratio</th>
              <th>Pixel Dimensions</th>
              <th>Best Social Media Platforms</th>
              <th>Recommended Content Type</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>16:9 Landscape</strong></td>
              <td>1280 × 720 (HD)</td>
              <td>YouTube, Facebook Watch, LinkedIn, Website Embeds</td>
              <td>Full podcast episodes, lofi music streams, album streams</td>
            </tr>
            <tr>
              <td><strong>9:16 Vertical</strong></td>
              <td>720 × 1280 (HD)</td>
              <td>TikTok, Instagram Reels, YouTube Shorts, Snapchat</td>
              <td>Viral podcast snippets, 30-second beat previews, hooks</td>
            </tr>
            <tr>
              <td><strong>1:1 Square</strong></td>
              <td>720 × 720</td>
              <td>Instagram Feed, Twitter / X, LinkedIn Carousel</td>
              <td>Quote clips, voiceover previews, single track promos</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Podcasts, Music & Beats: How Creators Use Audiograms for Social Growth</h2>
      <p>
        Audio content alone does not get shared natively on social feeds. Turning audio into video visualizers (also known as <em>audiograms</em>) unlocks several proven growth advantages:
      </p>
      <ul>
        <li><strong>Repurposing Long-Form Podcasts:</strong> Clip out the most dramatic 30-to-60-second moment of an interview, turn it into a 9:16 vertical visualizer with our tool, and use it as a teaser reel to drive full episode listens.</li>
        <li><strong>Music Producer Beat Showcases:</strong> Beatmakers and instrumental producers use circular spectrum visualizers to showcase new instrumentals on YouTube and TikTok without needing expensive music video production.</li>
        <li><strong>Voiceover & Audiobook Teasers:</strong> Voice actors and authors share snippets of new chapter releases with moving waveforms to build pre-launch anticipation.</li>
      </ul>

      <h2>How Browser-Based Web Audio Frequency Analysis Works (100% Private)</h2>
      <p>
        Traditional video renderers require uploading your heavy audio files to remote cloud render farms, waiting in long processing queues, and risking unreleased intellectual property.
      </p>
      <p>
        Our <strong>free online audio visualizer</strong> operates 100% client-side inside your browser:
      </p>
      <p>
        When you play audio, the Web Audio API creates an <code>AnalyserNode</code> that executes a Fast Fourier Transform (FFT) on your sound data at 60 frames per second. An HTML5 canvas reads these frequency bins in real time, animating dynamic bar heights and glowing gradients. When you click Export, the browser uses the native <code>MediaRecorder</code> API to capture canvas frames and audio streams directly into a clean, web-ready video container without a single byte leaving your device.
      </p>

      <h2>Design Tips for Creating Engaging Sound Waveforms and Cover Art</h2>
      <ul>
        <li><strong>Use High-Contrast Color Schemes:</strong> Pair a dark studio background (such as deep slate <code>#0f172a</code> or charcoal <code>#18181b</code>) with neon accent waveforms (electric cyan, vibrant indigo, or warm sunset orange) to make frequency bars pop.</li>
        <li><strong>Choose High-Resolution Center Artwork:</strong> Use crisp 500×500px square cover art. Our visualizer automatically applies smooth circular masking and subtle drop shadows.</li>
        <li><strong>Keep Text Short and Legible:</strong> Add a punchy episode title or track name that clearly communicates value to scrolling viewers.</li>
      </ul>

      <h2>Why Video Visualizers Outperform Static Images on Social Media</h2>
      <p>
        Static album artwork posted on video platforms quickly gets scrolled past. Social media algorithms are engineered to measure watch time and screen motion. Dynamic sound waveforms give viewers immediate visual confirmation that audio is actively playing, significantly increasing average view duration and click-through rates.
      </p>

      <h2>Best Practices for Optimizing Audiogram Audio and Video Quality</h2>
      <p>
        Combine your visualizer workflow with our creator suite to maximize video performance:
      </p>
      <ul>
        <li>Create captivating podcast intro scripts with our <a href="/tools/podcast-intro-generator">Podcast Intro Generator</a>.</li>
        <li>Hook viewers in the first 3 seconds using viral video hooks from our <a href="/tools/tiktok-hook-generator">TikTok Hook Generator</a>.</li>
        <li>Verify thumbnail pixel sizing and social compliance with the <a href="/tools/youtube-thumbnail-size-checker">YouTube Thumbnail Size Checker</a>.</li>
        <li>Trim audio and video segments with pinpoint precision using our <a href="/tools/online-video-trimmer">Online Video Trimmer</a>.</li>
        <li>Compress finished video exports for ultra-fast web delivery using the <a href="/tools/video-compressor">Video Compressor</a>.</li>
      </ul>

      <h2>Explore More Free Creator Tools on CreatorsFeel</h2>
      <div class="internal-links-grid">
        <a href="/tools/podcast-intro-generator" class="tool-link-card glass">
          <div class="tool-link-title">Podcast Intro Generator</div>
          <div class="tool-link-desc">Create catchy podcast intro voiceover scripts with sound cues and tone selectors.</div>
        </a>
        <a href="/tools/tiktok-hook-generator" class="tool-link-card glass">
          <div class="tool-link-title">TikTok Hook Generator</div>
          <div class="tool-link-desc">Generate high-retention opening hooks for short-form viral videos and reels.</div>
        </a>
        <a href="/tools/youtube-thumbnail-size-checker" class="tool-link-card glass">
          <div class="tool-link-title">YouTube Thumbnail Size Checker</div>
          <div class="tool-link-desc">Audit thumbnail resolution (1280x720), 16:9 ratio, and 2 MB file size limit.</div>
        </a>
        <a href="/tools/online-video-trimmer" class="tool-link-card glass">
          <div class="tool-link-title">Online Video Trimmer</div>
          <div class="tool-link-desc">Trim, cut, and clip video start and end points with 100% browser-side privacy.</div>
        </a>
        <a href="/tools/video-compressor" class="tool-link-card glass">
          <div class="tool-link-title">Video Compressor</div>
          <div class="tool-link-desc">Compress video files directly in your browser with zero quality loss.</div>
        </a>
      </div>

    </section>
  </div>
</ToolLayout>

<style>
  /* Base Card Container */
  .calc-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    max-width: 100%;
    box-sizing: border-box;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 992px) {
    .calc-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }

  /* Left Form & Controls */
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
  }

  .input-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  /* Dropzone Boxes */
  .dropzone-box {
    min-height: 100px;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    position: relative;
    transition: all var(--transition-fast);
    box-sizing: border-box;
  }

  .dropzone-box:hover {
    border-color: var(--color-brand);
    background: rgba(99, 102, 241, 0.04);
  }

  .file-hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .dropzone-idle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .dropzone-icon-wrap {
    width: 36px;

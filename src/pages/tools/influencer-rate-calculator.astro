  /* Responsive Rules */
  @media (min-width: 768px) {
    .calc-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>

<script>
  const setupCalculator = () => {
    const submitBtn = document.getElementById('calc-submit');
    if (!submitBtn) return;

    const emptyState = document.getElementById('results-empty');
    const contentState = document.getElementById('results-content');
    
    // Outputs
    const resRange = document.getElementById('res-range');
    const resMedian = document.getElementById('res-median');
    const resCpm = document.getElementById('res-cpm');
    const resTier = document.getElementById('res-tier');
    const resPitch = document.getElementById('res-pitch') as HTMLTextAreaElement;
    const copyBtn = document.getElementById('copy-pitch-btn');

    // Niche multipliers
    const nicheMultipliers: Record<string, number> = {
      lifestyle: 1.0,
      tech: 1.6,
      finance: 1.8,
      fitness: 1.2,
      gaming: 0.9,
      travel: 1.3,
      business: 1.5,
      beauty: 1.1
    };

    // Format multipliers
    const formatMultipliers: Record<string, number> = {
      post: 1.0,
      story: 0.5,
      reel: 1.4,
      dedicated: 2.2
    };

    submitBtn.addEventListener('click', () => {
      // Inputs
      const platformSelect = document.getElementById('platform') as HTMLSelectElement;
      const followersInput = document.getElementById('followers') as HTMLInputElement;
      const engagementInput = document.getElementById('engagement') as HTMLInputElement;
      const nicheSelect = document.getElementById('niche') as HTMLSelectElement;
      const formatSelect = document.getElementById('format') as HTMLSelectElement;

      const platform = platformSelect.value;
      const followers = parseFloat(followersInput.value);
      const engagement = parseFloat(engagementInput.value);
      const niche = nicheSelect.value;
      const format = formatSelect.value;

      if (!followers || !engagement) {
        alert("Please fill out follower counts and post engagement values.");
        return;
      }

      // Base Rates calculation
      let baseRate = 0;
      if (platform === 'instagram') {
        // IG base: roughly $10 per 1k followers
        baseRate = followers * 0.01;
      } else if (platform === 'tiktok') {
        // TikTok base: roughly $6 per 1k followers
        baseRate = followers * 0.006;
      } else if (platform === 'youtube') {
        // YT base is highly view-dependent, base on views: $25 per 1k views
        baseRate = engagement * 0.025;
      }

      // Adjust based on multipliers
      const nMult = nicheMultipliers[niche] || 1.0;
      const fMult = formatMultipliers[format] || 1.0;

      // Engagement adjustments
      let eMult = 1.0;
      if (platform === 'instagram' || platform === 'tiktok') {
        // calculate engagement percentage
        const engRate = (engagement / followers) * 100;
        const avgEng = platform === 'instagram' ? 2.5 : 4.0;
        
        if (engRate > avgEng) {
          eMult = Math.min(1.5, 1.0 + (engRate - avgEng) * 0.1);
        } else {
          eMult = Math.max(0.6, 1.0 - (avgEng - engRate) * 0.15);
        }
      } else {
        // YouTube: view/follower health
        const viewRatio = engagement / followers;
        if (viewRatio > 0.15) {
          eMult = Math.min(1.5, 1.0 + (viewRatio - 0.15) * 2);
        } else {
          eMult = Math.max(0.6, 1.0 - (0.15 - viewRatio) * 3);
        }
      }

      // Calculate final rate
      const finalRate = baseRate * nMult * fMult * eMult;
      
      const lowRange = Math.round(finalRate * 0.8);
      const highRange = Math.round(finalRate * 1.25);
      const medianRate = Math.round(finalRate);

      // Tier detection
      let tier = "Nano";
      if (followers >= 1000000) tier = "Mega / Elite";
      else if (followers >= 100000) tier = "Macro";
      else if (followers >= 50000) tier = "Mid-tier";
      else if (followers >= 10000) tier = "Micro";

      // CPM calculation (rate per 1k views or followers)
      const denominator = platform === 'youtube' ? engagement : followers;
      const cpm = denominator > 0 ? (medianRate / denominator) * 1000 : 0;

      // Update UI
      if (resRange) resRange.textContent = `$${lowRange.toLocaleString()} - $${highRange.toLocaleString()}`;
      if (resMedian) resMedian.textContent = `$${medianRate.toLocaleString()}`;
      if (resCpm) resCpm.textContent = `$${cpm.toFixed(2)}`;
      if (resTier) resTier.textContent = tier;

      // Pitch Template Generation
      const nicheName = nicheSelect.options[nicheSelect.selectedIndex].text.split('(')[0].trim();
      const formatName = formatSelect.options[formatSelect.selectedIndex].text.split('(')[0].trim();
      
      let pitchText = `Hi [Brand Manager Name],

I hope you're having a great week!

My name is [Your Name], and I'm a content creator in the ${nicheName} space on ${platform.charAt(0).toUpperCase() + platform.slice(1)}, where I have built a dedicated community of ${followers.toLocaleString()} followers.

I've been following [Brand Name] and love your recent campaign for [Product/Event]. My audience is highly engaged with topics regarding ${nicheName.toLowerCase()}, and I see a perfect fit for a collaboration. For reference, my posts average ${engagement.toLocaleString()} ${platform === 'youtube' ? 'views' : 'engagements'} per piece, yielding high-impact conversions.

I would love to pitch a collaboration featuring a ${formatName.toLowerCase()} on my channel.

Let me know if you would like me to send over my complete media kit. Looking forward to discussing how we can work together!

Best regards,
[Your Name]
[Your Social Link]`;

      if (resPitch) resPitch.value = pitchText;

      // Show Results
      if (emptyState) emptyState.classList.add('hidden');
      if (contentState) contentState.classList.remove('hidden');

      // Scroll to Results
      setTimeout(() => {
        const resultsBox = document.getElementById('results-container');
        if (resultsBox) {
          const headerOffset = 90;
          const elementPosition = resultsBox.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      }, 50);
    });

    if (copyBtn && resPitch) {
      copyBtn.addEventListener('click', () => {
        resPitch.select();
        navigator.clipboard.writeText(resPitch.value)
          .then(() => {
            const originalText = copyBtn.textContent;
            copyBtn.textContent = "Copied!";
            copyBtn.style.backgroundColor = "var(--color-success)";
            setTimeout(() => {
              copyBtn.textContent = originalText;
              copyBtn.style.backgroundColor = "";
            }, 2000);
          })
          .catch(() => {
            alert("Failed to copy text. Please select and copy manually.");
          });
      });
    }
  };

  setupCalculator();
  document.addEventListener('astro:after-swap', setupCalculator);
</script>

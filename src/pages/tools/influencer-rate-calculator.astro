</style>

<script>
  interface FormatItem {
    value: string;
    label: string;
  }

  const FORMAT_OPTIONS: Record<string, FormatItem[]> = {
    instagram: [
      { value: 'reel', label: 'Instagram Reel (Short-Form Video)' },
      { value: 'post', label: 'Static Feed Post (Single Photo)' },
      { value: 'carousel', label: 'Carousel Post (Multi-Slide)' },
      { value: 'story', label: 'Story Set (3 Frames with Link)' }
    ],
    tiktok: [
      { value: 'video', label: 'TikTok Video (30–60 Seconds)' },
      { value: 'series', label: 'Multi-Video Series (2+ Parts)' }
    ],
    youtube: [
      { value: 'dedicated', label: 'Dedicated Video (Full Review)' },
      { value: 'integration', label: 'Integrated Mid-Roll (60–90s)' },
      { value: 'short', label: 'YouTube Short (Vertical Video)' }
    ]
  };

  const setupCalculator = () => {
    let currentPlatform = 'instagram';

    // Interactive elements
    const platformButtons = document.querySelectorAll('.platform-tab');
    const followersInput = document.getElementById('calc-followers') as HTMLInputElement | null;
    const formatSelect = document.getElementById('calc-content-type') as HTMLSelectElement | null;
    const viewsInput = document.getElementById('calc-views') as HTMLInputElement | null;
    const btnReset = document.getElementById('btn-reset-form');
    const btnCopyRates = document.getElementById('btn-copy-rates');

    // Dynamic Labels
    const labelFollowersText = document.getElementById('label-followers-text');
    const labelViewsText = document.getElementById('label-views-text');
    const descFollowers = document.getElementById('desc-followers');

    // Result Containers
    const resultsEmpty = document.getElementById('results-empty');
    const resultsActive = document.getElementById('results-active');

    // Result Displays
    const badgePlatformName = document.getElementById('badge-platform-name');
    const badgeFormatName = document.getElementById('badge-format-name');
    const badgeCreatorTier = document.getElementById('badge-creator-tier');

    const valMinRate = document.getElementById('val-min-rate');
    const valRecRate = document.getElementById('val-rec-rate');
    const valMaxRate = document.getElementById('val-max-rate');

    const resExplanationText = document.getElementById('res-explanation-text');

    if (!followersInput || !formatSelect) return;

    // Populate format dropdown
    const updateFormatDropdown = (platform: string) => {
      formatSelect.innerHTML = '';
      const options = FORMAT_OPTIONS[platform] || FORMAT_OPTIONS.instagram;
      options.forEach(opt => {
        const optionEl = document.createElement('option');
        optionEl.value = opt.value;
        optionEl.textContent = opt.label;
        formatSelect.appendChild(optionEl);
      });
    };

    // Update dynamic labels
    const updatePlatformLabels = (platform: string) => {
      if (platform === 'youtube') {
        if (labelFollowersText) labelFollowersText.textContent = 'Subscriber Count';
        if (labelViewsText) labelViewsText.textContent = 'Average Video Views';
        if (descFollowers) descFollowers.textContent = 'Total YouTube channel subscribers.';
        followersInput.placeholder = 'Enter subscribers';
      } else {
        if (labelFollowersText) labelFollowersText.textContent = 'Follower Count';
        if (labelViewsText) labelViewsText.textContent = 'Average Views (Optional)';
        if (descFollowers) descFollowers.textContent = `Total ${platform === 'tiktok' ? 'TikTok' : 'Instagram'} followers.`;
        followersInput.placeholder = 'Enter followers';
      }
    };

    // Calculate rates
    const calculateRates = () => {
      const followersRaw = parseFloat(followersInput.value);
      const viewsRaw = viewsInput ? parseFloat(viewsInput.value) : 0;

      // Validate inputs
      const followers = isNaN(followersRaw) ? 0 : Math.max(0, followersRaw);
      const views = isNaN(viewsRaw) ? 0 : Math.max(0, viewsRaw);

      if (followers <= 0) {
        if (resultsEmpty) resultsEmpty.classList.remove('hidden');
        if (resultsActive) resultsActive.classList.add('hidden');
        return;
      }

      if (resultsEmpty) resultsEmpty.classList.add('hidden');
      if (resultsActive) resultsActive.classList.remove('hidden');

      const formatVal = formatSelect.value;
      let calculatedRate = 0;

      // Platform specific calculation models
      if (currentPlatform === 'instagram') {
        let basePerK = 11; // Static post baseline: $11/1k followers
        if (formatVal === 'reel') basePerK = 15;
        else if (formatVal === 'carousel') basePerK = 13;
        else if (formatVal === 'story') basePerK = 5.5;

        if (views > 0 && formatVal === 'reel') {
          // Blend 50% follower rate + 50% view CPM ($35 CPM on Reel views)
          const followerShare = (followers / 1000) * basePerK;
          const viewShare = (views / 1000) * 35;
          calculatedRate = (followerShare * 0.5) + (viewShare * 0.5);
        } else {
          calculatedRate = (followers / 1000) * basePerK;
        }

        // Project floor
        const floor = formatVal === 'story' ? 25 : 45;
        calculatedRate = Math.max(floor, calculatedRate);

      } else if (currentPlatform === 'tiktok') {
        let basePerK = 8; // Single video baseline: $8/1k followers
        if (formatVal === 'series') basePerK = 15;

        if (views > 0) {
          // Blend 50% follower rate + 50% view CPM ($22 CPM on TikTok views)
          const followerShare = (followers / 1000) * basePerK;
          const viewShare = (views / 1000) * 22;
          calculatedRate = (followerShare * 0.5) + (viewShare * 0.5);
        } else {
          calculatedRate = (followers / 1000) * basePerK;
        }

        calculatedRate = Math.max(40, calculatedRate);

      } else if (currentPlatform === 'youtube') {
        // YouTube CPM model
        let cpmRate = 35; // Integrated mid-roll
        if (formatVal === 'dedicated') cpmRate = 75;
        else if (formatVal === 'short') cpmRate = 20;

        if (views > 0) {
          calculatedRate = (views / 1000) * cpmRate;
        } else {
          // If no views entered, assume healthy 10% view-ratio of subscribers
          const estimatedViews = followers * 0.10;
          calculatedRate = (estimatedViews / 1000) * cpmRate;
        }

        const floor = formatVal === 'short' ? 60 : 120;
        calculatedRate = Math.max(floor, calculatedRate);
      }

      // Audience Tier Dampening for high numbers (>100K, >500K)
      if (followers > 500000) {
        const factor = Math.pow(followers / 500000, 0.90);
        calculatedRate = (calculatedRate / (followers / 500000)) * factor;
      } else if (followers > 100000) {
        const factor = Math.pow(followers / 100000, 0.95);
        calculatedRate = (calculatedRate / (followers / 100000)) * factor;
      }

      // Round calculations
      const recommended = Math.round(calculatedRate);
      const minimum = Math.round(recommended * 0.75);
      const premium = Math.round(recommended * 1.30);

      // Determine Creator Tier
      let tier = 'Nano-Creator';
      if (followers >= 1000000) tier = 'Mega / Celebrity';
      else if (followers >= 500000) tier = 'Macro-Creator';
      else if (followers >= 50000) tier = 'Mid-Tier Creator';
      else if (followers >= 10000) tier = 'Micro-Creator';

      // Format names for display
      const platformDisplay = currentPlatform === 'tiktok' ? 'TikTok' : currentPlatform === 'youtube' ? 'YouTube' : 'Instagram';
      const selectedOption = formatSelect.options[formatSelect.selectedIndex];
      const formatDisplay = selectedOption ? selectedOption.text.split('(')[0].trim() : 'Post';

      // Update UI numbers
      if (valMinRate) valMinRate.textContent = `$${minimum.toLocaleString()}`;
      if (valRecRate) valRecRate.textContent = `$${recommended.toLocaleString()}`;
      if (valMaxRate) valMaxRate.textContent = `$${premium.toLocaleString()}`;

      // Update UI badges
      if (badgePlatformName) badgePlatformName.textContent = platformDisplay;
      if (badgeFormatName) badgeFormatName.textContent = formatDisplay;
      if (badgeCreatorTier) badgeCreatorTier.textContent = tier;

      // Update Explanation sentence
      if (resExplanationText) {
        const audienceMetricName = currentPlatform === 'youtube' ? 'subscribers' : 'followers';
        const viewsSnippet = views > 0 ? ` and <strong>${views.toLocaleString()} average views</strong>` : '';
        resExplanationText.innerHTML = `Estimated sponsorship rate for an <strong>${platformDisplay} ${formatDisplay}</strong> with <strong>${followers.toLocaleString()} ${audienceMetricName}</strong>${viewsSnippet}.`;
      }
    };

    // Platform switcher tab click handlers
    platformButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        platformButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        currentPlatform = (btn as HTMLElement).dataset.platform || 'instagram';
        updateFormatDropdown(currentPlatform);
        updatePlatformLabels(currentPlatform);
        calculateRates();
      });
    });

    // Real-time input listeners
    [followersInput, viewsInput].forEach(inp => {
      if (inp) {
        inp.addEventListener('input', calculateRates);
        inp.addEventListener('change', calculateRates);
      }
    });

    if (formatSelect) {
      formatSelect.addEventListener('change', calculateRates);
    }

    // Reset button handler
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        followersInput.value = '25000';
        if (viewsInput) viewsInput.value = '4500';

        // Reset to Instagram
        platformButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        const igBtn = document.querySelector('[data-platform="instagram"]');
        if (igBtn) {
          igBtn.classList.add('active');
          igBtn.setAttribute('aria-pressed', 'true');
        }

        currentPlatform = 'instagram';
        updateFormatDropdown('instagram');
        updatePlatformLabels('instagram');
        calculateRates();
      });
    }

    // Copy rates handler
    if (btnCopyRates) {
      btnCopyRates.addEventListener('click', () => {
        const platformDisplay = currentPlatform === 'tiktok' ? 'TikTok' : currentPlatform === 'youtube' ? 'YouTube' : 'Instagram';
        const selectedOption = formatSelect.options[formatSelect.selectedIndex];
        const formatDisplay = selectedOption ? selectedOption.text.split('(')[0].trim() : 'Post';
        const followers = parseInt(followersInput.value || '0', 10).toLocaleString();
        const minRate = valMinRate?.textContent || '$0';
        const recRate = valRecRate?.textContent || '$0';
        const maxRate = valMaxRate?.textContent || '$0';

        const copyText = `${platformDisplay} ${formatDisplay} Sponsorship Rates:
• Audience: ${followers} ${currentPlatform === 'youtube' ? 'Subscribers' : 'Followers'}
• Recommended Rate: ${recRate}
• Minimum Floor: ${minRate}
• Premium Rate: ${maxRate}

Estimated via CreatorsFeel Influencer Rate Calculator: https://creatorsfeel.com/tools/influencer-rate-calculator`;

        navigator.clipboard.writeText(copyText).then(() => {
          const label = document.getElementById('copy-rates-label');
          if (label) label.textContent = 'Copied to Clipboard!';
          btnCopyRates.style.borderColor = '#10b981';
          btnCopyRates.style.color = '#10b981';

          setTimeout(() => {
            if (label) label.textContent = 'Copy Estimated Rates';
            btnCopyRates.style.borderColor = '';
            btnCopyRates.style.color = '';
          }, 2000);
        });
      });
    }

    // Initial run
    updateFormatDropdown('instagram');
    updatePlatformLabels('instagram');
    calculateRates();
  };

  setupCalculator();
  document.addEventListener('astro:after-swap', setupCalculator);
</script>

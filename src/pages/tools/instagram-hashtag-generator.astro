</style>

<script>
  // Fallback curated taxonomy for purely offline or static mode
  const CLIENT_TAXONOMY: Record<string, { broad: string[]; niche: string[] }> = {
    fashion: {
      broad: ['fashion', 'style', 'ootd', 'fashionblogger', 'instafashion', 'streetwear', 'outfitoftheday', 'fashionstyle', 'stylish', 'lookbook'],
      niche: ['sustainablefashion', 'capsulewardrobe', 'minimaliststyle', 'thriftedfashion', 'outfitinspo', 'aestheticfashion', 'vintagestreetwear', 'mensstyleguide', 'parisianchic', 'consciousfashion']
    },
    beauty: {
      broad: ['beauty', 'skincare', 'makeup', 'beautytips', 'instabeauty', 'makeuplover', 'skincareroutine', 'cosmetics', 'glam', 'makeupartist'],
      niche: ['cleanbeauty', 'kbeauty', 'skincarecommunity', 'glowingskin', 'crueltyfreebeauty', 'dewymakeup', 'glassskin', 'skincareaddict', 'barrierrepair', 'cleangirlaesthetic']
    },
    travel: {
      broad: ['travel', 'wanderlust', 'travelgram', 'instatravel', 'travelblogger', 'adventure', 'explore', 'vacation', 'holiday', 'tourism'],
      niche: ['solotravel', 'hiddenplaces', 'slowtravel', 'travelcouples', 'backpackerlife', 'budgettravel', 'offthebeatenpath', 'natureescapes', 'femaletraveler', 'postcardsfromtheworld']
    },
    food: {
      broad: ['food', 'foodie', 'foodporn', 'instafood', 'foodphotography', 'delicious', 'yummy', 'dinner', 'homemade', 'cooking'],
      niche: ['homemadecooking', 'plantbasedrecipes', 'sourdoughbread', 'easyweeknightmeals', 'mealprepsunday', 'comfortfoodie', 'cleaneatingrecipes', 'bakersofig', 'quickrecipes', 'feedfeed']
    },
    fitness: {
      broad: ['fitness', 'gym', 'workout', 'fit', 'fitnessmotivation', 'bodybuilding', 'training', 'fitfam', 'health', 'lifestyle'],
      niche: ['calisthenicsworkout', 'hyroxcommunity', 'mobilityroutine', 'strengthtraining', 'mindfulmovement', 'pilatesinstructor', 'runningcommunity', 'progressiveoverload', 'homegymlife', 'functionalfitness']
    },
    photography: {
      broad: ['photography', 'photooftheday', 'photographer', 'picoftheday', 'portrait', 'streetphotography', 'landscape', 'naturephotography', 'photoshoot', 'art'],
      niche: ['moodyports', 'filmisnotdead', 'goldenhourphotography', 'urbanstreetview', 'sonyalpha', 'fujifilmx', 'visualsofearth', 'visualstoryteller', 'cinematicphotography', 'analoguevibes']
    },
    technology: {
      broad: ['technology', 'tech', 'innovation', 'gadgets', 'programming', 'coding', 'developer', 'artificialintelligence', 'software', 'techtrends'],
      niche: ['saasgrowth', 'webdevcommunity', 'indiemaker', 'desksetupinspo', 'techtipsdaily', 'softwareengineer', 'aiartcommunity', 'buildinpublic', 'cleanarchitecture', 'technewsfeed']
    },
    business: {
      broad: ['business', 'entrepreneur', 'marketing', 'success', 'smallbusiness', 'startup', 'leadership', 'motivation', 'money', 'businessowner'],
      niche: ['digitalmarketingtips', 'freelancehustle', 'brandstrategy', 'contentcreationtips', 'solopreneurlife', 'smallbusinessgrowth', 'organicmarketing', 'creatoreconomy', 'inboundmarketing', 'socialmediastrategy']
    },
    education: {
      broad: ['education', 'learning', 'knowledge', 'study', 'motivation', 'student', 'studygram', 'facts', 'school', 'learn'],
      niche: ['studytips', 'lifelonglearning', 'notetakingaesthetic', 'languagelearning', 'productivityhacks', 'academicstudy', 'onlinecoursecreator', 'careeradvice', 'skillbuilding', 'digitalnote']
    },
    lifestyle: {
      broad: ['lifestyle', 'life', 'motivation', 'inspiration', 'mindset', 'happy', 'selfcare', 'dailylife', 'positivity', 'wellness'],
      niche: ['slowliving', 'morningroutine', 'wellnessjourney', 'intentionalcommunity', 'mindfulnesspractice', 'homedecorinspo', 'simpleliving', 'journalingcommunity', 'habittracker', 'cozyvibes']
    },
    other: {
      broad: ['instagram', 'creator', 'content', 'community', 'trending', 'explorepage', 'reels', 'creative', 'viral', 'instadaily'],
      niche: ['contentcreators', 'creatorsfeel', 'instadaily', 'digitalcreator', 'creativeprocess', 'reelsoftheday', 'visualcontent', 'aestheticfeed', 'explorepageviral', 'communitybuilding']
    }
  };

  const STOPWORDS_SET = new Set([
    'the','and','a','to','of','in','for','with','on','at','from','by','about','as',
    'into','like','through','after','over','between','out','against','during','without',
    'before','under','around','among','this','that','these','those','my','your','our',
    'their','his','her','its','is','am','are','was','were','be','been','being','have',
    'has','had','do','does','did','will','would','shall','should','may','might','must',
    'can','could','new','best','great','more','most','other','some','such','no','nor',
    'not','only','own','same','so','than','too','very','just','really','photo','reel',
    'video','post','content','instagram','image','pic'
  ]);

  function cleanStringTag(str: string): string {
    return str.replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
  }

  function extractUserKeywords(text: string): string[] {
    if (!text) return [];
    const words = text
      .toLowerCase()
      .replace(/[^a-z0-9\s]/g, ' ')
      .split(/\s+/)
      .filter(w => w.length >= 3 && !STOPWORDS_SET.has(w));
    return Array.from(new Set(words));
  }

  interface TagItem {
    name: string;
    countText: string;
    isLive: boolean;
    tier: 'broad' | 'niche' | 'specific';
  }

  function clientFallbackGenerator(description: string, keyword: string, category: string, targetCount: number) {
    const normCat = (category || 'lifestyle').toLowerCase();
    const tax = CLIENT_TAXONOMY[normCat] || CLIENT_TAXONOMY.other;
    
    const fullText = `${keyword} ${description}`.trim();
    const tokens = extractUserKeywords(fullText);

    const specificSet = new Set<string>();
    tokens.forEach(t => {
      const c = cleanStringTag(t);
      if (c.length >= 3) {
        specificSet.add(c);
        specificSet.add(`${c}inspo`);
      }
    });

    for (let i = 0; i < tokens.length - 1 && i < 3; i++) {
      const pair = cleanStringTag(tokens[i] + tokens[i + 1]);
      if (pair.length <= 25) specificSet.add(pair);
    }

    if (tokens.length > 0 && normCat !== 'other') {
      const first = cleanStringTag(tokens[0]);
      specificSet.add(cleanStringTag(`${normCat}${first}`));
      specificSet.add(cleanStringTag(`${first}daily`));
    }

    const broadCount = Math.max(1, Math.round(targetCount * 0.3));
    const specificCount = Math.max(2, Math.round(targetCount * 0.35));
    const nicheCount = Math.max(2, targetCount - broadCount - specificCount);

    const broad: TagItem[] = tax.broad.slice(0, broadCount).map(t => ({
      name: `#${cleanStringTag(t)}`,
      countText: 'High Reach (1M+)',
      isLive: false,
      tier: 'broad'
    }));

    const niche: TagItem[] = tax.niche.slice(0, nicheCount).map(t => ({
      name: `#${cleanStringTag(t)}`,
      countText: 'Targeted Niche (50K–1M)',
      isLive: false,
      tier: 'niche'
    }));

    const specArr = Array.from(specificSet);
    let finalSpec = specArr.slice(0, specificCount);
    if (finalSpec.length < specificCount) {
      const extra = tax.niche.slice(nicheCount);
      finalSpec = finalSpec.concat(extra.slice(0, specificCount - finalSpec.length));
    }

    const specific: TagItem[] = finalSpec.map(t => ({
      name: `#${cleanStringTag(t)}`,
      countText: 'Content Specific (<50K)',
      isLive: false,
      tier: 'specific'
    }));

    return {
      success: true,
      isLive: false,
      source: 'Curated Knowledge Base (Client-Side Fallback)',
      notice: 'Live SandBase API endpoint is in fallback mode. Showing verified curated suggestions.',
      broad,
      niche,
      specific
    };
  }

  function initHashtagGenerator() {
    const form = document.getElementById('hashtag-generator-form') as HTMLFormElement | null;
    const descInput = document.getElementById('post-description-input') as HTMLTextAreaElement | null;
    const keyInput = document.getElementById('main-keyword-input') as HTMLInputElement | null;
    const catSelect = document.getElementById('category-select') as HTMLSelectElement | null;
    const generateBtn = document.getElementById('btn-generate-tags') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('btn-reset-form') as HTMLButtonElement | null;
    const countBtns = document.querySelectorAll('.count-pill-btn');

    const loadingBox = document.getElementById('generator-loading-box');
    const loadingMessage = document.getElementById('loading-status-message');
    const errorBanner = document.getElementById('generator-error-banner');
    const errorDesc = document.getElementById('error-banner-desc');
    const resultsContainer = document.getElementById('generator-results-container');
    const originCard = document.getElementById('data-origin-notice');
    const originTitle = document.getElementById('origin-notice-title');
    const originDesc = document.getElementById('origin-notice-desc');
    const statusText = document.getElementById('data-status-text');

    const gridBroad = document.getElementById('chips-grid-broad');
    const gridNiche = document.getElementById('chips-grid-niche');
    const gridSpecific = document.getElementById('chips-grid-specific');

    const selectionCounter = document.getElementById('selection-counter');
    const exportTextarea = document.getElementById('copy-ready-textarea') as HTMLTextAreaElement | null;
    const exportCount = document.getElementById('export-count-label');

    const btnSelectAll = document.getElementById('btn-select-all');
    const btnClearSelection = document.getElementById('btn-clear-selection');
    const btnRegenerate = document.getElementById('btn-regenerate');
    const btnCopySelected = document.getElementById('btn-copy-selected');
    const btnCopyAll = document.getElementById('btn-copy-all');
    const copyToast = document.getElementById('copy-toast-banner');
    const copyToastMsg = document.getElementById('copy-toast-message');

    if (!form || !descInput) return;

    let selectedCount = 15;
    let currentTags: TagItem[] = [];
    let selectedSet: Set<string> = new Set();
    let toastTimeout: any = null;

    // Count selector pills
    countBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        countBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedCount = parseInt(btn.getAttribute('data-count') || '15', 10);
      });
    });

    function showError(msg: string) {
      if (errorDesc) errorDesc.textContent = msg;
      errorBanner?.classList.remove('hidden');
      resultsContainer?.classList.add('hidden');
      loadingBox?.classList.add('hidden');
    }

    function hideError() {
      errorBanner?.classList.add('hidden');
    }

    function showToast(msg: string) {
      if (copyToastMsg) copyToastMsg.textContent = msg;
      copyToast?.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        copyToast?.classList.add('hidden');
      }, 3000);
    }

    function updateExportView() {
      const selectedList = currentTags.filter(t => selectedSet.has(t.name)).map(t => t.name);
      const text = selectedList.join(' ');
      if (exportTextarea) exportTextarea.value = text;
      
      const count = selectedList.length;
      if (selectionCounter) selectionCounter.textContent = `${count} of ${currentTags.length} Selected`;
      if (exportCount) exportCount.textContent = `${count} ${count === 1 ? 'tag' : 'tags'} selected`;
    }

    function renderTagChip(tag: TagItem): HTMLElement {
      const chip = document.createElement('div');
      chip.className = `tag-chip-card ${selectedSet.has(tag.name) ? 'selected' : ''}`;
      chip.setAttribute('role', 'checkbox');
      chip.setAttribute('aria-checked', selectedSet.has(tag.name) ? 'true' : 'false');
      chip.setAttribute('tabindex', '0');

      chip.innerHTML = `
        <div class="tag-chip-checkbox">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="tag-chip-check-svg" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <span class="tag-chip-name">${tag.name}</span>
        <span class="tag-chip-count">${tag.countText}</span>
      `;

      chip.addEventListener('click', () => {
        if (selectedSet.has(tag.name)) {
          selectedSet.delete(tag.name);
          chip.classList.remove('selected');
          chip.setAttribute('aria-checked', 'false');
        } else {
          selectedSet.add(tag.name);
          chip.classList.add('selected');
          chip.setAttribute('aria-checked', 'true');
        }
        updateExportView();
      });

      chip.addEventListener('keydown', (e) => {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          chip.click();
        }
      });

      return chip;
    }

    function renderResults(data: any) {
      const broad: TagItem[] = data.broad || [];
      const niche: TagItem[] = data.niche || [];
      const specific: TagItem[] = data.specific || [];

      currentTags = [...broad, ...niche, ...specific];
      // Select all by default
      selectedSet = new Set(currentTags.map(t => t.name));

      // Clear existing chips
      if (gridBroad) gridBroad.innerHTML = '';
      if (gridNiche) gridNiche.innerHTML = '';
      if (gridSpecific) gridSpecific.innerHTML = '';

      broad.forEach(t => gridBroad?.appendChild(renderTagChip(t)));
      niche.forEach(t => gridNiche?.appendChild(renderTagChip(t)));
      specific.forEach(t => gridSpecific?.appendChild(renderTagChip(t)));

      // Data origin notice
      originCard?.classList.remove('hidden');
      if (data.isLive) {
        if (originTitle) originTitle.textContent = 'SandBase Live Public Instagram Data';
        if (originDesc) originDesc.textContent = 'Hashtags and media counts reflect verified live Instagram public query results.';
        if (statusText) statusText.textContent = 'Live SandBase API Data';
      } else {
        if (originTitle) originTitle.textContent = 'Curated Semantic Taxonomy';
        if (originDesc) originDesc.textContent = data.notice || 'Hashtags are matched using domain-specific category taxonomy and keyword parsing.';
        if (statusText) statusText.textContent = 'Curated Fallback Engine';
      }

      updateExportView();
      resultsContainer?.classList.remove('hidden');
      loadingBox?.classList.add('hidden');
    }

    async function executeGeneration() {
      hideError();
      const desc = descInput?.value.trim() || '';
      const kw = keyInput?.value.trim() || '';
      const cat = catSelect?.value || 'lifestyle';

      if (!desc && !kw) {
        showError('Please provide a post description or main keyword to generate hashtags.');
        return;
      }

      if (generateBtn) generateBtn.disabled = true;
      loadingBox?.classList.remove('hidden');
      resultsContainer?.classList.add('hidden');
      if (loadingMessage) loadingMessage.textContent = 'Extracting keywords and consulting Instagram hashtag endpoints...';

      try {
        // Attempt fetch from /api/instagram-hashtags (Cloudflare Pages Function)
        const response = await fetch('/api/instagram-hashtags', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            description: desc,
            keyword: kw,
            category: cat,
            count: selectedCount
          })
        }).catch(() => null);

        if (response && response.ok) {
          const apiData = await response.json();
          if (apiData && apiData.success) {
            renderResults(apiData);
            return;
          }
        }

        // Seamless client-side fallback if server endpoint is unreachable (e.g. offline or static preview)
        const fallbackData = clientFallbackGenerator(desc, kw, cat, selectedCount);
        renderResults(fallbackData);

      } catch (err: any) {
        // Fallback to client generator on network error
        const fallbackData = clientFallbackGenerator(desc, kw, cat, selectedCount);
        renderResults(fallbackData);
      } finally {
        if (generateBtn) generateBtn.disabled = false;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      executeGeneration();
    });

    btnRegenerate?.addEventListener('click', executeGeneration);

    // Select All
    btnSelectAll?.addEventListener('click', () => {
      currentTags.forEach(t => selectedSet.add(t.name));
      document.querySelectorAll('.tag-chip-card').forEach(c => {
        c.classList.add('selected');
        c.setAttribute('aria-checked', 'true');
      });
      updateExportView();
    });

    // Clear Selection
    btnClearSelection?.addEventListener('click', () => {
      selectedSet.clear();
      document.querySelectorAll('.tag-chip-card').forEach(c => {
        c.classList.remove('selected');
        c.setAttribute('aria-checked', 'false');
      });
      updateExportView();
    });

    // Copy Selected
    btnCopySelected?.addEventListener('click', async () => {
      const selectedList = currentTags.filter(t => selectedSet.has(t.name)).map(t => t.name);
      if (selectedList.length === 0) {
        showToast('Please select at least one hashtag to copy.');
        return;
      }
      const text = selectedList.join(' ');
      try {
        await navigator.clipboard.writeText(text);
        showToast(`Copied ${selectedList.length} hashtags to clipboard!`);
      } catch (_) {
        if (exportTextarea) {
          exportTextarea.select();
          document.execCommand('copy');
          showToast(`Copied ${selectedList.length} hashtags to clipboard!`);
        }
      }
    });

    // Copy All
    btnCopyAll?.addEventListener('click', async () => {
      const allList = currentTags.map(t => t.name);
      if (allList.length === 0) return;
      const text = allList.join(' ');
      try {
        await navigator.clipboard.writeText(text);
        showToast(`Copied all ${allList.length} hashtags to clipboard!`);
      } catch (_) {
        if (exportTextarea) {
          exportTextarea.value = text;
          exportTextarea.select();
          document.execCommand('copy');
          showToast(`Copied all ${allList.length} hashtags to clipboard!`);
        }
      }
    });

    // Reset Form
    resetBtn?.addEventListener('click', () => {
      hideError();
      form.reset();
      resultsContainer?.classList.add('hidden');
      originCard?.classList.add('hidden');
      loadingBox?.classList.add('hidden');
      if (statusText) statusText.textContent = 'Ready for Research';
      currentTags = [];
      selectedSet.clear();
    });
  }

  initHashtagGenerator();
  document.addEventListener('astro:after-swap', initHashtagGenerator);
</script>

---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faqs = [
  {
    question: "How does a Brand Deal Calculator estimate sponsorship pricing?",
    answer: "A brand deal calculator uses platform-specific baseline CPM (Cost Per Mille) averages. These baselines are multiplied by your active average video views or post impressions, then adjusted by niche value multipliers, deliverable format weights (such as a dedicated video versus an integrated mention), and audience engagement rate tiers."
  },
  {
    question: "What are the typical CPM baselines across YouTube, TikTok, and Instagram?",
    answer: "Industry CPM benchmarks vary significantly by platform: YouTube commands premium rates ($25 - $45+ CPM) due to long video lifespans and evergreen search traffic; Instagram Reels and Carousels average $30 - $60 CPM due to high lifestyle purchasing intent; while TikTok averages $12 - $25 CPM due to high view volatility and fast content turnover."
  },
  {
    question: "How do deliverable formats (Dedicated vs. Integrated) affect my rate?",
    answer: "A dedicated video (where the entire content is focused on the sponsor's product or service) is priced at 100% of your rate. An integrated mention (a 30 to 60-second segment within a regular video) requires less custom scripting and is typically priced at 40% to 60% of a dedicated video's rate."
  },
  {
    question: "Should I base my rates on follower count or active average views?",
    answer: "You should always base your rates on active average views. Follower count is a vanity metric that measures past reach, whereas average views over your last 15 to 30 posts reflect real-time active impressions, which is the primary metric brands use to evaluate campaign ROI."
  },
  {
    question: "How much extra should I charge for paid ad usage rights (whitelisting)?",
    answer: "If a brand wants permission to run paid ads through your handle (dark posting) or use your video in their paid advertising campaigns, you should charge an additional usage licensing fee of 20% to 50% of your base fee per 30-day period. Never grant perpetual usage rights for free."
  },
  {
    question: "What is an exclusivity clause and how much should I charge for it?",
    answer: "An exclusivity clause prevents you from promoting competing brands within a specific industry for a defined timeframe (e.g., 30, 60, or 90 days). Because exclusivity limits your ability to accept other sponsorships, you should charge a 20% to 50% premium on top of your standard fee."
  },
  {
    question: "How do niche categories affect my sponsorship rate?",
    answer: "Niches with high customer lifetime values (LTV)—such as Business, Personal Finance, Tech, and B2B SaaS—command a 1.5x to 2.0x pricing multiplier. Health, Fitness, and Food command a 1.2x multiplier, while broad Gaming and Entertainment typically operate at baseline or slightly discounted CPMs."
  },
  {
    question: "How do I handle revisions in a brand deal contract?",
    answer: "Standard brand deal contracts should include one round of minor revisions (such as trimming audio or clarifying a product feature). Major reshoots due to brand script changes or additional revision rounds should be billed at an hourly rate or a 15% to 25% revision surcharge."
  }
];
---

<ToolLayout
  title="Brand Deal Calculator - Influencer Sponsorship Pricing Tool"
  description="Calculate your sponsored brand deal rates for YouTube, TikTok, and Instagram. Free online influencer pricing calculator with custom platform CPM benchmarks."
  toolName="Brand Deal Calculator"
  toolDescription="Determine your sponsored campaign rates. Toggle between YouTube, TikTok, and Instagram to calculate authentic pricing ranges and export brand pitch templates."
  category="Calculators"
  faqs={faqs}
>
  <div slot="calculator" class="calc-card glass">
    <!-- Platform tab list -->
    <div class="calculator-mode-selector" role="tablist" aria-label="Platform Selector">
      <button type="button" class="mode-tab active" data-platform="youtube" role="tab" aria-selected="true" aria-controls="calc-form-container">
        <span>YouTube</span>
      </button>
      <button type="button" class="mode-tab" data-platform="tiktok" role="tab" aria-selected="false" aria-controls="calc-form-container">
        <span>TikTok</span>
      </button>
      <button type="button" class="mode-tab" data-platform="instagram" role="tab" aria-selected="false" aria-controls="calc-form-container">
        <span>Instagram</span>
      </button>
    </div>

    <div class="calc-grid" id="calc-form-container">
      <!-- Input fields -->
      <form class="calc-form" id="brand-deal-form" onsubmit="return false;">
        <input type="hidden" id="active-platform" value="youtube" />

        <div class="form-group">
          <div class="label-header">
            <label for="audience-count" class="icon-label" id="audience-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
              Subscriber Count
            </label>
          </div>
          <input type="number" id="audience-count" class="form-input" placeholder="e.g., 50000" min="100" step="1" required />
          <span class="input-helper" id="audience-helper">Your total YouTube subscribers.</span>
        </div>

        <div class="form-group">
          <div class="label-header">
            <label for="avg-views" class="icon-label" id="views-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
              Average Views
            </label>
          </div>
          <input type="number" id="avg-views" class="form-input" placeholder="e.g., 8000 (leave blank to estimate)" min="1" step="1" />
          <span class="input-helper" id="views-helper">The typical number of views per video (defaults to 15% of subscribers if blank).</span>
        </div>

        <div class="form-group">
          <div class="label-header">
            <label for="deliverable-format" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              Deliverable Format
            </label>
          </div>
          <select id="deliverable-format" class="form-input">
            <option value="youtube_dedicated" selected>Dedicated Video (100% Sponsorship)</option>
            <option value="youtube_integrated">Integrated Mention (30s - 60s Segment)</option>
          </select>
        </div>

        <div class="form-group">
          <div class="label-header">
            <label for="niche-category" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581a1.125 1.125 0 0 0 1.591 0l4.318-4.318a1.125 1.125 0 0 0 0-1.591L9.568 3.659A2.25 2.25 0 0 0 7.977 3Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h.008v.008H6V7.5Z" />
              </svg>
              Content Niche / Category
            </label>
          </div>
          <select id="niche-category" class="form-input">
            <option value="lifestyle" selected>Lifestyle, Fashion, & Art (Standard)</option>
            <option value="business">Business, Finance, & Tech (Premium)</option>
            <option value="fitness">Health, Fitness, & Food (Mid-Tier)</option>
            <option value="entertainment">Gaming & Entertainment (Low-CPM)</option>
          </select>
        </div>

        <div class="form-group">
          <div class="label-header">
            <label for="engagement-rate" class="icon-label">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="field-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.34 18.062 18 21m-2.66-2.938a7.478 7.478 0 0 0 1.256-4.242A7.472 7.472 0 0 0 9 6.25a7.472 7.472 0 0 0-7.592 7.57 7.461 7.461 0 0 0 1.256 4.242L0 21m15.34-2.938A7.476 7.476 0 0 0 16.5 13.75c0-4.14-3.36-7.5-7.5-7.5h-.012c-4.137 0-7.488 3.353-7.488 7.47a7.473 7.473 0 0 0 1.156 3.968l1.455-1.597a5.525 5.525 0 0 1-.611-2.371c0-3.053 2.477-5.529 5.525-5.529h.012c3.048 0 5.525 2.476 5.525 5.53a5.523 5.523 0 0 1-.611 2.37l1.455 1.598Z" />
              </svg>
              Engagement Rate (%)
            </label>
          </div>
          <input type="number" id="engagement-rate" class="form-input" placeholder="e.g., 2.5" min="0.1" max="50" step="0.1" value="2.5" required />
          <span class="input-helper">Your average engagement rate (standard: 1.5% - 3.5%).</span>
        </div>

        <div class="form-actions">
          <button type="button" id="calc-submit-btn" class="calc-btn" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            Calculate Deal Value
          </button>
          <button type="button" id="calc-reset-btn" class="calc-btn-secondary" style="width: 100%;">Reset Form</button>
        </div>
      </form>

      <!-- Outputs Display -->
      <div class="calc-results" id="results-wrapper">
        <div class="empty-state text-center" id="res-empty-box">
          <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <h3>Awaiting Price Analysis</h3>
          <p class="text-muted">Fill out your platform stats and click Calculate to estimate your brand deal market values.</p>
        </div>

        <div class="results-active hidden" id="res-active-box">
          <div class="rate-range-box">
            <h4 class="rate-label" id="res-primary-label">Sponsorship Value</h4>
            <div class="rate-range" id="res-rate-range">$0 - $0</div>
            <div class="grade-badge grade-low" id="res-tier-badge">Micro-Influencer</div>
          </div>

          <div class="breakdown-box">
            <h4 class="breakdown-title">Pricing Benchmarks Breakdown</h4>
            <div class="breakdown-list">
              <div class="breakdown-item">
                <span class="breakdown-label">Estimated Views/Impressions:</span>
                <span class="breakdown-val" id="res-views-val">-</span>
              </div>
              <div class="breakdown-item">
                <span class="breakdown-label">Suggested Cost Per View (CPV):</span>
                <span class="breakdown-val" id="res-cpv-val">-</span>
              </div>
              <div class="breakdown-item">
                <span class="breakdown-label">Calculated CPM Rate:</span>
                <span class="breakdown-val" id="res-cpm-val">-</span>
              </div>
            </div>
          </div>

          <!-- Brands pitch template -->
          <div class="pitch-container glass">
            <div class="pitch-header">
              <h5 class="pitch-title">Brands Outreach Template</h5>
              <button type="button" class="copy-pitch-btn" id="copy-pitch-btn" title="Copy template text">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 16px; height: 16px;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H5.25M16.5 5.25h.008v.008H16.5V5.25Zm-3 0h.008v.008h-.008V5.25Zm-3 0h.008v.008h-.008V5.25Zm-3 0h.008v.008h-.008V5.25ZM9 10.5c0-.621.504-1.125 1.125-1.125h9.75c.621 0 1.125.504 1.125 1.125v10.5c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V10.5Z" />
                </svg>
                Copy Pitch
              </button>
            </div>
            <textarea class="pitch-textbox" id="pitch-output" readonly rows="7"></textarea>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div slot="about" class="editorial-content">
    <h2>The Ultimate Guide to Brand Deal Pricing & Sponsorship Valuation</h2>
    <p>
      For modern digital creators, landing sponsored brand deals represents the most lucrative, high-margin monetization channel in the creator economy. Whether you produce long-form video essays on YouTube, viral vertical clips on TikTok, or aesthetic carousels on Instagram, direct brand collaborations allow you to monetize your audience trust without relying exclusively on platform ad-revenue splits.
    </p>
    <p>
      However, knowing exactly <strong>how much to charge for a brand deal</strong> is one of the greatest challenges creators face. Underpricing your work leads to burnout and thousands of dollars in lost income, while overquoting without justifying your value can cause brands to walk away.
    </p>
    <p>
      Our <strong>Brand Deal Calculator</strong> bridges this gap. By utilizing real-time platform CPM baselines, niche commercial purchasing multipliers, engagement weights, and deliverable format adjustments, this tool calculates accurate, market-tested pricing ranges and automatically generates a ready-to-send brand outreach pitch template.
    </p>

    <div class="callout-box">
      <div class="callout-title">
        <span>💼</span> Deep Dive Sponsorship Guide
      </div>
      <p style="margin: 0; font-size: 0.95rem;">
        Master the art of sponsorship contracts, pitch emails, and rate negotiation strategies with our comprehensive companion guide: <a href="/blog/brand-deal-calculator-guide">Brand Deal Pricing Guidelines & Sponsorship Negotiation Strategies</a>.
      </p>
    </div>

    <h2>What is a Brand Deal and How Does It Work for Creators?</h2>
    <p>
      A <strong>brand deal</strong> (also known as a sponsored collaboration or influencer partnership) is a commercial agreement where a business pays a content creator to produce and publish content featuring the brand's product, software, or service.
    </p>
    <p>
      Unlike traditional display ads, brand deals leverage the authentic connection and social proof that creators cultivate with their communities. A standard brand deal workflow typically follows five key milestones:
    </p>
    <ol>
      <li><strong>Outreach & Inbound Inquiries:</strong> The brand contacts the creator (or the creator pitches the brand) with a campaign brief outlining target deliverables, campaign goals, and timeline.</li>
      <li><strong>Rate Negotiation & Scope of Work:</strong> The creator quotes their fee based on expected impressions, niche alignment, usage rights, and deliverable formats.</li>
      <li><strong>Contract Execution & Deposit:</strong> Both parties sign an agreement defining deliverable specs, approval deadlines, exclusivity terms, and payment terms (typically 50% upfront, 50% upon publication).</li>
      <li><strong>Content Production & Creative Approval:</strong> The creator produces the draft, submits it for brand review, and implements any agreed minor revisions.</li>
      <li><strong>Publication & Performance Reporting:</strong> The creator posts the sponsored asset with required FTC disclosures, tracks link clicks and engagement, and delivers a post-campaign analytics report.</li>
    </ol>

    <h2>Different Types of Brand Deals & Sponsored Deliverables</h2>
    <p>
      Brand collaborations take many forms depending on the marketing funnel stage and platform:
    </p>

    <div class="step-guide">
      <div class="step-item">
        <h3>1. Dedicated Sponsored Videos (100% Sponsor Focus)</h3>
        <p>
          The entire video or post revolves around the brand's product. Common formats include full product reviews, unboxings, deep-dive software tutorials, and multi-step routine demonstrations. Because 100% of the audience's attention is focused on the sponsor, dedicated content commands the highest baseline rate.
        </p>
      </div>

      <div class="step-item">
        <h3>2. Integrated Mentions (30-to-60-Second In-Video Ad Segments)</h3>
        <p>
          The creator incorporates a 30-to-60-second sponsored segment within an organic, non-sponsored video (popular on YouTube). The sponsor shares screen time with regular content, making it less intrusive and typically priced at 40% to 60% of a dedicated video's rate.
        </p>
      </div>

      <div class="step-item">
        <h3>3. Social Media Reels & Short-Form TikTok Clips</h3>
        <p>
          High-energy, vertical video assets engineered for algorithmic distribution. These deliverables capitalize on rapid organic reach, making them ideal for viral product launches and brand discovery campaigns.
        </p>
      </div>

      <div class="step-item">
        <h3>4. Instagram Story Sequences (With Direct Link Stickers)</h3>
        <p>
          A series of 3 to 5 ephemeral 24-hour Story slides featuring product unboxing, personal testimony, and interactive link stickers. While short-lived, Stories drive exceptionally high direct-response conversion rates.
        </p>
      </div>

      <div class="step-item">
        <h3>5. Multi-Slide Carousels & Infographics</h3>
        <p>
          A permanent swipe-through photo or graphic deck on Instagram or LinkedIn. Ideal for educational breakdowns, step-by-step guides, and visual before-and-after comparisons.
        </p>
      </div>

      <div class="step-item">
        <h3>6. Long-Term Brand Ambassadorships & Retainers</h3>
        <p>
          Recurring multi-month partnerships where a creator commits to a regular cadence of monthly deliverables (e.g., 1 dedicated video and 3 Story sequences per month). Retainers provide creators with predictable recurring revenue while delivering sustained audience reinforcement for the brand.
        </p>
      </div>

      <div class="step-item">
        <h3>7. Whitelisting, Paid Ad Usage Rights & UGC Creation</h3>
        <p>
          The brand licenses the creator's video to run as a paid targeted advertisement directly from the creator's handle (Meta Partnership Ads / TikTok Spark Ads), or hires the creator purely for User-Generated Content (UGC) to be posted exclusively on the brand's official channels.
        </p>
      </div>
    </div>

    <h2>How Creators Calculate & Estimate Brand Deal Rates</h2>
    <p>
      In the modern creator economy, pricing has evolved away from simple follower counts toward <strong>reach-based performance metrics</strong>:
    </p>

    <h3>The Outdated '1% Rule' vs Modern CPM Pricing</h3>
    <p>
      Historically, creators used the simplistic rule of charging $100 per 10,000 followers ($10 per 1,000 followers). However, algorithmic feeds on TikTok, Instagram, and YouTube mean follower count no longer guarantees views. A creator with 100,000 followers might average only 3,000 views per post, while a creator with 10,000 followers might consistently generate 40,000 views.
    </p>
    <p>
      Today, professional agencies price collaborations using <strong>Cost Per Mille (CPM)</strong>—the cost to buy 1,000 impressions:
    </p>

    <div class="formula-box">
      Base Sponsorship Rate = (Average Views × Platform Baseline CPM) / 1,000
    </div>

    <h2>Key Factors That Influence Brand Deal Pricing</h2>
    <p>
      Our calculator adjusts your baseline rate using four core industry multipliers:
    </p>

    <div class="table-responsive-wrapper">
      <table class="content-table">
        <thead>
          <tr>
            <th>Pricing Factor</th>
            <th>Standard Benchmark</th>
            <th>Pricing Impact & Multipliers</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>YouTube Baseline CPM</strong></td>
            <td>$25.00 – $45.00 CPM</td>
            <td>Highest CPM due to long-form attention, high production effort, and evergreen search engine rankings.</td>
          </tr>
          <tr>
            <td><strong>Instagram Baseline CPM</strong></td>
            <td>$30.00 – $60.00 CPM</td>
            <td>Strong lifestyle purchasing intent, aesthetic appeal, and direct link-sticker conversion capabilities.</td>
          </tr>
          <tr>
            <td><strong>TikTok Baseline CPM</strong></td>
            <td>$12.00 – $25.00 CPM</td>
            <td>Lower CPM due to view volatility and shorter content lifespan, compensated by viral breakout potential.</td>
          </tr>
          <tr>
            <td><strong>Business, Tech & Finance Niche</strong></td>
            <td>Premium Purchasing Power</td>
            <td><strong>1.5x – 2.0x Multiplier</strong> (High Customer Lifetime Value / B2B buyers).</td>
          </tr>
          <tr>
            <td><strong>Health, Fitness & Food Niche</strong></td>
            <td>Mid-Tier Purchasing Power</td>
            <td><strong>1.2x Multiplier</strong> (Strong repeat consumable buying behavior).</td>
          </tr>
          <tr>
            <td><strong>Lifestyle, Fashion & Art Niche</strong></td>
            <td>Standard Baseline</td>
            <td><strong>1.0x Baseline</strong> (Broad consumer audience).</td>
          </tr>
          <tr>
            <td><strong>Gaming & General Entertainment</strong></td>
            <td>Broad Audience / Low Margin</td>
            <td><strong>0.8x Multiplier</strong> (Large impressions but lower immediate conversion rates).</td>
          </tr>
          <tr>
            <td><strong>High Engagement Rate (>4.0%)</strong></td>
            <td>Active Community</td>
            <td><strong>+20% Premium</strong> (Audience demonstrates high trust and interaction).</td>
          </tr>
          <tr>
            <td><strong>Low Engagement Rate (&lt;1.5%)</strong></td>
            <td>Passive Community</td>
            <td><strong>-15% Adjustment</strong> (Lower audience interaction rate).</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>How This Brand Deal Calculator Works</h2>
    <p>
      Our calculator combines platform CPM models, deliverable weights, niche factors, and engagement rates into an integrated mathematical engine:
    </p>

    <div class="formula-box">
      Calculated CPM = Platform Base CPM × Niche Multiplier × Format Multiplier × Engagement Multiplier
      <br />
      Cost Per View (CPV) = Calculated CPM / 1,000
      <br />
      Suggested Sponsorship Range = (Average Views × Calculated CPM / 1,000) ± 15% Variance
    </div>

    <h3>Automatic Creator Tier Categorization</h3>
    <p>
      The calculator categorizes creators into standard industry tiers:
    </p>
    <ul>
      <li><strong>Nano-Influencer (Under 1,000 followers):</strong> Niche community, high local trust.</li>
      <li><strong>Micro-Influencer (1,000 to 10,000 followers):</strong> Highly engaged niche audience, excellent conversion rates.</li>
      <li><strong>Mid-Tier Creator (10,000 to 100,000 followers):</strong> Established reach, professional production quality.</li>
      <li><strong>Macro-Influencer (100,000 to 500,000 followers):</strong> Broad regional authority, major brand campaign anchor.</li>
      <li><strong>Mega-Influencer (500,000+ followers):</strong> Household celebrity reach, massive cultural awareness driver.</li>
    </ul>

    <h2>Step-by-Step Guide: How to Use the Brand Deal Calculator</h2>
    <p>
      Follow these six simple steps to calculate your market rate and export a brand pitch template:
    </p>

    <div class="step-guide">
      <div class="step-item">
        <h3>Step 1: Select Your Platform</h3>
        <p>
          Click the tab at the top for <strong>YouTube</strong>, <strong>TikTok</strong>, or <strong>Instagram</strong>. The calculator will automatically adjust its deliverable options and CPM benchmarks.
        </p>
      </div>

      <div class="step-item">
        <h3>Step 2: Enter Your Audience Size</h3>
        <p>
          Input your total subscriber or follower count on that platform.
        </p>
      </div>

      <div class="step-item">
        <h3>Step 3: Enter Average Post Views</h3>
        <p>
          Input your median view count across your last 15 to 30 posts. If left blank, the tool automatically estimates views using standard platform view ratios (15% for YouTube, 12% for TikTok, 15% for Instagram Reels).
        </p>
      </div>

      <div class="step-item">

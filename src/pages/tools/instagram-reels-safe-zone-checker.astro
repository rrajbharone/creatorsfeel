---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    question: "What is the Instagram Reels safe zone and why is it important?",
    answer: "The Instagram Reels safe zone is the central visual area of a vertical 9:16 video (1080 × 1920 pixels) that remains completely unobstructed by Instagram's native user interface elements. When viewers watch Reels, Instagram overlays a top navigation header, a right-side interaction bar (like, comment, share, audio buttons), and a bottom metadata block (username, caption, and audio title). Keeping critical text, subtitles, faces, and brand logos inside the safe area prevents the platform UI from covering your content and hurting viewer retention."
  },
  {
    question: "What are the exact dimensions and aspect ratio for Instagram Reels in 2026?",
    answer: "Instagram Reels are rendered natively in a 9:16 vertical aspect ratio at 1080 × 1920 pixels. However, Reels appear on three distinct surfaces: fullscreen 9:16 in the Reels tab (1080 × 1920), 4:5 portrait crop in the algorithmic Home Feed (1080 × 1350 pixels), and 1:1 square crop in your profile grid (1080 × 1080 pixels). Important headlines and cover focal points should sit within the central 1080 × 1080 pixel square to display correctly everywhere."
  },
  {
    question: "Where should I place text, closed captions, and calls to action in a Reel?",
    answer: "Position all on-screen text, animated subtitles, product tags, and calls to action inside the central content safe zone: at least 270 pixels from the top, 420 pixels from the bottom, 65 pixels from the left edge, and 170 pixels from the right edge. Placing subtitles in the lower 20% of the screen causes them to collide directly with your username and caption, making them unreadable."
  },
  {
    question: "What is the difference between the 9:16 Reels view, 4:5 feed preview, and 1:1 profile grid?",
    answer: "The 9:16 view is the immersive fullscreen playback mode (1080 × 1920). When your Reel appears on follower home feeds, Instagram crops 285 pixels off the top and 285 pixels off the bottom to display it in 4:5 ratio (1080 × 1350). In your profile grid, Instagram crops 420 pixels from both top and bottom to create a 1:1 square thumbnail (1080 × 1080). Our tool visually displays all three crop boundaries so your cover art and text look intentional on every screen."
  },
  {
    question: "Why does text look perfectly centered in my editing app but covered on Instagram?",
    answer: "Most video editing apps (like CapCut, Premiere Pro, and Canva) default to the mathematical center of the entire 1080 × 1920 frame. However, because Instagram's bottom interface takes up approximately 22% of the screen height and the right action column occupies roughly 16% of the screen width, the true visual safe center is shifted slightly upward and to the left. Using an interactive Reels safe zone preview tool ensures your layout accounts for Instagram's asymmetrical interface."
  },
  {
    question: "Can I download and import this safe zone guide into CapCut, Premiere Pro, or Canva?",
    answer: "Yes! Our tool provides a dedicated 'Download Transparent 9:16 Template' action. You can download the 1080 × 1920 PNG overlay with transparent background and drop it directly onto the top track of your editing timeline in CapCut, Adobe Premiere, Final Cut Pro, or Canva to visually align text before rendering."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'Instagram Reels Safe Zone Checker', item: '/tools/instagram-reels-safe-zone-checker' }
];

const origin = Astro.site ? Astro.site.origin : "https://creatorsfeel.com";
const canonicalUrl = new URL(Astro.url.pathname, origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${canonicalUrl}#application`,
  "name": "Instagram Reels Safe Zone Checker",
  "url": canonicalUrl,
  "operatingSystem": "All",
  "applicationCategory": "DesignApplication",
  "description": "Free Instagram Reels Safe Zone Checker. Preview your Reel covers and video frames with realistic Instagram UI overlays, 4:5 feed crop guides, and 1:1 profile grid templates.",
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout
  title="Instagram Reels Safe Zone Checker - Test Text & UI Overlays Free"
  description="Free Instagram Reels Safe Zone Checker. Preview Reels text safe areas, UI overlays, 4:5 feed crop, and 1:1 profile grid guides. Download 9:16 templates."
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script type="application/ld+json" slot="meta" set:html={JSON.stringify(softwareSchema)} />

  <div class="tool-page-wrapper">

    <!-- 1. HERO SECTION (Centered Max-Width 820px) -->
    <header class="tool-hero-section">
      <div class="container hero-inner">

        <!-- Breadcrumbs at top -->
        <div class="hero-breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>

        <!-- Pill Badge with SVG Icon (Zero Emojis) -->
        <div class="hero-badge">
          <span class="badge-icon-tool">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tool-svg" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </span>
          <span class="badge-title">Instagram Reels Design &amp; Layout Optimizer</span>
          <span class="badge-pill-free">Free Tool</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-headline">
          Instagram Reels <span class="gradient-text">Safe Zone Checker</span>
        </h1>

        <!-- Short Description -->
        <p class="hero-desc">
          Test your Reel covers and video frames against Instagram's interface overlays, 4:5 home feed crops, and 1:1 profile grid templates. Ensure text, faces, and subtitles are never covered.
        </p>

        <!-- Feature Chips Row (Zero Emojis - Clean SVG Icons) -->
        <div class="hero-features-row">
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h17.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z" />
            </svg>
            9:16 Fullscreen Safe Guide
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M9 21V9"/>
            </svg>
            4:5 Feed &amp; 1:1 Grid Crops
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5" />
            </svg>
            Realistic Instagram UI Mockup
          </span>
          <span class="feature-chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            Download PNG Guides
          </span>
        </div>
      </div>
    </header>

    <!-- 2. MAIN TOOL SECTION (Container Max-Width 940px) -->
    <section class="tool-main-section" aria-label="Instagram Reels Safe Zone Checker Interface">
      <div class="container tool-card-container">

        <!-- The Prominent SaaS Tool Card -->
        <div class="saas-tool-card">

          <!-- Card Header Bar -->
          <div class="card-header-bar">
            <div class="header-title-cluster">
              <div class="card-icon-wrap" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="title-svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h17.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z" />
                </svg>
              </div>
              <div>
                <h2 class="card-title-text">Reels Safe Zone Studio</h2>
                <span class="card-sub-text">Workflow: Upload Media → Preview Safe Zones → Adjust Guides → Download</span>
              </div>
            </div>

            <div class="header-controls-cluster">
              <div class="live-status-pill">
                <span class="live-pulse-dot" aria-hidden="true"></span>
                <span>Client-Side Active</span>
              </div>
              <button type="button" class="btn-reset-tool" id="btn-reset-tool" title="Reset image and guides">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="reset-svg" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                <span>Reset</span>
              </button>
            </div>
          </div>

          <!-- Main Interactive Studio Layout (2-Column Grid on Desktop) -->
          <div class="studio-workspace-grid">

            <!-- LEFT COLUMN: CONTROLS & SETTINGS -->
            <div class="studio-controls-column">
              
              <!-- Upload Box -->
              <div class="control-card-block">
                <div class="block-title-row">
                  <span class="block-title">1. Upload Reel Cover or Frame</span>
                  <span class="block-badge">Image or Video</span>
                </div>

                <div class="dropzone-box" id="dropzone" tabindex="0" role="button" aria-label="Upload Reel cover image or video">
                  <input type="file" id="media-file-input" class="hidden-file-input" accept="image/png,image/jpeg,image/webp,video/mp4,video/webm,video/quicktime,.png,.jpg,.jpeg,.webp,.mp4,.webm,.mov" />
                  
                  <div class="dropzone-prompt" id="dropzone-prompt">
                    <div class="upload-icon-circle" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="upload-svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                      </svg>
                    </div>
                    <strong class="dropzone-prompt-text">Click to browse or drop file here</strong>
                    <span class="dropzone-sub-text">PNG, JPG, WebP, or MP4 (First frame extracted locally)</span>
                  </div>

                  <div class="loaded-file-indicator" id="loaded-file-indicator" style="display: none;">
                    <div class="loaded-meta-info">
                      <span class="loaded-filename" id="label-filename">reel_cover.png</span>
                      <span class="loaded-specs" id="label-dimensions">1080 × 1920 • 9:16</span>
                    </div>
                    <button type="button" class="btn-change-file" id="btn-change-file">Change File</button>
                  </div>
                </div>

                <!-- Sample Presets Row -->
                <div class="sample-presets-wrap">
                  <span class="sample-presets-label">Or test with demo templates:</span>
                  <div class="sample-buttons-row">
                    <button type="button" class="btn-sample-preset active" data-sample="creator">
                      Talking Head
                    </button>
                    <button type="button" class="btn-sample-preset" data-sample="product">
                      E-Commerce Reel
                    </button>
                    <button type="button" class="btn-sample-preset" data-sample="quote">
                      Quote Card
                    </button>
                  </div>
                </div>
              </div>

              <!-- Overlay Guides Toggles -->
              <div class="control-card-block">
                <div class="block-title-row">
                  <span class="block-title">2. Guide &amp; Overlay Toggles</span>
                </div>

                <div class="toggle-switches-list">
                  
                  <label class="toggle-switch-item">
                    <div class="toggle-text-group">
                      <span class="toggle-main-label">Recommended Safe Zone Box</span>
                      <span class="toggle-sub-label">Green boundary cleared of all UI interference</span>
                    </div>
                    <input type="checkbox" id="toggle-safe-zone" checked class="custom-toggle-input" />
                    <span class="toggle-slider"></span>
                  </label>

                  <label class="toggle-switch-item">
                    <div class="toggle-text-group">
                      <span class="toggle-main-label">Instagram UI Overlay Mockup</span>
                      <span class="toggle-sub-label">Like/comment buttons, caption, and audio info</span>
                    </div>
                    <input type="checkbox" id="toggle-insta-ui" checked class="custom-toggle-input" />
                    <span class="toggle-slider"></span>
                  </label>

                  <label class="toggle-switch-item">
                    <div class="toggle-text-group">
                      <span class="toggle-main-label">4:5 Feed &amp; 1:1 Profile Crop Guides</span>
                      <span class="toggle-sub-label">Home feed (1080×1350) and profile grid (1080×1080) lines</span>
                    </div>
                    <input type="checkbox" id="toggle-crop-lines" checked class="custom-toggle-input" />
                    <span class="toggle-slider"></span>
                  </label>

                  <label class="toggle-switch-item">
                    <div class="toggle-text-group">
                      <span class="toggle-main-label">Rule-of-Thirds Grid</span>
                      <span class="toggle-sub-label">Photographic 3×3 visual alignment lines</span>
                    </div>
                    <input type="checkbox" id="toggle-grid-thirds" class="custom-toggle-input" />
                    <span class="toggle-slider"></span>
                  </label>

                </div>
              </div>

              <!-- Editable Margins Accordion / Slider Panel -->
              <div class="control-card-block">
                <div class="block-title-row">
                  <span class="block-title">3. Adjustable Safe Zone Margins</span>
                  <button type="button" class="btn-reset-margins" id="btn-reset-margins" title="Restore recommended Meta safe zone percentages">
                    Reset Defaults
                  </button>
                </div>

                <div class="margins-sliders-grid">
                  
                  <div class="slider-field-group">
                    <div class="slider-label-row">
                      <span>Top Margin (Header):</span>
                      <span class="slider-val" id="val-margin-top">14% (~270px)</span>
                    </div>
                    <input type="range" id="slider-margin-top" min="5" max="25" step="1" value="14" class="custom-range" />
                  </div>

                  <div class="slider-field-group">
                    <div class="slider-label-row">
                      <span>Bottom Margin (Caption &amp; Audio):</span>
                      <span class="slider-val" id="val-margin-bottom">22% (~420px)</span>
                    </div>
                    <input type="range" id="slider-margin-bottom" min="10" max="35" step="1" value="22" class="custom-range" />
                  </div>

                  <div class="slider-field-group">
                    <div class="slider-label-row">
                      <span>Right Margin (Interaction Icons):</span>
                      <span class="slider-val" id="val-margin-right">16% (~170px)</span>
                    </div>
                    <input type="range" id="slider-margin-right" min="8" max="26" step="1" value="16" class="custom-range" />
                  </div>

                  <div class="slider-field-group">
                    <div class="slider-label-row">
                      <span>Left Margin:</span>
                      <span class="slider-val" id="val-margin-left">6% (~65px)</span>
                    </div>
                    <input type="range" id="slider-margin-left" min="2" max="15" step="1" value="6" class="custom-range" />
                  </div>

                </div>

                <!-- Media Fit Mode -->
                <div class="fit-mode-row">
                  <span class="fit-label">Media Scaling:</span>
                  <div class="fit-radio-group">
                    <label class="fit-radio-label">
                      <input type="radio" name="scale-mode" value="cover" checked id="scale-cover" />
                      <span>Fill 9:16 Canvas (Cover)</span>
                    </label>
                    <label class="fit-radio-label">
                      <input type="radio" name="scale-mode" value="contain" id="scale-contain" />
                      <span>Fit Proportions (Letterbox)</span>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Export / Download Actions -->
              <div class="control-card-block action-buttons-block">
                <button type="button" class="btn-download-primary" id="btn-download-preview">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-btn-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  <span>Download Preview with Guides (PNG)</span>
                </button>

                <button type="button" class="btn-download-secondary" id="btn-download-template">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="action-btn-svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  <span>Download Transparent 9:16 Overlay Template</span>
                </button>
              </div>

            </div>

            <!-- RIGHT COLUMN: PHONE MOCKUP PREVIEW STAGE -->
            <div class="studio-preview-column">
              <div class="phone-mockup-wrapper">
                
                <!-- Phone Mockup Frame (Realistic 9:16 Ratio) -->
                <div class="phone-frame-container" id="phone-stage">
                  
                  <!-- Canvas Layer where user media is drawn -->
                  <canvas id="preview-canvas" width="1080" height="1920" class="stage-canvas"></canvas>

                  <!-- Dynamic SVG Safe Zone Overlay Layer -->
                  <div class="stage-overlay-layer" id="overlay-layer">
                    
                    <!-- 1. Safe Zone Box (Green boundary) -->
                    <div class="safe-zone-box" id="guide-safe-box">
                      <span class="safe-zone-tag" aria-hidden="true">Content Safe Area</span>
                    </div>

                    <!-- 2. 4:5 Feed Crop Line Guide (1080 × 1350) -->
                    <div class="crop-guide-45" id="guide-45-crop" aria-hidden="true">
                      <span class="crop-tag-45">4:5 Home Feed Crop (1080 × 1350)</span>
                    </div>

                    <!-- 3. 1:1 Profile Grid Crop Guide (1080 × 1080) -->
                    <div class="crop-guide-11" id="guide-11-crop" aria-hidden="true">
                      <span class="crop-tag-11">1:1 Profile Grid Thumbnail (1080 × 1080)</span>
                    </div>

                    <!-- 4. Rule of Thirds Grid -->
                    <div class="grid-thirds-overlay" id="guide-thirds" style="display: none;" aria-hidden="true">
                      <div class="third-line v1"></div>
                      <div class="third-line v2"></div>
                      <div class="third-line h1"></div>
                      <div class="third-line h2"></div>
                    </div>

                    <!-- 5. Realistic Instagram UI Mockup Elements -->
                    <div class="instagram-ui-mockup" id="insta-ui-elements" aria-hidden="true">
                      
                      <!-- Top Bar -->
                      <div class="insta-top-bar">
                        <div class="insta-top-left">
                          <span class="insta-reels-title">Reels</span>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="insta-chevron-svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                          </svg>
                        </div>
                        <div class="insta-top-right">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="top-icon-svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316A2.192 2.192 0 0 0 14.53 4H9.47c-.527 0-1.026.262-1.332.712l-.822 1.316Z" />
                          </svg>
                        </div>
                      </div>

                      <!-- Right Interaction Column -->
                      <div class="insta-right-column">
                        <!-- Like -->
                        <div class="ui-action-item">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ui-icon-svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                          </svg>
                          <span class="ui-metric-label">84.2K</span>
                        </div>

                        <!-- Comment -->
                        <div class="ui-action-item">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ui-icon-svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.693 9-8.25s-4.03-8.25-9-8.25S3 7.443 3 12c0 2.104.859 4.023 2.273 5.48L4.5 21l3.75-1.5c1.1.256 2.27.375 3.75.375Z" />
                          </svg>
                          <span class="ui-metric-label">1,240</span>
                        </div>

                        <!-- Share -->
                        <div class="ui-action-item">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ui-icon-svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                          </svg>
                          <span class="ui-metric-label">14.6K</span>
                        </div>

                        <!-- More -->
                        <div class="ui-action-item">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ui-icon-svg">
                            <circle cx="12" cy="12" r="1.5" />
                            <circle cx="12" cy="5" r="1.5" />
                            <circle cx="12" cy="19" r="1.5" />
                          </svg>
                        </div>

                        <!-- Audio Disc -->
                        <div class="ui-disc-box">
                          <div class="disc-circle"></div>
                        </div>
                      </div>

                      <!-- Bottom Caption & Profile Area -->
                      <div class="insta-bottom-area">
                        <div class="insta-profile-row">
                          <div class="insta-avatar-mock"></div>
                          <span class="insta-username-text">@creatorhandle</span>
                          <span class="insta-follow-btn">Follow</span>
                        </div>
                        <p class="insta-caption-mock">
                          How to design Instagram Reels that never get cut off by the UI... <span class="caption-more">more</span>
                        </p>
                        <div class="insta-audio-row">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="audio-note-svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z" />
                          </svg>
                          <span class="audio-title-text">Original Audio - Creator Audio Track</span>
                        </div>
                      </div>

                    </div>

                  </div>

                </div>

                <!-- Legend Strip below Mockup -->
                <div class="preview-legend-strip">
                  <div class="legend-item">
                    <span class="legend-dot green-dot"></span>

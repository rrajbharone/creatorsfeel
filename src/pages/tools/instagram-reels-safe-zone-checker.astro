</style>

<script>
  function initInstagramReelsSafeZoneChecker() {
    // Canvas & Stage Elements
    const canvas = document.getElementById('preview-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Overlay Elements
    const guideSafeBox = document.getElementById('guide-safe-box');
    const guide45Crop = document.getElementById('guide-45-crop');
    const guide11Crop = document.getElementById('guide-11-crop');
    const guideThirds = document.getElementById('guide-thirds');
    const instaUiElements = document.getElementById('insta-ui-elements');

    // Controls
    const dropzone = document.getElementById('dropzone');
    const mediaInput = document.getElementById('media-file-input');
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedFileIndicator = document.getElementById('loaded-file-indicator');
    const labelFilename = document.getElementById('label-filename');
    const labelDimensions = document.getElementById('label-dimensions');
    const btnChangeFile = document.getElementById('btn-change-file');
    const btnResetTool = document.getElementById('btn-reset-tool');
    const samplePresetBtns = document.querySelectorAll('.btn-sample-preset');

    // Toggle Checkboxes
    const toggleSafeZone = document.getElementById('toggle-safe-zone');
    const toggleInstaUi = document.getElementById('toggle-insta-ui');
    const toggleCropLines = document.getElementById('toggle-crop-lines');
    const toggleGridThirds = document.getElementById('toggle-grid-thirds');

    // Sliders
    const sliderTop = document.getElementById('slider-margin-top');
    const sliderBottom = document.getElementById('slider-margin-bottom');
    const sliderRight = document.getElementById('slider-margin-right');
    const sliderLeft = document.getElementById('slider-margin-left');

    const valTop = document.getElementById('val-margin-top');
    const valBottom = document.getElementById('val-margin-bottom');
    const valRight = document.getElementById('val-margin-right');
    const valLeft = document.getElementById('val-margin-left');

    const btnResetMargins = document.getElementById('btn-reset-margins');
    const scaleRadios = document.querySelectorAll('input[name="scale-mode"]');

    // Download Buttons
    const btnDownloadPreview = document.getElementById('btn-download-preview');
    const btnDownloadTemplate = document.getElementById('btn-download-template');

    // State Variables
    let currentImage = new Image();
    let isDefaultSample = true;
    let sampleType = 'creator';
    let scaleMode = 'cover'; // 'cover' | 'contain'
    let mediaBlobUrl = null;

    // Default Margins (%)
    const DEFAULTS = { top: 14, bottom: 22, right: 16, left: 6 };

    // Built-in high-res procedural demo graphics
    function generateDemoCanvas(type) {
      const offscreen = document.createElement('canvas');
      offscreen.width = 1080;
      offscreen.height = 1920;
      const offCtx = offscreen.getContext('2d');
      if (!offCtx) return offscreen;

      if (type === 'creator') {
        // Talking Head Creator Demo
        const grad = offCtx.createLinearGradient(0, 0, 1080, 1920);
        grad.addColorStop(0, '#1e1b4b');
        grad.addColorStop(0.5, '#312e81');
        grad.addColorStop(1, '#0f172a');
        offCtx.fillStyle = grad;
        offCtx.fillRect(0, 0, 1080, 1920);

        // Studio lighting glow
        const rad = offCtx.createRadialGradient(540, 720, 50, 540, 720, 600);
        rad.addColorStop(0, 'rgba(129, 140, 248, 0.35)');
        rad.addColorStop(1, 'rgba(0,0,0,0)');
        offCtx.fillStyle = rad;
        offCtx.fillRect(0, 0, 1080, 1920);

        // Creator Head Silhouette
        offCtx.fillStyle = '#4338ca';
        offCtx.beginPath();
        offCtx.arc(540, 700, 220, 0, Math.PI * 2);
        offCtx.fill();
        offCtx.beginPath();
        offCtx.ellipse(540, 1200, 420, 320, 0, 0, Math.PI * 2);
        offCtx.fill();

        // Sample Text Hook (Demonstrating perfect safe zone positioning)
        offCtx.fillStyle = '#ffffff';
        offCtx.font = 'bold 64px Outfit, sans-serif';
        offCtx.textAlign = 'center';
        offCtx.fillText('HOW TO SCALE REELS', 540, 380);
        offCtx.font = '600 42px Outfit, sans-serif';
        offCtx.fillStyle = '#cbd5e1';
        offCtx.fillText('Without Getting Text Covered by UI', 540, 450);

        // Subtitle Hook inside 1:1 grid
        offCtx.fillStyle = '#fbbf24';
        offCtx.font = 'bold 50px Outfit, sans-serif';
        offCtx.fillText('Keep Focal Point in 1:1 Center', 540, 1050);

      } else if (type === 'product') {
        // E-Commerce Product Reel
        const grad = offCtx.createLinearGradient(0, 0, 1080, 1920);
        grad.addColorStop(0, '#831843');
        grad.addColorStop(0.5, '#be185d');
        grad.addColorStop(1, '#500724');
        offCtx.fillStyle = grad;
        offCtx.fillRect(0, 0, 1080, 1920);

        // Product Box Mockup
        offCtx.fillStyle = '#fce7f3';
        offCtx.beginPath();
        offCtx.roundRect(320, 680, 440, 560, 24);
        offCtx.fill();

        // Ribbon
        offCtx.fillStyle = '#db2777';
        offCtx.fillRect(480, 680, 120, 560);

        // Top Hook
        offCtx.fillStyle = '#ffffff';
        offCtx.font = '800 70px Outfit, sans-serif';
        offCtx.textAlign = 'center';
        offCtx.fillText('SUMMER DROP 2026', 540, 390);

        // Price badge in safe area
        offCtx.fillStyle = '#ffffff';
        offCtx.font = 'bold 44px Outfit, sans-serif';
        offCtx.fillText('Special 30% Off Launch', 540, 460);

      } else {
        // Aesthetic Quote Card
        const grad = offCtx.createLinearGradient(0, 0, 1080, 1920);
        grad.addColorStop(0, '#042f2e');
        grad.addColorStop(0.5, '#0f766e');
        grad.addColorStop(1, '#115e59');
        offCtx.fillStyle = grad;
        offCtx.fillRect(0, 0, 1080, 1920);

        offCtx.fillStyle = 'rgba(255, 255, 255, 0.08)';
        offCtx.beginPath();
        offCtx.roundRect(140, 560, 800, 800, 32);
        offCtx.fill();
        offCtx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
        offCtx.lineWidth = 2;
        offCtx.stroke();

        offCtx.fillStyle = '#ffffff';
        offCtx.font = 'italic 52px serif';
        offCtx.textAlign = 'center';
        offCtx.fillText('"Consistency beats talent', 540, 920);
        offCtx.fillText('when talent refuses to post."', 540, 1000);

        offCtx.font = '600 36px Outfit, sans-serif';
        offCtx.fillStyle = '#a7f3d0';
        offCtx.fillText('@dailyquotes', 540, 1140);
      }

      return offscreen;
    }

    function renderStage() {
      ctx.clearRect(0, 0, 1080, 1920);

      // Draw background / image
      if (currentImage && currentImage.complete && currentImage.naturalWidth > 0) {
        const iw = currentImage.naturalWidth;
        const ih = currentImage.naturalHeight;
        const cw = 1080;
        const ch = 1920;

        if (scaleMode === 'cover') {
          const imgRatio = iw / ih;
          const canvasRatio = cw / ch;
          let renderW = cw;
          let renderH = ch;
          let offsetX = 0;
          let offsetY = 0;

          if (imgRatio > canvasRatio) {
            renderW = ch * imgRatio;
            offsetX = (cw - renderW) / 2;
          } else {
            renderH = cw / imgRatio;
            offsetY = (ch - renderH) / 2;
          }
          ctx.drawImage(currentImage, offsetX, offsetY, renderW, renderH);
        } else {
          // Contain (letterbox)
          ctx.fillStyle = '#0f172a';
          ctx.fillRect(0, 0, cw, ch);
          const imgRatio = iw / ih;
          const canvasRatio = cw / ch;
          let renderW = cw;
          let renderH = ch;
          let offsetX = 0;
          let offsetY = 0;

          if (imgRatio > canvasRatio) {
            renderH = cw / imgRatio;
            offsetY = (ch - renderH) / 2;
          } else {
            renderW = ch * imgRatio;
            offsetX = (cw - renderW) / 2;
          }
          ctx.drawImage(currentImage, offsetX, offsetY, renderW, renderH);
        }
      }

      updateOverlays();
    }

    function updateOverlays() {
      const topPct = parseFloat(sliderTop ? sliderTop.value : '14');
      const bottomPct = parseFloat(sliderBottom ? sliderBottom.value : '22');
      const rightPct = parseFloat(sliderRight ? sliderRight.value : '16');
      const leftPct = parseFloat(sliderLeft ? sliderLeft.value : '6');

      // Update text labels
      if (valTop) valTop.textContent = `${topPct}% (~${Math.round(1920 * (topPct / 100))}px)`;
      if (valBottom) valBottom.textContent = `${bottomPct}% (~${Math.round(1920 * (bottomPct / 100))}px)`;
      if (valRight) valRight.textContent = `${rightPct}% (~${Math.round(1080 * (rightPct / 100))}px)`;
      if (valLeft) valLeft.textContent = `${leftPct}% (~${Math.round(1080 * (leftPct / 100))}px)`;

      // Apply margins to Safe Zone Box
      if (guideSafeBox) {
        guideSafeBox.style.top = `${topPct}%`;
        guideSafeBox.style.bottom = `${bottomPct}%`;
        guideSafeBox.style.right = `${rightPct}%`;
        guideSafeBox.style.left = `${leftPct}%`;
        guideSafeBox.style.display = (toggleSafeZone && toggleSafeZone.checked) ? 'block' : 'none';
      }

      // 4:5 and 1:1 crops
      const showCrops = toggleCropLines && toggleCropLines.checked;
      if (guide45Crop) guide45Crop.style.display = showCrops ? 'block' : 'none';
      if (guide11Crop) guide11Crop.style.display = showCrops ? 'block' : 'none';

      // Rule of Thirds
      if (guideThirds) {
        guideThirds.style.display = (toggleGridThirds && toggleGridThirds.checked) ? 'block' : 'none';
      }

      // Instagram UI Mockup
      if (instaUiElements) {
        instaUiElements.style.display = (toggleInstaUi && toggleInstaUi.checked) ? 'flex' : 'none';
      }
    }

    function loadSample(type) {
      sampleType = type;
      isDefaultSample = true;
      const demoCanvas = generateDemoCanvas(type);
      currentImage.src = demoCanvas.toDataURL('image/png');
      currentImage.onload = () => {
        renderStage();
        if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
        if (loadedFileIndicator) loadedFileIndicator.style.display = 'none';
      };
    }

    function handleFileSelection(file) {
      if (!file) return;

      const isVideo = file.type.startsWith('video/') || /\.(mp4|webm|mov)$/i.test(file.name);
      const isImage = file.type.startsWith('image/') || /\.(png|jpe?g|webp)$/i.test(file.name);

      if (!isVideo && !isImage) {
        alert('Please upload an image (PNG, JPG, WebP) or video file (MP4, WebM, MOV).');
        return;
      }

      isDefaultSample = false;
      samplePresetBtns.forEach(b => b.classList.remove('active'));

      if (labelFilename) labelFilename.textContent = file.name;

      if (mediaBlobUrl) {
        URL.revokeObjectURL(mediaBlobUrl);
      }
      mediaBlobUrl = URL.createObjectURL(file);

      if (isImage) {
        currentImage.src = mediaBlobUrl;
        currentImage.onload = () => {
          if (labelDimensions) {
            labelDimensions.textContent = `${currentImage.naturalWidth} × ${currentImage.naturalHeight} • ${(file.size / (1024 * 1024)).toFixed(2)} MB`;
          }
          if (dropzonePrompt) dropzonePrompt.style.display = 'none';
          if (loadedFileIndicator) loadedFileIndicator.style.display = 'flex';
          renderStage();
        };
      } else {
        // Video Frame Extraction
        const vid = document.createElement('video');
        vid.src = mediaBlobUrl;
        vid.muted = true;
        vid.playsInline = true;
        vid.currentTime = 0.1; // Seek to early keyframe
        vid.onloadeddata = () => {
          const vCanvas = document.createElement('canvas');
          vCanvas.width = vid.videoWidth || 1080;
          vCanvas.height = vid.videoHeight || 1920;
          const vCtx = vCanvas.getContext('2d');
          if (vCtx) {
            vCtx.drawImage(vid, 0, 0, vCanvas.width, vCanvas.height);
            currentImage.src = vCanvas.toDataURL('image/png');
            currentImage.onload = () => {
              if (labelDimensions) {
                labelDimensions.textContent = `${vid.videoWidth} × ${vid.videoHeight} • Video Frame`;
              }
              if (dropzonePrompt) dropzonePrompt.style.display = 'none';
              if (loadedFileIndicator) loadedFileIndicator.style.display = 'flex';
              renderStage();
            };
          }
        };
      }
    }

    // Drag and Drop Listeners
    if (dropzone) {
      dropzone.addEventListener('click', (e) => {
        if (e.target && (e.target.id === 'btn-change-file' || e.target.closest('#btn-change-file'))) {
          return;
        }
        if (mediaInput) mediaInput.click();
      });

      ['dragenter', 'dragover'].forEach(evt => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach(evt => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          handleFileSelection(dt.files[0]);
        }
      });
    }

    if (mediaInput) {
      mediaInput.addEventListener('change', () => {
        if (mediaInput.files && mediaInput.files.length > 0) {
          handleFileSelection(mediaInput.files[0]);
        }
      });
    }

    if (btnChangeFile) {
      btnChangeFile.addEventListener('click', (e) => {
        e.stopPropagation();
        if (mediaInput) mediaInput.click();
      });
    }

    // Sample preset click
    samplePresetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        samplePresetBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const st = btn.getAttribute('data-sample') || 'creator';
        loadSample(st);
      });
    });

    // Reset Tool
    if (btnResetTool) {
      btnResetTool.addEventListener('click', () => {
        if (mediaInput) mediaInput.value = '';
        if (mediaBlobUrl) {
          URL.revokeObjectURL(mediaBlobUrl);
          mediaBlobUrl = null;
        }
        samplePresetBtns.forEach(b => b.classList.remove('active'));
        const firstPreset = document.querySelector('.btn-sample-preset[data-sample="creator"]');
        if (firstPreset) firstPreset.classList.add('active');
        loadSample('creator');
      });
    }

    // Toggle Checkboxes Listeners
    [toggleSafeZone, toggleInstaUi, toggleCropLines, toggleGridThirds].forEach(toggle => {
      if (toggle) toggle.addEventListener('change', updateOverlays);
    });

    // Sliders Listeners
    [sliderTop, sliderBottom, sliderRight, sliderLeft].forEach(slider => {
      if (slider) slider.addEventListener('input', updateOverlays);
    });

    // Reset Margins Button
    if (btnResetMargins) {
      btnResetMargins.addEventListener('click', () => {
        if (sliderTop) sliderTop.value = String(DEFAULTS.top);
        if (sliderBottom) sliderBottom.value = String(DEFAULTS.bottom);
        if (sliderRight) sliderRight.value = String(DEFAULTS.right);
        if (sliderLeft) sliderLeft.value = String(DEFAULTS.left);
        updateOverlays();
      });
    }

    // Scale Mode Radio Listeners
    scaleRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          scaleMode = radio.value;
          renderStage();
        }
      });
    });

    // =========================================================================
    // EXPORT & DOWNLOAD CAPABILITIES
    // =========================================================================
    // 1. Download Composed Preview with Safe Zones (1080 × 1920 PNG)
    if (btnDownloadPreview) {
      btnDownloadPreview.addEventListener('click', () => {
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = 1080;
        exportCanvas.height = 1920;
        const eCtx = exportCanvas.getContext('2d');
        if (!eCtx) return;

        // Draw image layer
        eCtx.drawImage(canvas, 0, 0);

        const topPct = parseFloat(sliderTop ? sliderTop.value : '14') / 100;
        const bottomPct = parseFloat(sliderBottom ? sliderBottom.value : '22') / 100;
        const rightPct = parseFloat(sliderRight ? sliderRight.value : '16') / 100;
        const leftPct = parseFloat(sliderLeft ? sliderLeft.value : '6') / 100;

        const safeX = 1080 * leftPct;
        const safeY = 1920 * topPct;
        const safeW = 1080 * (1 - leftPct - rightPct);
        const safeH = 1920 * (1 - topPct - bottomPct);

        // Draw Safe Zone Box if enabled
        if (toggleSafeZone && toggleSafeZone.checked) {
          eCtx.strokeStyle = '#10b981';
          eCtx.lineWidth = 4;
          eCtx.strokeRect(safeX, safeY, safeW, safeH);

          eCtx.fillStyle = 'rgba(16, 185, 129, 0.12)';
          eCtx.fillRect(safeX, safeY, safeW, safeH);

          eCtx.fillStyle = '#10b981';
          eCtx.font = 'bold 24px sans-serif';
          eCtx.fillText('CONTENT SAFE AREA', safeX + 12, safeY + 36);
        }

        // Draw 4:5 Crop if enabled (Top/Bottom 285px)
        if (toggleCropLines && toggleCropLines.checked) {
          eCtx.strokeStyle = '#3b82f6';
          eCtx.lineWidth = 3;
          eCtx.setLineDash([12, 8]);
          eCtx.beginPath();
          eCtx.moveTo(0, 285);
          eCtx.lineTo(1080, 285);
          eCtx.moveTo(0, 1635);
          eCtx.lineTo(1080, 1635);
          eCtx.stroke();

          // 1:1 Profile Crop (Top/Bottom 420px)
          eCtx.strokeStyle = '#a855f7';
          eCtx.beginPath();
          eCtx.moveTo(0, 420);
          eCtx.lineTo(1080, 420);
          eCtx.moveTo(0, 1500);
          eCtx.lineTo(1080, 1500);
          eCtx.stroke();
          eCtx.setLineDash([]);
        }

        // Download trigger
        const link = document.createElement('a');
        link.download = 'instagram_reels_safe_zone_preview.png';
        link.href = exportCanvas.toDataURL('image/png');
        link.click();
      });
    }

    // 2. Download Transparent 9:16 Overlay Template (1080 × 1920 PNG)
    if (btnDownloadTemplate) {
      btnDownloadTemplate.addEventListener('click', () => {
        const templateCanvas = document.createElement('canvas');
        templateCanvas.width = 1080;
        templateCanvas.height = 1920;
        const tCtx = templateCanvas.getContext('2d');
        if (!tCtx) return;

        // Clear to transparent
        tCtx.clearRect(0, 0, 1080, 1920);

        // Safe Zone Box
        const topPct = parseFloat(sliderTop ? sliderTop.value : '14') / 100;
        const bottomPct = parseFloat(sliderBottom ? sliderBottom.value : '22') / 100;
        const rightPct = parseFloat(sliderRight ? sliderRight.value : '16') / 100;
        const leftPct = parseFloat(sliderLeft ? sliderLeft.value : '6') / 100;

        const safeX = 1080 * leftPct;
        const safeY = 1920 * topPct;
        const safeW = 1080 * (1 - leftPct - rightPct);
        const safeH = 1920 * (1 - topPct - bottomPct);

        tCtx.strokeStyle = '#10b981';
        tCtx.lineWidth = 4;
        tCtx.strokeRect(safeX, safeY, safeW, safeH);

        tCtx.fillStyle = 'rgba(16, 185, 129, 0.1)';
        tCtx.fillRect(safeX, safeY, safeW, safeH);

        tCtx.fillStyle = '#10b981';
        tCtx.font = 'bold 28px sans-serif';
        tCtx.fillText('CONTENT SAFE ZONE', safeX + 16, safeY + 40);

        // 4:5 Crop Line Guide (Top/Bottom 285px)
        tCtx.strokeStyle = '#3b82f6';
        tCtx.lineWidth = 3;
        tCtx.setLineDash([14, 8]);
        tCtx.beginPath();
        tCtx.moveTo(0, 285);
        tCtx.lineTo(1080, 285);
        tCtx.moveTo(0, 1635);
        tCtx.lineTo(1080, 1635);
        tCtx.stroke();
        tCtx.fillStyle = '#3b82f6';
        tCtx.font = 'bold 22px sans-serif';
        tCtx.fillText('4:5 FEED CROP TOP (285px)', 16, 275);
        tCtx.fillText('4:5 FEED CROP BOTTOM (1635px)', 16, 1665);

        // 1:1 Profile Crop Guide (Top/Bottom 420px)
        tCtx.strokeStyle = '#a855f7';
        tCtx.beginPath();
        tCtx.moveTo(0, 420);
        tCtx.lineTo(1080, 420);
        tCtx.moveTo(0, 1500);
        tCtx.lineTo(1080, 1500);
        tCtx.stroke();
        tCtx.fillStyle = '#a855f7';
        tCtx.fillText('1:1 PROFILE GRID TOP (420px)', 16, 410);
        tCtx.fillText('1:1 PROFILE GRID BOTTOM (1500px)', 16, 1530);

        const link = document.createElement('a');
        link.download = 'instagram_reels_9x16_safe_zone_template.png';
        link.href = templateCanvas.toDataURL('image/png');
        link.click();
      });
    }

    // Initial Load
    loadSample('creator');
  }

  // Handle both DOM load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstagramReelsSafeZoneChecker);
  } else {
    initInstagramReelsSafeZoneChecker();
  }

  document.addEventListener('astro:after-swap', initInstagramReelsSafeZoneChecker);
</script>

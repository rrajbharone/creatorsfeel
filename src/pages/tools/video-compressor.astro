    transition: all var(--transition-fast);
  }

  .calc-btn-secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg);
  }

  .btn-svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
  }

  /* Right Column: Results & Progress */
  .calc-results {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: 100%;
  }

  /* Empty State Placeholder */
  .empty-state-card {
    min-height: 340px;
    padding: 2rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }

  .empty-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .empty-svg {
    width: 28px;
    height: 28px;
  }

  .empty-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .empty-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 320px;
    margin: 0;
    line-height: 1.45;
  }

  /* Progress Card */
  .progress-card {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .progress-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .progress-pct {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-brand);
  }

  .progress-bar-bg {
    width: 100%;
    height: 10px;
    background: var(--color-bg);
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--gradient-brand);
    border-radius: 999px;
    transition: width 0.15s ease-out;
  }

  .progress-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Results Display Box */
  .results-display-box {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: 100%;
  }

  /* Verdict Status Banner */
  .verdict-banner {
    padding: 0.9rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .verdict-banner.success-verdict {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.08);
  }

  .verdict-icon {
    font-size: 1.4rem;
  }

  .verdict-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .verdict-title {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .verdict-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* 4 Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .metric-card {
    padding: 0.8rem 0.6rem;
    text-align: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: border-color var(--transition-fast);
  }

  .metric-card:hover {
    border-color: var(--color-border-hover);
  }

  .metric-value {
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-brand);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.2rem;
  }

  .metric-sub {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Video Player Stage */
  .player-stage-card {
    padding: 1rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stage-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stage-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stage-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-brand);
    background: rgba(99, 102, 241, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .player-wrapper {
    width: 100%;
    max-height: 260px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #000000;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .compressed-video-player {
    max-width: 100%;
    max-height: 260px;
    outline: none;
  }

  .output-actions-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  /* Editorial Content Styles */
  .editorial-section {
    padding-top: 1.5rem;
  }

  .editorial-section h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .editorial-section p {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .editorial-section ul, .editorial-section ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .editorial-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .editorial-section code {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .editorial-table th, .editorial-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .editorial-table th {
    background: var(--color-bg-alt);
    font-weight: 700;
  }

  .editorial-table tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .internal-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-link-card {
    display: block;
    padding: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .tool-link-title {
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.35rem;
  }

  .tool-link-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const dropzonePrompt = document.getElementById('dropzone-prompt');
    const loadedFileBar = document.getElementById('loaded-file-bar');
    const loadedSourceVideo = document.getElementById('loaded-source-video') as HTMLVideoElement | null;
    const loadedFilename = document.getElementById('loaded-filename');
    const loadedFilesize = document.getElementById('loaded-filesize');
    const btnClearFile = document.getElementById('btn-clear-file');

    const compressionPreset = document.getElementById('compression-preset') as HTMLSelectElement | null;
    const resolutionSelect = document.getElementById('resolution-select') as HTMLSelectElement | null;
    const audioToggle = document.getElementById('audio-toggle') as HTMLSelectElement | null;

    const btnCompress = document.getElementById('btn-compress');
    const btnClearAll = document.getElementById('btn-clear-all');

    // Progress & Results Displays
    const emptyStateCard = document.getElementById('empty-state-card');
    const progressCard = document.getElementById('progress-card');
    const progressStatusText = document.getElementById('progress-status-text');
    const progressPctText = document.getElementById('progress-pct-text');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressSubText = document.getElementById('progress-sub-text');

    const resultsDisplayBox = document.getElementById('results-display-box');
    const resOrigSize = document.getElementById('res-orig-size');
    const resCompSize = document.getElementById('res-comp-size');
    const resSavings = document.getElementById('res-savings');
    const resSavingsSub = document.getElementById('res-savings-sub');
    const resResolution = document.getElementById('res-resolution');
    const resDuration = document.getElementById('res-duration');

    const compressedVideoPlayer = document.getElementById('compressed-video-player') as HTMLVideoElement | null;
    const btnDownloadVideo = document.getElementById('btn-download-video');

    if (!dropzone || !fileInput) return;

    let currentVideoFile: File | null = null;
    let sourceVideoUrl: string | null = null;
    let compressedBlobUrl: string | null = null;
    let outputDownloadName = 'compressed_video.webm';
    let isProcessing = false;

    // Drag & Drop Handling
    ['dragenter', 'dragover'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach(evtName => {
      dropzone.addEventListener(evtName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('dragover');
      });
    });

    dropzone.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFileSelection(dt.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFileSelection(fileInput.files[0]);
      }
    });

    if (btnClearFile) btnClearFile.addEventListener('click', resetState);
    if (btnClearAll) btnClearAll.addEventListener('click', resetState);

    function resetState() {
      currentVideoFile = null;
      isProcessing = false;
      if (fileInput) fileInput.value = '';
      if (sourceVideoUrl) {
        URL.revokeObjectURL(sourceVideoUrl);
        sourceVideoUrl = null;
      }
      if (compressedBlobUrl) {
        URL.revokeObjectURL(compressedBlobUrl);
        compressedBlobUrl = null;
      }
      if (loadedSourceVideo) loadedSourceVideo.src = '';
      if (dropzonePrompt) dropzonePrompt.style.display = 'flex';
      if (loadedFileBar) loadedFileBar.style.display = 'none';
      if (progressCard) progressCard.style.display = 'none';
      if (resultsDisplayBox) resultsDisplayBox.style.display = 'none';
      if (emptyStateCard) emptyStateCard.style.display = 'flex';
    }

    function formatTime(seconds: number): string {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function handleFileSelection(file: File) {
      if (!file || !file.type.startsWith('video/')) {
        alert('Please upload a valid video file (MP4, WebM, MOV, MKV).');
        return;
      }

      currentVideoFile = file;
      const mbSize = (file.size / (1024 * 1024)).toFixed(2);
      if (loadedFilename) loadedFilename.textContent = file.name;
      outputDownloadName = `compressed_${file.name.replace(/\.[^/.]+$/, "")}.webm`;

      if (sourceVideoUrl) URL.revokeObjectURL(sourceVideoUrl);
      sourceVideoUrl = URL.createObjectURL(file);

      if (loadedSourceVideo) {
        loadedSourceVideo.src = sourceVideoUrl;
        loadedSourceVideo.onloadedmetadata = () => {
          const w = loadedSourceVideo.videoWidth;
          const h = loadedSourceVideo.videoHeight;
          const dur = formatTime(loadedSourceVideo.duration);

          if (loadedFilesize) {
            loadedFilesize.textContent = `${mbSize} MB • ${dur} • ${w}×${h}`;
          }

          if (dropzonePrompt) dropzonePrompt.style.display = 'none';
          if (loadedFileBar) loadedFileBar.style.display = 'flex';
        };
      }
    }

    // High-Efficiency Canvas & MediaRecorder Client-Side Video Compressor
    async function startCompression() {
      if (!currentVideoFile || !sourceVideoUrl || !loadedSourceVideo) {
        alert('Please select or upload a video file first.');
        return;
      }

      if (isProcessing) return;
      isProcessing = true;

      // Show Progress UI
      if (emptyStateCard) emptyStateCard.style.display = 'none';
      if (resultsDisplayBox) resultsDisplayBox.style.display = 'none';
      if (progressCard) progressCard.style.display = 'flex';
      updateProgress(0, 'Preparing video encoder...');

      try {
        const video = document.createElement('video');
        video.src = sourceVideoUrl;
        video.muted = false;
        video.crossOrigin = 'anonymous';
        video.playsInline = true;

        await new Promise((res) => {
          video.onloadedmetadata = res;
        });

        const origW = video.videoWidth || 1280;
        const origH = video.videoHeight || 720;
        const duration = video.duration || 1;

        // Calculate Target Dimensions
        const resChoice = resolutionSelect?.value || 'original';
        let targetW = origW;
        let targetH = origH;

        if (resChoice !== 'original') {
          const targetHeight = parseInt(resChoice, 10);
          const aspect = origW / origH;
          targetH = targetHeight;
          targetW = Math.round(targetHeight * aspect);
          // Make even
          if (targetW % 2 !== 0) targetW += 1;
          if (targetH % 2 !== 0) targetH += 1;
        }

        // Calculate Target Bitrate
        const preset = compressionPreset?.value || 'balanced';
        let videoBitrate = 1200000; // ~1.2 Mbps balanced
        if (preset === 'aggressive') videoBitrate = 600000; // ~600 Kbps aggressive
        if (preset === 'light') videoBitrate = 2500000; // ~2.5 Mbps light

        const keepAudio = audioToggle?.value === 'keep';

        // Setup Offscreen Canvas
        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d', { alpha: false });
        if (!ctx) throw new Error('Canvas 2D context creation failed.');

        // Setup MediaStream
        const stream = canvas.captureStream(30);

        // Setup Audio Stream if available and enabled
        let audioContext: AudioContext | null = null;
        if (keepAudio) {
          try {
            audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
            const source = audioContext.createMediaElementSource(video);
            const destination = audioContext.createMediaStreamDestination();
            source.connect(destination);
            const audioTrack = destination.stream.getAudioTracks()[0];
            if (audioTrack) {
              stream.addTrack(audioTrack);
            }
          } catch (e) {
            console.warn('Audio extraction warning:', e);
          }
        }

        // Determine Supported MimeType
        let mimeType = 'video/webm';
        if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus')) {
          mimeType = 'video/webm;codecs=vp9,opus';
        } else if (MediaRecorder.isTypeSupported('video/webm;codecs=vp8,opus')) {
          mimeType = 'video/webm;codecs=vp8,opus';
        }

        const recorder = new MediaRecorder(stream, {
          mimeType,
          videoBitsPerSecond: videoBitrate,
          audioBitsPerSecond: keepAudio ? 96000 : undefined
        });

        const recordedChunks: Blob[] = [];
        recorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) {
            recordedChunks.push(e.data);
          }
        };

        // Frame rendering loop
        let isEnded = false;
        video.currentTime = 0;

        recorder.start(100);
        await video.play();

        const renderFrame = () => {
          if (isEnded) return;

          ctx.drawImage(video, 0, 0, targetW, targetH);
          const pct = Math.min(99, Math.round((video.currentTime / duration) * 100));
          updateProgress(pct, `Compressing video frames... (${pct}%)`);

          if (!video.paused && !video.ended) {
            requestAnimationFrame(renderFrame);
          }
        };

        requestAnimationFrame(renderFrame);

        await new Promise((res) => {
          video.onended = () => {
            isEnded = true;
            recorder.stop();
            res(true);
          };
        });

        // Wait for recorder to finalize
        await new Promise((res) => {
          recorder.onstop = res;
        });

        if (audioContext) {
          audioContext.close();
        }

        // Finalize Compressed Blob
        const compressedBlob = new Blob(recordedChunks, { type: mimeType });
        if (compressedBlobUrl) URL.revokeObjectURL(compressedBlobUrl);
        compressedBlobUrl = URL.createObjectURL(compressedBlob);

        const origSizeMB = (currentVideoFile.size / (1024 * 1024)).toFixed(2);
        const compSizeMB = (compressedBlob.size / (1024 * 1024)).toFixed(2);
        const savingsPct = Math.round(((currentVideoFile.size - compressedBlob.size) / currentVideoFile.size) * 100);

        // Update UI Results
        if (resOrigSize) resOrigSize.textContent = `${origSizeMB} MB`;
        if (resCompSize) resCompSize.textContent = `${compSizeMB} MB`;
        if (resResolution) resResolution.textContent = `${targetW} × ${targetH}`;
        if (resDuration) resDuration.textContent = `${formatTime(duration)} Duration`;
        if (resSavings) {
          if (savingsPct > 0) {
            resSavings.textContent = `-${savingsPct}%`;
            resSavings.style.color = 'var(--color-brand)';
            if (resSavingsSub) resSavingsSub.textContent = 'Size Reduction';
          } else {
            resSavings.textContent = `+${Math.abs(savingsPct)}%`;
            resSavings.style.color = 'var(--color-text-muted)';
            if (resSavingsSub) resSavingsSub.textContent = 'Optimized Quality';
          }
        }

        if (compressedVideoPlayer) {
          compressedVideoPlayer.src = compressedBlobUrl;
        }

        if (progressCard) progressCard.style.display = 'none';
        if (resultsDisplayBox) {
          resultsDisplayBox.style.display = 'flex';
          if (window.innerWidth < 992) {
            resultsDisplayBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        isProcessing = false;

      } catch (err: any) {
        isProcessing = false;
        alert(`Compression Error: ${err.message || 'Unable to compress video file.'}`);
        if (progressCard) progressCard.style.display = 'none';
        if (emptyStateCard) emptyStateCard.style.display = 'flex';
      }
    }

    function updateProgress(pct: number, msg: string) {
      if (progressPctText) progressPctText.textContent = `${pct}%`;
      if (progressBarFill) progressBarFill.style.width = `${pct}%`;
      if (progressStatusText) progressStatusText.textContent = msg;
    }

    if (btnCompress) {
      btnCompress.addEventListener('click', startCompression);
    }

    // Download Compressed Video Handler
    if (btnDownloadVideo) {
      btnDownloadVideo.addEventListener('click', () => {
        if (!compressedBlobUrl) return;

        const a = document.createElement('a');
        a.href = compressedBlobUrl;
        a.download = outputDownloadName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
    }
  });
</script>

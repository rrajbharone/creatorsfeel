<script>
  const setupMetaDescriptionChecker = () => {
    const titleInput = document.getElementById('title-input') as HTMLInputElement;
    const descInput = document.getElementById('description-input') as HTMLTextAreaElement;
    const targetInput = document.getElementById('target-keyword-input') as HTMLInputElement;

    // View Toggles
    const desktopViewBtn = document.getElementById('desktop-view-btn');
    const mobileViewBtn = document.getElementById('mobile-view-btn');

    // Actions
    const analyzeBtn = document.getElementById('analyze-btn');
    const resetBtn = document.getElementById('reset-btn');

    // Layout slots
    const resultsWrapper = document.getElementById('results-wrapper');

    // Stat targets
    const statCharCount = document.getElementById('stat-char-count');
    const statCharBadge = document.getElementById('stat-char-badge');
    const statPixelWidth = document.getElementById('stat-pixel-width');
    const statPixelBadge = document.getElementById('stat-pixel-badge');
    const statKeywordMatch = document.getElementById('stat-keyword-match');

    // Mockup targets
    const mockupTitleLink = document.getElementById('mockup-title-link');
    const mockupDescText = document.getElementById('mockup-desc-text');

    let currentViewMode = 'desktop'; // 'desktop' or 'mobile'

    // Helper to calculate pixel width of text
    const getTextPixelWidth = (text: string, font: string = '14px Arial') => {
      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d');
      if (context) {
        context.font = font;
        return Math.ceil(context.measureText(text).width);
      }
      return text.length * 8; // fallback approximation
    };

    const runAnalysis = () => {
      const title = titleInput?.value || 'How to Grow Your Instagram Account in 2026';
      const desc = descInput?.value || '';
      const targetKw = (targetInput?.value || '').trim().toLowerCase();

      const charCount = desc.length;
      const pixelWidth = getTextPixelWidth(desc, '14px Arial');

      // Update stat cards
      if (statCharCount) statCharCount.textContent = charCount.toString();
      if (statPixelWidth) statPixelWidth.textContent = `${pixelWidth} px`;

      // Character count badges
      if (statCharBadge) {
        if (charCount > 160) {
          statCharBadge.textContent = 'Too Long (> 160)';
          statCharBadge.style.background = '#ffeeef';
          statCharBadge.style.color = '#ef4444';
        } else if (charCount < 120) {
          statCharBadge.textContent = 'Too Short (< 120)';
          statCharBadge.style.background = '#fef3c7';
          statCharBadge.style.color = '#d97706';
        } else {
          statCharBadge.textContent = 'Optimal (120-160)';
          statCharBadge.style.background = '#dcfce7';
          statCharBadge.style.color = '#16a34a';
        }
      }

      // Pixel count badges
      if (statPixelBadge) {
        const limit = currentViewMode === 'desktop' ? 960 : 680;
        if (pixelWidth > limit) {
          statPixelBadge.textContent = `Too Wide (> ${limit}px)`;
          statPixelBadge.style.background = '#ffeeef';
          statPixelBadge.style.color = '#ef4444';
        } else {
          statPixelBadge.textContent = `Optimal (< ${limit}px)`;
          statPixelBadge.style.background = '#dcfce7';
          statPixelBadge.style.color = '#16a34a';
        }
      }

      // Keyword matching
      if (statKeywordMatch) {
        if (targetKw && desc.toLowerCase().includes(targetKw)) {
          statKeywordMatch.textContent = 'Found ✓';
          statKeywordMatch.style.color = '#16a34a';
        } else if (targetKw) {
          statKeywordMatch.textContent = 'Missing ⚠️';
          statKeywordMatch.style.color = '#ef4444';
        } else {
          statKeywordMatch.textContent = 'N/A';
          statKeywordMatch.style.color = 'var(--color-text-muted)';
        }
      }

      // Update Mockup link title
      if (mockupTitleLink) {
        mockupTitleLink.textContent = title;
        // Truncate title in preview if too long (desktop 600px, mobile 550px)
        const titleLimit = currentViewMode === 'desktop' ? 600 : 520;
        const titleWidth = getTextPixelWidth(title, '19px Arial');
        if (titleWidth > titleLimit) {
          mockupTitleLink.style.whiteSpace = 'nowrap';
        } else {
          mockupTitleLink.style.whiteSpace = 'normal';
        }
      }

      // Update Mockup description text with keyword highlight and truncation
      if (mockupDescText) {
        const pixelLimit = currentViewMode === 'desktop' ? 960 : 680;
        let truncatedDesc = desc;

        // Truncate logic by pixel width
        if (pixelWidth > pixelLimit) {
          let temp = desc;
          while (getTextPixelWidth(temp + '...', '14px Arial') > pixelLimit && temp.length > 0) {
            temp = temp.slice(0, -1);
          }
          truncatedDesc = temp + '...';
        }

        if (targetKw && truncatedDesc.toLowerCase().includes(targetKw)) {
          const escKw = targetKw.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&');
          const highlightHtml = truncatedDesc.replace(new RegExp(`(${escKw})`, 'gi'), `<mark style="background: none; font-weight: 700; color: #000000; padding: 0;">$1</mark>`);
          mockupDescText.innerHTML = highlightHtml;
        } else {
          mockupDescText.textContent = truncatedDesc;
        }
      }

      resultsWrapper?.classList.remove('hidden');
    };

    // Toggle view modes
    desktopViewBtn?.addEventListener('click', () => {
      currentViewMode = 'desktop';
      desktopViewBtn.style.background = 'var(--color-brand)';
      desktopViewBtn.style.color = 'white';
      if (mobileViewBtn) {
        mobileViewBtn.style.background = '#f1f3f4';
        mobileViewBtn.style.color = '#3c4043';
      }
      runAnalysis();
    });

    mobileViewBtn?.addEventListener('click', () => {
      currentViewMode = 'mobile';
      mobileViewBtn.style.background = 'var(--color-brand)';
      mobileViewBtn.style.color = 'white';
      if (desktopViewBtn) {
        desktopViewBtn.style.background = '#f1f3f4';
        desktopViewBtn.style.color = '#3c4043';
      }
      runAnalysis();
    });

    analyzeBtn?.addEventListener('click', () => {
      runAnalysis();

      const resultsSection = document.getElementById('results-wrapper');
      if (resultsSection) {
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    resetBtn?.addEventListener('click', () => {
      if (titleInput) titleInput.value = '';
      if (descInput) descInput.value = '';
      if (targetInput) targetInput.value = '';
      resultsWrapper?.classList.add('hidden');
    });

    // Auto-run initial analysis
    runAnalysis();
  };

  setupMetaDescriptionChecker();
  document.addEventListener('astro:after-swap', setupMetaDescriptionChecker);
</script>

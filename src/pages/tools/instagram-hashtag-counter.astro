</style>

<script>
  function initInstagramHashtagCounter() {
    const captionInput = document.getElementById('caption-input');
    const labelLiveCharCount = document.getElementById('label-live-char-count');
    const progressMeterFill = document.getElementById('progress-meter-fill');

    const btnCleanSpacing = document.getElementById('btn-clean-spacing');
    const btnPasteText = document.getElementById('btn-paste-text');
    const btnCopyHashtags = document.getElementById('btn-copy-hashtags');
    const copyHashtagsLabel = document.getElementById('copy-hashtags-label');
    const btnCopyCaption = document.getElementById('btn-copy-caption');
    const copyCaptionLabel = document.getElementById('copy-caption-label');
    const btnClearAll = document.getElementById('btn-clear-all');
    const btnCopyAllChips = document.getElementById('btn-copy-all-chips');

    const banner = document.getElementById('density-status-banner');
    const bannerTitle = document.getElementById('density-title');
    const bannerBadge = document.getElementById('density-badge');
    const bannerDesc = document.getElementById('density-desc');

    const valTotalHashtags = document.getElementById('val-total-hashtags');
    const subTotalDetail = document.getElementById('sub-total-detail');
    const valUniqueHashtags = document.getElementById('val-unique-hashtags');
    const subUniqueDetail = document.getElementById('sub-unique-detail');
    const valRemainingHashtags = document.getElementById('val-remaining-hashtags');
    const subAllowanceDetail = document.getElementById('sub-allowance-detail');
    const badgeAllowanceTag = document.getElementById('badge-allowance-tag');
    const valCharacterCount = document.getElementById('val-character-count');

    const detectedCountBadge = document.getElementById('detected-count-badge');
    const chipsContainer = document.getElementById('chips-container');

    if (!captionInput) return;

    let extractedTagsList = [];
    let uniqueTagsList = [];

    function analyzeText() {
      const text = captionInput.value || '';
      const charCount = text.length;

      // Update character counter and progress bar
      if (labelLiveCharCount) labelLiveCharCount.textContent = `${charCount.toLocaleString('en-US')} / 2,200 chars`;
      if (valCharacterCount) valCharacterCount.textContent = charCount.toLocaleString('en-US');

      const percent = Math.min(100, (charCount / 2200) * 100);
      if (progressMeterFill) {
        progressMeterFill.style.width = `${percent}%`;
        if (charCount > 2200) {
          progressMeterFill.style.background = '#ef4444';
        } else {
          progressMeterFill.style.background = 'linear-gradient(90deg, #6366f1, #ec4899)';
        }
      }

      // Regex to extract hashtags: matches # followed by Unicode letters, numbers, and underscores
      const regex = /#([\p{L}\p{N}_]+)/gu;
      const rawMatches = [];
      let match;
      while ((match = regex.exec(text)) !== null) {
        rawMatches.push('#' + match[1]);
      }

      extractedTagsList = rawMatches;
      const totalCount = extractedTagsList.length;

      // Group and count occurrences (case-insensitive for uniqueness)
      const tagCounts = new Map();
      extractedTagsList.forEach(tag => {
        const lower = tag.toLowerCase();
        tagCounts.set(lower, (tagCounts.get(lower) || 0) + 1);
      });

      // Distinct unique tags preserving original casing of first appearance
      const uniqueTagsMap = new Map();
      extractedTagsList.forEach(tag => {
        const lower = tag.toLowerCase();
        if (!uniqueTagsMap.has(lower)) {
          uniqueTagsMap.set(lower, tag);
        }
      });

      uniqueTagsList = Array.from(uniqueTagsMap.values());
      const uniqueCount = uniqueTagsList.length;
      const duplicateCount = Math.max(0, totalCount - uniqueCount);
      const remainingLimit = 30 - totalCount;

      // Update stat cards
      if (valTotalHashtags) valTotalHashtags.textContent = totalCount.toString();
      if (subTotalDetail) subTotalDetail.textContent = `${totalCount} occurrence${totalCount === 1 ? '' : 's'} detected`;

      if (valUniqueHashtags) valUniqueHashtags.textContent = uniqueCount.toString();
      if (subUniqueDetail) subUniqueDetail.textContent = `${duplicateCount} duplicate tag${duplicateCount === 1 ? '' : 's'}`;

      if (valRemainingHashtags) {
        if (remainingLimit >= 0) {
          valRemainingHashtags.textContent = remainingLimit.toString();
          valRemainingHashtags.className = 'stat-number-display green-number';
          if (badgeAllowanceTag) {
            badgeAllowanceTag.textContent = '30 Limit';
            badgeAllowanceTag.className = 'stat-badge-tag badge-green-tag';
          }
          if (subAllowanceDetail) subAllowanceDetail.textContent = `${remainingLimit} slot${remainingLimit === 1 ? '' : 's'} available`;
        } else {
          valRemainingHashtags.textContent = `+${Math.abs(remainingLimit)}`;
          valRemainingHashtags.className = 'stat-number-display';
          valRemainingHashtags.style.color = '#ef4444';
          if (badgeAllowanceTag) {
            badgeAllowanceTag.textContent = 'Exceeded';
            badgeAllowanceTag.className = 'stat-badge-tag';
            badgeAllowanceTag.style.background = 'rgba(239, 68, 68, 0.15)';
            badgeAllowanceTag.style.color = '#ef4444';
          }
          if (subAllowanceDetail) subAllowanceDetail.textContent = `Exceeds 30 limit by ${Math.abs(remainingLimit)}`;
        }
      }

      // Update Status Recommendation Banner
      if (banner && bannerTitle && bannerBadge && bannerDesc) {
        if (totalCount === 0) {
          banner.className = 'density-status-banner status-neutral';
          bannerTitle.textContent = 'Awaiting Caption Input';
          bannerBadge.textContent = 'Ready';
          bannerDesc.textContent = 'Paste your drafted Instagram caption or list of hashtags above. The counter automatically extracts hashtags, spots duplicates, and verifies your count against Instagram\'s 30-tag ceiling.';
        } else if (totalCount > 30) {
          banner.className = 'density-status-banner status-exceeded';
          bannerTitle.textContent = 'Exceeded Instagram Limit (30 Tags)';
          bannerBadge.textContent = 'Over Limit';
          bannerDesc.textContent = `Danger: Your caption contains ${totalCount} hashtags, exceeding Instagram's maximum limit of 30. Instagram will reject the post or publish it with the caption completely stripped. Remove at least ${totalCount - 30} tag${totalCount - 30 === 1 ? '' : 's'}.`;
        } else if (duplicateCount > 0) {
          banner.className = 'density-status-banner status-within-limit';
          bannerTitle.textContent = `Duplicate Hashtags Detected (${duplicateCount} Repeats)`;
          bannerBadge.textContent = 'Action Needed';
          bannerDesc.textContent = `You have ${duplicateCount} repeated tag${duplicateCount === 1 ? '' : 's'} in your caption. Click "Copy Clean Caption" to automatically strip repetitive tags without losing formatting.`;
        } else if (totalCount >= 3 && totalCount <= 5) {
          banner.className = 'density-status-banner status-optimal';
          bannerTitle.textContent = 'Optimal Recommendation Range (3 to 5 Tags)';
          bannerBadge.textContent = 'Recommended';
          bannerDesc.textContent = 'Great balance! Instagram\'s creators team recommends using 3 to 5 highly relevant hashtags to give clear indexing signals without cluttering your post.';
        } else {
          banner.className = 'density-status-banner status-within-limit';
          bannerTitle.textContent = `Within Platform Allowance (${totalCount} of 30 Tags)`;
          bannerBadge.textContent = 'Safe to Post';
          bannerDesc.textContent = `Your hashtag count is within Instagram's 30-tag limit. You have ${remainingLimit} tag slot${remainingLimit === 1 ? '' : 's'} remaining.`;
        }
      }

      // Update detected chips
      if (detectedCountBadge) detectedCountBadge.textContent = `${uniqueCount} unique / ${totalCount} total`;

      if (chipsContainer) {
        if (totalCount === 0) {
          chipsContainer.innerHTML = '<div class="empty-chips-msg">Type or paste an Instagram caption above to extract and inspect hashtags.</div>';
        } else {
          chipsContainer.innerHTML = '';
          uniqueTagsMap.forEach((originalTag, lowerTag) => {
            const count = tagCounts.get(lowerTag) || 1;
            const isDup = count > 1;

            const chip = document.createElement('button');
            chip.type = 'button';
            chip.className = `tag-chip ${isDup ? 'is-duplicate' : ''}`;
            chip.title = `Click to copy ${originalTag}`;
            chip.innerHTML = `
              <span>${escapeHtml(originalTag)}</span>
              ${isDup ? `<span class="dup-count-badge">&times;${count}</span>` : ''}
            `;

            chip.addEventListener('click', () => {
              copyTextToClipboard(originalTag, chip);
            });

            chipsContainer.appendChild(chip);
          });
        }
      }
    }

    function escapeHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    async function copyTextToClipboard(text, btnElement) {
      try {
        await navigator.clipboard.writeText(text);
        showFeedback(btnElement, 'Copied!');
      } catch {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          showFeedback(btnElement, 'Copied!');
        } catch {
          showFeedback(btnElement, 'Error');
        }
      }
    }

    function showFeedback(btnElement, text) {
      if (!btnElement) return;
      const textSpan = btnElement.querySelector('span') || btnElement;
      const original = textSpan.textContent;
      textSpan.textContent = text;
      btnElement.style.pointerEvents = 'none';
      setTimeout(() => {
        textSpan.textContent = original;
        btnElement.style.pointerEvents = 'auto';
      }, 1500);
    }

    // Input listener
    captionInput.addEventListener('input', analyzeText);

    // Clean Spacing Button
    if (btnCleanSpacing) {
      btnCleanSpacing.addEventListener('click', () => {
        let val = captionInput.value || '';
        // Trim multiple consecutive spaces into single space, remove excessive empty lines
        val = val.replace(/[ \t]+/g, ' ');
        val = val.replace(/\n{3,}/g, '\n\n');
        captionInput.value = val.trim();
        analyzeText();
      });
    }

    // Paste Text Button
    if (btnPasteText) {
      btnPasteText.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) {
            captionInput.value = text;
            analyzeText();
          }
        } catch {
          captionInput.focus();
        }
      });
    }

    // Copy Unique Hashtags
    if (btnCopyHashtags && copyHashtagsLabel) {
      btnCopyHashtags.addEventListener('click', () => {
        if (uniqueTagsList.length === 0) return;
        const textToCopy = uniqueTagsList.join(' ');
        copyTextToClipboard(textToCopy, btnCopyHashtags);
      });
    }

    // Copy All Detected Hashtags
    if (btnCopyAllChips) {
      btnCopyAllChips.addEventListener('click', () => {
        if (extractedTagsList.length === 0) return;
        const textToCopy = extractedTagsList.join(' ');
        copyTextToClipboard(textToCopy, btnCopyAllChips);
      });
    }

    // Copy Clean Caption without Duplicate Hashtags
    if (btnCopyCaption && copyCaptionLabel) {
      btnCopyCaption.addEventListener('click', () => {
        const text = captionInput.value || '';
        if (!text.trim()) return;

        // Strip duplicate hashtags while preserving layout
        const seen = new Set();
        const words = text.split(/(\s+)/);
        const cleanWords = words.map(word => {
          if (word.startsWith('#')) {
            const lower = word.toLowerCase().trim();
            if (seen.has(lower)) {
              return '';
            }
            seen.add(lower);
          }
          return word;
        });

        let cleanText = cleanWords.join('');
        cleanText = cleanText.replace(/[ \t]{2,}/g, ' ').trim();
        copyTextToClipboard(cleanText, btnCopyCaption);
      });
    }

    // Clear All Button
    if (btnClearAll) {
      btnClearAll.addEventListener('click', () => {
        captionInput.value = '';
        captionInput.focus();
        analyzeText();
      });
    }

    // Initial analysis
    analyzeText();
  }

  // Handle both DOMContentLoaded and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstagramHashtagCounter);
  } else {
    initInstagramHashtagCounter();
  }

  document.addEventListener('astro:after-swap', initInstagramHashtagCounter);
</script>
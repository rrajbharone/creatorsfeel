---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    question: "Can I use this Discord emoji generator to create server emoji image files?",
    answer: "This tool generates copy-and-paste Unicode text styles, symbols, bracket badges, and Kaomojis for Discord messages, bios, server nicknames, and channel names. It does not create graphic image files (PNG/GIF). To upload custom image emojis to a Discord server, upload a 128x128 pixel square image under 256 KB directly in Discord via Server Settings > Emoji."
  },
  {
    question: "Will these styled text formats and Kaomojis work without Discord Nitro?",
    answer: "Yes, completely! Because all styles generated by this tool are composed of universal Unicode characters and standard keyboard symbols, they can be copied, pasted, and viewed by any user on any Discord server without requiring a paid Discord Nitro subscription."
  },
  {
    question: "Why do some Unicode symbols appear as empty boxes or question marks?",
    answer: "When a Unicode symbol displays as an empty rectangle, box, or question mark (often called a 'tofu' box), it means the viewer's device or operating system lacks font glyph support for that specific character. Modern iOS, Android, Windows, and macOS devices natively render these characters, but older operating systems may have limited font coverage."
  },
  {
    question: "Can I use styled text, badges, and symbols in Discord channel names?",
    answer: "Yes. Discord server administrators and moderators commonly use bracket styles (such as 『general』, 【rules】, or ✦-announcements) to establish organized, attractive visual hierarchy in server channel and category lists."
  },
  {
    question: "What are the character limits for Discord bios, nicknames, and messages?",
    answer: "Discord user bios ('About Me') support up to 190 characters, custom statuses allow up to 128 characters, server nicknames allow up to 32 characters, and standard chat messages support up to 2,000 characters (or 4,000 characters with Discord Nitro)."
  },
  {
    question: "Are Unicode text styles accessible for screen readers?",
    answer: "Mathematical alphanumeric Unicode styles (such as bold or monospace characters) are read aloud letter-by-letter by screen readers. For optimal accessibility, use styled text for short headlines, channel tags, and badges rather than entire multi-sentence paragraphs."
  }
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Tools', item: '/tools' },
  { name: 'Discord Emoji Generator', item: '/tools/discord-emoji-generator' }
];

const origin = Astro.site ? Astro.site.origin : "https://creatorsfeel.com";
const canonicalUrl = new URL(Astro.url.pathname, origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `${canonicalUrl}#application`,
      "name": "Discord Emoji Generator",
      "url": canonicalUrl,
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Free Discord Emoji Generator. Format copy-and-paste Unicode text styles, aesthetic bracket badges, and Kaomojis for Discord messages, bios, and channel names.",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Discord Emoji Generator - Custom Text Emojis, Symbols & Kaomojis"
  description="Free Discord Emoji Generator. Format copy-and-paste Unicode text styles, aesthetic bracket badges, and Kaomojis for Discord messages, bios, and channel names."
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script type="application/ld+json" slot="meta" set:html={JSON.stringify(softwareSchema)} />

  <div class="tool-page-wrapper">
    
    <!-- 1. HERO SECTION (Centered Max-Width 820px) -->
    <header class="tool-hero-section">
      <div class="container hero-inner">
        
        <!-- Breadcrumbs at top -->
        <div class="hero-breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>

        <!-- Pill Badge with SVG Icon (Zero Emojis) -->
        <div class="hero-badge">
          <span class="badge-icon-tool">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tool-svg" aria-hidden="true">

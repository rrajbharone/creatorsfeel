<script>
  function initYouTubeWatchTimeCalculator() {
    const inputCurrentHours = document.getElementById('input-current-hours') as HTMLInputElement | null;
    const inputDailyHours = document.getElementById('input-daily-hours') as HTMLInputElement | null;
    const targetTabs = document.querySelectorAll('.target-tab');

    const badgeTargetHeader = document.getElementById('badge-target-header');
    const gaugeRatioText = document.getElementById('gauge-ratio-text');
    const gaugePctBadge = document.getElementById('gauge-pct-badge');
    const progressBarFill = document.getElementById('progress-bar-fill');

    const achievedBanner = document.getElementById('achieved-banner');

    const valRemainingHours = document.getElementById('val-remaining-hours');
    const subRemainingDetail = document.getElementById('sub-remaining-detail');
    const valDaysRemaining = document.getElementById('val-days-remaining');
    const subDaysDetail = document.getElementById('sub-days-detail');
    const valProjectedDate = document.getElementById('val-projected-date');
    const subDateDetail = document.getElementById('sub-date-detail');
    const valCurrentDisplay = document.getElementById('val-current-display');
    const subCurrentDetail = document.getElementById('sub-current-detail');

    const resExplanationText = document.getElementById('res-explanation-text');
    const btnReset = document.getElementById('btn-reset');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const copySummaryLabel = document.getElementById('copy-summary-label');

    if (!inputCurrentHours || !inputDailyHours) return;

    let targetHours = 4000;

    function formatNumber(num: number): string {
      if (isNaN(num) || !isFinite(num)) return '0';
      return Math.round(num).toLocaleString('en-US');
    }

    function calculateWatchTime() {
      let current = parseFloat(inputCurrentHours?.value || '0');
      let daily = parseFloat(inputDailyHours?.value || '0');

      if (isNaN(current) || current < 0) current = 0;
      if (isNaN(daily) || daily < 0) daily = 0;

      const remainingHours = Math.max(0, targetHours - current);
      const progressPct = Math.min(100, Math.max(0, (current / targetHours) * 100));

      const isAchieved = current >= targetHours;

      // Calculate days remaining and completion date
      let daysRemainingText = 'N/A';
      let daysSubText = 'Enter daily watch hours > 0';
      let projectedDateText = 'N/A';
      let dateSubText = 'Requires active daily watch time';

      if (isAchieved) {
        daysRemainingText = '0 Days';
        daysSubText = 'Target requirement satisfied';
        projectedDateText = 'Achieved!';
        dateSubText = 'Milestone reached';
      } else if (daily > 0) {
        const estimatedDays = Math.ceil(remainingHours / daily);
        daysRemainingText = `${formatNumber(estimatedDays)} ${estimatedDays === 1 ? 'Day' : 'Days'}`;
        daysSubText = `Based on ${daily.toFixed(1)} daily watch hours`;

        // Calculate projected completion date from current date
        const now = new Date();
        const finishDate = new Date(now.getTime() + estimatedDays * 24 * 60 * 60 * 1000);
        
        const monthNames = [
          'January', 'February', 'March', 'April', 'May', 'June',
          'July', 'August', 'September', 'October', 'November', 'December'
        ];
        
        projectedDateText = `${monthNames[finishDate.getMonth()]} ${finishDate.getDate()}, ${finishDate.getFullYear()}`;
        dateSubText = 'Calculated from today at current pace';
      } else {
        daysRemainingText = 'No Pace';
        daysSubText = 'Daily accumulation is 0 hrs/day';
        projectedDateText = 'Pending';
        dateSubText = 'Waiting for watch time accumulation';
      }

      // Update Header Badge
      if (badgeTargetHeader) {
        badgeTargetHeader.textContent = `Progress to ${formatNumber(targetHours)} Watch Hours`;
      }

      // Update Progress Gauge
      if (gaugeRatioText) {
        gaugeRatioText.textContent = `${formatNumber(current)} / ${formatNumber(targetHours)} Hours`;
      }

      if (gaugePctBadge) {
        gaugePctBadge.textContent = `${progressPct.toFixed(1)}%`;
      }

      if (progressBarFill) {
        progressBarFill.style.width = `${progressPct}%`;
      }

      // Achieved Status Alert Banner
      if (achievedBanner) {
        achievedBanner.style.display = isAchieved ? 'flex' : 'none';
      }

      // Update 4 Metric Cards
      if (valRemainingHours) {
        valRemainingHours.textContent = isAchieved ? '0' : formatNumber(remainingHours);
      }

      if (subRemainingDetail) {
        subRemainingDetail.textContent = isAchieved
          ? `Target milestone satisfied (${formatNumber(targetHours)} hrs)`
          : `Hours left to reach ${formatNumber(targetHours)} threshold`;
      }

      if (valDaysRemaining) {
        valDaysRemaining.textContent = daysRemainingText;
      }

      if (subDaysDetail) {
        subDaysDetail.textContent = daysSubText;
      }

      if (valProjectedDate) {
        valProjectedDate.textContent = projectedDateText;
      }

      if (subDateDetail) {
        subDateDetail.textContent = dateSubText;
      }

      if (valCurrentDisplay) {
        valCurrentDisplay.textContent = formatNumber(current);
      }

      if (subCurrentDetail) {
        subCurrentDetail.textContent = `${progressPct.toFixed(1)}% of ${formatNumber(targetHours)} hour target`;
      }

      // Update Explanation Box
      if (resExplanationText) {
        if (isAchieved) {
          resExplanationText.innerHTML = `Your channel has reached <strong>${formatNumber(current)} valid watch hours</strong>, satisfying the <strong>${formatNumber(targetHours)}-hour threshold</strong>.`;
        } else if (daily > 0) {
          const daysNum = Math.ceil(remainingHours / daily);
          resExplanationText.innerHTML = `Calculation: <span class="formula-text">${formatNumber(targetHours)} target − ${formatNumber(current)} current = ${formatNumber(remainingHours)} remaining hours</span>. At <span class="formula-text">${daily.toFixed(1)} hours/day</span>, reaching the milestone will take an estimated <span class="formula-text">${formatNumber(daysNum)} days</span>.`;
        } else {
          resExplanationText.innerHTML = `Calculation: <span class="formula-text">${formatNumber(targetHours)} target − ${formatNumber(current)} current = ${formatNumber(remainingHours)} remaining hours</span>. Daily watch hour accumulation is currently set to 0.`;
        }
      }
    }

    // Live update listeners
    inputCurrentHours.addEventListener('input', calculateWatchTime);
    inputDailyHours.addEventListener('input', calculateWatchTime);

    // Target Milestone Selector Tabs
    targetTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const val = parseInt(tab.getAttribute('data-target') || '4000', 10);
        targetHours = val;

        targetTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-pressed', 'false');
        });

        tab.classList.add('active');
        tab.setAttribute('aria-pressed', 'true');

        calculateWatchTime();
      });
    });

    // Reset Handler
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (inputCurrentHours) inputCurrentHours.value = '1250';
        if (inputDailyHours) inputDailyHours.value = '12.5';

        targetHours = 4000;
        targetTabs.forEach(t => {
          const val = parseInt(t.getAttribute('data-target') || '4000', 10);
          if (val === 4000) {
            t.classList.add('active');
            t.setAttribute('aria-pressed', 'true');
          } else {
            t.classList.remove('active');
            t.setAttribute('aria-pressed', 'false');
          }
        });

        calculateWatchTime();
      });
    }

    // Copy Summary Action
    if (btnCopySummary && copySummaryLabel) {
      btnCopySummary.addEventListener('click', async () => {
        const current = inputCurrentHours.value || '0';
        const daily = inputDailyHours.value || '0';
        const remaining = valRemainingHours?.textContent || '0';
        const days = valDaysRemaining?.textContent || 'N/A';
        const finishDate = valProjectedDate?.textContent || 'N/A';
        const pct = gaugePctBadge?.textContent || '0%';

        const summaryText = `YouTube Watch Time Milestone Forecast (${formatNumber(targetHours)} Hours Goal):\n` +
          `• Current Valid Watch Hours: ${formatNumber(parseFloat(current))}\n` +
          `• Daily Watch Hours Pace: ${parseFloat(daily).toFixed(1)} hrs/day\n` +
          `• Progress: ${pct} Complete\n` +
          `• Remaining Watch Hours: ${remaining} hours\n` +
          `• Estimated Days Remaining: ${days}\n` +
          `• Projected Completion Date: ${finishDate}\n` +
          `Calculated with CreatorsFeel YouTube Watch Time Calculator: https://creatorsfeel.com/tools/youtube-watch-time-calculator`;

        try {
          await navigator.clipboard.writeText(summaryText);
          const original = copySummaryLabel.textContent;
          copySummaryLabel.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copySummaryLabel.textContent = original;
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    // Initial Execution
    calculateWatchTime();
  }

  // Handle both DOMContentLoaded and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYouTubeWatchTimeCalculator);
  } else {
    initYouTubeWatchTimeCalculator();
  }

  document.addEventListener('astro:after-swap', initYouTubeWatchTimeCalculator);
</script>

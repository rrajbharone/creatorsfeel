<script>
  const setupYoutubeWatchTimeCalculator = () => {
    const viewsInput = document.getElementById('views-input') as HTMLInputElement;
    const avdInput = document.getElementById('avd-input') as HTMLInputElement;
    const videoLengthInput = document.getElementById('video-length-input') as HTMLInputElement;
    const goalHoursInput = document.getElementById('goal-hours-input') as HTMLInputElement;

    // Actions
    const calculateBtn = document.getElementById('calculate-btn');
    const resetBtn = document.getElementById('reset-btn');

    // Layout slots
    const resultsWrapper = document.getElementById('results-wrapper');

    // Overview Stat Targets
    const statTotalHours = document.getElementById('stat-total-hours');
    const statTotalMins = document.getElementById('stat-total-mins');
    const statViewsNeeded = document.getElementById('stat-views-needed');
    const statRetentionPct = document.getElementById('stat-retention-pct');

    // Mockup Card Targets
    const mockupStatusBadge = document.getElementById('mockup-status-badge');
    const mockupProgressPct = document.getElementById('mockup-progress-pct');
    const mockupProgressBar = document.getElementById('mockup-progress-bar');
    const mockupCurrentHours = document.getElementById('mockup-current-hours');
    const mockupViewsNeeded = document.getElementById('mockup-views-needed');

    const runCalculation = () => {
      const views = Math.max(1, parseFloat(viewsInput?.value || '50000') || 50000);
      const avdMins = Math.max(0.05, parseFloat(avdInput?.value || '4.5') || 4.5);
      const videoLengthMins = Math.max(avdMins, parseFloat(videoLengthInput?.value || '10.0') || 10.0);
      const goalHours = Math.max(1, parseFloat(goalHoursInput?.value || '4000') || 4000);

      // Calculations
      const totalMinutes = views * avdMins;
      const totalHours = totalMinutes / 60;
      const progressPct = Math.min(100, (totalHours / goalHours) * 100);

      // Views needed to hit goal
      const viewsNeeded = Math.ceil((goalHours * 60) / avdMins);
      const retentionPct = Math.min(100, (avdMins / videoLengthMins) * 100);

      // Update stat cards
      if (statTotalHours) statTotalHours.textContent = `${totalHours.toLocaleString('en-US', { maximumFractionDigits: 1 })} Hrs`;
      if (statTotalMins) statTotalMins.textContent = `${totalMinutes.toLocaleString('en-US', { maximumFractionDigits: 0 })} Mins`;
      if (statViewsNeeded) statViewsNeeded.textContent = `${viewsNeeded.toLocaleString()} Views`;
      if (statRetentionPct) statRetentionPct.textContent = `${retentionPct.toFixed(1)}%`;

      // Update Mockup card
      if (mockupCurrentHours) mockupCurrentHours.textContent = `${totalHours.toLocaleString('en-US', { maximumFractionDigits: 0 })} hrs`;
      if (mockupProgressPct) mockupProgressPct.textContent = `${progressPct.toFixed(1)}%`;
      if (mockupProgressBar) mockupProgressBar.style.width = `${progressPct}%`;
      if (mockupViewsNeeded) mockupViewsNeeded.textContent = `${viewsNeeded.toLocaleString()} views`;

      if (mockupStatusBadge) {
        if (progressPct >= 100) {
          mockupStatusBadge.textContent = 'Unlocked! 🎉';
          mockupStatusBadge.style.color = '#16a34a';
          mockupStatusBadge.style.background = '#183820';
        } else {
          mockupStatusBadge.textContent = 'In Progress';
          mockupStatusBadge.style.color = '#f59e0b';
          mockupStatusBadge.style.background = '#272727';
        }
      }

      resultsWrapper?.classList.remove('hidden');
    };

    calculateBtn?.addEventListener('click', () => {
      runCalculation();

      const resultsSection = document.getElementById('results-wrapper');
      if (resultsSection) {
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    resetBtn?.addEventListener('click', () => {
      if (viewsInput) viewsInput.value = '50000';
      if (avdInput) avdInput.value = '4.5';
      if (videoLengthInput) videoLengthInput.value = '10.0';
      if (goalHoursInput) goalHoursInput.value = '4000';
      runCalculation();
    });

    // Auto-run initial calculation
    runCalculation();
  };

  setupYoutubeWatchTimeCalculator();
  document.addEventListener('astro:after-swap', setupYoutubeWatchTimeCalculator);
</script>

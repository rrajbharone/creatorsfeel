---

<BaseLayout
  title="CreatorsFeel - Everything You Need To Create, Grow & Succeed"
  description="CreatorsFeel provides free tools, resources and helpful guides to make your content creation journey easier, faster and more productive. Save time, optimize your content and grow your audience."
  breadcrumbs={breadcrumbs}
  canonicalUrl="https://creatorsfeel.com"
  hideGlow={true}
>
  <!-- 1. HERO SECTION (Matching Reference) -->
  <section class="hero-section">
    <div class="container hero-container">
      <!-- Left Column: Content, Headline, Search, Popular Chips -->
      <div class="hero-content">
        <!-- Small Pill Label -->
        <div class="hero-pill-badge">
          Tools &bull; Resources &bull; Growth
        </div>

        <!-- Large Bold Headline -->
        <h1 class="hero-title">
          Everything You Need<br />
          To <span class="text-purple-highlight">Create, Grow &amp; Succeed</span>
        </h1>

        <!-- Short Description -->
        <p class="hero-subtitle">
          CreatorsFeel provides free tools, resources and helpful guides to make your content creation journey easier, faster and more productive. Save time, optimize your content and grow your audience.
        </p>

        <!-- Wide Tool Search Field with Purple "Explore Tools" Button -->
        <div class="hero-search-container" id="hero-search-wrapper">
          <form action="/tools" method="GET" class="hero-search-form" role="search" aria-label="Search Creator Tools">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.637 10.637Z" />
            </svg>
            <input
              type="search"
              name="q"
              id="hero-search-input"
              class="hero-search-input"
              placeholder="Search creator tools and calculators..."
              autocomplete="off"
            />
            <button type="submit" class="hero-explore-btn">
              <span>Explore Tools</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </button>
          </form>

          <!-- Live Search Dropdown -->
          <div id="hero-search-dropdown" class="hero-search-dropdown hidden">
            <div class="dropdown-header">Quick Results</div>
            <div id="dropdown-results-list" class="dropdown-results-list"></div>
            <div class="dropdown-footer">
              <a href="/tools" class="dropdown-view-all">View all 80+ tools in directory &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Popular Tool Suggestion Chips -->
        <div class="hero-popular-chips">
          <span class="popular-label">Popular:</span>
          <a href="/tools/youtube-thumbnail-size-checker" class="popular-chip">YouTube Thumbnail</a>
          <a href="/tools/instagram-hashtag-counter" class="popular-chip">Hashtag Generator</a>
          <a href="/tools/video-compressor" class="popular-chip">Video Compressor</a>
          <a href="/tools/tiktok-caption-generator" class="popular-chip">Caption Generator</a>
        </div>
      </div>

      <!-- Right Column: Creator Artwork Illustration -->
      <div class="hero-artwork-col">
        <HeroIllustration />
      </div>
    </div>
  </section>

  <!-- 2. EXPLORE TOOLS BY CATEGORY (Matching Reference: 6 Cards) -->
  <section class="section-categories">
    <div class="container">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Explore Tools by Category</h2>
          <p class="section-subtitle">Find the right tool for your needs. From video editing to SEO, we've got you covered.</p>
        </div>
        <a href="/tools" class="view-all-link">
          <span>View All Tools</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="categories-grid-6">
        {categories.map(cat => (
          <a 
            href={cat.href} 
            class="category-pastel-card" 
            style={`background-color: ${cat.bg}; border-color: ${cat.border};`}
          >
            <div class="category-icon-square" style={`background-color: ${cat.iconColor};`}>
              <div class="category-svg-icon" set:html={cat.icon} />
            </div>
            <h3 class="category-card-title">{cat.title}</h3>
            <p class="category-card-desc">{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. FEATURED TOOLS (8 Cards) -->
  <section class="section-featured">
    <div class="container">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Featured Tools</h2>
          <p class="section-subtitle">Most popular and useful tools for creators, handpicked for you.</p>
        </div>
        <a href="/tools" class="view-all-link">
          <span>View All Tools</span>

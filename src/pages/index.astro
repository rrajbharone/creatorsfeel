<script>
  const setupHeroSearch = () => {
    const input = document.getElementById('hero-search-input') as HTMLInputElement | null;
    const dropdown = document.getElementById('hero-search-dropdown');
    const resultsContainer = document.getElementById('dropdown-results-list');
    const searchDataScript = document.getElementById('hero-search-data');
    const searchWrapper = document.getElementById('hero-search-wrapper');

    if (!input || !dropdown || !resultsContainer || !searchDataScript) return;

    let tools: Array<{ title: string; href: string; cat: string; desc: string }> = [];
    try {
      tools = JSON.parse(searchDataScript.textContent || '[]');
    } catch {
      tools = [];
    }

    let selectedIndex = -1;

    const render = (items: typeof tools) => {
      resultsContainer.innerHTML = '';
      selectedIndex = -1;

      if (items.length === 0) {
        resultsContainer.innerHTML = `
          <div style="padding: 1rem; text-align: center; font-size: 0.85rem; color: #64748b;">
            No tools found. Press <strong>Enter</strong> to explore full directory.
          </div>
        `;
        dropdown.classList.remove('hidden');
        return;
      }

      items.slice(0, 5).forEach((tool, idx) => {
        const item = document.createElement('a');
        item.href = tool.href;
        item.className = 'search-result-item';
        item.setAttribute('data-idx', idx.toString());
        item.innerHTML = `
          <div class="search-result-info">
            <span class="search-result-title">${tool.title}</span>
            <span class="search-result-desc">${tool.desc}</span>
          </div>
          <span class="search-result-cat">${tool.cat}</span>
        `;
        resultsContainer.appendChild(item);
      });

      dropdown.classList.remove('hidden');
    };

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        dropdown.classList.add('hidden');
        return;
      }
      const matched = tools.filter(t => 
        t.title.toLowerCase().includes(q) ||
        t.desc.toLowerCase().includes(q) ||
        t.cat.toLowerCase().includes(q)
      );
      render(matched);
    });

    input.addEventListener('focus', () => {
      if (input.value.trim()) {
        const q = input.value.trim().toLowerCase();
        render(tools.filter(t => t.title.toLowerCase().includes(q)));
      }
    });

    input.addEventListener('keydown', (e) => {
      const items = resultsContainer.querySelectorAll('.search-result-item');
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelected(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelected(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        const el = items[selectedIndex] as HTMLAnchorElement;
        if (el?.href) window.location.href = el.href;
      } else if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
      }
    });

    const updateSelected = (items: NodeListOf<Element>) => {
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.classList.add('selected');
        } else {
          item.classList.remove('selected');
        }
      });
    };

    document.addEventListener('click', (e) => {
      if (searchWrapper && !searchWrapper.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });
  };

  setupHeroSearch();
  document.addEventListener('astro:after-swap', setupHeroSearch);
</script>

---
interface Props {
  title: string;
  description: string;
  href?: string;
  badge?: string;
  badgeType?: 'brand' | 'success' | 'warning' | 'info';
  icon?: string; // We can pass SVG markup or inline content
}

const { title, description, href, badge, badgeType = 'brand', icon } = Astro.props;

const CardElement = href ? 'a' : 'div';
---

<CardElement href={href} class:list={["card glass", { "interactive": !!href }]}>
  <div class="card-inner">
    <div class="card-header">
      {icon && (
        <div class="card-icon" set:html={icon} />
      )}
      {badge && (
        <span class:list={["card-badge", `badge-${badgeType}`]}>{badge}</span>
      )}
    </div>
    
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-desc text-muted">{description}</p>
    </div>

    {href && (
      <div class="card-footer">
        <span class="action-text">Try Tool &rarr;</span>
      </div>
    )}
  </div>
</CardElement>

<style>
  .card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 1.15rem 1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    border: 1.5px solid var(--color-border) !important;
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
    box-sizing: border-box;
  }

  @media (max-width: 639px) {
    .card {
      padding: 0.95rem 0.8rem;
      border-radius: var(--radius-md);
    }
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
    gap: 0.65rem;
    min-width: 0;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
    gap: 0.35rem;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--gradient-glow);
    border: 1px solid var(--glass-border);
    color: var(--color-brand);
    flex-shrink: 0;
  }

  @media (max-width: 639px) {
    .card-icon {
      width: 32px;
      height: 32px;
    }
  }

  .card-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 639px) {
    .card-icon :global(svg) {
      width: 17px;
      height: 17px;
    }
  }

  .card-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .card-badge {
      font-size: 0.575rem;
      padding: 0.15rem 0.35rem;
    }
  }

  .badge-brand {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-brand);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .badge-success {
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-success);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .badge-warning {
    background: rgba(245, 158, 11, 0.1);
    color: var(--color-warning);
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .badge-info {
    background: rgba(14, 165, 233, 0.1);
    color: var(--color-info);
    border: 1px solid rgba(14, 165, 233, 0.2);
  }

  .card-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.5em;
  }

  @media (max-width: 639px) {
    .card-title {
      font-size: 0.9rem;
      line-height: 1.25;
      min-height: 2.5em;
    }
  }

  .card-desc {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.8em;
  }

  @media (max-width: 639px) {
    .card-desc {
      font-size: 0.725rem;
      line-height: 1.35;
      min-height: 2.7em;
    }
  }

  .card-footer {
    display: flex;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-brand);
    margin-top: auto;
    padding-top: 0.2rem;
  }

  @media (max-width: 639px) {
    .card-footer {
      font-size: 0.725rem;
    }
  }

  .action-text {
    transition: transform var(--transition-fast);
  }

  /* Interactive Cards */
  .interactive {
    cursor: pointer;
  }

  .interactive:hover {
    border-color: var(--color-brand) !important;
    transform: translateY(-4px);
    box-shadow: 0 10px 25px var(--color-shadow-hover);
    background: var(--color-bg-card-hover);
  }

  .interactive:hover .action-text {
    transform: translateX(4px);
  }
</style>
